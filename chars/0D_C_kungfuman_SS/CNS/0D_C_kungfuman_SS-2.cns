triggerall = Time = 1
triggerall = Alive && GameTime % 3 = 0
trigger1 = stateno=5000 || stateno=5010 || stateno=5020
trigger2 = stateno = 5070 || stateno = 5080
value = 10,random/333
channel = 0

;コピペ
;ワーヒー式悲鳴連呼システム・汎用
[State -2,Lose Voice]
type = PlaySnd
triggerall = !IsHelper
triggerall = !Alive
trigger1 = Time = 0
trigger1 = Hitshakeover = 0
value = 11, 1  ;悲鳴の番号。通常は11,0だが、キャラによってはその他の番号
channel = 14   ;悲鳴を一度あげるたびに声が切れるかどうか。台詞が長いキャラはここを消すこと
ignorehitpause = 1



