;-----------------------------------------------------------------------------
[Statedef -2];常時監視ステート(相手に行動を制御されても関係無く常に実行される)
;-----------------------------------------------------------------------------

;デバッグモードに白い文字の表示を加える
[State -2, デバッグ表示]
type = DisplayToClipboard
trigger1 = 1
text = "9=%d,V50=%d,V9-J=%d,V4-D=%d,Var24-B=%d"
params = var(9),var(9),var(9),var(35),var(4)
ignorehitpause = 1

;表示を横に加える
[State -2, デバッグ表示その2]
type = AppendToClipboard
trigger1 = 1
text = " V13-A=%d,V21-R=%d,Pos X=%d,Y=%d"
params = var(13),var(21),ceil(Pos X),PrevStateNo
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1


[State -3, システムヘルパー]
type=helper
trigger1=!NumHelper(10010+id)
trigger1=alive
helpertype=normal
name="var"
stateno=10010
ID=10010+id
pos=0, 0
postype=p1
facing=1
keyctrl=1
pausemovetime=2147483647
supermovetime=2147483647
persistent = 1
ignorehitpause = 1

