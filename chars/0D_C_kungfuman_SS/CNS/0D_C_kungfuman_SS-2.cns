;入力---------------------


[State -1, リセット時間]
type = varadd
triggerall = roundstate = 2
trigger1 = var(8)
var(8) = 1
Persistent = 1


[State -1, 先行入力リセット]
type = varset
trigger1 = roundstate != 2
trigger2 = var(8) < 0
Trigger3 = (var(8) = [20000,399999])&&movetype = A&&time = 1
Trigger4 = ((stateno = [900,929])||(stateno = [1000,2999]))&&time >= 3
trigger5 = statetype != L&&statetype != A
trigger5 = floor(var(8)%100) = 15
trigger6 = statetype = L||statetype = A
trigger6 = floor(var(8)%100) = 25
Trigger7 = stateno = 1305 
var(8) = 0
Persistent = 1

;******************補正合計******************************************************

;---------------補正合計----------------------------------------

[State -2, アタック]
type = AttackMulSet
trigger1 = roundstate = 2
value = Helper(10010+id),fVar(24)
ignorehitpause = 1

[State -2, ディフェンス]
type = DefenceMulSet
trigger1 = roundstate = 2
trigger1 = Helper(10010+id),fVar(20)
value = 1/Helper(10010+id),fVar(20)
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認リセット]
type = VarSet
triggerall = !IsHelper
trigger1 = MoveType != H
trigger2 = StateNo = [120, 159]
trigger3 = StateNo = 771
trigger4 = (Life <= 100)
v = 33
value = 0
ignorehitpause = 1

[State -2, 初撃防御力ヒット確認]
type = VarSet
triggerall = (Life > 100)
triggerall = !IsHelper
trigger1 = MoveType = H
trigger1 = StateNo != [120, 159]
trigger1 = StateNo != 771
v = 33
value = GetHitVar(HitCount)
ignorehitpause = 1

[State -2, 初撃防御力]
type           = LifeAdd
triggerall = (Life > 100)
triggerall     = Alive
triggerall     = life - var(35) > 0
triggerall = StateNo != 771
triggerall     = var(33) = 1
triggerall     = var(34) := GetHitVar(Damage)
trigger1       = var(35) := Floor(var(34) * (1.0 - ((Const(data.defence) / Helper(10010+id),fvar(20)) / 100)))
value          = var(35)
absolute       = 1
persistent     = 0
ignorehitpause = 1

[State -2, 初撃防御力KO]
type           = LifeAdd
triggerall = (Life > 100)
triggerall     = var(33) = 1
triggerall     = Alive
trigger1     = life - var(35) <= 0
value          = -1
absolute       = 1
persistent     = 0
ignorehitpause = 1
;******************補正合計******************************************************

;******************パレット・残像消去******************************************************

[State -2, 残像]
type = AfterImage
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = StateNo = [5000,5210]
Time = 0
;******************パレット・残像消去******************************************************

;******************気を付けてシステム******************************************************
;---------------------------------------------------------------------------
;----------------------------------------------------------------------------
;！用

[State -2,ヒット有利不利計測地上]
type = varset
triggerall= time > 3
triggerall = (NumTarget)
triggerall = statetype != A
triggerall = !Target,GetHitVar(fall)
Trigger1 = movetype = A
Trigger1 = movehit
var(7) = (Target,GetHitVar(hittime)+AnimTime)

[State -2,ガード有利不利計測地上]
type = varset
triggerall= time > 3
triggerall = (NumTarget)
triggerall = statetype != A
triggerall = !Target,GetHitVar(fall)
Trigger1 = movetype = A
Trigger1 = moveguarded
var(7) = (Target,GetHitVar(ctrltime)+AnimTime)

[State -2,ヒット有利不利計測空中]
type = varset
triggerall= time > 3
triggerall = (NumTarget)
triggerall = statetype = A
triggerall = !Target,GetHitVar(fall)
Trigger1 = movetype = A
Trigger1 = movehit
var(7) = (Target,GetHitVar(hittime)-AnimTime)

[State -2,ガード有利不利計測空中]
type = varset
triggerall= time > 3
triggerall = (NumTarget)
triggerall = statetype = A
triggerall = !Target,GetHitVar(fall)
Trigger1 = movetype = A
Trigger1 = moveguarded
var(7) = (Target,GetHitVar(ctrltime)-AnimTime)

[State -2,有利不利リセット]
type = varset
Trigger1 = movetype != A
trigger2= time <= 3
trigger3 = (NumTarget)
Trigger3 = Target,GetHitVar(fall) = 1
var(7) = 0

[State -2,文字]
type = RemoveExplod
trigger1= var(7) >= 0
id = 31011

[State -2,文字]
type = Explod
triggerall= var(20) = 0
trigger1= var(7) < 0
trigger1 = !NumExplod(31011)
anim = 31011
id = 31011
pos= const(size.head.pos.x)+ -40,const(size.head.pos.y)+ -15
postype = p1
facing = ifelse(facing = 1,1,-1)
sprpriority = 8
bindtime = -1
removetime = 999999999
scale = 0.25,0.25
shadow = 0,0,0
ownpal = 1
removeongethit = 1
;----------------------------------------------------------------------------
;キャンセル用

[State -2,文字]
type = RemoveExplod
trigger1= movetype = H
trigger2= ctrl = 1
trigger3= var(7) < 0
id = 31012

[State -2,文字]
type = Explod
triggerall= var(20) = 0
triggerall = !NumExplod(31012)
triggerall =  movehit = 1
triggerall= var(7) >= 0
trigger1 = anim = 200||anim = 210||anim = 230
trigger2 = anim = 400||anim = 410||anim = 430
anim = 31012
id = 31012
pos= const(size.head.pos.x)+ 5,const(size.head.pos.y)+ -15
postype = p1
facing = ifelse(facing = 1,1,-1)
sprpriority = 8
bindtime = 1
removetime = 20
scale = 0.25,0.25
shadow = 0,0,0
ownpal = 1
removeongethit = 1

