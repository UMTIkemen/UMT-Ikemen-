;******************ヘルパー******************************************************

;################投げ###########################
[state -2,投げエフェ]
type=Helper
triggerall=!ishelper
triggerall=!numhelper(9502)
triggerall = NumTarget(800) >= 1
trigger1 = target(800),anim = 815
trigger1 = target(800),Vel Y > 0
trigger1 = target(800),Pos Y >= 0
helpertype=normal
name="down"
ID=9502
pos=0,0
postype=p2
facing=1
stateno=9502
ownpal=1
;************************************************************************
[state -2,右飛ばしエフェ]
type=Helper
triggerall=!ishelper
triggerall=!numhelper(6603)
triggerall = NumTarget(1000)
triggerall = target(1000),Pos X >= 0
trigger1 = target(1000),stateno = 6601
trigger2 = target(1000),stateno = 4006
helpertype=normal
name="right_edge"
ID=6603
pos=0,ceil(target(1000),Pos Y)
postype=right
facing=1
stateno=6603
ownpal=1
;*************************
[state -2,左飛ばしエフェ]
type=Helper
triggerall=!ishelper
triggerall=!numhelper(6603)
triggerall = NumTarget(1000)
triggerall = target(1000),Pos X <= 0
trigger1 = target(1000),stateno = 6601
trigger2 = target(1000),stateno = 4006
helpertype=normal
name="right_edge"
ID=6603
pos=0,ceil(target(1000),Pos Y)
postype=left
facing=1
stateno=6604
ownpal=1
