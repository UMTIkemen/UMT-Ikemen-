; 中段
[Statedef 300]
type     = S
movetype = A
physics  = S
juggle   = 1
poweradd = 0
ctrl     = 0
anim     = 300
sprpriority = 1

[State ]
Type  = Trans
trigger1 = var(18) = 1&&var(49) = 0
Trans  = Add
IgnoreHitPause= 1

[State 52, 2]
type = Posadd
trigger1 = var(18) = 1&&var(49) = 0
trigger1 = Time = 0
x = 15

[State 52, 2]
type = Posadd
trigger1 = var(18) = 1&&var(49) = 0
trigger1 = animTime = 0
x = -15

[State 1000,***]
type = AssertSpecial
trigger1 = var(18) = 1&&var(49) = 0
flag = noshadow

;--------------------------
[State -2,1]
type = RemoveExplod
trigger1 = var(18) = 1&&var(49) = 0
trigger1 = time = 0
id = 2

[State -2,立ち画像エフェクト]
type = Explod
trigger1 = var(18) = 1&&var(49) = 0
trigger1 = time = 0
anim = 0
id = 2
pos = ceil(-17*const(size.xscale)),ceil(0*const(size.yscale))
postype = P1
sprpriority = 2
bindtime = -1
ownpal = 0
facing = 1
removetime = 9999999
scale = const(size.xscale),const(size.yscale)
shadow = -255,-255,-255
removeongethit = 1
pausemovetime = ifelse(fvar(2),999999,0)

[State -2,1]
type = RemoveExplod
trigger1 = var(18) = 1&&var(49) = 0
trigger1 = animtime = 0
id = 2

;--------------------------
