;スタンドon
[Statedef 710]
type = U
movetype = I
physics = N
ctrl = 0
anim = 750
sprpriority = 1
velset = 0,0

[State -1, スタンドon]
type = varset
Trigger1 = time = 0
var(18) = 1
Persistent = 0

[State 710, 音]
type = PlaySnd
trigger1 = time = 0
value = 3, 0

[State 600,土煙]
type = Explod
trigger1 = time = 0
anim = 30073
id = 30073
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = 3
ownpal = 1
facing = 1
bindtime = 1
scale = 0.5,0.5
removeongethit = 1
supermovetime = 999
pausemovetime = 999

[State 710,着地]
type = ctrlset
trigger1 = Time >= 1
value = 1

[State 710,着地]
type = ChangeState
trigger1 = Statetype = S
trigger1 = Time >= 16
value = 0
ctrl = 1

[State 710,着地]
type = ChangeState
trigger1 = Statetype = C
trigger1 = Time >= 16
value = 11
ctrl = 1
;---------------------------------------------------------------------------
;スタンドoff
