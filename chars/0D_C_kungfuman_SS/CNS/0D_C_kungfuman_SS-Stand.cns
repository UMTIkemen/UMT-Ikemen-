;***************************************************************************
;--------------------------スタンド-------------------------------------------
;***************************************************************************
;----------------------------------------------------------------
;基本動作
;----------------------------------------------------------------
;----------------
;待機中
[Statedef 4000]
type = S
movetype = I
physics = N
anim =  0
ctrl = 0
sprpriority = -1
poweradd = 0
velset = 0,0

[State ]
Type  = Trans
Trigger1 = 1
Trans  = Add
IgnoreHitPause= 1

[State 5900, スタンド使用不可]
type = VarSet
trigger1 = root,var(18) = 5
var(59) = 2

[State 200, ステート変更]
type = ChangeState
trigger1 = root,var(18) = 5
value = 4010

[State 3000, NotHitby]
type = NotHitBy
trigger1 = 1
value = SCA
ignorehitpause = 1

[State 1000, 座標固定]
type = BindToRoot
trigger1 = 1
Pos = ceil(30*root,const(size.xscale)),ceil(-30*root,const(size.yscale))
Time = -1
Facing = 1

[State 1000,***]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 1000,***]
type = AssertSpecial
trigger1 = root,Stateno = [200,699]
trigger2 = root,Stateno = [1000,1499]
trigger3 = root,Stateno = [1600,1699]
trigger4 = root,Stateno = [1800,1899]
trigger5 = root,Stateno = [2400,2599]
trigger6 = root,movetype = H
trigger6 = root,Stateno != [120,155]
trigger6 = root,Stateno != [5000,5069]
trigger7 = root,Stateno = 5610
trigger8 = root,Stateno = 712
trigger9 = root,anim = 5120
trigger10 = root,Stateno = [800,819]
trigger11 = root,Stateno = [2000,2099]
trigger12 = roundstate != 2
trigger13 = root,Stateno = [2600,2699]
trigger14 = root,Stateno = [2300,2399]
flag = invisible

[State 210, 3]
type = SprPriority
trigger1 = root,Stateno = [120,155]
value = 1

[State 210, 3]
type = SprPriority
trigger1 = root,Stateno != [120,155]
value = -1

