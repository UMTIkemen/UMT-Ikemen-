id = 30073
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
sprpriority = 3
ownpal = 1
facing = 1
bindtime = 1
scale = 0.5,0.5
removeongethit = 1
supermovetime = 999
pausemovetime = 999

