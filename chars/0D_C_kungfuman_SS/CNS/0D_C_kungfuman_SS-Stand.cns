trigger1 = time = 0
anim = 750
id = 2
pos = ceil(-25*const(size.xscale)),ceil(0*const(size.yscale))
postype = P1
sprpriority = 1
bindtime = -1
ownpal = 0
facing = 1
removetime = 9999999
scale = const(size.xscale),const(size.yscale)
shadow = -255,-255,-255
removeongethit = 1
