trigger1 = time = 4
value = 80
 
[State -2,1]
type = RemoveExplod
trigger1 = movetype = H
id = 2

;****コマンド判定****************************************

[State 1001, 強弱]
type = VarSet
triggerall = var(59) != 1
trigger1 = Time = 0
var(1) = ifelse((command="y"),1,ifelse((command="z"),2,0))
IgnoreHitPause = 1
Persistent = 1

