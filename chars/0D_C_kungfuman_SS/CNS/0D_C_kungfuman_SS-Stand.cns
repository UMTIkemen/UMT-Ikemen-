[State 40, しゃがみガード受付]
type = ChangeAnim
trigger1 = root,anim = 131||root,anim = 151 
trigger1 = anim != 131
value  = 131

[State 40, しゃがみガード終了]
type = ChangeAnim
trigger1 = root,anim = 141
trigger1 = anim != 132
value  = 132

[State 40, 空中ガード開始]
type = ChangeAnim
trigger1 = root,anim = 122
trigger1 = anim != 140
value  = 140

[State 40, 空中ガード受付]
type = ChangeAnim
trigger1 = root,anim = 132||root,anim = 152
