[State 40, 空中ガード終了]
type = ChangeAnim
trigger1 = root,anim = 142
trigger1 = anim != 142
value  = 142

;===========================================================

;===============くらい============================================


[State 40, うえくらい]
type = ChangeAnim
trigger1 = root,anim = [5000,5019]
trigger1 = anim != ifelse((root,GetHitVar(groundtype) = 1),5000,5010) + root,GetHitVar(animtype)
value  = ifelse((root,GetHitVar(groundtype) = 1),5000,5010) + root,GetHitVar(animtype)

[State 40, しゃがみくらい]
type = ChangeAnim
trigger1 = root,anim = [5020,5029]
trigger1 = anim != 5020 + root,GetHitVar(animtype)
value  = 5020 + root,GetHitVar(animtype)

[State 40, ふきとび]
type = ChangeAnim
trigger1 = (root,anim = [5030,5039])||(root,anim = [5070,5079])||(root,anim = [5100,5109])
trigger1 = anim != 5030
value  = 5030

[State 40, だうん]
type = ChangeAnim
trigger1 = root,anim = 5110||root,anim = 5150
trigger1 = anim != 5110
value  = 5110

[State 40, 受け身]
type = ChangeAnim
trigger1 = root,anim = 5040||(root,anim = [5200,5219])
trigger1 = anim != 5040
value  = 5040

[State 40, 気絶]
type = ChangeAnim
trigger1 = root,anim = 5300
trigger1 = anim != 5300
value  = 5300

;===========================================================


[State 815, 6]
type = DestroySelf
trigger1 = root,var(18) = 0

