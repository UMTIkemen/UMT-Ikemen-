trigger1 = time = 0
var(16) = ceil(-180*const(size.yscale))
ignorehitpause = 1
Persistent = 1
;*********************************************

[State 200, 弱ヒット定義];空中ガードなし
type = HitDef 
trigger1 = Time = 0
;攻撃属性
attr = S, NA
guardflag = M
ground.type = H
;アニメ属性
animtype  = H
;ダメージ　ポーズ
damage    = 80,28
pausetime = 10 + var(39),10 + var(39)
;
sparkno = -1
guard.sparkno = -1
sparkxy =0,0
hitsound   = -1
guardsound = -1
;ヒットタイム
ground.hittime  = var(36)
Guard.HitTime = var(37)
guard.ctrltime = var(37)
air.hittime = var(38)
ground.slidetime = var(36)-2
Guard.slidetime = var(36)-2
;ベクトル
ground.velocity = -4
air.velocity = -4,-4
air.cornerpush.veloff = -20
Priority = 4,H
getpower = 0
givepower = 0
Guard.Kill = 0

[State -1, スタンドon]
type = varset
Trigger1 = time = 0
var(18) = 1
Persistent = 0

[State 710, 音]
type = PlaySnd
trigger1 = time = 0
value = 3, 0

[State 600,土煙]
