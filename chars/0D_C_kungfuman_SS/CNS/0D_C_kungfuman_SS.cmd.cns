trigger2 = Animelem = 3,>= 1&&Animelem = 5,<= 0
trigger3 = (stateno = [200,299])||(stateno = [400,499])||(stateno = [600,699])
trigger3 = movecontact
trigger4 = (stateno = [1000,1999])
trigger4 = movecontact

