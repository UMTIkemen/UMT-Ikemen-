;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 基本行動のステート

;---------------------------------------------------------------------------
; ラウンド開始前初期化専用ステート
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = !RoundsExisted;roundno = 1
value = 9999

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = !RoundsExisted;roundno = 1
value = 190

;---------------------------------------------------------------------------
; ジャンプ開始
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 小ジャンプ]
type = VarSet
triggerall = fvar(0) = 1||fvar(0) = 4
trigger1 = var(59) != 1
trigger1 = var(1) = 0
trigger1 = !(command = "Njump")
trigger1 = !(command = "Hjump")
trigger1 = !(command = "holdup")
var(1) = 2

[State 1990, 投げ無敵]
type = NotHitBy
trigger1 = 1
value = ,AT
time = 1

[State 40, 6]
type = ChangeState
trigger1 = var(59) = 1
value = 0
ctrl = 1


[State 40, ハイジャンプ]
type = VarSet
trigger1 = var(59) != 1
trigger1 = (command = "jump")
var(1) = 1

[State 40, 1]
type = VarSet
trigger1 = var(59) != 1
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = var(59) != 1
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = var(59) != 1
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 移動速度]
type = VelSet
trigger1 = var(1) = [0,1]
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*ifelse(var(1) = 1,1.2,1), const(velocity.jump.back.x)*ifelse(var(1) = 1,1.2,1)))
y = const(velocity.jump.y)*ifelse(var(1) = 1,1.3,1)

[State 40, 移動速度]
type = VelSet
trigger1 = var(1) = 2
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4, -4))
y = -4.5

[State 40, 移動速度]
type = VelSet
trigger1 = (AnimTime = 0)
trigger1 = (PrevStateNo = 100)
trigger1 = (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)
y = const(velocity.runjump.y)

[State 40, 振り返る]
type = Turn
triggerall = (PrevStateNo = 52)
trigger1 = (Time = 0) && (P2Dist X < 0)
Persistent = 0

[State 40, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; ジャンプ
[Statedef 50]
type    = A
physics = A

[State 450, 音を鳴らす]
type = PlaySnd
trigger1 = time = 0
value = 40, 2

[State 192, esen]
type = Helper
trigger1 =  time  = 1
stateno = 9952
id = 9952
name = "esen"
helpertype=normal
keyctrl=0
pos = ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype = p1
ownpal = 1

[State 40, ハイジャンプ音]
type = PlaySnd
trigger1 = var(1) = 1
trigger1 = Time = 0
value = 40,3

[State 40, ハイジャンプ残像]
type = AfterImage
trigger1 = var(1) = 1
trigger1 = Time = 0
time = 30
trans = add1

[State 50, 1]
type = VarSet
trigger1 = Time = 5
var(1) = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))


