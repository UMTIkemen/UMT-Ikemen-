trigger1= !isHelper(10011+id)
trigger1=!NumHelper(10011+id)
trigger1=alive
helpertype=normal
name="Left"
stateno=10011
ID=10011+id
pos=0, 0
postype=Left
facing=-1
keyctrl=0
pausemovetime=2147483647
supermovetime=2147483647
persistent = 0

