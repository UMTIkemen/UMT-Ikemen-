
;-----------------------------------------------------------------------------
[Statedef -2]
;-----------------------------------------------------------------------------


;表示を横に加える
[State -2, デバッグ表示その2]
type = DisplayToClipboard
trigger1 = 1
text = " V1-C=%d,V8-C=%d,FV10-R=%f,FV15-R=%f,Y=%d"
params = var(1),var(8),Fvar(10),Fvar(15),floor(Pos Y)
ignorehitpause = 1

;表示を下に加える
[State -2, デバッグ表示その3]
type = AppendToClipboard
trigger1 = 1
text = "\nDist X=%d,Y=%d, Vel X=%d/10,Y=%d/10 : Power=%d"
params = floor(P2BodyDist X),ceil(P2BodyDist Y),ceil(Vel X*10),floor(Vel Y*10),Power
ignorehitpause = 1

[State -2, 投げバグ対策]
type = ChangeState
triggerall = NumTarget(800) >= 1
trigger1 = target(800),anim = 810
trigger1 = Stateno != 800
value = 800
ignorehitpause = 1

