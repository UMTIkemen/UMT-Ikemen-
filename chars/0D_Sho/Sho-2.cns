; 1,1以降ワイド画面自動切り替え
[State 5900, 1]
type = VarSet
trigger1 = var(9) = 2
trigger1 = 2**9 = 4096
var(9) = 0
;winmugen通常画面比率

; 1,1以降ワイド画面自動切り替え
[State 5900, 1]
type = VarSet
trigger1 = var(9) = 2
trigger1 = 2**9 != 4096
var(9) = 1
;mugen1.1ワイド画面比率


[State -2, 崩れＫＯ]
type = ChangeState
triggerall = (!Alive) || (Life <= 0) || (Lose)
triggerall = (PrevStateNo = [120,131]) || (PrevStateNo = [150,153])
trigger1 = (StateNo = [120,155])
value = 5035
IgnoreHitPause = 1

[State 5101, 3]
type = StopSnd
trigger1 = Name = "Wen kamuy"
channel = 0
ignorehitpause = 1

[State 5101, 3]
type = Trans
trigger1 = Name = "Wen kamuy"
trans = addalpha
alpha = 250,30

[State -2,KO]
type = AssertSpecial
trigger1 = Name = "Wen kamuy"
trigger1 = (StateNo != 5150)
trigger1 = enemynear,movetype != H
trigger1 = life >= 0 
flag = nokosnd
IgnoreHitPause = 1


[State -2, スクロール];負けて倒れたらカメラワークを相手に移す処理
type = ScreenBound
triggerall = (Life <= 0) || (!Alive) || (Lose)
trigger1 = (StateNo = 5150) && (RoundState = 4)
value = 0
MoveCamera = 0,0
IgnoreHitPause = 1


