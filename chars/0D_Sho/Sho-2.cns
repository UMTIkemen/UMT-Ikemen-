triggerall = stateno != [0,105]
triggerall = stateno != [120,155]
triggerall = stateno != [5000,5270]
triggerall = ctrl = 0
triggerall = Prevstateno = 5001||Prevstateno = 5011||Prevstateno = 151||Prevstateno = 153
