v = 20
value = 0
ignorehitpause = 1

[State -2, リセット]
type = Varset
triggerall = var(22)
trigger1 = movetype != H
trigger2 = ctrl = 1
trigger3 = stateno = 5000||stateno = 5010||stateno = 150||stateno = 152
v = 22
value = 0
ignorehitpause = 1

[State -2, hittime10～14]
type = Varset
triggerall = !var(22)
trigger1 = GetHitVar(hittime) >= 10&&GetHitVar(hittime) <= 14
v = 22
value = 1
ignorehitpause = 1

[State -2, hittime14～30];上限をつけないとロックしない乱舞技などにも割り込める
type = Varset
triggerall = !var(22)
trigger1 = GetHitVar(hittime) >= 14&&GetHitVar(hittime) <= 30
v = 22
value = 2
ignorehitpause = 1

[State -2, hittime30～];リセット
type = Varset
triggerall = !var(22)
trigger1 = GetHitVar(hittime) >= 30
trigger2 = stateno = 5000||stateno = 5010||stateno = 150||stateno = 152
v = 22
value = 0
ignorehitpause = 1

[State -2, バグ防止用処置]
type = null;StateTypeSet
trigger1 = var(20)
movetype = I
ignorehitpause = 1

[State -2, キャンセル];hittime10～30でキャンセル可能
type = Varset
triggerall = (Alive&&!var(59))||(var(59)&& roundstate = 2&&var(58)>=5)
triggerall = statetype != A||statetype != L
triggerall = GetHitVar(animtype) != 0
triggerall = !var(26)
trigger1 = stateno = 5001
trigger2 = stateno = 5011
trigger3 = stateno = 151
trigger4 = stateno = 153
v = 20
value = GetHitVar(hittime) < (2*var(22))
ignorehitpause = 1

