;------------------------------------------------------------------------------
;==============================================================================
; 技を実行するための条件の設定（ステートエントリーパート）
;==============================================================================
;------------------------------------------------------------------------------

[Statedef -1];←この行は絶対に消さないでください。必須の項目です。

;==============================================================================


;***************************************************************************
;---------------------------------------------------------------------------
;----------------------------超必殺-----------------------------------------
;---------------------------------------------------------------------------
;***************************************************************************

;紅岩砕蹴
[State -1, 紅岩砕蹴]
type = ChangeState
value = 2200
triggerall = !var(59)
triggerall = movetype != H
triggerall = command = "紅岩砕蹴"||(var(8) = [220000,220099])
triggerall = power >=1000
triggerall = statetype != L
trigger1 = ctrl||Var(20) = 1||((Stateno = [200,599])&&time <= 3&&statetype != A)||((Stateno = [600,799])&&time <= 3&&statetype = A)
trigger2 = stateno = 200&&Animelem = 2,>= 0
trigger3 = anim = 210&&((Animelem = 3,>= 1&&Animelem = 4,<= 5)||Movecontact)
trigger4 = anim = 211&&((Animelem = 2,>= 0&&Animelem = 4,<= 0)||Movecontact)
trigger5 = anim = 212&&((Animelem = 2,>= 0&&Animelem = 3,<= 0)||Movecontact)
trigger6 = anim = 220&&MoveContact
trigger7 = anim = 230&&((Animelem = 4,>= 0)||Movecontact)
trigger8 = anim = 231&&((Animelem = 3,>= 0)||Movecontact)
trigger9 = anim = 241&&((Animelem = 3,>= 0&&Animelem = 4,<= 0)||Movecontact)
trigger10 = anim = 250&&((Animelem = 3,>= 0)||Movecontact)
trigger11 = anim = 400&&((Animelem = 2,>= 0)||Movecontact)
trigger12 = anim = 401&&((Animelem = 2,>= 0)||Movecontact)
trigger13 = anim = 410&&((Animelem = 3,>= 0&&Animelem = 3,<= 3)||Movecontact)
trigger14 = anim = 430&&((Animelem = 2,>= 0)||Movecontact)
trigger15 = anim = 440&&((Animelem = 2,>= 0&&Animelem = 3,<= 3)||Movecontact)
trigger16= stateno = 213&&((Animelem = 5,>= 0)||Movecontact)
trigger17 = stateno = 245&&MoveContact
trigger18 = stateno = 600&&((Animelem = 2,>= 0)||Movecontact)
trigger19 = stateno = 610&&((Animelem = 4,>= 0&&Animelem = 5,<= 0)||Movecontact)
trigger20 = anim = 630&&((Animelem = 2,>= 0)||Movecontact)
trigger21 = anim = 631&&((Animelem = 3,>= 0)||Movecontact)
trigger22 = anim = 641&&movehit
trigger23 = stateno = 645&&((Animelem = 2,>= 0)||Movecontact)
trigger24 = stateno = 650&&((Animelem = 4,>= 0)||Movecontact)

