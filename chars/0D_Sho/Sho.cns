; ダッシュ
[Statedef 100]
type    = S
physics = S
anim = 100
poweradd = 20
sprpriority = 1
velset = 0,0
ctrl = 0

[State 1510, 0]
type = Turn
triggerall = Alive&&var(59) && roundstate = 2
trigger1 = time = 0
trigger1 = P2Dist x< 0

[State 3, 走る]
type = PlaySnd
trigger1 = time = 4||time = 12||time = 20||time = 28
value = 4,1

[State 800,土煙1]
type = Explod
trigger1 =AnimElem = 1
anim = 10302
id = 10302
pos = -40,0
postype = P1
sprpriority = 2
bindtime = 1
ownpal = 1

[State 800,土煙2]
type = Explod
trigger1 =AnimElem = 2||AnimElem = 5||AnimElem = 6
anim = 10303
id = 10303
pos = -40,0
postype = P1
sprpriority = 2
bindtime = 1
ownpal = 1

[State 100, 1]
type = VelSet
trigger1 = animelemtime(6) < 0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = !var(59)
triggerall = movetype != H
trigger1 = command != "holdfwd"
trigger1 = animtime = 0
value = 0
ctrl = 1


[State 100, 4]
type = ChangeState
trigger1 = !var(59)
trigger1 = command = "holdback"
value = 101
ctrl = 0

