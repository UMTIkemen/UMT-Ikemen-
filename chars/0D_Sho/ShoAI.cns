[State -3, 以前のステート記憶]
Type = Null
TriggerAll = Var(2) != Root,StateNo
TriggerAll = Root,Time = 1
Trigger1 = 0&& Var(5) := Var(4)
Trigger2 = 0&& Var(4) := Var(3)
Trigger3 = 0&& Var(3) := Var(2)
Trigger4 = 0&& Var(2) := Var(1)
Trigger5 = 0&& Var(1) := Root,StateNo
IgnoreHitPause = 1

