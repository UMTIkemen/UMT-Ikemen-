trigger1 = GetHitVar(hitshaketime) = 0
x = 1
y = 1

[state 16710, スクロール]
type = ScreenBound
triggerall = pos y < -15
trigger1 = BackEdgeBodyDist < 15       ;プレイヤー背面のぶつかり判定から、後方の画面端までの距離を返す。
trigger2 = FrontEdgeBodyDist < 15      ;プレイヤー前面のぶつかり判定から、前方の画面端までの距離を返す。
value = 1         ;画面のスクロールに影響を受けるか。0=受けない　1=受ける
movecamera = 0,0  ;カメラがプレイヤーを追うか否か。x,y軸。

[state 16710, ステート変更] ;壁に激突するステートへ
