;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[StateDef -3]
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;コンフィグ設定
;---------------------------------------------------------------------------
;ヒットストップ新MUGEN対応
[State -2]
type = VarSet
trigger1 = Life >= 1
trigger1 = 1
v = 13
value = 0        ;0 で WinMUGEN。1 で 新MUGENに対応。

;-------------------------------------
;ズーム対応（主に全画面の演出に対しての設定です。MUGEN本体による演出のズレの修正です）
[State -3]
type = VarSet
trigger1 = 1
v = 34
value = 1        ;0 ～ 2 で設定可能。

;0 で MUGEN1.1 のようなズームにも対応します。WINMUGENでも大丈夫でしょう。
;（ステージによってはおかしくなるかも知れませんが大丈夫でしょう）。

;1 で従来の WINMUGEN や MUGEN1.0

;2 でどちらを設定してもおかしくなる場合使ってみるとまだマシになる可能性が……あるかも知れません。

;どれも完全ではないので対処療法的なものがありますが、
;本体の異なるバージョンとステージ側の様々な設定に全て対応するのは不可能です。
;取り合えずキャラ側で頑張れる範囲内での設定となっています。
;-------------------------------------
;アルカナ選択
[State -2]
type = VarSet
trigger1 = 1
v = 24
value = 1

;0  アルカナ無し
;1  釼神のガイスト   ゴットフリート
;2  磁のアルカナ     メデイン
;3  音のアルカナ     フェネクス
;4  罪のアルカナ     サルヴァーチ
;5  顎獣のガイスト   バルドゥール（弱体化モード）
;6  顎獣のガイスト   バルドゥール（強化モード）
;7  聖のアルカナ     ジラエル
;8  氷のアルカナ     アルマシア
;9  命のアルカナ     パラセ・ルシア（弱体化モード）
;10 命のアルカナ     パラセ・ルシア（通常モード）

;-------------------------------------
;バージョン仕様変更
[State -2]
type = VarSet
trigger1 = 1
v = 6
value = 3        ;0 でＯＦＦ。1 でＯＮ。

;0   Ver3.00
;1   Ver3.01
;2   ラブマックス
;3   ラブマックス＋3.00

;3.00 だとなっている物は 4B が受身不可。
;ラブマックスとなっている物は、
;必殺技のグライデンの性能変化。
;エクステンドブラストの追加。
;エクステンド中もアルカナバーストが使える。
;追剣ヤーデンはどれでも使えるようになってますが。

;-------------------------------------
;相殺可能フラグ
[State -2]
type = VarSet
trigger1 = 1
v = 14
value = 0        ;0 相殺有り。1 相殺無し。

;-------------------------------------
;アルカナゲージ
[State -2]
type = VarSet
trigger1 = 1
v = 18
value = 1        ;0 原作基準。1 アレンジモード。

;アルカナゲージの初期値を弄れます。
;0 で原作基準で１ゲージスタートで超必殺技などゲージ技はアルカナゲージを使います。
;1 でアレンジで３ゲージスタート。ただし超必殺技は MUGEN のデフォルトゲージを使います。
;このヴァイスは原作再現キャラなのでデフォルトでは 0 の原作基準となっていますが、
;MUGENでは他キャラとの兼ね合いでアレンジモードをお勧めします。
;他にもアレンジモードだと性能が違う技が一部あります（アルカナ技など）。

;-------------------------------------
;ガードクラッシュフラグ
[State -2]
type = VarSet
trigger1 = 1
v = 26
value = 1        ;0 無し。1 有り。

;タメＥ攻撃を相手にガードさせた場合、相手側はガードクラッシュするかどうかです。
;原作では当然 ON ですが、AI 殺しの面もあるので、デフォルトでは OFF にしています。

;-------------------------------------
;先行入力時間
[State -2]
type = VarSet
trigger1 = 1
v = 29
value = 10

;必殺技とか先行入力受付時間です。お好みにどうぞ。
;デフォでは 10 になってますが、40 はないと暗転見て即入力必殺技とかはキビシイかもしれません。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;===========================================================================
; ここからＡＩ記述
;===========================================================================
;---------------------------------------------------------------------------
[State -3, AIテスト用1]
type = null;VarSet
triggerall = Var(59) != 0
trigger1 = command != "/b"
v = 59
value = 0

[State -3, AIテスト用2]
type = null;VarSet
triggerall = Var(59) = 0
trigger1 = command = "/b"
v = 59
value = 3

[State -3, AIフラグセット]
Type = VarSet
TriggerAll = Var(59) = 0
TriggerAll = RoundState = 2
Trigger1   = Command = "AI01" || Command = "AI02" || Command = "AI03" || Command = "AI04" || Command = "AI05"
Trigger2   = Command = "AI06" || Command = "AI07" || Command = "AI08" || Command = "AI09" || Command = "AI10"
Trigger3   = Command = "AI11" || Command = "AI12" || Command = "AI13" || Command = "AI14" || Command = "AI15"
Trigger4   = Command = "AI16" || Command = "AI17" || Command = "AI18" || Command = "AI19" || Command = "AI20"
Trigger5   = Command = "AI21" || Command = "AI22" || Command = "AI23" || Command = "AI24" || Command = "AI25"
Trigger6   = Command = "AI26" || Command = "AI27" || Command = "AI28" || Command = "AI29" || Command = "AI30"
Trigger7   = Command = "AI31" || Command = "AI32" || Command = "AI33" || Command = "AI34" || Command = "AI35"
Trigger8   = Command = "AI36" || Command = "AI37" || Command = "AI38" || Command = "AI39" || Command = "AI40"
Trigger9   = Command = "AI41" || Command = "AI42" || Command = "AI43" || Command = "AI44" || Command = "AI45"
Trigger10  = Command = "AI46" || Command = "AI47" || Command = "AI48" || Command = "AI49" || Command = "AI50"
;Trigger11 = 1      ;Trigger11の前の ; を消すと AI 常時起動
v = 59 
value = 3   ;0 ～ 4 で設定可能。取りあえず動く程度。固めは人操作だと連携が慣れるまで強いと思います。
            ;全レベルで超反応や、AI 精度の割り込みとかしない筈ですが、ちょっと作りこみが甘く、そうでもないかも知れません。
            ;まあ Lv3 と Lv4 のお陰で何とか残念な強さでは無くなったかと思います。

;0  AI無し
;1  ヴァイス本体の性能でのみ戦います。必殺技とかはコンボ中以外使いません。
;2  アルカナ技を使うようになります。
;3  必殺技を使うようになります。Ｅ攻撃のガードクラッシュや、無敵昇竜も使うようになります。
;4  ガードキャンセルの使用頻度アップと、そこからの昇竜で差し込んできます。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;--------------------- 以下AI記述弄る箇所はありません ----------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;Var(46)   連続技フラグ
;Var(47)   
;Var(48)   ランダム変数
;Var(49)   中下段学習
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -3, ランダム変数] ;低確率のぶっぱなし用
type = VarRandom
triggerall = Var(59) != 0
triggerall = RoundState = 2
trigger1 = 1
v = 48
range = 0,10000

[State -3, 連続技フラグ] ;リセット
type = VarSet
trigger1 = RoundState = 0
trigger2 = Var(59) = 0
v = 46
value = 0

[state -3, AI用ヘルパー]
type = helper
trigger1 = Var(59) != 0
trigger1 = RoundState = 2
trigger1 = numhelper(7895) = 0
helpertype = normal
ID = 7895
stateno = 7895
pos = 0,0
postype = left
ownpal = 0
keyctrl = 0
supermovetime = 999999999999999
pausemovetime = 999999999999999
ignorehitpause = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;------------------------------ AI基本コンボ -------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;Var(46)   10   ～  19    
;Var(46)   20   ～  29     地上チェーンからグライデン後のコンボ（基本）
;Var(46)   30   ～  39     4B 生当て後
;Var(46)   40   ～  49    
;Var(46)   50   ～  59    
;Var(46)   60   ～  69    
;Var(46)   470  ～  479    音アルカナ起き攻め
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -3, VarSet] ;リセット
type = VarSet
triggerall = Var(59) >= 1
trigger1 = Movetype = H
trigger2 = StateNo = [9000,9999]
v = 46
value = 0

;-------------連打キャンセル--------------

[State -3, 5A]
type = Changestate
value = 200
triggerall = Var(59) >= 1
triggerall = Statetype != A
triggerall = StateNo = 200
triggerall = Movecontact
trigger1 = (EnemyNear,Statetype = A)
trigger2 = Var(48) = [8000,10000]

[State -3, 2A]
type = Changestate
value = 400
triggerall = Var(59) >= 1
triggerall = Statetype != A
trigger1 = StateNo = 400
trigger1 = Movecontact
trigger1 = (Var(48) = [9000,10000])
;トリガー１は気まぐれ連打キャンセル
trigger2 = StateNo = 400
trigger2 = Movecontact
trigger2 = PrevStateNo = 400
;トリガー２は気まぐれ連打キャンセル

