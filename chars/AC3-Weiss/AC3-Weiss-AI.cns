;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;AI 制御用ステート
;StateDef 41        AI用ジャンプ前予備動作（前方）
;StateDef 42        AI用ジャンプ前予備動作（垂直）
;StateDef 43        AI用ジャンプ前予備動作（後方）
;StateDef 61        AI用ハイジャンプ開始。ハイジャンプ前予備動作（前方）
;StateDef 62        AI用ハイジャンプ開始。ハイジャンプ前予備動作（垂直）
;StateDef 63        AI用ハイジャンプ開始。ハイジャンプ前予備動作（後方）
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;AI用ジャンプ前予備動作（前方）
[StateDef 41]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 41, 2] ;前方ジャンプ、sysvar(1)を1にセット
type = VarSet
trigger1 = 1
sysvar(1) = 1

;---------------------↑ジャンプする方向を指定

[State 41, 4] ;ジャンプ開始時の速度制御
type = VelSet
trigger1 = AnimTime = 0
x = const(velocity.jump.fwd.x)
y = const(velocity.jump.y)

[State 41, 5] ;ダッシュジャンプ時の速度制御、
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;ダッシュ
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[state 41, 投げ無敵] ;ジャンプ前動作中は投げ回避可能
type = NotHitBy
trigger1 = 1
value = ,AT

[state 41, VarSet] ;通常ジャンプ判定
type = VarSet
trigger1 = 1
v = 4
value = 0

[State 41, VarSet] ;エクステンド解除。
type = VarSet
trigger1 = Var(50) <= 2
v = 50
value = 0

[State 41, 音を鳴らす]
type = PlaySnd
trigger1 = animtime = 0
value = 3,7

[State 41, 6] ;ジャンプ中ステートへ以降
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

