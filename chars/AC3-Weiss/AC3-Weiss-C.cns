;軍剣展開ヒンメルファールト、全方向から相手に突き刺さる剣
[StateDef 9100]
type = A
movetype = A
physics = N
ctrl = 0
sprpriority = 2

[state 9100] ;アニメランダム用
type = VarRandom
trigger1 = time = 0
v = 5
range = 0,6

[State 9100, アニメ変更]
type = ChangeAnim
trigger1 = time = 0
value = 9100 + Var(5)

[state 9100, 影を非表示]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;---------

[state 9100, 振り向き]
type = Turn
trigger1 = P2Dist X < 0
trigger1 = time <= 1

[State 9100, 相手のＸ座標]
type = VarSet
trigger1 = time <= 1
Fv = 2
value = (P2Dist X) / 10

[State 9100, 相手のＹ座標]
type = VarSet
trigger1 = time <= 1
Fv = 3
value = (P2Dist Y - 30) / 10

[State 9100] ;サイズと角度
type = AngleDraw
trigger1 = FVar(3) >= 0
value = floor(((Atan(FVar(2)/FVar(3))*180)/pi)-180)
scale = 1.0,1.0

[State 9100] ;サイズと角度
type = AngleDraw
trigger1 = FVar(3) <= -1
value = floor(((Atan(FVar(2)/FVar(3))*180)/pi))
scale = 1.0,1.0

[State 9100, VarSet]
type = VarSet
trigger1 = time <= 1
trigger1 = FVar(3) >= 0
v = 1
value = floor(((Atan(FVar(2)/FVar(3))*180)/pi)-180)

[State 9100, VarSet]
type = VarSet
trigger1 = time <= 1
trigger1 = FVar(3) <= -1
v = 1
value = floor(((Atan(FVar(2)/FVar(3))*180)/pi))

