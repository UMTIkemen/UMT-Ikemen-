[state 9064, 攻撃を食らわなくする]
type = nothitby
trigger1 = 1
value = SCA,AA,AP,AT
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[State 9064, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 9064, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
persistent = 0
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
value = 5110 + (anim % 10)

[State 9064, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 9064, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = 5170 + (anim % 10)

[State 9064, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 9064, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 9064, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 9064, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 9064, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 9064, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 9064, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)

[State 9064, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

[State 9064, 11] ;If just died
type = SelfState
trigger1 = !alive
trigger1 = Life = 0
trigger1 = time >= 30
value = 5150

[State 9064, 11-2] ;体力有り
type = SelfState
trigger1 = (PrevStateNo != [9460,9469])
trigger1 = alive = 1
trigger1 = time >= 100
value = 5120

[State 9064, 11-2] ;体力有り
type = SelfState
trigger1 = (PrevStateNo = [9460,9469])
trigger1 = alive = 1
trigger1 = time >= 250
value = 5120

[State 9064, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 9064, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 9064, 14]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 9064, 15]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

