type = HitAdd
trigger1 = time = 0
value = 1

[State 9200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 1, 6

[state 9200] ;ヒットエフェクトの角度
type = VarRandom
trigger1 = time = 0
v = 1
range = 0,360

[state 9200] ;ヒットエフェクトの幅（初期値）を変更
type = VarSet
trigger1 = time = 0
Fv = 1
value = 0

