type = A
movetype = I
physics = N
anim = 3351
ctrl = 0
sprpriority = 5

[state 3381, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AP,AT

[State 3381, 親の位置に固定]
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 3381, 角度]
type = AngleDraw
trigger1 = 1
value = 20

[state 3351] ;影を消す
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state 3381] ;エフェクトの透過度
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[State 3381, ヘルパー消去]
type = DestroySelf
trigger1 = time = 33

