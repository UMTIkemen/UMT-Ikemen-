;突攻剣ツァールライヒ（相手立ち食らい）
[StateDef 3390]
type    = S
movetype= H
physics = N
velset = 0,0

[state 3390, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[state 3390, 振り向き]
type = Turn
trigger1 = P2Dist X < 0

[State 3390, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim2
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 3390, 2] ;Anim for HIT_BACK
type = ChangeAnim2
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 3390, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim2
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 3390, 4] ;Freeze anim
type = ChangeAnim2
trigger1 = Time > 0
value = anim

[State 3390, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 3390, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 3391 ;HITG_SLIDE

[State 3390, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 3391 ;3392

[State 3390, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 3390, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 3390, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 3390, 相手にステートを戻す]
type = SelfState
trigger1 = time = 60
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;突攻剣ツァールライヒ（相手立ち食らい後退）
[StateDef 3391]
type    = S
movetype= H
physics = S

[state 3391, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[State 3391, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 3391, 2]
type = ChangeAnim2
trigger1 = AnimTime = 0
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 3391, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 3391, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 3391, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 3391, 6]
type = SelfState
trigger1 = HitOver
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;突攻剣ツァールライヒ（吹っ飛び開始）
[StateDef 3392]
type    = A
movetype= H
physics = N
ctrl = 0

[State 3392, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(airtype) = 1),5000,5010) + GetHitVar(animtype)

[State 3392, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 3392, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[state 3392, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[State 3392, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 3392, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 3392, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 3392, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 3392, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 3393 ;HITA_UP (transition)

;---------------------------------------------------------------------------
;突攻剣ツァールライヒ（吹っ飛び（フォール状態か否かの判断もしている））
[StateDef 3393]
type    = A
movetype= H
physics = N

[state 3393, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[State 3393, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5035

[State 3393, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 3393, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 3394 ;HITA_RECOV

[State 3393, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 3394 ;HITA_FALL

;---------------------------------------------------------------------------
;突攻剣ツァールライヒ（吹っ飛び下降）
[StateDef 3394]
type    = A
movetype= H
physics = N

[state 3394, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[State 3394, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 3394, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 3394, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 3394, 6]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
trigger2 = time = 360
value = 5100 ;HIT_BOUNCE

;---------------------------------------------------------------------------
;突攻剣ツァールライヒ（剣ヘルパー攻撃される相手）
[StateDef 3395]
type    = A
movetype= H
physics = N

[state 3395, 無敵]
type = NotHitBy
trigger1 = 1
time = 24
value = ,AA,AP,NT,ST

[State 3395, 1] ;Change anim when done with transition
type = ChangeAnim2
trigger1 = 1
value = 3395

[State 3395, 2]
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 3395, 6]
type = SelfState
trigger1 = time = 60
trigger2 = Vel Y > 0
trigger2 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100

