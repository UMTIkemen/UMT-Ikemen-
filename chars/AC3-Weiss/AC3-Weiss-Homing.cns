;レバー入力初速の減速用

[State 4100, VarSet] ;初期値リセット
type = VarSet
trigger1 = time = 0
Fv = 12
value = 0

[State 4100, VarSet]
type = VarAdd
triggerall = FVar(12) <= 6.0
trigger1 = time = [1,6]
Fv = 12
value = 0.03

[State 4100, VarSet] ;
type = VarAdd
triggerall = FVar(12) <= 6.0
trigger1 = time = [7,12]
Fv = 12
value = 0.05

[State 4100, VarSet] ;
type = VarAdd
triggerall = FVar(12) <= 6.0
trigger1 = time >= 13
Fv = 12
value = 0.6

[State 4100, 移動速度Ｘ軸] ;正面の相手に対して距離が一番離れている。後ろ方向レバー入力
type = VelSet
triggerall = Var(59) = 0 
triggerall = FVar(10) >= abs(FVar(11))
triggerall = P2BodyDist X >= 20
trigger1 = Command = "holdback"
trigger1 = time <= 13
x = 1.0 + FVar(12)

;---------------------
;---------------------
;---------------------
;相手真下時に相手方向への速度減速
[state 4100, 移動速度] ;レバー入力Ｙ軸制御、上方向（ほぼ密着）
type = Velset
triggerall = Var(59) = 0 
trigger1 = P2BodyDist X  <= 20
trigger1 = P2BodyDist Y = [0,150]
trigger1 = Command = "holdup"
y = 3.25

;---------------------
;多少以上距離が離れている場合の下方向へのレバー移動
[state 4100, 移動速度] ;レバー入力Ｙ軸制御、下方向（密着以上以上）
type = VelSet
triggerall = Var(59) = 0 
triggerall = FVar(10) >= abs(FVar(11))
trigger1 = P2BodyDist X >= 21
trigger1 = Command = "holddown"
y = 4.0 / FVar(13)

;---------------------
;Ｙ軸上方向へのレバー入力制御
[state 4100, 移動速度] ;レバー入力Ｙ軸制御1
type = Velset
triggerall = Var(59) = 0
triggerall = FVar(10) >= abs(FVar(11))
triggerall = P2BodyDist Y >= 150 || P2BodyDist Y <= -150
;trigger1 = P2BodyDist X >= 20
trigger1 = P2BodyDist X  <= 199
trigger1 = Command = "holdup"
y = -(P2BodyDist X / 50) / FVar(13)

[state 4100, 移動速度] ;レバー入力Ｙ軸制御2
type = Velset
triggerall = Var(59) = 0 
triggerall = FVar(10) >= abs(FVar(11))
trigger1 = P2BodyDist X  >= 200;[200,399]
trigger1 = Command = "holdup"
y = -(P2BodyDist X / 100) / FVar(13)

[state 4100, 移動速度] ;レバー入力Ｙ軸制御3
type = Velset
triggerall = Var(59) = 0
triggerall = FVar(10) >= abs(FVar(11))
triggerall = P2BodyDist Y >= 150 || P2BodyDist Y <= -150
trigger1 = P2BodyDist X  = [400,599]
trigger1 = Command = "holdup"
y = -(P2BodyDist X / 200) / FVar(13)

[state 4100, 移動速度] ;レバー入力Ｙ軸制御4
type = Velset
triggerall = Var(59) = 0 
triggerall = FVar(10) >= abs(FVar(11))
trigger1 = P2BodyDist X  = [600,799]
trigger1 = Command = "holdup"
y = -(P2BodyDist X / 300) / FVar(13)

[state 4100, 移動速度] ;レバー入力Ｙ軸制御5
