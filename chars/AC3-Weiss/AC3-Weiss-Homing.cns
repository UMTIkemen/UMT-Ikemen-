;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;アルカナハート３のホーミング
;このままコピペで使えます。性能はヴァイスの物となっているので、
;速度とかは多少弄らないといけないキャラもいますが基本弄らなくてもおｋです。
;ただアニメとVarの調整は自分のキャラに合わせてください
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;使用Var表

;FVar(0)     ホーミング時のエフェクト

;FVar(10)    相手のＸ座標軸抽出
;FVar(11)    相手のＹ座標軸抽出


;Var(16)    ホーミングＸ軸レバー入力制御
;Var(17)    ホーミングＹ軸レバー入力制御

;FVar(12)    ホーミング時、後方レバー入力制御用
;FVar(13)    ホーミング時、追加加速度制御

;------------------------------
;ステート表

;StateDef 4000  ホーミング、地上、発動。
;StateDef 4010  ホーミング、地上前。
;StateDef 4020  ホーミング、地上前、ホバー走行。
;StateDef 4030  ホーミング、地上後ろ。

;StateDef 4050  ホーミング、空中、発動。
;StateDef 4060  ホーミング、空中、上昇。
;StateDef 4065  ホーミング、空中、前方上昇。
;StateDef 4070  ホーミング、空中、前方。
;StateDef 4070  ホーミング、空中、前方下降。
;StateDef 4080  ホーミング、空中、下降。

;StateDef 4090  ホーミング、空中、後ろ。
;StateDef 4095  ホーミング、空中、後方上昇。

;StateDef 4100  ホーミング、地上、誘導開始。

;StateDef 4300  空中ホーミング時・青い波紋のエフェクト
;StateDef 4350  空中ホーミング発動、魔方陣・横
;StateDef 4360  空中ホーミング発動、魔方陣・縦
;StateDef 4370  空中ホーミング発動、フラッシュ

------------------------------

;StateDef 4500  地上ガードキャンセルホーミング・前
;StateDef 4550  空中ガードキャンセルホーミング・前
;StateDef 4590  地上および空中ガードキャンセルホーミング・後ろ

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;ホーミング、地上、発動。
[StateDef 4000]
type = A
physics = N
anim = 4000
sprpriority = 2
ctrl = 0

[State 4000, VarAdd] ;ホーミングキャンセル時のアルカナゲージ消費
type = null;VarAdd
triggerall = time = 0
trigger1 = (PrevStateNo =  [200,14499])
trigger2 = (PrevStateNo =  [14600,14699])
Fv = 30
value = -0.1666

[State 4000, VarAdd] ;アルカナゲージ自動回復阻止
type = VarSet
triggerall = time = 0
trigger1 = (PrevStateNo =  [200,14699])
v = 3
value = 1

[State 4000, ヘルパー呼び出し] ;演出用エフェクト、魔方陣・横
type = Helper
triggerall = PrevStateNo <= 199
trigger1 = time = 0
helpertype = Normal
ID = 4350
stateno = 4350
pos = 0,-70
postype = p1
ownpal = 0

