value = (P2Dist Y * 1.01) / 10

[State 4100, XY総合速度] ;減速用
type = VarSet
trigger1 = 1
Fv = 1
value = (Vel X)+abs(Vel Y)

;---------------------
;---------------------
[State 4100, Ｘ軸加速、移動速度]
type = VelAdd
trigger1 = Vel X < (8.0*cos(Atan(FVar(11)/FVar(10))))*(FVar(13)) ;先頭の 8.0 が最大速度。キャラによってこの数値を弄れば、おｋ
;trigger1 = FVar(13) = 1.0    ;加速無し時のみ
x = 0.7 + (0.80*cos(Atan(FVar(11)/FVar(10))))*(FVar(13))    ;先頭の 0.80 が加速度。キャラによってこの数値を弄れば、おｋ

[State 4100, Ｙ軸加速、移動速度]
type = VelAdd
trigger1 = Vel Y < (8.0*cos(Atan(FVar(11)/FVar(10))))*(FVar(13)) ;先頭の 8.0 が最大速度。キャラによってこの数値を弄れば、おｋ
y = 0.7 + (0.80*sin(Atan(FVar(11)/FVar(10))))*(FVar(13))    ;先頭の 0.80 が加速度。キャラによってこの数値を弄れば、おｋ


[State 4100, Ｘ軸加速、移動速度]
type = VelSet
triggerall = Facing = 1 &&(Pos X <= EnemyNear,Pos X) || Facing = -1 &&(Pos X > EnemyNear,Pos X)
trigger1 = Vel X >= (8.0*cos(Atan(FVar(11)/FVar(10))))*(FVar(13))        ;8.0 が最大速度。キャラによってこの数値を弄れば、おｋ
x = 0.7 + (8.0*cos(Atan(FVar(11)/FVar(10))))*(FVar(13))             ;8.0 が最大速度。キャラによってこの数値を弄れば、おｋ

[State 4100, Ｙ軸加速、移動速度]
type = VelSet
triggerall = Facing = 1 &&(Pos X <= EnemyNear,Pos X) || Facing = -1 &&(Pos X > EnemyNear,Pos X)
trigger1 = Vel Y >= (8.0*cos(Atan(FVar(11)/FVar(10))))*(FVar(13))        ;8.0 が最大速度。キャラによってこの数値を弄れば、おｋ
y = 0.7 + (8.0*sin(Atan(FVar(11)/FVar(10))))*(FVar(13))             ;8.0 が最大速度。キャラによってこの数値を弄れば、おｋ

[State 4100, Ｙ軸減速フラグ]
