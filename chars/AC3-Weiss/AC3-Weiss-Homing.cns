;---------------------
;相手より下方向

[State 4100, 移動速度Ｙ軸] ;下方向減速
type = VelSet
triggerall = Var(59) = 0 
trigger1 = abs(FVar(11)) > FVar(10)+10
trigger1 = P2BodyDist X >= 120
trigger1 = P2BodyDist Y <= -100
trigger1 = Command = "holddown"
trigger1 = !(Vel X > 0)
trigger1 = time <= 13
y = -1.0 + FVar(12)

