trigger1 = abs(FVar(11)) > FVar(10)+10
trigger1 = P2BodyDist X >= 120
trigger1 = P2BodyDist Y >= 100
trigger1 = Command != "holdup"
trigger1 = !(Vel X < 0)
y = 1.0 + FVar(12)

