;クリティカルハート・超必殺技、カットイン演出用ヘルパー、カットイン本体
[StateDef 6600]
type = A
movetype = I
physics = N
sprpriority = -5
ctrl = 0
anim = 6600

[state 6600, 攻撃を食らわなくする]
type = nothitby
trigger1 = 1
value = SCA
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 影を非表示]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 初期表示位置]
type = PosAdd
trigger1 = time = 0
x = Root,FVar(22)*50
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 初期表示位置]
type = PosSet
trigger1 = (Root,Var(34) = [1,2])
trigger1 = time = 0
y = -Screenpos Y + 240
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 初期表示位置]
type = PosSet
trigger1 = !(Root,Var(34) = [1,2])
trigger1 = time = 0
y = -Screenpos Y + ceil(265*Root,FVar(22))
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;----------

[state 6600, VarSet]
type = varset
trigger1 = time = 0
Fv = 0
value = 0

[state 6600, VarSet]
type = varadd
trigger1 = time >= 39
Fv = 0
value = 0.1

[state 6600, 縮尺]
type = AngleDraw
trigger1 = time <= 38
value = 0
scale = Root,FVar(22)*0.9,Root,FVar(22)*0.9
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 縮尺]
type = AngleDraw
trigger1 = time >= 39
value = 0
scale = Root,FVar(22)*(1.2 + FVar(0)),Root,FVar(22)*(1.2 + FVar(0))
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;----------

[state 6600, 移動関連]
type = velset
trigger1 = time = 0
x = Root,FVar(22)*8.0
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, 移動関連]
type = veladd
triggerall = Vel X > 1
trigger1 = time >= 0
trigger1 = time <= 33
x = Root,FVar(22)*-0.4

[state 6600, 移動関連]
type = velset
trigger1 = time >= 39
x = Root,FVar(22)*20.0
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;----------明るさ

[state 6600, VarSet]
type = varset
trigger1 = time = 0
v = 1
value = 0

[state 6600, VarSet]
type = varadd
trigger1 = time = [1,6]
v = 1
value = 30

[state 6600, VarSet]
type = varadd
trigger1 = time >= 39
v = 1
value = -20

[state 6600] ;カットインを段々明るくする
type = PalFX
trigger1 = 1
time = 1
Mul = 58 + Var(1),58 + Var(1),58 + Var(1)
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;----------背景明るさ

[state 6600]
type = AssertSpecial
trigger1 = time <= 40
trigger2 = Var(2) < 1
flag = noBG
flag2 = noFG
flag3 = globalnoshadow
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, Var(2)]
type = varset
trigger1 = time = 0
v = 2
value = 0

[state 6600, Var(2)]
type = varadd
trigger1 = time >= 35
v = 2
value = 5

[state 6600] ;背景を段々明るくする
type = BGPalFX
trigger1 = time >= 0
time = 1
add = -255+Var(2),-255+Var(2),-255+Var(2)
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state 6600, ヘルパーを消す]
type = DestroySelf
trigger1 = time = 45
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

;---------------------------------------------------------------------------
;クリティカルハート・超必殺技、カットイン演出用ヘルパー、自分を囲む外側の光1
