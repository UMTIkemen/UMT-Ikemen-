;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;弱攻撃ヒットスパーク1
[StateDef 6000]
type = A
movetype = I
physics = N
sprpriority = 4
anim = 6000

[state 6000] ;ヒットエフェクトの幅（初期値）を変更
type = VarSet
trigger1 = time = 0
FV = 0
value = 0

[state 6000] ;ヒットエフェクトの幅（ヒット後の時間経過で）を変更
type = VarAdd
trigger1 = time >= 1
fv = 0
value = 0.044

[state 6000] ;ヒットエフェクトのサイズ
type = AngleDraw
trigger1 = 1
value = 335
scale = 0.8 - Fvar(0),0.2 - Fvar(0)/4

[state 6000] ;ヒットエフェクトの透過度
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[state 6000, 影を消す]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state 6000, 特定の攻撃を食らわなくする]
type = NotHitby
trigger1 = 1
value = SCA

[state 6000, ヘルパー消去]
type = destroyself
trigger1 = time = 18

