ctrl = 0
velset = 0,0

[state 7300, カメラ固定] ;超必殺技フィニッシュ時に本体をカメラが追わなくする。
type = ScreenBound
triggerall = RoundState = 3
trigger1 = 1
value = 0
movecamera = 0,0

[state 7300, 相手のアニメ変更]
type = changeanim2
trigger1 = time = 0
value = 7300

[state 7300, 食らい中の速度]
type = VelSet
trigger1 = GetHitVar(hitshaketime) >= 1
x = 0
y = 0

[state 7300, 食らい中の速度]
type = HitVelSet
trigger1 = GetHitVar(hitshaketime) = 0
x = 1
y = 1

[state 7300, スクロール]
type = ScreenBound
triggerall = pos y < -15
trigger1 = BackEdgeBodyDist < 15       ;プレイヤー背面のぶつかり判定から、後方の画面端までの距離を返す。
trigger2 = FrontEdgeBodyDist < 15      ;プレイヤー前面のぶつかり判定から、前方の画面端までの距離を返す。
value = 1         ;画面のスクロールに影響を受けるか。0=受けない　1=受ける
movecamera = 0,0  ;カメラがプレイヤーを追うか否か。x,y軸。

[state 7300, ステート変更] ;壁に激突するステートへ
type = changestate
trigger1 = BackEdgeBodyDist <= 10
trigger2 = FrontEdgeBodyDist <= 10
value = 7310

[state 7300, 相手にステートを戻す]
type = Selfstate
trigger1 = time >= 180
value = 5100

