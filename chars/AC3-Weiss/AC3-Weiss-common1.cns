;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;----------------------------- コモンステート ------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 通常立ち（振り返る動作もシステムがここで処理しています）
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1-1]
type = ChangeAnim
triggerall = Var(50) <= 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1-2]
type = ChangeAnim
triggerall = Var(50) >= 1
trigger1 = Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[state 0, 5] ;ヘルパー分身バグ消去
type = DestroySelf
trigger1 = ishelper

;---------------------------------------------------------------------------
; 立ち状態からしゃがむ動作
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ状態から立ち上がる動作
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; 前進＆後退
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; ジャンプ開始。ジャンプ前予備動作
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

;---------------------↓ジャンプする方向を制御する変数。
[State 40, 1] ;垂直ジャンプ、sysvar(1)を0にセット
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2] ;前方ジャンプ、sysvar(1)を1にセット
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3] ;後方ジャンプ、sysvar(1)を-1にセット
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

;---------------------↑ジャンプする方向を指定

[State 40, 4] ;ジャンプ開始時の速度制御
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 移動速度] ;ダッシュジャンプ時の速度制御
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;ダッシュ
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[state 40, 投げ無敵] ;ジャンプ前動作中は投げ回避可能
type = NotHitBy
trigger1 = 1
value = ,AT

[state 40, VarSet] ;通常ジャンプ判定
type = VarSet
trigger1 = 1
v = 4
value = 0

[State 40, VarSet] ;エクステンド解除。
type = VarSet
trigger1 = Var(50) <= 2
v = 50
value = 0

[State 40, 音を鳴らす]
type = PlaySnd
trigger1 = animtime = 0
value = 3,7

[State 40, 6] ;ジャンプ中ステートへ以降
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; 空中ジャンプ開始。
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[state 45, 空中ジャンプ回数制御]
type = varadd
trigger1 = time = 0
v = 2
value = 1

[State 45, アニメ変更]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44
;オプション設定の「44 垂直ジャンプ頂点からの下降」が存在する場合はそれを表示

[State 45, アニメ変更]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 変数を指定（垂直J時）]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 変数を指定（前J時）]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 変数を指定（後J時）]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 移動速度]
type = VelSet
trigger1 = Time = 2
trigger1 = Var(4) = 0
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 移動速度]
type = VelSet
trigger1 = Time = 2
trigger1 = Var(4) = [1,2]
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x)*1.5, const(velocity.airjump.back.x)*1.5))
y = const(velocity.airjump.y)

[state 45, アニメ変更]
type = changeanim
triggerall = SelfAnimExist(38) && SelfAnimExist(39)
trigger1 = time = 0
value = ifelse((sysvar(1)=0),38, ifelse((sysvar(1)=1),39,40))
;アニメは、垂直ジャンプ時38、前ジャンプ時39、それ以外（後ろ）40へ以降

[State 45, アニメ変更]
type = ChangeAnim
trigger1 = PrevStateNo = [110,119]
value = 46

[State 45, ステート変更]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jumping (UP)
[Statedef 50]
type    = A
physics = A
ctrl = 1

[state 50, VarSet]
type = varset
trigger1 = time = 0
v = 5
value = 0







[state 50, VarSet]
type = varset
triggerall = Var(4) = [1,2]
trigger1 = command = "holdfwd"
v = 5
value = 1

[state 50, VarSet]
type = varset
triggerall = Var(4) = [1,2]
trigger1 = command = "holdback"
v = 5
value = -1

[state 50, 速度増減] ;ハイジャンプ・レバー入力の移動速度（前方）
type = veladd
triggerall = Var(4) = [1,2]
trigger1 = Var(5) = 1
x = .05

[state 50, 速度増減] ;ハイジャンプ・レバー入力の移動速度（後方）
type = veladd
triggerall = Var(4) = [1,2]
trigger1 = Var(5) = -1
x = -.05


[State 0, VelAdd]
type = VelAdd
trigger1 = vel y > 0
trigger1 = prevstateno = 60
y = .2


[State 0, VelAdd]
type = VelAdd
trigger1 = vel y < 0
trigger1 = prevstateno = 60
y = -.1




[state 50, 振り向き]
type = Turn
trigger1 = Var(4) = [1,2]
trigger1 = P2Dist X < 0

[state 50, エフェクト表示]
type = Explod
triggerall = prevstateno = [45, 655]
trigger1 = time = 0
anim = 50
ID = 50
pos = 0,-45
postype = p1
vel = 0.3,0
sprpriority = 3
bindtime = 1
ownpal = 1

[State 50, アニメ変更]
type = ChangeAnim
triggerall = time = 0
trigger1 = (PrevStateNo = [110,114])
trigger2 = (PrevStateNo = [630,639])
trigger3 = (PrevStateNo = 13610)
value = 46

[State 50, 2]  ;表示アニメの設定
type = ChangeAnim
triggerall = (PrevStateNo != [630,639])
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))
;X軸の移動がゼロならアニメ41へ、マイナスなら42へ、それ以外なら43へ

[state 50, 投げ無敵] ;ジャンプ前動作中は投げ回避可能
type = NotHitBy
trigger1 = time <= 3
value = ,AT

[State 50, 3] ; Y軸の高さが、-2になったらairファイルのアニメが＋３のアニメへ以降、44→47、45→48、46→49
type = ChangeAnim
triggerall = (PrevStateNo != [630,639])
trigger1 = Vel y > -2              ;y軸の高さが0になったらジャンプ終了
;trigger1 = SelfAnimExist(anim + 3) ;このトリガーでアニメの位置を特定するみたいだ？
persistent = 0                     ;試しに1にしてみると垂直ジャンプの落下が変になる
value = 45      ;Anim + 3                   ;ここでSelfAnimExistで呼び出したパラメーター値を実行？

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
; ジャンプ降下中だが今は使われてないらしい

[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

