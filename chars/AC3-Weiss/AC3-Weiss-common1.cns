; ガード開始＆準備
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
triggerall = Var(59) = 0  ;この行は追加
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
triggerall = Var(59) = 0  ;この行は追加
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
triggerall = Var(59) = 0  ;この行は追加
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo] ;プレイヤー用、しゃがみガード
type = StateTypeSet
triggerall = Var(59) = 0  ;この行は追加
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Hi to Lo] ;AI用、しゃがみガード（新たに追加）
type = StateTypeSet
triggerall = Var(59) != 0
triggerall = statetype != A
trigger1 = P2statetype = S || P2statetype = C
trigger1 = Var(49) = 0
trigger1 = (Var(49) != [6,8])
trigger2 = Var(49) = [1,3]
statetype = C
physics = C

[State 120, Lo to Hi] ;プレイヤー用、立ちガード
type = StateTypeSet
triggerall = Var(59) = 0  ;この行は追加
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, Lo to Hi] ;AI用、立ちガード（新たに追加）
type = StateTypeSet
triggerall = Var(59) != 0
triggerall = statetype != A
trigger1 = P2statetype = A
trigger1 = Var(49) = 0
trigger1 = (Var(49) != [1,3])
trigger2 = Var(49) = [6,8]
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = Var(59) = 0
trigger1 = command != "holdback"
trigger2 = !inguarddist
trigger3 = !inguarddist
trigger3 = P2movetype != A
value = 140

