
[Info]
Name         = "Weiss"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Weiss"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 01,18,2016     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "ミマァ"       ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4        ;ＣＰＵで出てきた時のカラーパレットの順番


