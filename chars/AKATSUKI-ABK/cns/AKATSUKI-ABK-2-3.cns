[Statedef -2]


[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "movehit=%d, var(18)=%d, var(17)=%d, var(13)=%d,var(14)=%d \n"
params = movehit,var(18),var(17),var(13),var(14)

[State -2, クリップボード（追加専用）]
type = null;AppendToClipboard
trigger1 = 1
text = "fVar(20)=%f,fVar(10)=%f, fVar(11)=%f,fVar(12)=%f,fVar(13)=%f \n"
params = fVar(20),fVar(10),fVar(11),fVar(12),fVar(13)

[State -2, 常駐ヘルパー呼び出し]
type = Helper
trigger1 = NumHelper(46000) = 0
stateno = 46000
ID = 46000
keyctrl = 0
postype = p1
supermovetime = 99999999
pausemovetime = 99999999
ownpal = 1
IgnoreHitPause = 1

;-------------------------------------------------------------------------------
;オプション
[State -2,演出の変更]
type = VarSet
trigger1 = RoundsExisted = 0
trigger1 = RoundState = 0
var(50) = 0
;var(50) = 0にするとアカツキ風の演出になります
;var(50) = 0以外にするとエヌアイン風の演出になります
;自分の好みに合わせてお使い下さい

