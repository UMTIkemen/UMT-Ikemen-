

;---------------------------------------------------------------------------
;236X
[Statedef 1105]
type     = S
movetype = A
physics  = N
anim     = 1111
poweradd = 0
ctrl     = 0
sprpriority = 4

;---------飛び道具以外に無敵
[State -2, NotHitBy]
type = NotHitBy
trigger1 = 1
value = ,NA,SA,HA,NT,ST,HT
time = 999

;---------影消しとか
[State -2, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2= NoAutoTurn
IgnoreHitPause = 1

;---------ダメージ量
[State -2, VarSet]
type = VarSet
trigger1 = root,Stateno = 1100
var(1) = 70

[State -2, VarSet]
type = VarSet
trigger1 = root,Stateno = 1140
var(1) = 63

;---------ケズリ量
[State -2, VarSet]
type = VarSet
trigger1 = root,Stateno = 1100
var(2) = 7

[State -2, VarSet]
type = VarSet
trigger1 = root,Stateno = 1140
var(2) = 6

;---------移動関連
[State -2, Vel1]
type = Velset
trigger1 = root,Stateno = 1100
trigger1 = time = 0
x = 3.5

[State -2, Vel1]
type = Velset
trigger1 = root,Stateno = 1140
trigger1 = time = 0
x = 3.5
y = 3.5

;---------ヒット定義(通常)
[State -2, HitDef]
type = HitDef
trigger1 = 1
attr = S,SP
hitflag = MAFD
guardflag = MA
animtype = Hard
priority = 4,Hit
damage = ceil(var(1) * root,fVar(10) * root,fVar(11) * root,fVar(12)),var(2)
pausetime = 0, 10
sparkno = -1
guard.sparkno = -1
sparkxy = -ceil(30 - Random%10), -ceil(90 - Random%10)
hitsound = S1 ,2
guardsound = S2, 2
ground.type = High
ground.slidetime = 20
ground.hittime = 20
air.hittime = 20
guard.slidetime = 16
guard.ctrltime = 16
yaccel = .5
ground.velocity = -4, 0
air.velocity = -3.5, -6 + root,fVar(20)
guard.velocity = -5
airguard.velocity = -3, -4
down.velocity = -3, 0
fall = 0
air.fall = ifelse(P2movetype = H,1,0)
fall.recover = 0
kill = 1
getpower = 0, 0
givepower = 40, 0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
palfx.time = 45
palfx.sinadd = 120,120,120,12
palfx.add = -100,-20,60
palfx.color = 0
palfx.invertall = 1
envshake.time = 10
envshake.freq = 25
envshake.ampl = 10
envshake.phase = 10
fall.envshake.time = ifelse(p2statetype = L,0,5)
fall.envshake.freq = ifelse(p2statetype = L,0,15)
fall.envshake.ampl = ifelse(p2statetype = L,0,10)
fall.envshake.phase = ifelse(p2statetype = L,0,10)

;---------ヒットエフェクト
[State -2, Explod]
type = Explod
triggerall = P2movetype = H
trigger1 = MoveHit = 1
