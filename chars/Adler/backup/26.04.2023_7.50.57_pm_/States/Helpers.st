trigger1=1
flag=intro
flag2=noshadow

[State 256, Reset]
type=varset
trigger1=!time
var(29)=200

[State 256, Pal]
type=varset
trigger1=!time
var(55)=root,palno

[State 256, Varset]
type=varset
