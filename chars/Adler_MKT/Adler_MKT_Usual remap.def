;--| 基本情報 |---------------------------------------------------------------
[Info]
Name         = "Adler"      ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Adler (remap)"      ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 02,22,2013   ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002   ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Mikita"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6  ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
Cmd     = Usual_AI/Adler remap.cmd
Cns     = Usual_AI/Adler.cns
St      = Usual_AI/Adler.cns
St1     = Usual_AI/Reflector.cns
St2     = Usual_AI/Super.cns
St3     = Usual_AI/-2_-3.txt
St4     = Usual_AI/AIstate.cns
StCommon = common1.cns
Sprite  = Adler.sff
Anim    = Adler.air
Sound   = Usual_AI//Adler.snd

;--| カラーパレットファイル |-------------------------------------------------

Pal1 = color/Adler_01.act  ;同人版_Color_01
Pal2 = color/Adler_02.act  ;同人版_Color_02
Pal3 = color/Adler_03.act  ;同人版_Color_03
Pal4 = color/Adler_04.act  ;同人版_Color_04
Pal5 = color/Adler_05.act  ;同人版_Color_05
Pal6 = color/Adler_06.act  ;同人版_Color_06

PalXX = color/Tag/Adler_Red.act   ;同人版_Tag-Mode_赤組
PalXX = color/Tag/Adler_Blue.act  ;同人版_Tag-Mode_青組
PalXX = color/Tag/Adler_Yellow.act;同人版_Tag-Mode_黄組
PalXX = color/Tag/Adler_Green.act ;同人版_Tag-Mode_緑組
PalXX = color/Tag/Adler_Black.act ;同人版_Tag-Mode_黒組

Pal7 = color/EX/Adler_EX_01.act  ;オリジナルカラー_01
Pal8 = color/EX/Adler_EX_02.act  ;オリジナルカラー_02
Pal9 = color/EX/Adler_EX_03.act  ;オリジナルカラー_03
Pal10= color/EX/Adler_EX_04.act  ;オリジナルカラー_04
Pal11= color/EX/Adler_EX_05.act  ;オリジナルカラー_05
