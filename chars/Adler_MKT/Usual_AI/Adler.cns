triggerall = IsHelper
trigger1   = root,var(59) != 0 || var(59) = -1
trigger2   = command = "fwd" && root,command = "fwd"
trigger3   = command = "back" && root,command = "back"
trigger4   = command = "up" && root,command = "up"
trigger5   = command = "down" && root,command = "down"
