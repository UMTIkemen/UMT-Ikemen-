value = ,AT

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
Trigger1 = (var(59)>0) && roundstate = 2
Trigger1 = enemynear(var(58)),StateType != L || P2BodyDist X >= 30
Trigger1 = ((enemynear(var(58)),MoveType=H||Random<=333||enemynear(var(58)),StateType=L)&&(enemynear(var(58)),stateno!=[120,159]))
Trigger2 = fvar(39)>0
Trigger2 = enemynear(var(58)),MoveType = H
trigger2 = enemynear(var(58)),stateno!=[120,159]
Trigger3 = (var(59)>0)&&roundstate = 2
Trigger3 = enemynear(var(58)),StateType = L
Trigger3 = BackEdgeBodyDist<=60
trigger4 = (var(59)>0)||(fvar(39)>0)
trigger4 = var(44) = 1
Trigger5 = (var(59)>0) && roundstate = 2
Trigger5 = enemynear(var(58)),StateType = L
Trigger5 = Random <= 600
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = sysvar(1) != 1
Trigger1 = (var(59)>0)&&roundstate = 2
Trigger1 = enemynear(var(58)),StateType != L
Trigger1 = enemynear(var(58)),MoveType != H
Trigger1 = BackEdgeBodyDist>60
Trigger1 = Random < 500
Trigger2 = (var(59)>0) && roundstate = 2
Trigger2 = enemynear(var(58)),StateType = L
Trigger2 = Random < 500
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
