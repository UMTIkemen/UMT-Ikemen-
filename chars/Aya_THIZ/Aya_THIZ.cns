[Data]
life = 900
power = 2000
attack = 100
defence = 100
fall.defence_up = 0
liedown.time = 11
airjuggle = 1
sparkno = S8000
guard.sparkno = S8030
KO.echo = 0
volume = 255
IntPersistIndex = 28;60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 16     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 16        ;Player width (back, air)
air.front = 16       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0, -80   ;Approximate position of head
mid.pos = 0, -55    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.2      ;Walk forward
walk.back = -2.9     ;Walk backward
run.fwd  = 7.0,0.0;4.6, 0    ;Run forward (x, y)
run.back = -7.0,-2.5 ;Hop backward (x, y)
jump.neu = 0,-10.4    ;Neutral jumping velocity (x, y)
jump.back = -2.9   ;Jump back Speed (x, y)
jump.fwd = 3.2       ;Jump forward Speed (x, y)
runjump.back = -7.0,-6.3;8.1 ;Running jump speeds (opt)
runjump.fwd = 7.0,-6.3;8.1      ;.
airjump.neu = 0,-6.3;8.1      ;.
airjump.back = -2.9      ;Air jump speeds (opt)
airjump.fwd = 3.2         ;.
air.gethit.groundrecover = -.15,-3.5  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-4.5    ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -1       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 0         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 1.5      ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5       ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .5    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

[Quotes]
; Generic Versus Quotes
victory1 = "There's this big incident going on and I'm not able to get any big scoop? Well that's just disappointing."
victory2 = "*Snap* Yep. This one's going in my cringe compilation."
; Versus Marisa
victory3 = "You're not thinking of going behind my back to get a free subscription are you?"
; Versus Reimu
victory4 = "This week's headline: 'Local shrine maiden gone rogue?'"
; Versus Sakuya
victory5 = "This next scoop will come out faster than you can say"
; Versus Yukari
victory6 = "Breaking news: 'Gap youkai investigates outside world fragments; false flag inside job?'"
; Versus Tenshi
victory7 = "'Celestial kicked out of heaven for the second time' just might be the new scoop! Whatcha think?"
; Versus Reisen
victory8 = "'Moon rabbits and outside world adult entertainment: a Lunarian conspiracy?' That was going to be an article in the second edition of a new tabloid I was going to publish, before I cancelled it."
; Versus Iku
victory9 = "Oh? You here for a follow-up interview on the oarfish article?"
; Versus Meiling
victory10 = "You know the number of subscritions for the Scarlet Devil mansion has continued to increase. Who is reading all of these, anyway?"
; Versus Youmu
victory11 = "There was an article from the outside world about swords. Seems like they're super popular in animation, but they're always twice the size of their bodies."
; Versus Yuuka
victory12 = "No matter how tough you are, it doesn't mean anything if your foe is fast enough!"
;;SEASON 2
; Versus Aya
victory13 = "This week's headline: 'News reporter found impersonating rival for fame and fortune'. I got you this time, Hatate!"
; Versus Momiji
victory14 = "Nah, you know what? You're not even worth writing an article about. Why the hell would I give you free publicity?"
; Versus Sanae
victory15 = "The kappa are rebuilding the Hisou Tensoku? This sounds like a scoop!"
; Versus Suwako
victory16 = "Just off the record, do you have any comment on why the kappa are rebuilding the Hisou Tensoku?"
;;SEASON 3
; Versus Sumireko
victory17 = "You know I don't often get the chance to interview outsiders. How about it?"
; Versus Nitori
victory18 = "So the rumors were true; the Kappa are building new advanced weapons. I guess us tengu need to step our game up."