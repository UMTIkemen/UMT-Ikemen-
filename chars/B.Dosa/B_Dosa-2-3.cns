trigger51 = Command = "AI50"
Trigger52 = NumHelper(20000+ID)
Trigger52 = Helper(20000+ID),Var(59)
Trigger52 = RoundState < 2 || (RoundState = 2 && ctrl)
;trigger53  = 1;常時AI起動用
var(59) = 10;←AIレベル（1～10、0でoff）

[State -3, off]
Type = VarSet
TriggerAll = Var(59) >= 1
Trigger1 = RoundState >= 3
var(59) = 0

[State -3, タッグ時の生死確認]
type = VarSet
trigger1 = var(59) != 0 && roundstate = 2
var(58) = ifelse((!EnemyNear,Alive && NumEnemy = 2),1,0)

[State -3, ダウン攻撃空振り判断セット]
type = VarSet
Trigger1 = var(57) = 0 && roundstate = 2
Trigger1 = EnemyNear(var(58)),statetype = L
Trigger1 = StateNo = 430 || StateNo = 440
Trigger1 = !movehit
var(57) = 1

[State -3, リセット]
type = VarSet
Triggerall = var(57) = 1 && roundstate = 2
Trigger1 = EnemyNear(var(58)),movetype != H
Trigger2 = StateNo = 430 || StateNo = 440
Trigger2 = movehit
var(57) = 0
ignorehitpause = 1

[State -3, ダッシュ判断]
type = VarSet
trigger1 = stateno = 101
var(55) = 1

[State -3, ダッシュ判断リセット]
type = VarSet
Triggerall = var(55) != 0
trigger1 = stateno = 0
trigger2 = (MoveType = H && Time = 1)
var(55) = 0

[State -3, ダッシュ中喰らいカウント]
type = VarAdd
triggerall = var(55) = 1
trigger1 = (MoveType = H && Time = 0)
var(54) = 1

;-------------------------------------------------------------------------
;超必

[State -3, ANIME PUNCH]
type = ChangeState
value = 3000
triggerall = var(59) != 0 && roundstate = 2
triggerall = statetype != A
triggerall = movetype != H
triggerall = EnemyNear(var(58)),Statetype != L
Trigger1 = EnemyNear(var(58)),StateType != A
Trigger1 = EnemyNear(var(58)),MoveType = A
Trigger1 = P2BodyDist X = [0,120]
trigger1 = power >= 2000
trigger1 = ctrl
trigger1 = Random <= Var(59)*40
Trigger2 = EnemyNear(var(58)),StateType != A
trigger2 = power >= 2000
trigger2 = (stateno = [200,299]) || (stateno = [400,499])
trigger2 = stateno != 440
trigger2 = movecontact
trigger2 = Random <= Var(59)*40

