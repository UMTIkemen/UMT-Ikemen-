Trigger1 = 1
y = .4

[State 821, 画面を揺らす]
type = EnvShake
trigger1 = Vel Y > 0
trigger1 = Pos Y >= -20
persistent = 0
time = 20
freq = 60
ampl = -5
phase = 0

[State 821, 制御解除して相手のステートに戻す]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= -20
value = 5100


