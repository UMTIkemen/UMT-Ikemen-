
; Standing Parry
[Statedef 8000]
type = S
physics = S
movetype = I
anim = 8000  ; Your parry anim
velset = 0,0
ctrl = 0
sprpriority = 2
poweradd = 75

[State 8000, NotHitBy]
type = NotHitBy
trigger1 = time<=10
time = 1
value = SCA

[State 8000, Parry SFX]
type = PlaySnd
trigger1 = !Time
value = 8000,0
channel = 1

[State 8000, Pause]
type = Pause
trigger1 = !Time
time = 15
moveTime = 15
endCmdBufTime = 15
pauseBg = 0

[State 8000, Freeze]
type = PosFreeze
trigger1 = 1
value = 1

[State 8000, PalFX]  ; Blue success
type = PalFX
trigger1 = !time && var(21)>=0
add = 0,50,255
sinadd = 0,-50,-255,60
time = 15

[State 8000, PalFX]  ; Red fail
type = PalFX
trigger1 = !time && var(21)<0
add = 255,0,0
sinadd = -255,0,0,60
time = 15

[State 8000, PlaySnd]
type = PlaySnd
trigger1 = !time
value = 3,1  ; Clash SFX

[State 8000, Explod]  ; Spark
type = Explod
trigger1 = animelem=2
anim = 7200
ID = 7200
sprpriority = 5
postype = p1
pos = 37,-64
pausemovetime = 60
ownpal = 1
scale = .5,.5

[State 8000, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nowalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 8000, CtrlSet]
type = CtrlSet
trigger1 = time>10
value = 1

[State 8000, ChangeState]
type = ChangeState
trigger1 = !animtime
value = 0
ctrl = 1

