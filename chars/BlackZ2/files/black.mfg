trigger5 = Helper(1120),MoveContact
trigger6 = NumHelper(1240) && StateNo = 1203
trigger6 = Helper(1240),MoveContact
Trigger7= StateNo=1202 || StateNo = 1203
Trigger7 = MoveContact
trigger8 = (PrevStateno = 40 || (PrevStateNo = [10230,10233])) && Stateno = 50 && Time <3
trigger9 = StateNo = 1100 && AnimElemTime(10)>=0
trigger10 = NumHelper(1051) &&StateNo = 1003
trigger10 = Helper(1051),MoveContact
value = 3500

