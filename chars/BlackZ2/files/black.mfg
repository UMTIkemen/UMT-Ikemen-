triggerall = (power >= 3000 && var(53)=0) || (power>=2000 && var(53)>=1)
TriggerAll=!NumHelper(3325) && !NumHelper(3320)	;Clone Portal
trigger1 = ctrl || StateNo = 40 || (StateNo = [10230,10233])
