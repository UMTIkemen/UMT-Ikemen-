;var(25) is the animation randomizer for rose black MINI 1
;var(26) is the animation randomizer for zamasu
;var(27) is the animation randomizer for merged zamasu
;var(28) is used as a timer to count up initiating everything that happens during the exit
;var(29) is used for storing emo level value not much else
;root,var(40) is used for the initial x position which is set by black clone 1 (state 2902)
;the helper calls are stored in -1



[State 2901, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "emo = %d pos x = %d pos y =%d"
params = var(28), var(30),var(31)
ignoreHitPause = 1



[State 0, VarAdd]
type = VarAdd
triggerall = root,stateno != [3500,3803]
trigger1 = time > 90
var(28) = cond((Var(28) = 49 && time <= 690 && (root, command = "holdy" || root, command = "holdb")),0,1)
ignorehitpause = 1

