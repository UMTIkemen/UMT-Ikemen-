;=========================================
;Zamasu Winpose Helper
[Statedef 28000]
type = A
movetype = I
physics = N
Anim = 1

[State init]
type = null
trigger1 = 1 || var(0) := root,id
trigger1 = 1 || var(1) := parent,id
;Var(2) is the number of ticks to wait before playing anims
;Var(3) is a "time" replacement, incrementing based on time root is in winpose rather than helpers time
trigger1 = 1 || var(4) := random%5 ;Set Anim to play
;Set SND Group
trigger1 = 1 || var(5) := random%7
;Var(6) is used to play one of the SNDs from the group
trigger1 = 1 || var(7) := (root,var(14) = 3) ;Only play SND if needed
persistent = 0

[State Get SND Index range] ; How many SNDs in each group?
type = null
trigger1 = var(5) = 0
trigger1 = 1 || var(6) := 3
trigger2 = var(5) = 1
trigger2 = 1 || var(6) := 2
trigger3 = var(5) = 2
trigger3 = 1 || var(6) := 2
trigger4 = var(5) = 3
trigger4 = 1 || var(6) := 2
trigger5 = var(5) = 4
trigger5 = 1 || var(6) := 3 || var(9) := 100
trigger6 = var(5) = 5
trigger6 = 1 || var(6) := 2 || var(9) := 60
trigger7 = var(5) = 6
trigger7 = 1 || var(6) := 2
persistent = 0

[State Voiceline]
type = playsnd
trigger1 = time = 66 && var(7)
value = s(stateno+var(5)),random%var(6)
persistent = 0

[State play until the snd has stopped]
type = assertspecial
triggerall = var(7)
trigger1 = time < 200 + var(9) ;Slapped on additional time cause I'm lazy
flag = roundnotover

[State Set time to teleport in/Positional Offset]
type = null
triggerall = playeridexist(var(0))
trigger1 = cond((playerid(var(0)),stateno = 181),1||var(2) := 20 || fvar(0) := 50,0) ;Scythe
trigger2 = cond((playerid(var(0)),stateno = 184),1||var(2) := 20 || fvar(0) := 30,0) ;Scythe2
trigger3 = cond((playerid(var(0)),stateno = 185),1||var(2) := 20 || fvar(0) := 10,0) ;Death is a blessing
trigger4 = cond((playerid(var(0)),stateno = 18100),1||var(2) := 20 || fvar(0) := 110,0) ;Iori Flames
persistent = 0


[State Increment timer]
type = varadd
triggerall = playeridexist(var(0))
trigger1 = playerid(var(0)),stateno = [181,188]
trigger2 = playerid(var(0)),stateno = [18100,18101]
var(3) = 1

[State Add to Position based on intro]
type = posadd
trigger1 = 1 || cond(var(4) = 0,1||fvar(0) := fvar(0) - 20,0);Set position but move back if in step anim
x = floor(fvar(0))
persistent = 0

;winposes neccesitate that Zamasu teleport in first
[State Teleport in]
type = changeanim
triggerall = var(3)
trigger1 = var(3) >= var(2)
value = stateno + 30
persistent = 0

[State TP SND]
type = playsnd
trigger1 = var(3) >= var(2)
value = 2302,0
persistent = 0

[State no shadow while teleporting]
type = assertspecial
trigger1 = anim = stateno + 30
flag = noshadow

[State set anim]
type = changeanim
trigger1 = cond((anim= stateno+30),!animtime,0)
value = stateno+var(4);+var(2)
persistent = 0

[State spwan back turn fx]
type = explod
triggerall = var(4) = 0 && anim >= stateno
trigger1 = !numexplod(stateno)
id = stateno
anim = stateno+29
pos = 0,-30
postype = P1
sprpriority = 20
persistent = 0

[State Skip talking frames]
type = changeanim
triggerall = anim = stateno+var(4) && (!var(7) || var(5) = 6) ;Either when Zamasu doesn't talk or plays a laugh SND
trigger1 = var(4) = 1 && animelemno(0) >= 11
trigger1 = 1 || var(8) := 16
trigger2 = var(4) = 2 && animelemno(0) >= 3
trigger2 = 1 || var(8) := 12
trigger3 = var(4) = 4 && animelemno(0) >= 4
trigger3 = 1 || var(8) := 13
value = anim
elem = var(8)
persistent = 0

