; Taunt
[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0,0
sprpriority = 1
ctrl = 0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !AILEVEL
trigger1 = !Time
trigger1 = command = "holdz"
value = 198

[State 0, Helper]
type = Helper
triggerall = Var(19) = 0
triggerall = !NumProjID(1400)
trigger1 = !AILEVEL
trigger1 = !Time
trigger1 = command = "holdc"
name = "zam speech"
ID = 199
stateno = 199
pos = -60,-200
postype = p1    ;p2,front,back,left,right
ownpal = 1



[State 0, PlaySnd]
type = PlaySnd
trigger1 = !Time
trigger1 = Anim = 198
value = 198,0
volumescale = 255
channel = 0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = Anim = 198
flag = nomusic



[State 0, ChangeAnim]
type = ChangeAnim
triggerall = Anim = 195
triggerall = AnimElemTime(10)>=20
triggerall = AnimElemTime(11)<0
trigger1 = (command="holdstart") 
value = 195
elem = 5
ignorehitpause = 1

[State 0]
Type=VarAdd
triggerall = Anim = 195
TriggerAll = Var(53) > 0
Trigger1=(command="holdstart") 
V=53
Value= cond(var(53)<2100,1,0)
persistent = 2

[State 0, CtrlSet]
type = CtrlSet
triggerall = Anim = 195
trigger1 = Time >50
value = 1

[State 0, PowerSet]
type = PowerSet
trigger1 = Anim = 198
trigger1 = !AnimTime
value = 3000

[State 0, VarSet]
type = VarSet
trigger1 = Anim = 198
trigger1 = !AnimTime
trigger1 = Var(53)> 0
var(53) = 2100

[State 0, StopSnd]
type = StopSnd
trigger1 = Anim = 198
trigger1 = RoundState = 3
channel = 0



[State 195, 2]
type = ChangeState
trigger1 = !AnimTime
trigger2 = Anim = 198
trigger2 = RoundState = 3
value = 0
ctrl = 1

