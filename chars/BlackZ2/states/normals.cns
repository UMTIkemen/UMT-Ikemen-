;AI Zamasu Burst assist
[State 0, Projectile]
type = Projectile
triggerall = AILEVEL && (enemy,stateno!=[5951,5956]) 
triggerall = Var(5)>=200 || Var(52) >=1
triggerall = (p2bodydist x < 100) && P2Movetype = A && P2statetype != L && enemynear, Pos Y >=-50
trigger1 = MoveGuarded 
trigger1 = Cond(Var(52) >=1 && RoundsExisted > 0, 250,random < Cond(Var(59)=0,150,100))*(AIlevel ** 2 / 64.0)
trigger2 = MoveHit
trigger2 = Cond(Var(52) >=1 && RoundsExisted > 0, 230,random < Cond(Var(59)=0,130,95))*(AIlevel ** 2 / 64.0)
trigger3 = Time <14
trigger3 = Cond(Var(52) >=1 && RoundsExisted > 0, 37,random < Cond(Var(59)=0,17,12))*(AIlevel ** 2 / 64.0)
ProjID = 1518
projanim = 1
projremovetime = 1
ignorehitpause = 1


;AI Zamasu Stab assist
[State 0, Projectile]
type = Projectile
triggerall = AILEVEL && (enemy,stateno!=[5951,5956]) 
triggerall = Var(5)>=200 || Var(52) >=1
triggerall = (p2bodydist x >= 0) && P2statetype != L 
trigger1 = MoveGuarded 
trigger1 = Cond(Var(52) >=1 && RoundsExisted > 0, 175,random < Cond(Var(59)=0,75,20))*(AIlevel ** 2 / 64.0)
trigger2 = MoveHit
trigger2 = Cond(Var(52) >=1 && RoundsExisted > 0, 230,random < Cond(Var(59)=0,130,95))*(AIlevel ** 2 / 64.0)
trigger3 = Time <6
trigger3 = Cond(Var(52) >=1 && RoundsExisted > 0, 30,random < Cond(Var(59)=0,10,5))*(AIlevel ** 2 / 64.0)
ProjID = 1517
projanim = 1
projremovetime = 1
ignorehitpause = 1

;AI Zamasu JK assist
[State 0, Projectile]
type = Projectile
triggerall = AILEVEL && (enemy,stateno!=[5951,5956]) 
triggerall = Var(5)>=200 || Var(52) >=1
triggerall = P2statetype = A && P2statetype != L && (enemynear, Vel Y <= 0 && P2BodyDist Y >-70)
triggerall = (enemynear, ScreenPos X > GameWidth/2 && enemynear, ScreenPos Y < GameHeight/2) || (enemynear, ScreenPos X < GameWidth/2 && enemynear, ScreenPos Y > GameHeight/2)|| (enemy, BackEdgeBodyDist < 100 && enemy, Pos Y >=50)
trigger1 = MoveGuarded 
trigger1 = Cond(Var(52) >=1 && RoundsExisted > 0, 175,random < Cond(Var(59)=0,75,35))*(AIlevel ** 2 / 64.0)
ProjID = 1515
projanim = 1
projremovetime = 1
ignorehitpause = 1

;AI Zamasu FireBall assist
