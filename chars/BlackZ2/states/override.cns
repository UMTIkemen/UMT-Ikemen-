trigger1 = Anim = 1
flag = noBG
flag2 = noFG
flag3 = noshadow

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = Anim = 1
id = 3530

[State 0, PosSet]
type = PosSet
trigger1 = Anim = 1
y = 0

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = !Time
id = 3632

[State 0, AssertSpecial]
