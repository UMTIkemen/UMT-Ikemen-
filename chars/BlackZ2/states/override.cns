trigger1 = fvar(21) = 2
trigger1 = Time = 30
anim = 27101
ID = 27101
pos = 300,150
postype = left ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = -40,0
removetime = 100
ontop = 1
ownpal = 1

;earth
[State 0, Explod]
