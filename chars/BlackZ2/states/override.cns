value = 0
movecamera = 0,0

[State 0]
Type=VarSet
Trigger1=Anim=0&&AnimElem=1
Trigger2=Anim=6660
V=50
Value=10
[State 0]
Type=VarAdd
Trigger1=Time%60=0
V=50
Value=-1

[State 0]
Type=ChangeAnim
Trigger1= Anim = 6660 && !AnimTime
Trigger2 = Anim = 5 && !AnimTime
Value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0]
Type=ChangeAnim
TriggerAll=RoundState=2
Trigger1=Anim!=6660
Trigger1=Anim=0&&Var(50)=0&&Random<500
;Trigger1=Random<100
Value=6660

[State 0]
