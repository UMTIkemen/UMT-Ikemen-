Trigger1=Anim=6660&&AnimElem=1
Value=s6660,1
VolumeScale=80
Channel=9
[State 0]
Type=PlaySND
Trigger1=Anim=6660&&AnimElem=1
Value=s2746,0
VolumeScale=20
Channel=8
[State 0]
Type=null
Trigger1=Anim=6660&&AnimElemTime(3)>=0
X=Sin(Time)

[State 0, ChangeAnim]
