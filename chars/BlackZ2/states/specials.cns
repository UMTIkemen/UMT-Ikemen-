;Light En Guarde
[Statedef 1000]
type = S
movetype = A
physics = N
anim = 1000
velset = 0,0
juggle = 3
ctrl = 0
sprpriority = 1

;AI Zamasu JK assist
[State 0, Projectile]
type = Projectile
triggerall = AILEVEL
triggerall = !Time || (MoveGuarded && Cond(Anim = 1000, Time<=12, Cond(Anim = 1001, Time<=21, Time<=35)))
triggerall = Var(5)>=200|| Var(52) >=1
trigger1 = (p2bodydist x >= 60) && P2statetype = A && P2statetype != L
trigger1 = P2StateNo = [120,155] 
trigger1 = random < 250*(AIlevel ** 2 / 64.0)
