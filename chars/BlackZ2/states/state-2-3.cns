[State -2, Prevent starting with decreased lifebar after skipping ressurection intro]
type = LifeSet
triggerall = RoundNo = 1
trigger1 = roundstate=2
trigger1 = prevstateno = 708 ;[700,750] ;735
trigger2 = roundstate<2
trigger2 = stateno!=708
value = LifeMax
;ignorehitpause =
persistent = 0

