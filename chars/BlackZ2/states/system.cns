[StateDef 900]
type = S
movetype = I
physics = S
anim = 900
velset = 0,0
ctrl = 0

[State 900, Power]
type = PowerAdd
triggerall = fvar(37) = 0
triggerall = (Anim = 900) && (power < 3000)
triggerall = Time >= 12
trigger1 = (AILevel<=0) && (command = "holdb") && (command = "holdy")
trigger2 = AILevel>0
value = Cond(!Var(42),5,2) + ((time-12)/Cond(!Var(42),20,100))

[State 900, Power]
type = PowerAdd
triggerall = fvar(37) = 0
triggerall = (Anim = 900) && (power < 3000)
triggerall = Time >= 12
TriggerAll = NumHelper(909)
TriggerAll=Var(53)>=2100
TriggerAll=Enemy,NumExplod(991901)=0
TriggerAll=NumExplod(991901)=0	;cinematic
;TriggerAll=StateNo!=2745		;entering emo
TriggerAll=Enemy,StateNo!=[150,155]	;block stun
triggerall = MoveType != H      ;getting hit
trigger1 = !(time%4)
value = Cond(!Var(42),2,1) 

[State 900, Power]
type = PowerAdd
triggerall = fvar(37) != 0
triggerall = (Anim = 900) && (power < 3000)
triggerall = Time >= 12
trigger1 = (AILevel<=0) && (command = "holdb") && (command = "holdy")
trigger2 = AILevel>0
value = 5 + ((time-12)/20)

[State 900, Power]
type = PowerAdd
triggerall = fvar(37) != 0
triggerall = (Anim = 900) && (power < 3000)
triggerall = Time >= 12
TriggerAll = NumHelper(909)
TriggerAll=Var(53)>=2100
TriggerAll=Enemy,NumExplod(991901)=0
TriggerAll=NumExplod(991901)=0	;cinematic
;TriggerAll=StateNo!=2745		;entering emo
TriggerAll=Enemy,StateNo!=[150,155]	;block stun
triggerall = MoveType != H      ;getting hit
trigger1 = !(time%4)
