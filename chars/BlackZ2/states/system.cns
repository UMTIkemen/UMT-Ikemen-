triggerall = AuthorName = "Team Z2"
triggerall = var(47)=1
trigger1 = time = 0
value = 5100
[State 5100, 4] ;Varset (for flip knockout)
type = Varset
triggerall = AuthorName = "Team Z2"
triggerall = var(47)=1
trigger1 = time = 0
var(47)=0
 
[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0
 
[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0
 
