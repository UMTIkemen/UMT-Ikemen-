;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]

;------------------------------------------------------------------------
;Barrier System -2
[State -2]
type = VarSet
triggerall = !AILevel
triggerall = Time > GetHitVar(hittime)
triggerall = fvar(44) < 1
trigger1 = command != "holdy" 
trigger2 = stateno != [120,155]
trigger3 = numhelper(6901) = 1
trigger4 = power = 0
;trigger4 = fvar(29) <= 0
var(51) = 0

[State -2]
type = VarSet
triggerall = !AILevel
;triggerall = stateno != [130,155]
triggerall = power >= 1
;triggerall = fvar(29) > 0
trigger1 = command = "holdy"
trigger2 = command = "holdy" 
trigger2 = command = "holddown"
var(51) = 1

[State -2];AI Barrier
type = VarSet
triggerall = AILevel
triggerall = Time > GetHitVar(hittime)
triggerall = fvar(44) < 1
trigger1 = stateno != [120,155]
trigger2 = numhelper(6901) = 1
trigger3 = p2dist y > 200
trigger4 = p2dist y < -200
trigger5 = power = 0
var(51) = 0

[State -2, AI Barrier On]
type = VarSet
triggerall = ctrl
triggerall = random < AILevel*12 || AILevel > 7 && random <= AILevel*100
triggerall = roundstate = 2
triggerall = power >= 1
triggerall = var(51) = 0
triggerall = movetype != H
triggerall = stateno = [120,155]
;trigger1 = (backedgebodydist < 100)
trigger1 = inguarddist
trigger1 = enemynear,movetype = A
trigger1 = ((enemynear,HitDefAttr != SCA, NT, ST, HT)  || (enemynear,numhelper > 0) || (enemynear,numproj > 0) || (enemynear,animtime < -6)  || (enemynear,time = [0,5]))
trigger2 = (enemynear,numproj)||(enemynear,hitdefattr=SCA,AP)
var(51) = 1

[State 0, VarSet]
type = VarSet
trigger1 = roundstate = 0 || roundstate = 1
trigger2 = fvar(45) > 10000
fvar(45)= 10000

[State 0, VarSet]
type = VarSet
trigger1 = fvar(45)< 0
fvar(45)= 0

[State 0, VarAdd]
type = VarAdd
trigger1 = var(53) = 0
trigger1 = fvar(4) < 10000
fvar(45)= 2

[State 0, VarSet]
type = Varadd
trigger1 = numhelper(6901) = 1
fvar(45)= 8.33

[State 0, VarAdd]
type = VarAdd
trigger1 = var(53) > 0
var(53) = -1

[State 0, VarSet];Barrier Drain on Hit
type = poweradd
trigger1 = var(51) = 1
trigger1 = stateno = [150,155]
trigger1 = !time
trigger1 = enemy,moveguarded
value = -2
ignorehitpause = 1
persistent = 0

[State 0, VarSet];Barrier Drain
type = poweradd
triggerall = var(51) = 1
trigger1 = 1
value = -2
persistent = 0

[State 181, AssertSpecial];No Chip Damage
type = AssertSpecial
trigger1 = var(51) = 1
flag = NoGuardDamage


[State -2]
type = VarSet
trigger1 = stateno = [150,152]
;trigger1 = enemy,movecontact
;trigger1 = var(51) = 1
fvar(16) = GetHitVar(hittime)+1

[State -2]
type = VarSet
trigger1 = stateno = [150,152]
;trigger1 = enemy,movecontact
;triggerall = var(51) = 1
trigger1 = facing = 1
fvar(17) = gethitvar(xvel)-5

[State -2]
type = VarSet
trigger1 = stateno = [150,152]
;trigger1 = enemy,movecontact
;trigger1 = var(51) = 1
trigger1 = facing = -1
fvar(17) = -gethitvar(xvel)

[State -2]
type = VarSet
triggerall = stateno = [150,152]
trigger1 = enemy,numproj = 0
trigger1 = enemy,HitDefAttr = SCA,NA,SA,HA
trigger1 = 1
fvar(18) = 1

[State -2]
type = VarSet
triggerall = stateno = [150,152]
trigger1 = enemy,numproj != 0
trigger1 = 1
;trigger2 = numhelper(12001) > 0
fvar(18) = 0

[State -2];Hitpause Counter
type = VarSet
triggerall = stateno = [150,152]
trigger1 = !time
fvar(44) = gethitvar(hitshaketime)+1

[State -2];Hitpause Counter Going Down
type = Varadd
triggerall = fvar(44) > 0
trigger1 = 1
fvar(44) = -1

[State 0, CtrlSet];Hitpause Ctrl Remover
type = CtrlSet
trigger1 = numhelper(12002) = 1
value = 0 

[State 0, CtrlSet];Hitpause Ctrl Returner
type = CtrlSet
triggerall = roundstate = 2
triggerall = !ishelper
trigger1 = stateno = 140 || stateno = 0 
trigger1 = prevstateno = [1,99999] 
trigger1 = prevstateno != [170,199]
trigger1 = prevstateno != 5900
trigger1 = numhelper(12002) = 0
value = 1 

[State Helper, 1]
type = Helper
triggerall = numhelper(12001) < 1
triggerall = stateno = [150,152]
triggerall = numhelper(12000) = 1
triggerall = p2dist x > 50
trigger1 = fvar(18) = 1
;trigger1 = prevstateno != 120
trigger1 = !time
;trigger1 = fvar(16) != 0
name = "Pushback"
ID = 12001
Stateno = 12001
persistent = 0
ignorehitpause = 0
pos = 40,0
facing = -1
postype = p1
size.xscale = 0.5
size.yscale = 0.5

[State Helper, 1]
type = Helper
triggerall = numhelper(12001) < 1
triggerall = stateno = [150,152]
triggerall = numhelper(12000) = 1
triggerall = p2dist x < 51
trigger1 = fvar(18) = 1
;trigger1 = prevstateno != 120
trigger1 = !time
;trigger1 = fvar(16) != 0
name = "Pushback"
ID = 12001
Stateno = 12001
persistent = 0
ignorehitpause = 0
pos = 25 - (fvar(17) * 2),0
;facing = -1
postype = p2
size.xscale = 0.5
size.yscale = 0.5

[State 610, 2]
