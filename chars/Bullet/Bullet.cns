[Statedef 3101];I use this code so that state 3001 can change state to 3005 when hitting the opponent upon touching the ground. Thanks for the code Ares.
type = A
movetype = H
physics = N
velset = 0,0

[State PosS, 1]
type = PosSet
trigger1 = pos Y > 0
y = 0

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) != [3,5]
value = ifelse((gethitvar(airtype) = 1),5000,5010) + gethitvar(animtype)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = ifelse((gethitvar(animtype) = [4,5]), (ifelse(selfanimexist(5047 + gethitvar(animtype)), 5047 + gethitvar(animtype), 5030)), 5030)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = (gethitvar(animtype) = [4,5]) && (selfanimexist(5047 + gethitvar(animtype)))
value = 5047 + gethitvar(animtype)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State ChangeS, 1]
type = ChangeState
trigger1 = HitShakeOver
value = 3102

[Statedef 3102]
type = A
movetype = H
physics = N

[State VelS, 1]
type = VelSet
trigger1 = time = 0
x = gethitvar(xvel) * facing
y = gethitvar(yvel)

[State VelA, 1]
type = VelAdd
trigger1 = 1
y = gethitvar(yaccel)

[State ChangeA, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = selfanimexist(5035)
trigger1 = anim != 5050
trigger1 = anim != [5051,5059]
trigger1 = anim != 5090
value = 5035

[State ChangeA, 1]
type = ChangeAnim
trigger1 = animtime = 0
trigger1 = anim = 5035
trigger2 = time = 0
trigger2 = anim != 5035
trigger2 = (anim != [5051, 5059]) && (anim != [5061, 5069])
trigger2 = anim != 5090
value = 5050

[State ChangeA, 1]
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = vel Y >= ifelse(anim = 5050, -1, -10)
trigger1 = selfanimexist(anim+10)
value = anim+10
persistent = 0

[State ChangeA, 1]
type = ChangeAnim
triggerall = anim != 5415
trigger1 = anim = 5090
trigger1 = vel Y >= 0
value = 5060
persistent = 0

[State SelfS, 1]
type = SelfState
trigger1 = vel Y > 0
trigger1 = pos Y >= 0
value = 5100

