;---------------------------------------------------------------------------
;Barrier
[Statedef 12000]
type = A
movetype = I
physics = N
sprpriority=4
Anim    = 12000

[State 0, VarSet]
type = parentVarSet
trigger1 = 1
var(53) = 180

[State 0, Turn]
type = Turn
trigger1 = facing != root,facing

[State , 1]
triggerall = root,statetype = S
type = Bindtoroot
trigger1 = 1
time = -1
pos = 33,-78

[State , 1]
type = Bindtoroot
triggerall = root,statetype = C
trigger1 = 1
time = -1
pos = 33,-45

[State , 1]
type = Bindtoroot
triggerall = root,statetype = A
trigger1 = 1
time = -1
pos = 33,-78

[State ]
type = Assertspecial
Trigger1=1
flag=Noshadow

[State 6000,~??~]
Type     = DestroySelf
trigger1 = root,var(51) = 0
trigger2 = root,stateno != [120,155]

;---------------------------------------------------------------------------
[Statedef 12001]
type = A
physics = N
anim = 12001
sprpriority = 1

[State NotHitB, 1]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AT

[State VelS, 1]
type = VelSet
trigger1 = time = 0
ignorehitpause = 1
x = ifelse(parent,backedgebodydist > 5, root,fvar(17), root,fvar(17)*2)

[State VelM, 1]
type = VelMul
trigger1 = time >= 0
ignorehitpause = 1
x = .9

[State PlayerP, 1]
type = PlayerPush
trigger1 = 1
value = 1
ignorehitpause = 1

[State DestroyS, 1]
type = DestroySelf
trigger1 = root,fvar(16) < time
trigger2 = root,Numhelper(12001) > 1

;---------------------------------------------------------------------------
[Statedef 12002]
type =A  
physics = N
anim = 99999
sprpriority = 1

[State DestroyS, 1]
type = DestroySelf
trigger1 = root,fvar(19) < time
;trigger2 = root,Numhelper(12001) > 1

;--------------------------------------------------------------------------
;Custom (zoom)
[Statedef 2902]
type    = A
movetype= A
physics = N
anim = 9741
ctrl = 0
sprpriority = 1

[State Zoom control]
type = varadd
trigger1 = time <= 5
fvar(0) = 0.05

[State Zoom control]
type = varadd
trigger1 = time >= 30
fvar(0) = -0.05

[State 0]
type = posset
trigger1 = time = 0
y = 0

[State Zoom control]
Type = EnvShake
trigger1 = time = 0
Time  = 30
Ampl  = 3
Freq  = 90

[State Zoom state]
type = Zoom
trigger1 = 1
pos = root,pos x/2,root, pos y/2
scale = 1+fvar(0)
ignorehitpause = 1

[State 0]
type = destroyself
trigger1 = time = 35

;---------------------------------------------------------------------------
;Helper: Camera
[Statedef 1820]
type = S
physics = S
anim = 9741
ctrl = 0

[state 1820]
type = turn
trigger1 = ishelper(1820)
trigger1 = facing!=root,facing
ignorehitpause = 1

[State 1820]
type = VelSet
trigger1 = parent,pos X > 0
x = ifelse(facing = 1,4,-4)
[State 1820]
type = VelSet
trigger1 = parent,pos X < 0
x = ifelse(facing = 1,-4,4)
[State 1820]
type = VelSet
trigger1 = parent,pos X = [-5,5]
x = 0

[State 1820]
type = Width
trigger1 = 1
value = 1,1

[State 1820]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 320,0

[State 1820]
type = PlayerPush
trigger1 = 1
value = 0

[State 6001, Destroyself]
type = destroyself
trigger1 = Time = 50
trigger1 = enemy, Life >= 1
trigger2 = numhelper(1820)>= 2

;========================<COUNTER F.X.>=============================
[Statedef 7400]
type = A
physics = N
anim = 9999

[State 7400, Flash]
type = bgpalfx
trigger1 = !time
time = 8
add = 255, 255, 255
sinadd = -255, -255, -255, 32

[State Zoom control]
type = varadd
trigger1 = 1
trigger1 = time <= 8
fvar(0) = 0.075
[State Zoom control]
type = varadd
trigger1 = 1
trigger1 = time >= 8
fvar(0) = -0.075

[State 3007,]
type = Helper
trigger1 = !numhelper(8985)
helpertype = Normal
name = "Zoom"
stateno = 2902
ID = 2902
pos = 15,-105
postype = p2
facing = 1
keyctrl = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
persistent = 0

[State 7400, slow]
type = pause
trigger1 = time < 8
time = 2
endcmdbuftime = 1

[State 7400, End]
type = destroyself
trigger1 = time >= 8

;Box
[Statedef 250]
type    = S                     ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                     ;Move-type: A-attack, I-idle, H-gethit
physics = N                     ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0       
anim = 250                ;Set ctrl (Def: no change)                   ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 3 

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 0, Width]
type = Width
trigger1 = 1
player = 30,10

[State 0, PosSet]
type = PosSet
trigger1 = 1
x = root,pos x

[State 0, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = time = 40

