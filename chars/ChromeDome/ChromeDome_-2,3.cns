;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;あえぎ音
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = VarRandom
trigger1 = Time = 0
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
v = 43
range = 0,6

[State -2];あえぎ音
type = PlaySnd
trigger1 = Time = 1 && alive = 1
trigger1 = Var(43) = [0,3]
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
value = S15,IfElse(Random >= 601,1,0)

[State -2];あえぎ音
type = PlaySnd
trigger1 = Time = 1 && alive = 1
trigger1 = Var(43) = [0,4]
trigger1 = stateno = 5100
value = S15,IfElse(Random >= 401,3,2)

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;くたばり音
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2];負け時音
type     = PlaySnd
trigger1 = StateType = A
trigger1 = Lose = 1
trigger1 = Var(42) = 0
trigger1 = Alive = 0 && NumExplod(32000) = 0
value    = S3,5
Persistent = 0

[State -2];負け時煙
type = Explod
trigger1 = StateType = A && NumExplod(36001) <= 10
trigger1 = Lose = 1
trigger1 = Var(42) = 1
anim = 3600
ID   = 36001
postype     = p1
pos         = 0,Const(size.mid.pos.y)
sprpriority = 1
ownpal      = 1
Scale        = 0.2,0.2

[State -2];負け時雷-空中
type = Explod
trigger1 = StateType = A
trigger1 = Lose = 1
trigger1 = Var(42) = 1
trigger1 = Alive = 0 && NumExplod(32000) = 0
anim = 3200
ID   = 32000
pos         = 0,Const(size.mid.pos.y)
postype     = p1  
bindtime    = -1
removetime  = -2
sprpriority = 3
shadow      = -1
ownpal      = 1
Scale        = 0.6,0.6

[State -2];負け時雷-くたばり
type = Explod
trigger1 = StateType = L
trigger1 = Lose = 1
trigger1 = Var(42) = 1
trigger1 = Alive = 0 && NumExplod(32000) = 0
trigger1 = NumHelper(51) = 0 && NumHelper(52) = 0
trigger1 = Anim != 10300
anim = 3200
ID   = 32000
pos         = 0,-20
postype     = p1  
bindtime    = -1
removetime  = -2
sprpriority = 3
shadow      = -1
ownpal      = 1

[State -2];負け時の点滅
type = Palfx
trigger1 = Lose = 1
trigger1 = Var(42) = 1
trigger1 = Alive = 0
mul = 240,100,100
add = 200,50,10
time = 1

[State -2];点滅のためのvar
type = Varset
trigger1 = Lose = 1
trigger1 = Var(42) = 0
var(42) = 4

[State -2];点滅のためのvar
type = VarAdd
trigger1 = Lose = 1
trigger1 = 1
var(42) = -1

[State -2];念のためvarリセット
type = Varset
trigger1 = Lose = 0
var(42) = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ストーンバタフライ AI (HIT確認)
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = VarSet
trigger1 = StateNo != [1000,1010]
trigger2 = var(59) = 0
var(58) = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;スーパーキャンセル && ドリームキャンセル
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = VarSet
trigger1 = StateNo != [1500,2000]
var(35) = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;埃 EFFECT処理
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = RemoveExplod
trigger1 = StateNo != 0
id = 2050
ignorehitpause = 1

[State -2]
type = RemoveExplod
trigger1 = StateNo != 191
id = 10190
ignorehitpause = 1

[State -2]
type = RemoveExplod
trigger1 = StateNo != 180
id = 10187
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 自爆 EFFECT処理
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = RemoveExplod
Trigger1 = stateno != 1805 
ID = 1801

[State -2]
type = RemoveExplod
Trigger1 = stateno != 1805 
ID = 1901

[State -2]
type = RemoveExplod
Trigger1   = stateno != 1805 
Trigger1   = stateno != 1620 
ID = 3700

[State -2]
type = RemoveExplod
Trigger1   = stateno != 1805 
Trigger1   = stateno != 1620 
ID = 3750

[State -2]
type = RemoveExplod
Trigger1   = stateno != 1805 
ID = 2800

[State -2]
type = RemoveExplod
Trigger1   = stateno != 1805 
Trigger1   = stateno != 1905 
ID = 3208

[State -2];---------------------------------VOICE消し
type = Helper
triggerAll = NumHelper(1806) != 0 && NumHelper(1907) = 0
trigger1  = StateNo != [1800,1950]
trigger2  = MoveType = H
helpertype = normal
name = "Voice-X"
ID      = 1907
stateno = 1907
pos     = 0,0
postype = p1 
keyctrl = 0
ownpal  = 1
supermovetime    = 99999
pausemovetime    = 99999


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 叩きつけ EFFECT処理
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2]
type = PlaySnd
Trigger1   = P2StateNo = 5101 && NumExplod(3000) = 0
value  = S5 ,4
volume = 300

[State -2]
type = Explod
Trigger1   = P2StateNo = 5101 && NumExplod(3000) = 0
anim = 3000
ID   = 3000
postype     = p2  
pos         = 0 ,-1 
bindtime    = 1
removetime  = -2
sprpriority = -1
ownpal      = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;ブロッキング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, Blocking-1]
type = VarSet
trigger1 = var(7) >= 20
trigger2 = (stateno = [900,920]) && time = 1
var(7) = 0

[State -2, Blocking-1]
type = VarSet
trigger1 = var(7) >= 20
trigger2 = (stateno = [900,920]) && time = 1
var(8) = 0

[State -2, Blocking-1]
type = VarSet
triggerall = var(59) = 0 && (var(59) != [1,11])
triggerall = !Var(7)
trigger1 = command = "block" && command != "holddown"&& Command != "holdup"
var(7) = 1

[State -2, Blocking-1]
type = VarAdd
trigger1 = Var(7) > 0
var(7) = 1
ignorehitpause = 1

[State -2, Blocking-1]
type = VarSet
triggerall = var(7) = [1,4]
trigger1 = command != "holdfwd" && Command != "holdback" && command != "holdup" && Command != "holddown"
var(8) = 1

[State -2, Blocking-2]
type = VarSet
trigger1 = var(9) >= 20
trigger2 = (stateno = [900,920]) && time = 1
var(9) = 0

[State -2, Blocking-2]
type = VarSet
trigger1 = var(9) >= 20
trigger2 = (stateno = [900,920]) && time = 1
var(10) = 0

[State -2, Blocking-2]
type = VarSet
triggerall = var(59) = 0 && (var(59) != [1,11])
triggerall = !Var(9)
trigger1 = command = "block2" && command != "holdfwd"&& Command != "holdback"
var(9) = 1

[State -2, Blocking-2]
type = VarAdd
trigger1 = var(9)
var(9) = 1
ignorehitpause = 1

[State -2, Blocking-2]
type = VarSet
triggerall = var(9) = [1,4]
trigger1 = command != "holdfwd" && Command != "holdback" && command != "holdup" && Command != "holddown"
var(10) = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;立ちブロッキング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, 900] 
type = HitOverride
triggerall = statetype = S && ctrl
trigger1 = (Var(7) = [1,4]) && (var(59) = 0 && (var(59) != [1,11]))
trigger2 = (Var(7) = [5,8]) && var(8) && (var(59) = 0 && (var(59) != [1,11]))
trigger3 = (var(59) = [1,11]) && var(59) != 0
trigger3 = random <= (var(13))*100
slot = 0
stateno = 900;ブロッキングstate
attr = SA, AA, AP ;対応している攻撃属性
time = 3
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;屈ブロッキング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[State -2, 910]
type = HitOverride
triggerall = statetype = C && ctrl 
trigger1 = (Var(9) = [1,4]) && (var(59) = 0 && (var(59) != [1,11]))
trigger2 = (Var(9) = [5,8]) && var(10) && (var(59) = 0 && (var(59) != [1,11]))
trigger3 = (var(59) = [1,11]) && var(59) != 0
trigger3 = random <= (var(13))*100
slot = 0
stateno = 910
attr = C, AA, AP
time = 3
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中ブロッキング
