trigger2 = (Var(7) = [5,8]) && var(8) && (var(59) = 0 && (var(59) != [1,11]))
trigger3 = (var(59) = [1,11]) && var(59) != 0
trigger3 = random <= (var(13))*100
slot    = 0
stateno = 920
