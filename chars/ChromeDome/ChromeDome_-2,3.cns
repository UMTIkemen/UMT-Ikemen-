;---------------------------------------------------------------------------
; States that are always executed (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

[State -2];---------------------------------機動音
type = PlaySnd
TriggerAll = Time = 1
Trigger1   = StateNo = 10 
Trigger2   = StateNo = 12
Trigger3   = StateNo = 20
Trigger4   = StateNo = 40
value = S3 , 0

