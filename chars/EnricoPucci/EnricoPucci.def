
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "pucci"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "pucci"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,14,2002     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "salami"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,3,4,2        ;ＣＰＵで出てきた時のカラーパレットの順番

;--| 必要なファイルの設定 |---------------------------------------------------

[Files]
Cmd     = EnricoPuccicmd.cns       ;コマンドファイルの登録
Cns     = EnricoPucciWS.cns       ;コンスタンツファイルの登録
St      = EnricoPucciWS.cns       ;ステートファイルの登録・最大１１個まで増やせます
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
St0     = standhelper.cns;ステートファイルの登録・最大１１個まで増やせます
St1     = remote.cns
st2     = remoteCMOON.cns
st3     = EnricoPucciCMOON.cns
st4     = EnricoPucciMIH.cns
StCommon= puccicommon1.cns  ;コモンステートファイルの登録
Sprite  = pucci.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = EnricoPucci.air       ;アニメーションファイルの登録
Sound   = EnricoPucci.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------

Pal1 = pucci2.act  ;Ａボタンで決定した色が使えます
Pal2 = pucci.act  ;Ｂ
Pal3 = pucci3.act  ;Ｃ
Pal4 = pucci4.act  ;Ｘ
Pal5 = pucci5.act  ;Ｙ
Pal6 = pucci6.act  ;Ｚ

Pal7 = pucci7.act  ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = pucci8.act  ;Ｓ押しながらＢ
Pal9 = pucci.act  ;Ｓ押しながらＣ
Pal10= pucci2.act  ;Ｓ押しながらＸ
Pal11= pucci3.act  ;Ｓ押しながらＹ
Pal12= pucci4.act  ;Ｓ押しながらＺ
