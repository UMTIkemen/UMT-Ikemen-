;===========================================================================
; 常時監視ステート（‐２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[State 連続挑発制限解除]
type = Varset
trigger1 = var(26) && !(enemy,statetype = L)
var(26)=0

[State MIH時の押し出し判定]
type = Width
trigger1 = !ishelper && var(50)=2 && movetype != H
Player = 5,0
IgnoreHitPause = 1

[State 当て投げ制限 ガードさせてからの時間]
type = Varset
triggerall = !ishelper
trigger1 = (enemynear,stateno = [150,155])
trigger2 = (enemynear,stateno = [5000,5011])
var(33) = 0
IgnoreHitPause = 1
[State 当て投げ制限 ガードさせてからの時間]
type = Varadd
trigger1 = !ishelper
var(33) = 1
IgnoreHitPause = 1

[State バイツァ・ダスト]
type = Varset
trigger1 = !ishelper && TeamMode = single
trigger1 = enemy,name = "KawajiriKosaku" && enemy,stateno = 14005
trigger1 = var(51):=100
var(50) = 0
IgnoreHitPause = 1

[State 50, 投げ抜け用 相手 通常投げ]
type = varset
trigger1 = enemynear(0),HitDefAttr = S, NT
var(27) = 1
ignorehitpause = 1
[State 50, 投げ抜け用 相手 通常投げリセット]
type = varset
trigger1 = !(enemynear(0),HitDefAttr = S, NT)
var(27) = 0

[State スタイリッシュムーブ時間計測]
type = null
triggerall = !ishelper
trigger1 = 1 || var(11):=var(11)+1
trigger1 = 1 || var(12):=var(12)+1
[State スタイリッシュムーブ時間計測]
type = varset
triggerall = !ishelper
trigger1 = (command = "SM6")
trigger1 = var(11) > 25 && var(12) > 25
var(11) = 0
[State スタイリッシュムーブ時間計測]
type = varset
triggerall = !ishelper
trigger1 = (command = "SM2")
trigger1 = var(12) > 25 && var(11) > 25
var(12) = 0
[State めくりに対してSM発動しない]
type = null
triggerall = !ishelper
trigger1 = p2dist X < 0
trigger1 = 1 || var(12) := 25-10
trigger1 = 1 || var(11) := 25-10

[State 遠隔操作スタンドステート奪取認識]
type = parentVarSet
trigger1 = ishelper(40000)
trigger1 = (parent,var(43)!=gametime)
var(44) = 1
IgnoreHitPause = 1
[State 遠隔操作スタンドステート奪取認識OFF]
type = VarSet
triggerall = !ishelper
trigger1 = !numhelper(40000)
var(44) = 0
IgnoreHitPause = 1

[State 遠隔操作スタンドステート奪取認識2]
type = parentVarSet
trigger1 = ishelper(40000)
var(46) = (parent,var(43)!=gametime)
IgnoreHitPause = 1

[State 本体ステート奪取認識]
type = VarSet
trigger1 = !ishelper
var(21) = (var(20)!=gametime)
IgnoreHitPause = 1

[State -2 デバッグ用背景の色]
type = null;BGpalfx
trigger1 = !ishelper
time = 1
add = 0,0,Var(44)

[State 連続ガードクールタイムカウント]
type = varadd
trigger1 = !ishelper
trigger1 = roundstate = 2 && var(10)>0
var(10) = -1
[State 連続ガードクールタイム設定 ガード時]
type = varset
trigger1 = !ishelper && roundstate = 2
trigger1 = stateno = [140,155]
var(10) = 80
[State 連続ガードクールタイム設定 着地時]
type = varset
trigger1 = !ishelper && roundstate = 2
trigger1 = stateno = 52 && time = 1 && var(10)<7
var(10) = 7-1

[State ガードゲージ初期値]
type = VarSet
triggerall = !ishelper
trigger1 = RoundState < 2
var(8) = 5000
IgnoreHitPause = 1
[State ガードゲージ制限]
type = VarSet
triggerall = !ishelper
trigger1 = var(8)>5000 || var(8)<0
var(8) = ifelse(var(8)>5000,5000,0)
IgnoreHitPause = 1
[State ガードゲージ回復 通常]
type = Varadd
triggerall = !ishelper
triggerall = stateno != 7444;SM中じゃない
triggerall = statetype != A;ジャンプ中というか空中では回復しない
trigger1 = var(10) <= 0;クールタイム
trigger1 = var(8) = [2501,4999]
var(8) = 3 *ifelse(movetype = H,0.5,1)
IgnoreHitPause = 1
[State ガードゲージ回復 ゲージが少ない時]
type = Varadd
triggerall = !ishelper
triggerall = stateno != 7444;SM中じゃない
triggerall = statetype != A;ジャンプ中というか空中では回復しない
trigger1 = var(10) <= 0;クールタイム
trigger1 = var(8) = [0,2500]
var(8) = 3*(2-(var(8)**1.0/2500)**1.0) *ifelse(movetype = H,0.5,1)
IgnoreHitPause = 1

;スタンドが奪取される
;var(44)ON
;本体は消えて追従
;スタンドがやられなどに戻される スプライトはスタンドになってしまうので設定で本体絵にする
;スタンドが消えるとvar(44)OFF
;スタンドが消えると同時に本体が登場

[State 非常用遠隔操作解除]
type = VarSet
trigger1 = !ishelper
trigger1 = !(numhelper(40000)) && var(49)
var(49) = 0
IgnoreHitPause = 1

[State -2 デバッグ用モード切替]
type = null;varset
triggerall = !ishelper
trigger1 = command = "c"
var(50) = ifelse(var(50)<=1,var(50)+1,0)

[State -2 遠隔操作時相手がスタンドを向かないようにするダミーヘルパー]
type = helper
triggerall = !ishelper
trigger1 = NumHelper(40000)
trigger1 = NumHelper(7999)=0
stateno = 7999
HelperType = Player
ID = 7999
pos = 0,0
pausemovetime = 99999999

[State -2 遠隔操作ヘルパーの体力 1Fごとの変化量]
Type = parentvarset
trigger1 = ishelper(40000)
var(48) = parent,var(47)-life
IgnoreHitPause = 1

[State -2 遠隔操作ヘルパーの体力]
Type = parentvarset
trigger1 = ishelper(40000)
var(47) = life
IgnoreHitPause = 1

[State -2 スタンド]
type = helper
triggerall = !ishelper
trigger1 = roundstate >= 2
trigger1 = NumHelper(10000)=0
stateno = 9999
ID = 10000
pos = 0,0
;pausemovetime = 99999999
ownpal = 1
;supermovetime = 2147483647

[State -2, スタンド使用時ガード不可]
type = AssertSpecial
triggerall = !ishelper
trigger1 = var(5) = 1
Flag  = NoStandGuard
Flag2 = NoCrouchGuard
Flag3 = NoAirGuard
IgnoreHitPause = 1

[State -2 幻覚ﾔﾒﾃｵｹ変数減算]
Type = varadd
trigger1 = var(4)>0
var(4) = -1
IgnoreHitPause = 1

[State -2 幻覚ﾔﾒﾃｵｹ変数減算]
Type = varset
trigger1 = var(4)>0 && movetype = H
var(4) = 0
IgnoreHitPause = 1
;-----------------------------------

[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = !ishelper
text = "var(46)=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(46),var(2),var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = !ishelper
text = "Position X=%d,Y=%d,STANDvar(5)=%d, REMOTE(49)=%d VAR(6)=%d \n"
params = floor(Pos X),floor(Pos Y),(var(5)),(var(49)),var(6)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = !ishelper
text = "stateno(10000)=%d,stateno(40000)=%d,VAR(47)=%d,VAR(48)=%d,VAR(5)=%d \n"
params = (helper(10000),stateno),(helper(40000),stateno),(var(47)),(var(48)),(helper(99999),var(5))

;===========================================================================
; 準常時監視ステート（‐３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; ‐１や‐２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

[state -3, 硬直差表示ヘルパー]
type = helper
triggerall = !ishelper
trigger1 = !numhelper(17760)
helpertype = normal
name = "F"
stateno = 17760
ID = 17760
postype = L
pos = 0,0
pausemovetime = 2147483647
supermovetime = 2147483647

[State -3 画面端裏回り防止]
type = width
trigger1 = movetype != H
trigger1 = stateno != [2000,2200]
edge = 3,0
ignorehitpause = 1

[State -2 ヒットスパーク用(0～1000)]
type = VarRandom
trigger1 = !ishelper
trigger1 = movetype != H
v = 3
Range = 0,1000
IgnoreHitPause = 1

[State 遠隔操作中ガード不可]
type = AssertSpecial
trigger1 = numhelper(40000)
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard

[State スタンドステート奪取認識用]
type = parentVarSet
trigger1 = ishelper(40000)
var(43) = gametime
IgnoreHitPause = 1
[State ステート奪取認識用]
type = VarSet
trigger1 = !ishelper
var(20) = gametime
IgnoreHitPause = 1

[State 遠隔操作スタンド本体がやられると即消える]
type = ChangeState
triggerall = ishelper(40000)
trigger1 = (root,movetype=H && root,stateno != [7500,7550]) && stateno != 45000 && root,var(44)=0
trigger1 = !(stateno = 21000 && movehit);例外
value = 45000
ignorehitpause = 1

[State 遠隔操作スタンドとやられを合わせる]
type = ChangeState
triggerall = !ishelper
triggerall = numhelper(40000)
triggerall = var(44)=0
trigger1 = !gethitvar(damage);自分はくらっていないとき
trigger1 = helper(40000),movetype=H && helper(40000),stateno = [5000,5999]
trigger1 = helper(40000),gethitvar(damage);くらった瞬間
value = ifelse(statetype=S,7500,7510)
IgnoreHitPause = 1

[State 遠隔操作スタンドステート奪取された本体]
type = ChangeState
triggerall = !ishelper && stateno != 7550
triggerall = numhelper(40000)
trigger1 = var(46);ステート奪取されている状態;ここは本体から見るとズレるので、ヘルパーが設定したvarに従いましょう
value = 7550
IgnoreHitPause = 1

[State 透明]
Type = AssertSpecial
triggerall = ishelper(40000) && stateno != 45000
trigger1 = (root,stateno =7880); && root,var(50)=1
trigger2 = (root,stateno =12100); && root,var(50)=1
trigger3 = (root,stateno =12000); && root,var(50)=1
Flag = Invisible
Flag2 = NoShadow
ignorehitpause = 1
[State 遠隔操作スタンド C-MOON時のプッツンキャンセルやゲージキャンセル]
type = ChangeState
triggerall = ishelper(40000) && stateno != 45000
trigger1 = (root,stateno =7880); && root,var(50)=1
trigger2 = (root,stateno =12100); && root,var(50)=1
trigger3 = (root,stateno =12000); && root,var(50)=1
value = 45000
ignorehitpause = 1

[State -2 ヒットカウント増加 本体]
type = Varadd
triggerall = !ishelper
trigger1 = movehit=1
var(6) = 1
;IgnoreHitPause = 1
[State -2 ヒットカウント増加 遠隔操作]
type = parentVaradd
triggerall = ishelper(40000)
trigger1 = movehit=1
var(6) = 1
;IgnoreHitPause = 1
[State -2 ヒットカウントリセット]
type = Varset
triggerall = !ishelper
trigger1 = p2movetype!=H
var(6) = 0
IgnoreHitPause = 1
[State -2 補正]
type = Varset
triggerall = !ishelper
trigger1 = var(6)=[0,9]
fvar(0)=(1+((stateno=200||stateno=400||stateno=10202||stateno=10402||stateno=30200||stateno=30400)&&p2movetype=A&&p2statetype=A)+(!(stateno=200||stateno=400||stateno=10202||stateno=10402||stateno=30200||stateno=30400)&&p2movetype=A))*(1+(var(38)>0)*0.1)
IgnoreHitPause = 1
[State -2 補正]
type = Varset
triggerall = !ishelper
trigger1 = var(6)=[10,19]
fvar(0) = 0.7 *(1+(var(38)>0)*0.1)
IgnoreHitPause = 1
[State -2 補正]
type = Varset
triggerall = !ishelper
trigger1 = var(6)=[20,29]
fvar(0) = 0.5 *(1+(var(38)>0)*0.1)
IgnoreHitPause = 1
[State -2 補正]
type = Varset
triggerall = !ishelper
trigger1 = var(6)>=30
fvar(0) = 0.1 *(1+(var(38)>0)*0.1)
IgnoreHitPause = 1

[State 連続ガード回数]
type = varadd
trigger1 = (stateno = [150,155]) && !time
trigger1 = (prevstateno = [150,155])
var(9) = 1
[State 連続ガード回数リセット]
type = varset
trigger1 = (stateno = [150,155]) && !time
trigger1 = !(prevstateno = [150,155])
var(9) = 0

;先行入力認識用ヘルパー暴走防止
[state -3, ステートリセット]
type = changestate
trigger1 = ishelper(99999)
value = 99999
ignorehitpause = 1
;先行入力認識用ヘルパー
[state -3, 先行入力認識用ヘルパー]
type = helper
triggerall = !ishelper
trigger1 = !numhelper(99999)
helpertype = normal
name = "commandhelper"
stateno = 99999
ID = 99999
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

[state -3, 前転後転用常に同方向向くヘルパー]
type = helper
triggerall = !ishelper
trigger1 = !numhelper(99998)
helpertype = normal
name = "commandhelper2"
stateno = 99998
ID = 99998
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

;ガードゲージヘルパー
[state -3, ガードゲージヘルパー]
type = helper
triggerall = !ishelper
trigger1 = !numhelper(16000)
name = "GG"
stateno = 16000
ID = 16000
postype = L
pos = 135,-170
Size.XScale = 0.5
Size.YScale = 0.5
pausemovetime = 2147483647
supermovetime = 2147483647

;ゴゴゴモード
[state スイッチ]
type = varset
triggerall = !ishelper && roundstate = 2
trigger1 = life <= lifemax*0.30 && movetype!=H && var(38)=0
var(38) = 1
[state -3, オーラヘルパー]
type = helper
triggerall = !ishelper
trigger1 = !numhelper(17000)
trigger1 = var(38) = 1
name = "black"
stateno = 17000
ID = 17000
postype = p1
pos = 0,0
ownpal = 1
Size.XScale = Const(size.xscale)*1.04
Size.YScale = Const(size.yscale)*1.04
pausemovetime = 2147483647
supermovetime = 2147483647
[State ゴゴゴ発動時の色]
type = palfx
trigger1 = numhelper(17000) && helper(17000),var(0)
mul = helper(17000),var(0),helper(17000),var(0),helper(17000),var(0)
time = 1
IgnoreHitPause = 1

[State ガークラ移行]
type = changestate
trigger1 = !ishelper
trigger1 = var(8)<=0 && (stateno = 150 || stateno = 152)
value = 5400
[State ガークラ移行]
type = changestate
trigger1 = !ishelper
trigger1 = var(8)=0 && stateno = 154
value = 5410

[State commonに飛ばされたとき遠隔操作スタンド消滅]
type = changestate
trigger1 = ishelper(40000)
trigger1 = stateno = [0,199]
value = 45000

[State デバグ]
type = Varset
trigger1 = var(50)!=2 && 0
var(50)=2
IgnoreHitPause = 1
