;===========================================================================
; 遠隔操作中のスタンド(root)
;===========================================================================
;---------------------------------------------------------------------------
;遠隔操作発動&本体待機 N
[Statedef 7000]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 41000
sprpriority = -1
[State ガード距離]
Type = AttackDist
trigger1 = 1
value = 0

;-3ステートで遠隔操作モード中はここに飛んでくるように設定
;スタンドがやられた時の動作は-3ステートで

[State 終了]
type = ChangeState
triggerall = time > 10
trigger1 = var(49) = 0
value = 0
ctrl = 1

[State 200, ホワイトスネイク！]
type = PlaySnd
trigger1 = Time = 0
value = 100, 0
channel = 0

[State -2 遠隔操作用スタンド]
type = helper
trigger1 = time = 0
stateno = 42100
HelperType = Player
ID = 40000
pos = 0,0
ownpal = 1
KeyCtrl = 1
;---------------------------------------------------------------------------
;遠隔操作発動&本体待機 一瞬考えたな！
[Statedef 7020]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 41020
sprpriority = -1
[State ガード距離]
Type = AttackDist
trigger1 = 1
value = 0

;-3ステートで遠隔操作モード中はここに飛んでくるように設定
;スタンドがやられた時の動作は-3ステートで

[State 200, 声]
type = PlaySnd
trigger1 = Time = 0
value = 100, 8
channel = 0

[State 終了]
type = ChangeState
triggerall = time > 10
trigger1 = var(49) = 0
value = 0
ctrl = 1

[State -2 遠隔操作用スタンド]
type = helper
trigger1 = time = 0
stateno = 42000
HelperType = Player
ID = 40000
pos = 0,0
ownpal = 1
KeyCtrl = 1

;遠隔操作変数が絶対
;変数の有無でスタンドが消えるように変更する
;スタンドが攻撃されたとき、本体も挙動を合わせるには？
;同じステートに飛ばしたいが…
;ステートを奪われたときの挙動から作成する
;アニメはどうしても本体になるので、スタンドのステートを奪われた場合は本体がその場所へ
;本体が奪われたら別に消えればいい

;---------------------------------------------------------------------------
;遠隔操作発動&本体待機 2 打ち上げ
[Statedef 7040]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 41040
sprpriority = -1
[State ガード距離]
Type = AttackDist
trigger1 = 1
value = 0

;-3ステートで遠隔操作モード中はここに飛んでくるように設定
;スタンドがやられた時の動作は-3ステートで

[State 200, 賛美しろ]
type = PlaySnd
trigger1 = Time = 0
value = 100, 5
channel = 0

[State 終了]
type = ChangeState
triggerall = time > 10
trigger1 = var(49) = 0
value = 0
ctrl = 1

[State -2 遠隔操作用スタンド]
type = helper
trigger1 = time = 0
stateno = 42400
HelperType = Player
ID = 40000
pos = -20,0
ownpal = 1
KeyCtrl = 1

