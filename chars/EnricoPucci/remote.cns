;---------------------------------------------------------------------------
;スタンドがやられたときの本体 本体が地上
[Statedef 7500]
type    = S
movetype= H
physics = S
velset = 0,0
ctrl = 0
;anim = 7000
sprpriority = -1

[State ヒットストップ]
type = posset
trigger1 = pos Y > 0
Y = 0

[State  ダメージフィードバック]
type = lifeadd
trigger1 = numhelper(40000) && var(48)!=0
value = -var(48)
ignorehitpause = 1

[State アニメ]
type = Changeanim
triggerall = numhelper(40000) && time>0
trigger1 = (helper(40000),stateno = [5000,5999]) && ((helper(40000),anim = [15000,15999])||(helper(40000),anim = [25000,25999]))
trigger1 = anim != helper(40000),anim-10000*(var(50)+1)
value = helper(40000),anim-10000*(var(50)+1)

[State ヒットシェイク中のアニメ固定]
type = Changeanim
triggerall = numhelper(40000) && time>0
trigger1 = helper(40000),stateno = 5000 || helper(40000),stateno = 5010 || helper(40000),stateno = 5020
value = helper(40000),anim-10000*(var(50)+1)
[State ヒットストップ]
type = posfreeze
triggerall = numhelper(40000)
trigger1 = helper(40000),GetHitVar(HitShakeTime)
[State 2250,ヒットシェイク]
Type = Offset
trigger1 = helper(40000),GetHitVar(HitShakeTime) && time%2=0
x = -1*facing
IgnoreHitPause = 1

[State 速度]
type = velset
triggerall = numhelper(40000)
trigger1 = time = 0
X = helper(40000),gethitvar(Xvel)*helper(40000),facing
;Y = helper(40000),gethitvar(Yvel)

[State 5050, hitfall]
Type = HitFallSet
trigger1 = numhelper(40000)
trigger1 = helper(40000),gethitvar(fall)
value = 1

[State 終了]
type = Changestate
trigger1 = !numhelper(40000) || (numhelper(40000) && helper(40000),stateno != [5000,5999])
value = 0
ctrl = 1

;吹き飛ぶやられ

[State 吹き飛びへ]
type = changestate
triggerall = numhelper(40000)
trigger1 = helper(40000),statetype=A && helper(40000),time < 2
;trigger1 = helper(40000),stateno = 5030 && helper(40000),time < 2
value = 7510
ignorehitpause = 1

;---------------------------------------------------------------------------
;スタンドがやられたときの本体 空中
[Statedef 7510]
type    = A
movetype= H
physics = N
ctrl = 0
sprpriority = -1

[State ヒットストップ]
type = posfreeze
triggerall = numhelper(40000)
trigger1 = helper(40000),GetHitVar(HitShakeTime)
[State 2250,ヒットシェイク]
Type = Offset
trigger1 = helper(40000),GetHitVar(HitShakeTime) && time%2=0
x = -1*facing
IgnoreHitPause = 1

[State  ダメージフィードバック]
type = lifeadd
trigger1 = numhelper(40000) && var(48)!=0
value = -var(48)
ignorehitpause = 1

;gethitvar関連はvarに格納してヒットシェイク後に放つ方がいいかも

[State 速度]
type = velset
triggerall = numhelper(40000)
trigger1 = time = 0
X = helper(40000),gethitvar(Xvel)*helper(40000),facing
Y = helper(40000),gethitvar(Yvel)

[State  重力fvar格納]
type = varset
trigger1 = numhelper(40000)
fvar(20) = helper(40000),gethitvar(yaccel)
ignorehitpause = 1
[State  重力]
type = veladd
trigger1 = numhelper(40000)
trigger1 = !(helper(40000),GetHitVar(HitShakeTime));ヒットストップ中でない
trigger2 = !numhelper(40000)
Y = ifelse(fvar(20)>0,fvar(20),Const(movement.yaccel))

[State 5050, hitfall]
Type = HitFallSet
trigger1 = numhelper(40000)
trigger1 = helper(40000),gethitvar(fall)
value = 1

[State  受け身可能時間var格納]
type = varset
trigger1 = numhelper(40000)
trigger1 = time = 0
trigger1 = helper(40000),GetHitVar(fall.recover)=1;受け身可能な攻撃
var(45) = helper(40000),GetHitVar(fall.recoverTime)+2;受け身可能までの残り時間+ズレ補正+1
ignorehitpause = 1
[State  受け身不可の場合]
type = varset
trigger1 = numhelper(40000)
trigger1 = time = 0
trigger1 = helper(40000),GetHitVar(fall.recover)=0;受け身不可な攻撃
var(45) = 0
ignorehitpause = 1
[State  受け身可能時間カウントダウン]
type = varadd
trigger1 = !(numhelper(40000) && helper(40000),GetHitVar(HitShakeTime));ヒットストップ中でない
trigger1 = var(45)>1
var(45) = -1
ignorehitpause = 1

[State 受け身]
type = Changestate
triggerall = Vel Y > -1
triggerall = alive
triggerall = Command = "recovery"
trigger1 = var(45)=1
trigger2 = numhelper(40000) && helper(40000),CanRecover
trigger2 = numhelper(40000) && helper(40000),stateno = [5000,5999]
value = 5210 ;HITFALL_AIR

;細かい受け身可能時間の調整はしていない

[State アニメ]
type = Changeanim
triggerall = numhelper(40000)
trigger1 = (helper(40000),stateno = [5000,5999]) && helper(40000),anim = [5000+10000*(var(50)+1),15999+10000*(var(50)+1)]
trigger1 = anim != helper(40000),anim-10000*(var(50)+1)
value = helper(40000),anim-10000*(var(50)+1)

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]) || (anim = [5000,5009]), 0, 25)
value = ifelse(numhelper(40000) && helper(40000),statetype!=A,7500,5100);5100 ;HIT_BOUNCE

;---------------------------------------------------------------------------
;スタンドがステート奪取された際の本体
[Statedef 7550]
type    = U
movetype= H
physics = N
ctrl = 0
sprpriority = -1

[State  ダメージフィードバック]
type = lifeadd
trigger1 = numhelper(40000) && var(48)!=0
value = -var(48)
ignorehitpause = 1

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State ステートタイプ]
type = statetypeset
trigger1 = numhelper(40000) && helper(40000),statetype = S
statetype = S
ignorehitpause = 1
[State ステートタイプ]
type = statetypeset
trigger1 = numhelper(40000) && helper(40000),statetype = C
statetype = C
ignorehitpause = 1
[State ステートタイプ]
type = statetypeset
trigger1 = numhelper(40000) && helper(40000),statetype = A
statetype = A
ignorehitpause = 1
[State ステートタイプ]
type = statetypeset
trigger1 = numhelper(40000) && helper(40000),statetype = L
statetype = L
ignorehitpause = 1

[State 場所を合わせる]
type = posset
trigger1 = numhelper(40000)
X = helper(40000),pos X
Y = helper(40000),pos Y
ignorehitpause = 1
[State 速度を合わせる]
type = velset
trigger1 = numhelper(40000)
X = helper(40000),vel X
Y = helper(40000),vel Y
ignorehitpause = 1

[State アニメも合わせる]
type = Changeanim
trigger1 = numhelper(40000)
trigger1 = SelfAnimExist(helper(40000),anim) && anim != helper(40000),anim
value = helper(40000),anim

[State 向きも合わせる]
type = Turn
trigger1 = numhelper(40000)
trigger1 = facing != helper(40000),facing

[State 5050, hitfall]
Type = HitFallSet
trigger1 = numhelper(40000)
trigger1 = helper(40000),gethitvar(fall)
value = 1

[State ステートが返されて復帰するとき];commonステートに返された場合も考えるべきか
type = ChangeState
trigger1 = numhelper(40000)
trigger1 = var(46)=0;ヘルパーがステート奪取されていない
trigger1 = helper(40000),stateno != 45000
trigger1 = helper(40000),stateno = 5040 || helper(40000),stateno = [5120,5210]
value = helper(40000),stateno
ignorehitpause = 1

[State 緊急用]
type = ChangeState
trigger1 = !numhelper(40000)
value = 5100
;ctrl = 1
ignorehitpause = 1

[State 透明];優先順位はchangestateより下
Type = AssertSpecial
trigger1 = 1
Flag = Invisible

;---------------------------------------------------------------------------
;遠隔操作相手がスタンドを向かないためのヘルパー
[Statedef 7999]
type    = A
movetype= I
physics = N
ctrl = 0
anim = 9998

[State 押し出しなし]
Type = PlayerPush
trigger1 = 1
value = 0
[State 420, 狭く]
type = Width
trigger1 = 1
edge = -10,-10
Player = -10,-10
IgnoreHitPause = 1

[State ステートタイプset];p2movetype系の補正率制御に対して
type = statetypeset
trigger1 = helper(40000),movetype = H
movetype = H
ignorehitpause = 1
[State ステートタイプset]
type = statetypeset
trigger1 = helper(40000),movetype = A
movetype = A
ignorehitpause = 1
[State ステートタイプset]
type = statetypeset
trigger1 = helper(40000),movetype = I
movetype = I
ignorehitpause = 1

[State ステートタイプset]
type = statetypeset
trigger1 = helper(40000),statetype = S
statetype = S
ignorehitpause = 1
[State ステートタイプset]
type = statetypeset
trigger1 = helper(40000),statetype = C
statetype = C
ignorehitpause = 1
[State ステートタイプset]
type = statetypeset
trigger1 = helper(40000),statetype = A
statetype = A
ignorehitpause = 1

[State カメラ]
Type = ScreenBound
trigger1 = 1
value = 0

[State 位置]
type = posset
trigger1 = numhelper(40000)
trigger1 = root,pos X <= EnemyNear(0),pos X
X = EnemyNear(0),pos X - abs(helper(40000),pos X-EnemyNear(0),pos X)+1
;相手の位置 -（スタンドと相手との距離）より1相手と近く
ignorehitpause = 1
[State 位置]
type = posset
trigger1 = numhelper(40000)
trigger1 = root,pos X > EnemyNear(0),pos X
X = EnemyNear(0),pos X + abs(helper(40000),pos X-EnemyNear(0),pos X)-1
;相手の位置 +（スタンドと相手との距離）より1相手と近く
ignorehitpause = 1

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 消滅]
type = destroyself;ChangeState
trigger1 = !numhelper(40000)

