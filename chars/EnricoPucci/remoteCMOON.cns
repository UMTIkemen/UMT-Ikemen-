;---------------------------------------------------------------------------
;遠隔操作始動 6サイコザク特格 C-MOON ヘルパー
[Statedef 20100]
type    = S
movetype= A
physics = N
velset = 0,0
ctrl = 0
anim = ifelse((prevstateno = [20000,21000]),20100,20101)
sprpriority = 1
facep2 = (prevstateno = [20000,21000])
[State 40000, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA,AT
time = 1
[State カメラ]
Type = ScreenBound
trigger1 = 1
value = 1
ignorehitpause = 1
[State -2 体力を合わせる]
Type = lifeset
trigger1 = !time
value = parent,life
IgnoreHitPause = 1

[State 空中の挙動]
Type = statetypeset
trigger1 = pos Y < 0
statetype = A
IgnoreHitPause = 1
[State 空中の挙動]
Type = veladd
trigger1 = pos Y < 0
Y = 0.5
IgnoreHitPause = 1
[State 空中の挙動]
Type = posset
trigger1 = pos Y > 0
Y = 0
IgnoreHitPause = 1

[State 透明]
Type = AssertSpecial
triggerall = ishelper(40000) && stateno != 45000
trigger1 = (root,stateno =7880); && root,var(50)=1
trigger2 = (root,stateno =12100); && root,var(50)=1
trigger3 = (root,stateno =12000); && root,var(50)=1
Flag = Invisible
Flag2 = NoShadow
ignorehitpause = 1
[State 遠隔操作スタンド C-MOON時のプッツンキャンセルやゲージキャンセル]
type = ChangeState
triggerall = ishelper(40000) && stateno != 45000
trigger1 = (root,stateno =7880); && root,var(50)=1
trigger2 = (root,stateno =12100); && root,var(50)=1
trigger3 = (root,stateno =12000); && root,var(50)=1
value = 45000
ignorehitpause = 1

[State 遠隔操作スイッチON]
type = ParentVarSet
trigger1 = !time
var(49) = 10000
[State スタンド使用不可スイッチ]
type = ParentVarSet
trigger1 = !time
var(5) = 1

[State スタイルアクション使用回数変数増加]
type = parentvaradd
trigger1 = !time
var(40) = 1
persistent = 0

[State 本体がやられると即消える]
type = ChangeState
trigger1 = root,movetype = H && !(root,stateno = [7500,7550]);遠隔操作専用やられ以外
value = 45000
ignorehitpause = 1

[State 速度]
type = velset
trigger1 = (time = 4 && anim = 20100) || (time = 4+6 && anim = 20101)
X = 5.3
[State 速度]
type = velmul
trigger1 = anim=20100 && animelemtime(4)>8 && vel X >= 0.1
trigger2 = anim=20101 && animelemtime(9)>8 && vel X >= 0.1
X = 0.86
[State 速度]
type = veladd
trigger1 = anim=20100 && animelemtime(5)=0
trigger1 = anim=20101 && animelemtime(10)=0
X = 2.8
[State 速度]
type = velset
trigger1 = vel X < 0.1
X = 0

[State 200, 発現SE]
type = PlaySnd
trigger1 = !Time
value = 50, 0

[State 発現エフェクト]
type = Explod
trigger1 = !time; && numexplod(7210)=0
anim = 7210
ID = 7210
postype = p1
pos =0,-60
IgnoreHitPause = 1
Persistent = 0
sprpriority = 2
scale = 0.5, 0.5
removetime = -2
bindtime = -1
[State オーラエフェクト]
type = Explod
trigger1 = !time && numexplod(7200)=0
anim = 7200
ID = 7200
postype = p1
pos =0,-60
IgnoreHitPause = 1
Persistent = 0
sprpriority = 2
scale = 0.5, 0.5
removetime = -1
bindtime = -1
RemoveOnGethit = 1

[State 200, SE]
type = PlaySnd
trigger1 = Time=4
value = 0, 6

[State 200, 空振り音]
type = PlaySnd
trigger1 = anim=20100 && animelemTime(5) = 0
trigger2 = anim=20101 && animelemTime(10) = 0
value = 0, 5

[State 打ち上げやられ]
type = TargetState
triggerall = movehit = 1
trigger1 = numtarget(20100) &&target(20100),ishelper=0 &&target(20100),statetype != A
value = 21940
ID = 20100
persistent = 0
IgnoreHitPause = 1

[State 410, ヒット定義]
type = HitDef
trigger1 = (anim=20100&&AnimElemno(0) = 7) || (anim=20101&&AnimElemno(0) = 12)
trigger1 = movecontact=0 && movereversed=0
attr = S, SA
damage    = ceil(22*root,fvar(0))
animtype  = B
hitflag = MAF
guardflag = MA
pausetime = 11,2
sparkno = -1
Guard.SparkNo = -1
hitsound = s6, 2
guardsound = s7, 0
ground.type = H
ground.slidetime = 20
ground.hittime  = 32
air.hittime  = 32
ground.velocity = -0.6,-5.5
yaccel = 0.2+(p2statetype=A)*0.1
air.velocity = -0.8,-3
Ground.CornerPush.VelOff = -8
Guard.CtrlTime = 15
Guard.Kill = 0
fall = 1
Fall.RecoverTime = 50
getpower  = ceil( 34*(1+(root,var(38)>0)*0.1) ),ceil( 18*(1+(root,var(38)>0)*0.1) )
givepower = 12,6;18,23,30
ID = 20100
P2Facing =1

[State 331,ヒットエフェクト]
type = Explod
trigger1 = Movehit = 1
anim = 801
postype = p1
pos = P2BodyDist X+40+root,var(3)%20,-100+root,var(3)%20
IgnoreHitPause = 1
Persistent = 0
scale = 0.55, 0.55
ontop = 1
[State 331,ヒットエフェクト強]
type = Explod
trigger1 = Movehit = 1
anim = 810
postype = p1
pos = P2BodyDist X+40+root,var(3)%20,-100+root,var(3)%20
IgnoreHitPause = 1
Persistent = 0
scale = 0.5, 0.5
ontop = 1
[State 331,ガードエフェクト]
type = Explod
trigger1 = Moveguarded
anim = 840
postype = p2
pos = 10-random%10,-60+random%20
IgnoreHitPause = 1
Persistent = 0
scale = 0.5, 0.5
ontop = 1

[State キャンセル]
type = ChangeState
triggerall = root,var(40)<3
triggerall = (((helper(99999),command = "6a") || (helper(99999),var(1)=[11,19]))&&facing*p2dist X>=0) || (((helper(99999),command = "4a") || (helper(99999),var(1)=[21,29]))&&facing*p2dist X<0)
trigger1 = (anim=20100&&time > 28)||(anim=20101&&time > 37)
value = 20100
[State キャンセル]
type = ChangeState
triggerall = root,var(40)<3
triggerall = (((helper(99999),command = "6a") || (helper(99999),var(1)=[11,19]))&&facing*p2dist X<0) || (((helper(99999),command = "4a") || (helper(99999),var(1)=[21,29]))&&facing*p2dist X>=0)
trigger1 = (anim=20100&&time > 16)||(anim=20101&&time > 28)
value = 20105
[State キャンセル]
type = ChangeState
triggerall = root,var(40)<3
triggerall = (command = "2a") || (helper(99999),var(1)=[31,39])
trigger1 = (anim=20100&&time > 16)||(anim=20101&&time > 28)
value = 20040
[State キャンセル]
type = ChangeState
triggerall = root,var(40)<3 && roundstate = 2
triggerall = (command = "a" && command != "holdfwd" && command != "holdback" && command != "holdup" && command != "holddown") || (helper(99999),var(1)=[1,9])
trigger1 = (anim=20100&&time > 28)||(anim=20101&&time > 37)
value = 21000

[State オーラエフェクト消滅]
type = removeExplod
triggerall = numexplod(7200)
trigger1 = animtime = 0
trigger2 = root,var(40)>=3; && animelemtime(12)>10
IgnoreHitPause = 1
ID = 7200
[State 終了エフェクト]
type = Explod
trigger1 = animtime = 0
trigger2 = root,var(40)>=3; && animelemtime(12)>10
anim = 7220
ID = 7220
postype = p1
pos =0,-60
IgnoreHitPause = 1
Persistent = 0
sprpriority = 2
scale = 0.5, 0.5
removetime = -2
bindtime = -1

[State 一定時間後終了]
type = ChangeState
trigger1 = animtime = 0
trigger2 = root,var(40)>=3 && animelemtime(12)>30
value = 40021

