;スタンド
;---------------------------------------------------------------------------
;待機中 遠隔操作中もここ
[Statedef 9999]
type    = A
movetype= I
physics = N
velset = 0,0
anim = 9999
sprpriority = -1
[State bind]
Type = BindToParent
trigger1 = 1
time = 1
pos = 6,0
Facing = 1
ignorehitpause = 1
[State 向きを合わせる]
type = turn
trigger1 = root,facing != facing
[State 非常用]
type = ChangeState
trigger1 = !numhelper
value = 0
ctrl = 1
ignorehitpause = 1

[State スタンド使用可能(ガード可能)]
type = parentvarset
trigger1 = numhelper(40000)=0;遠隔操作スタンドがいない
var(5) = 0
ignorehitpause = 1

[State ガード]
type = changestate
triggerall = ishelper(10000)
trigger1 = root,stateno = 120
trigger2 = root,stateno = [130,132]
trigger3 = root,stateno = 140
trigger4 = root,stateno = [150,155]
value = 10140
ignorehitpause = 1

[State 通常攻撃 白蛇]
type = changestate
triggerall = ishelper(10000) && stateno!=root,stateno+10000
trigger1 = root,stateno = 220 && root,time = 1
trigger2 = root,stateno = 410 && root,time = 1
trigger3 = root,stateno = 420 && root,time = 1
trigger4 = root,stateno = 625 && root,time = 1
value = root,stateno+10000
ignorehitpause = 1

[State 通常攻撃 C-MOON]
type = changestate
triggerall = ishelper(10000) && stateno!=root,stateno-1
trigger1 = root,stateno = 10202 && root,time = 1
trigger2 = root,stateno = 10212 && root,time = 1
trigger3 = root,stateno = 10222 && root,time = 1
trigger4 = root,stateno = 10402 && root,time = 1
trigger5 = root,stateno = 10412 && root,time = 1
trigger6 = root,stateno = 10422 && root,time = 1
trigger7 = root,stateno = 10602 && root,time = 1
trigger8 = root,stateno = 10612 && root,time = 1
trigger9 = root,stateno = 10622 && root,time = 1
value = root,stateno-1
ignorehitpause = 1

[State コマンド技 C-MOON]
type = changestate
triggerall = ishelper(10000) && stateno!=root,stateno-1
trigger1 = root,stateno = 11002 && root,time = 1
value = root,stateno-1
ignorehitpause = 1
[State コマンド技 C-MOON]
type = changestate
triggerall = ishelper(10000) && stateno!=11706
trigger1 = root,stateno = 11700 && root,time = 1
value = 11706
ignorehitpause = 1

[State スデニデキテイタナ突進]
type = changestate
trigger1 = root,stateno = 2100 && root,time = 2
value = 12105
ignorehitpause = 1
[State スデニデキテイタナ裏回り]
type = changestate
trigger1 = root,stateno = 2200 && root,time = 2
value = 12205
ignorehitpause = 1

[State 新月の重力]
type = null;changestate
triggerall = ishelper(10000) && stateno!=root,stateno+10000
trigger1 = root,stateno = 2020
value = root,stateno+10000
ignorehitpause = 1

[State お前は私にとって釈迦の C-MOON]
type = changestate
triggerall = ishelper(10000)
trigger1 = root,stateno = 12200 && root,time = 70
value = 12300
ignorehitpause = 1

[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && root,stateno = 0 && anim != 30000
value = 30000
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && root,anim = 29020 && anim != 30020
value = 30020
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && root,anim = 29021 && anim != 30021
value = 30021
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = [10,12]) && anim != 30011
value = 30011
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = 40) && anim != 30040
value = 30040
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = 50) && anim != 30041
value = 30041
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = 52) && anim != 30050
value = 30050
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = 100) && anim != 30100
value = 30100
[State メイド・イン・ヘブン時のcommonアニメ]
type = changeanim
trigger1 = root,var(50)=2 && (root,stateno = 105) && anim != 30105
value = 30105
[State メイド・イン・ヘブン時のcommonアニメ やられ]
type = changeanim
trigger1 = root,var(50)=2 && root,movetype = H && anim != 35000
trigger1 = !(root,anim=[5005,5007]) && !(root,anim=[5015,5017]) && !(root,anim=[5025,5027]) && !(root,stateno=5210) 
value = 35000
[State メイド・イン・ヘブン時のcommonアニメ やられもどり]
type = changeanim
trigger1 = root,var(50)=2 && root,movetype = H && anim != 35001
trigger1 = (root,anim=[5005,5007]) || (root,anim=[5015,5017]) || (root,anim=[5025,5027]) || (root,stateno=5210) 
value = 35001

[State メイド・イン・ヘブン時のcommonアニメ やられもどり]
type = changeanim
trigger1 = (anim = [30000,39999])&&root,var(50)!=2
value = 9999

[State 透明]
Type = AssertSpecial
trigger1 = root,var(50)=2 && root,statetype=L
trigger2 = root,var(50)=2 && root,var(21)>0
trigger3 = root,Alive=0
Flag = Invisible
Flag2 = NoShadow

[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 7444
value = 7445
ignorehitpause = 1

[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 31550
value = 31551
ignorehitpause = 1

[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 31200
value = 31201
ignorehitpause = 1

[State ステート移動 挑発]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 940
trigger2 = root,stateno = 961
value = 30941
ignorehitpause = 1
[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 31600
value = 31601
ignorehitpause = 1
[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 31700
value = 31701
ignorehitpause = 1
[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0
trigger1 = root,stateno = 32000
value = 32001
ignorehitpause = 1
[State ステート移動]
type = ChangeState
trigger1 = root,var(50)=2 && root,var(21)=0 && root,stateno = 700
value = 30701
ignorehitpause = 1

[State ステート移動]
type = ChangeState
triggerall = root,var(50)=2 && root,var(21)=0 && RoundState != 4
trigger1 = root,stateno != stateno-1 && root,stateno >= 200 && root,movetype!=H && !(root,stateno=[5000,5999])
trigger1 = root,stateno != 700
value = root,stateno+1
ignorehitpause = 1

[State 透明]
Type = AssertSpecial
trigger1 = RoundState = 4
Flag = Invisible
Flag2 = NoShadow

;---------------------------------------------------------------------------
;ガード
[Statedef 10140]
type    = U
movetype= I
physics = U
velset = 0,0
anim = 9999
sprpriority = 1

[State bind]
Type = BindToParent
trigger1 = root,anim = 120 || root,anim = 130 || root,anim = 140 || root,anim = 150
pos = 1,9
Facing = 1
ignorehitpause = 1
[State bind]
Type = BindToParent
trigger1 = root,anim = 121 || root,anim = 131 || root,anim = 141 || root,anim = 151
pos = 5,55 -(root,var(50)=2&&root,anim%10=1)*50
Facing = 1
ignorehitpause = 1
[State bind]
Type = BindToParent
trigger1 = root,anim = 122 || root,anim = 132 || root,anim = 142 || root,anim = 152
pos = 0,-5
Facing = 1
ignorehitpause = 1

[State ガード待機]
type = ChangeAnim
triggerall = anim != 133
trigger1 = root,anim = 120 || root,anim = 130
trigger2 = root,anim = 121 || root,anim = 131
trigger3 = root,anim = 122 || root,anim = 132
value = 133+root,var(50)*2 +(root,var(50)=2&&root,anim%10=1)*2

[State ガード硬直中]
type = ChangeAnim
triggerall = anim != 134
trigger1 = root,anim = 150
trigger2 = root,anim = 151
trigger3 = root,anim = 152
value = 134+root,var(50)*2 +(root,var(50)=2&&root,anim%10=1)*1

[State ガード解除]
type = ChangeAnim
triggerall = anim != 133
trigger1 = root,anim = 140
trigger2 = root,anim = 141
trigger3 = root,anim = 142
value = 133+root,var(50)*2 +(root,var(50)=2&&root,anim%10=1)*2

[State ガード終了]
type = ChangeState
trigger1 = root,stateno != 120
trigger1 = root,stateno != [130,132]
trigger1 = root,stateno != 140
trigger1 = root,stateno != [150,155]
value = 9999

