;スタンドやられ(すぐ消滅)
[Statedef 15000]
type    = A
movetype= H
physics = N
anim = 15020+root,var(50)*10000
sprpriority = -1
[State カメラ]
Type = ScreenBound
trigger1 = 1
value = 0
ignorehitpause = 1

[State スタンド使用可能(ガード可能)]
type = parentvarset
trigger1 = time = 0
var(5) = 0
ignorehitpause = 1

[State 遠隔操作終了]
type = parentvarset
trigger1 = time = 0
var(49) = 0
ignorehitpause = 1

[State ガード]
type = changestate
triggerall = ishelper(10000)
trigger1 = root,stateno = 120
trigger2 = root,stateno = [130,132]
trigger3 = root,stateno = 140
trigger4 = root,stateno = [150,155]
value = 10140
ignorehitpause = 1

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
ignorehitpause = 1

[State 待機へ]
type = changestate
trigger1 = root,gethitvar(hitshaketime)=0
value = 9999
ignorehitpause = 1

