;5H スタンド
[Statedef 10220]
type    = S
movetype= I
physics = S
ctrl = 0
anim = 221
sprpriority = 3

ignorehitpause = 1
[State bind]
Type = BindToParent
trigger1 = 1
pos = 20,0
Facing = 1
ignorehitpause = 1

[State ヒットストップ 攻撃の表示時間は合わせる必要あり]
type = Changeanim
trigger1 = root,anim=220 && root,animelemno(0)=4 && animelemno(0)!=4
value = 221
elem = 4

[State スタンドやられ]
type = ChangeState
trigger1 = root,movetype = H && root,stateno != [0,155];立ち～ガード以外。
value = 15000;本体が攻撃受けてスタンド消滅
ignorehitpause = 1

[State 待機へ]
type = changestate
trigger1 = anim = 221 && animtime = 0
trigger2 = root,stateno != 220
value = 9999
ignorehitpause = 1

[State 通常攻撃キャンセル]
type = changestate
triggerall = ishelper(10000) && stateno!=root,stateno+10000
trigger1 = root,stateno = 220 && root,time = 1
trigger2 = root,stateno = 410 && root,time = 1
trigger3 = root,stateno = 420 && root,time = 1
value = root,stateno+10000
ignorehitpause = 1

