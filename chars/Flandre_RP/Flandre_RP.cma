;---------------------------------------------------------------------------
; Run Fwd
[State -1, Run Fwd]
type = ChangeState
value = 100+10*(statetype=A)
triggerall = stateno != [100,101]
triggerall = stateno != 110
trigger1 = command = "FF" || (command = "holdfwd" && command!="holdback" && (command="a"))
trigger1 = ctrl
;AI
trigger2 = AILevel > 0
trigger2 = statetype != A
trigger2 = var(58) = 100
trigger2 = (var(58):=0)||1
trigger3 = AILevel > 0
trigger3 = statetype = A
trigger3 = var(58) = 110
trigger3 = (var(58):=0)||1

; Run Back
[State -1, Run Back]
type = ChangeState
value = 105+10*(statetype=A)
triggerall = ctrl
triggerall = stateno != [105,106]
trigger1 = command = "BB" || (command = "holdback" && command!="holdfwd" && (command="a"))
trigger1 = ctrl
;AI
trigger2 = AILevel > 0
trigger2 = statetype != A
trigger2 = var(58) = 105
trigger2 = (var(58):=0)||1
trigger3 = AILevel > 0
trigger3 = statetype = A
trigger3 = var(58) = 115
trigger3 = (var(58):=0)||1

;---------------------------------------------------------------------------
;Guard Cancel Counter
[State -1, Guard Cancel Counter]
type = ChangeState
value = 1900
;triggerall = statetype != A
triggerall = power >= 1000
triggerall = statetype != A
triggerall = stateno=[150,155]
trigger1 = AILevel <= 0 ;AI Off
trigger1 = ifelse((anim!=[5,6]),command="412_X",command="632_X")
trigger1 = var(10) := 1
trigger2 = AILevel <= 0 ;AI Off
trigger2 = ifelse((anim!=[5,6]),command="412_Y",command="632_Y")
trigger2 = var(10) := 1
trigger3 = AILevel <= 0 ;AI Off
trigger3 = ifelse((anim!=[5,6]),command="412_Z",command="632_Z")
trigger3 = var(10) := 1

