;1318xyz: Laevatein
[State -1, 1318xyz: Laevatein]
type = ChangeState
value = 2000
triggerall = statetype != A
triggerall = power >= 1000
triggerall = ctrl  || stateno = 40 || stateno = 52 || (stateno=101) || (stateno=106) || (((stateno = [200,625])||(stateno = [1000,1500])) && (movecontact || var(1)))
;trigger1 = AILevel <= 0 ;AI Off
trigger1 = var(50)>6 ;Down Charge Buffer
trigger1 = var(48)>6
trigger1 = var(47)<42 && var(49)<42
trigger1 = command="Delta"
trigger1 = command!="holdfwd"
trigger1 = var(10) := 1
;trigger2 = AILevel <= 0 ;AI Off
trigger2 = var(50)>16 ;Down Charge Buffer
trigger2 = var(48)>16
trigger2 = var(47)<42 && var(49)<42
trigger2 = command="Delta"
trigger2 = command="holdfwd"
trigger2 = var(10) := 2
;AI
trigger4 = AILevel > 0
trigger4 = var(58) = 2101
trigger4 = (var(10):=1)||1
trigger4 = (var(58):=0)||1
;AI
trigger5 = AILevel > 0
trigger5 = var(58) = 2103
trigger5 = (var(10):=1)||1
trigger5 = (var(58):=0)||1

