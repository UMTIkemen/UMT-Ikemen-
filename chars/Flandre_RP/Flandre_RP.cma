[State -1, ATWTBN]
type = ChangeState
value = 4100
triggerall = var(48)>6
triggerall = var(47)<42
triggerall = var(53)>=1 ;Need at least 1 win
triggerall = var(52)=2;Level 3 Spellcard Select
triggerall = (ctrl) || stateno = 40 || stateno = 52 || (stateno=101) || (stateno=106) || (((stateno = [200,625])||(stateno = [1000,1500])) && (p2life <= cond((enemynear(0),lifemax)>1000,0.35*(enemynear(0),lifemax),350)) && (movecontact)) || (var(1) && (p2life <= cond((enemynear(0),lifemax)>1000,0.35*(enemynear(0),lifemax),350)))
triggerall = statetype != A
triggerall = power >= 3000
;trigger1 = var(58) <= 0 ;AI Off
trigger1 = (command="ChargeBFBF_Lv3"||(command="ChargeBFBF_Lv3R"&&var(40)&3584=3584))
;AI
trigger2 = AILevel > 0
trigger2 = var(58) = 4100
trigger2 = (var(58):=0)||1

[State -1, WMD]
type = ChangeState
value = 4000
triggerall = var(48)>6
triggerall = var(47)<42
triggerall = var(52)=1;Level 3 Spellcard Select
triggerall = ctrl  || stateno = 40 || stateno = 52 || (stateno=101) || (stateno=106) || (((stateno = [200,625])||(stateno = [1000,1500])) && (movecontact || var(1)))
triggerall = statetype != A
triggerall = power >= 3000
;trigger1 = var(58) <= 0 ;AI Off
trigger1 = (command="ChargeBFBF_Lv3"||(command="ChargeBFBF_Lv3R"&&var(40)&3584=3584))
;AI
trigger2 = AILevel > 0
trigger2 = var(58) = 4000
trigger2 = (var(58):=0)||1

