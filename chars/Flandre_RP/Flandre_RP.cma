time = 1

;---------------------------------------------------------------------------
; 2. State entry
; --------------
; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]
[State -1, Negative Edge]; - Reset // Release // Hold
type = null
trigger1 = var(40)&4032
trigger1 = (var(40):= 0)||1
trigger2 = var(40)
trigger2 = (var(40):= var(40) +64*(var(40)&1 && command != "holda") +128*(var(40)&2 && command != "holdb") +256*(var(40)&4 && command != "holdc") +512*(var(40)&8 && command != "holdx") +1024*(var(40)&16 && command != "holdy") +2048*(var(40)&32 && command != "holdz")) - var(40)
trigger3 = var(40):= var(40)-(var(40)&63) + 1*(command = "holda") + 2*(command = "holdb") + 4*(command = "holdc") + 8*(command = "holdx") + 16*(command = "holdy") + 32*(command = "holdz")


[State -1, Tick Fix]
type = CtrlSet
triggerAll = !ctrl
trigger1 = (StateNo = 52 || StateNo = 101 || StateNo = 5120) && !AnimTime
trigger2 = (StateNo = [200,499]) && !AnimTime
trigger2 = stateno != 225
trigger3 = ((StateNo = [760,762]) || (StateNo = [700,715]) || (StateNo = [900,905])) && !AnimTime
trigger4 = StateNo = 810 && !AnimTime
trigger5 = (StateNo = 5001 || StateNo = 5011 || StateNo = 151 || StateNo = 153) && HitOver
value = 1

;===========================================================================
[State -1, Combo condition Reset]
type = VarSet
trigger1 = 1
var(1) = 0
ignorehitpause = 1

[State -1, Combo condition Check]
type = VarSet
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = [200,299]) || (stateno = [400,499]) || (stateno = [600,699])
trigger2 = movecontact
trigger3 = (stateno = [1000,1020]) && movecontact
trigger4 = stateno = 1100 && movecontact
trigger5 = (stateno = [1200,1202]) && movecontact
trigger6 = (stateno = [1040,1041]) && movecontact
trigger7 = (stateno = 1301) && movecontact
var(1) = 1
ignorehitpause = 1

;===========================================================================
;///////////////////////////////////////////////////////////////////////////
;===========================================================================
; CPU Controls
;===========================================================================
;///////////////////////////////////////////////////////////////////////////
;===========================================================================
[State -1, Jump Back AI]
type = changestate
value = 1
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,2])
; AI SHIT GOES HERE:
trigger1 = var(58)=1
trigger1 = (var(58):=0)||1

[State -1, Jump Fwd AI]
type = changestate
value = 2
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,2])
; AI SHIT GOES HERE:
trigger1 = var(58)=2
trigger1 = (var(58):=0)||1

[State -1, Jump Neutral AI]
type = changestate
value = 3
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,2])
; AI SHIT GOES HERE:
trigger1 = var(58)=3
trigger1 = (var(58):=0)||1

[State -1, Guard]
type=changestate
value=120
triggerall = !(stateno = [2000,4200])
trigger1 = var(58) > 0
trigger1 = roundstate=2
trigger1 = inguarddist
trigger1 = ctrl || (stateno = [100,106])
trigger1 = (stateno!=[120,155])
trigger1 = !(enemynear,hitdefattr=SCA,AT) && (enemynear,time<120)
trigger1 = (random%100)<ifelse((p2stateno=[200,699]), 49, ifelse((p2stateno=[1000,2999]), 49, 100))

[State -1, Recover AI] ; Recover near ground (use ChangeState)
type = SelfState
triggerall = !(stateno = [2000,4200])
triggerall = stateno = 5050;movetype = H
triggerall = time >= 10
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = var(58) > 0
trigger1 = (random%100) <= 24
value = 5200 ;HITFALL_RECOVER

[State -1, Recover AI] ; Recover in mid air (use SelfState)
type = SelfState
triggerall = !(stateno = [2000,4200])
triggerall = stateno = 5050;movetype = H
triggerall = time >= 10
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = var(58) > 0
trigger1 = (random%100) <= 24
value = 5210 ;HITFALL_AIRRECOVER

