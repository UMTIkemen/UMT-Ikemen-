[Velocity]
walk.fwd  = 3.7      ;Walk forward
walk.back = -3.7     ;Walk backward
run.fwd  = 8.6,0;4.6, 0    ;Run forward (x, y)
run.back = -9.0,-3.8 ;Hop backward (x, y)
jump.neu = 0,-10.4    ;Neutral jumping velocity (x, y)
