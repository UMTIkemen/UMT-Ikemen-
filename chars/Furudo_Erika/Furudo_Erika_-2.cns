trigger1 = fvar(11) < 0.01
fv = 11
value = 0.01
ignorehitpause = 1
Persistent = 1

[State -2];補正
type = AttackMulSet
trigger1 = var(34)>=1
value = 1*fvar(11)
ignorehitpause = 1
Persistent = 1

