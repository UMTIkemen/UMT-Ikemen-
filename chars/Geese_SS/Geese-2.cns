;=========================< 常時監視-2 >=========================
[Statedef -2]

;--- デバッグ ---
[State -2, Clipboard]
type = displaytoclipboard
trigger1 = 1
text = "AI = %d Chain = %d Attack = %f Combo = %f Cancel = %d \n"
params = var(59),!var(0),fvar(3),fvar(0),(var(10) || var(11) || var(12))
ignorehitpause = 1

[State -2, Clipboard]
type = appendtoclipboard
trigger1 = 1
text =  "Life = %d Power = %d P2X = %f P2Y = %f \n"
params = life,power,p2bodydist x,p2bodydist y
ignorehitpause = 1

;--- 喰らい判定 ---
[State -2, NoJuggleCheck]
type = assertspecial
trigger1 = 1
flag = nojugglecheck
ignorehitpause = 1

[State -2, Chain Var]
type = varset
triggerall = var(0)
trigger1 = p2movetype != H
trigger2 = p2statetype = L
v = 0
value = 0

[State -2, HitDef]
type = hitdef
trigger1 = var(0) = 1
attr = S,NA
hitflag = 

;--- ヒット硬直時間 ---
[State -2, HitPause Var]
type = varadd
trigger1 = movecontact = 1
v = 9
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movecontact != 1
v = 9
value = 0
ignorehitpause = 1

;--- ヒット判定 ---
[State -2, HitPause Var]
type = varset
trigger1 = movecontact = 1
trigger2 = movereversed = 1
v = 14
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movetype = I
trigger2 = !movecontact && !movereversed
v = 14
value = 0
ignorehitpause = 1

;--- イントロ用変数 ---
;リセット
[State -2, VarSet]
type = varset
trigger1 = roundstate <= 2
trigger1 = var(2)
v = 2
value = 0

;VS 関係者(タクマ)
[State -2, VarSet]
type = varset
triggerall = var(2) != 2
trigger1 = p2name = "Takuma Sakazaki" || p4name = "Takuma Sakazaki"
trigger2 = p2name = "Takuma_Sakazaki" || p4name = "Takuma_Sakazaki"
trigger3 = p2name = "TakumaSakazaki" || p4name = "TakumaSakazaki"
trigger4 = p2name = "Takuma" || p4name = "Takuma"
trigger5 = p2name = "Takuma945" || p4name = "Takuma945";鶺鴒氏 94,95仕様
trigger6 = p2name = "TakumaXIII" || p4name = "TakumaXIII";Capone氏 XIII仕様
v = 2
value = 2

