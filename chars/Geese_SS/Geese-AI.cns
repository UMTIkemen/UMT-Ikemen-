;=========================< 常時監視-3 >=========================
[Statedef -3]

;--- 画面端ヒットバック ---
[State -3, VarSet]
type = varset
trigger1 = numtarget
trigger1 = target,statetype = S || target,statetype = C
trigger1 = movecontact = 1
trigger1 = hitdefattr = SCA,AA || stateno = 3050
fv = 6
value = target,gethitvar(xvel)

[State -3, VarSet]
type = varset
trigger1 = numtarget
trigger1 = fvar(6)
trigger1 = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
trigger1 = target,hitshakeover
fv = 6
value = fvar(6)*0.85

[State -3, PosAdd]
type = posadd
trigger1 = fvar(6)
trigger1 = numtarget
trigger1 = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
trigger1 = statetype = S || statetype = C
trigger1 = target,statetype = S || target,statetype = C
trigger1 = target,backedgebodydist <= 0 || target,frontedgebodydist <= 0
trigger1 = target,hitshakeover
trigger1 = fvar(6)*facing > 0
x = -fvar(6)*facing

;--- ワイヤーダメージ判定 ---
[State -3, Wire Var]
type = varset
trigger1 = numtarget(var(29))
trigger1 = target(var(29)),stateno = [5600,5604]
v = 16
value = 1

[State -3, Wire Var]
type = varset
trigger1 = p2movetype != H
v = 16
value = 0

[State -3, Helper]
type = helper
trigger1 = !numhelper(5604)
trigger1 = numtarget(var(29))
trigger1 = target(var(29)),stateno = 5600
helpertype = normal
name = "Wire Damage"
stateno = 5604
ID = 5604
postype = p1
pos = 0,0
facing = 1

[State -3, PosAdd]
type = posset
triggerall = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
triggerall = numhelper(5604)
trigger1 = facing = 1 && helper(5604),facing = 1
trigger1 = pos x > helper(5604),pos x
trigger2 = facing = -1 && helper(5604),facing = -1
trigger2 = pos x < helper(5604),pos x
x = helper(5604),pos x

;--- 画面端めくり防止 ---
[State -3, CornerPush]
type = width
triggerall = movetype != H
trigger1 = enemynear, backedgedist < 10
trigger2 = enemynear, frontedgedist < 10
edge = 10


[State -3, 確率用変数]
type = varset
trigger1 = 1;var(59)
v = 58
value = random

[State -3, NoGuard]
type = assertspecial
trigger1 = var(59) > 0
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

;--- 没技解放 ---
[State -3, Rejected Skills]
type = parentvarset
trigger1 = var(49) && var(59) > 0
var(49) = 0
ignorehitpause = 1

;-------------------------< 乱舞VS乱舞 反応 >-------------------------
;デッドリーレイブ リョウ、ロバート、EXロバート、タクマ
[State -3, Deadly Rave]
type = changestate
value = 4000
triggerall = !ishelper
triggerall = var(59) > 0
triggerall = sysfvar(2) = 0
triggerall = roundstate = 2
triggerall = random <= var(59)*100
triggerall = p2stateno = 3150 || p2stateno = 4000
triggerall = statetype != A
triggerall = var(22) = 1 || var(22) = 3 || var(22) = 4 || var(22) = 5
triggerall = numenemy = 1 || (enemy(0),alive = 0 ^^ enemy(1),alive = 0)
triggerall = power >= 3000 || (fvar(2) && power >= 2000)
trigger1 = ctrl || stateno = 30 || stateno = 100 || stateno = [120,139]
trigger2 = var(11) = 1

