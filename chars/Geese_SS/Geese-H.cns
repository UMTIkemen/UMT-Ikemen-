;=========================< レイジングストーム >=========================
[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0,0
ctrl = 0
anim = 3000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(21) >= helper(9999),var(22)
triggerall = helper(9999),var(21) >= helper(9999),var(23)
triggerall = helper(9999),var(21) >= helper(9999),var(24)
trigger1 = time = 0
v = 1
value = 0

[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(22) >= helper(9999),var(21)
triggerall = helper(9999),var(22) >= helper(9999),var(23)
triggerall = helper(9999),var(22) >= helper(9999),var(24)
trigger1 = time = 0
v = 1
value = 1

[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(23) >= helper(9999),var(21)
triggerall = helper(9999),var(23) >= helper(9999),var(22)
triggerall = helper(9999),var(23) >= helper(9999),var(24)
trigger1 = time = 0
v = 1
value = 2

[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(24) >= helper(9999),var(21)
triggerall = helper(9999),var(24) >= helper(9999),var(22)
triggerall = helper(9999),var(24) >= helper(9999),var(23)
trigger1 = time = 0
v = 1
value = 3

[State 3000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(44) = 3000,0,1)

[State 3000, ChangeAnim]
type = changeanim
trigger1 = time = 0
value = ifelse((var(1) = 1 || var(1) = 3),3001,3000)

;--- 超必殺技演出 ---
[State 3000, SuperPause]
type = superpause
trigger1 = time = 1
time = 28 + ifelse(var(1) >= 2,4,0)
movetime = 28 + ifelse(var(1) >= 2,4,0)
darken = 0
anim = -1
p2defmul = 1

[State 3000, Super Helper]
type = helper
trigger1 = time = 1
helpertype = normal
name = "Super Helper"
ownpal = 1
stateno = 7000
ID = 7000
postype = p1
pos = -10,-130
pausemovetime = 999999
supermovetime = 999999

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && fvar(2) = 0
value = -1000

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && fvar(2)
fv = 2
value = 0

;---- スーパーキャンセル ---
[State 3000, VarSet]
type = varset
trigger1 = time = 0
v = 13
value = 0

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && prevstateno = [1000,1999]
v = 13
value = 1

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && var(13) = 1
value = -1000

[State 3000, PalFx]
type = palfx
trigger1 = (time = [0,15]) && time%2 = 0
trigger1 = var(13) = 1
time = 1
add = 256,256,256

;--- 効果音 ---
[State 3000, Voice]
type = playsnd
trigger1 = animelem = 2
trigger1 = var(1) = 0 || var(1) = 1
value = s3000,0
channel = 0

[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
trigger1 = var(1) = 2 || var(1) = 3
value = s3000,1
channel = 0

[State 3000, Sound]
type = playsnd
trigger1 = animelem = 8
value = s3005,0

;--- エフェクト ---
[State 3000, Explod]
type = explod
trigger1 = animelem = 6
ID = 3005
pos = 0,0
postype = p1
bindtime = -1
removeongethit = 1
anim = 3005+var(1)
ownpal = 1
sprpriority = 5
supermovetime = 999999

;--- 無敵 ---
[State 3000, Invincible]
type = nothitby
trigger1 = animelemtime(10) < 0
value = SCA
ignorehitpause = 1

;--- 飛び道具 ---
[State 3000, ProjectileHelper]
type = helper
trigger1 = animelem = 8
helpertype = normal
name = "Raging Stome"
ownpal = 1
stateno = 3010
ID = 3010
postype = p1
pos = 20,0

;--- 画面 ---
[State 3000, EnvShake]
type = envshake
trigger1 = animelem = 8
time = 40
ampl = -6
freq = 90

;--- 攻撃判定消滅 ---
[State 3000, StateTypeSet]
type = statetypeset
trigger1 = animelem = 9
movetype = I

;--- 終了 ---
[State 3000, End]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

[State 3000,0 Helper]
type = Helper
triggerall = numhelper(3091) != 0
triggerAll = !numhelper(3092)
trigger1 = animelem = 7
id = 3092
pos = 0,0
postype = P2
stateno = 3092
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
