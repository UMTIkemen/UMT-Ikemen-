[State 3010, ChangeAnim]
type = changeanim
trigger1 = time = 0
value = 3010+var(1)

;--- アニメ ---
[State 3010, ChangeAnim]
type = changeanim
trigger1 = root,stateno != 3000
value = 3010+var(1)
