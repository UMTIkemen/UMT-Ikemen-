getpower = floor(50*(fvar(2) = 0)*fvar(4)),floor(50*(fvar(2) = 0)*fvar(4))
givepower = 10,10
pausetime = 12,12
hitsound = s6000,0
guardsound = s6100,0
sparkno = s6000+(fvar(2) > 0)
guard.sparkno = s6100
sparkxy = -15,-95
ground.hittime = 12
ground.slidetime = 12
ground.velocity = -5,0
ground.cornerpush.veloff = 0
air.hittime = 12
air.velocity = -3,-6
guard.hittime = 10
guard.slidetime = 10
guard.velocity = -5
airguard.ctrltime = 999999
airguard.velocity = -3,0
yaccel = 0.4

[State 200, HitDef]
type = hitdef
triggerall = var(0) = 0
triggerall = var(14) = 0
triggerall = var(34)
trigger1 = animelemno(0) = 2
attr = S,NA
hitflag = MAF
guardflag = MA
affectteam = E
priority = 4,Hit
animtype = Light
ground.type = High
damage = floor(40*fvar(0)*fvar(3)),0
getpower = floor(50*(fvar(2) = 0)*fvar(4)),floor(50*(fvar(2) = 0)*fvar(4))
givepower = 10,10
pausetime = 12,12
hitsound = s6000,0
guardsound = s6100,0
sparkno = s6000+(fvar(2) > 0)
guard.sparkno = s6100
sparkxy = -15,-95
ground.hittime = 12
ground.slidetime = 12
ground.velocity = -5,0
ground.cornerpush.veloff = 0
air.hittime = 12
air.velocity = -3,-6
guard.hittime = 10
guard.slidetime = 10
guard.velocity = -5
airguard.ctrltime = 999999
airguard.velocity = -3,0
yaccel = 0.4

;--- 攻撃判定消滅 ---
[State 200, StateTypeSet]
type = statetypeset
trigger1 = animelem = 3
movetype = I

;--- 追撃判定 ---
[State 200, Chain Var]
type = varset
triggerall = numtarget
triggerall = var(3) = 0
triggerall = var(9) = 1
trigger1 = movecontact = 1 && target,statetype = A
v = 0
value = 1
ignorehitpause = 1

;--- ステート奪取 ---
[State 200, TargetState]
type = targetstate
triggerall = numtarget
triggerall = var(9) = 1
trigger1 = movehit = 1 && target,statetype = A
value = 5670
ignorehitpause = 1

;--- 終了 ---
[State 200, ChangeState]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

