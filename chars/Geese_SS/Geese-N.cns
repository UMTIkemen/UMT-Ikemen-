triggerall = time >= 30
trigger1 = p2movetype = A
trigger2 = p2bodydist x = [-125,125]
trigger2 = enemynear,statetype != L
trigger3 = !numpartner
trigger3 = random < 5
trigger4 = numpartner
trigger4 = random < ifelse(partner,alive,2,5)
trigger5 = time > 300
trigger6 = var(22) = 1 && (p2stateno = 3250 || p2stateno = 4000)
trigger7 = var(22) = 2 && (p2stateno = 3150 || p2stateno = 4000)
trigger8 = var(22) = 4 && (p2stateno = 3150 || p2stateno = 4000)
trigger9 = var(22) = 5 && (p2stateno = 3400 || p2stateno = 4000)
