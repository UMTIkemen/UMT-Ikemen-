trigger10 = var(40)
trigger10 = numpartner
trigger10 = (partner,stateno = 1000) || (partner,var(43) = 1000 && partner,stateno = 358004)
trigger10 = p2bodydist x >= 100
trigger11 = power >= powermax
trigger12 = roundstate != 2
value = 341

