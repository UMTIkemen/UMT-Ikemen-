;=========================< 烈風拳 >=========================
[Statedef 1000]
type = S
movetype = A
physics = S
velset = 0,0
ctrl = 0
anim = 1000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 1000, Command Var]
type = varset
triggerall = var(59) <= 0
trigger1 = time = 0
v = 1
value = (helper(9999),var(6) >= helper(9999),var(5))

[State 1000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(43) = 1000,0,1)

