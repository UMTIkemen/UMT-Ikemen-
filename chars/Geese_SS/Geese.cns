;=========================< ステータス >=========================
[Data]
life              = 1000
power             = 5000
attack            = 95
defence           = 100
fall.defence_up   = 50
liedown.time      = 60
airjuggle         = 30
sparkno           = 2
guard.sparkno     = 40
KO.echo           = 0
volume            = 0
IntPersistIndex   = 0
FloatPersistIndex = 0

[Size]
xscale           = 1
yscale           = 1
ground.back      = 15
ground.front     = 15
air.back         = 12
air.front        = 12
height           = 60
attack.dist      = 160
proj.attack.dist = 90
proj.doscale     = 1
head.pos         = 0,-105
mid.pos          = 0,-75
shadowoffset     = 0
draw.offset      = 0,0

[Velocity]
walk.fwd     = 3
walk.back    = -3
run.fwd      = 6,0
run.back     = -9,-6
jump.neu     = 0,-10
jump.fwd     = 3
jump.back    = -3
runjump.fwd  = 5,-10
runjump.back = -5,-10
airjump.neu  = 0,-8
airjump.fwd  = 3
airjump.back = -3

[Movement]
airjump.num     = 0
airjump.height  = 35
yaccel          = .55
stand.friction  = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; ニュートラル
[Statedef 0]
type = S
physics = S
sprpriority = 0

;--- アニメ ---
[State 0, ChangeAnim]
type = changeanim
trigger1 = fvar(10) = 0
trigger1 = anim != 0 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 0

[State 0, ChangeAnim]
type = changeanim
trigger1 = fvar(10) > 0
trigger1 = anim != 1 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 1

;--- 振り向き ---
[State 0, ChangeAnim]
type = changeanim
trigger1 = (anim = 0 || anim = 1) && p2dist x < 0
value = 5

[State 0, Turn]
type = turn
trigger1 = anim = 5 && animelem = 1

;--- 速度 ---
[State 0, VelSet]
type = velset
trigger1 = time = 0
x = 0
y = 0

;--- エフェクト ---
[State 0, Effect Helper]
type = helper
trigger1 = fvar(10) > 0 && anim = 1
trigger1 = numhelper(2) = 0
helpertype = normal
name = "Raiging Dead End Effect"
ownpal = 1
stateno = 2
ID = 2
postype = p1
pos = 0,0

[State 0, Effect Helper]
type = helper
trigger1 = fvar(10) > 0 && anim = 1
trigger1 = numhelper(3) = 0
helpertype = normal
name = "Raiging Dead End Effect"
ownpal = 1
stateno = 3
ID = 3
postype = p1
pos = 0,0

;--- 死亡時 ---
[State 0, ChangeState]
type = changestate
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; AI用待機ステート
[Statedef 1]
type = S
physics = S
ctrl = 0
sprpriority = 0

;--- アニメ ---
[State 1, ChangeAnim]
type = changeanim
trigger1 = fvar(10) = 0
trigger1 = anim != 0 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 0

[State 1, ChangeAnim]
type = changeanim
trigger1 = fvar(10) > 0
trigger1 = anim != 1 && anim != 5
trigger2 = anim = 5 && animtime = 0
value = 1

;--- 振り向き ---
[State 1, ChangeAnim]
type = changeanim
trigger1 = (anim = 0 || anim = 1) && p2dist x < 0
value = 5

[State 1, Turn]
type = turn
trigger1 = anim = 5 && animelem = 1

;--- 速度 ---
[State 1, VelSet]
type = velset
trigger1 = Time = 0
x = 0
y = 0

;--- エフェクト ---
[State 1, Effect Helper]
type = helper
trigger1 = fvar(10) > 0 && anim = 1
trigger1 = numhelper(2) = 0
helpertype = normal
name = "Raiging Dead End Effect"
ownpal = 1
stateno = 2
ID = 2
postype = p1
pos = 0,0

[State 1, Effect Helper]
type = helper
trigger1 = fvar(10) > 0 && anim = 1
trigger1 = numhelper(3) = 0
helpertype = normal
name = "Raiging Dead End Effect"
ownpal = 1
stateno = 3
ID = 3
postype = p1
pos = 0,0

;--- 待機解除 ---
[State 1, End]
type = changestate
trigger1 = p2movetype != H
value = 0
ctrl = 1

;--- 死亡時 ---
[State 1, ChangeState]
type = changestate
trigger1 = !alive
value = 5050

;------------------------------------------------------------
; レイジングデッドエンド エフェクト
[Statedef 2]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0
anim = 2
sprpriority = 2

;--- 固定 ---
[State 2, BindToParent]
type = bindtoparent
trigger1 = parent,anim = 1
trigger1 = parent,animelemtime(1) >= 0 && parent,animelemtime(2) < 0
pos = -24,-62

[State 2, BindToParent]
type = bindtoparent
trigger1 = parent,anim = 1
trigger1 = parent,animelemtime(2) >= 0 && parent,animelemtime(3) < 0
pos = -25,-64

[State 2, BindToParent]
type = bindtoparent
trigger1 = parent,anim = 1
trigger1 = parent,animelemtime(3) >= 0 && parent,animelemtime(4) < 0
pos = -24,-61

[State 2, BindToParent]
type = bindtoparent
trigger1 = parent,anim = 1
trigger1 = parent,animelemtime(4) >= 0
pos = -23,-60

;--- 消滅 ---
[State 2, DestroySelf]
type = destroyself
trigger1 = parent,anim != 1

;------------------------------------------------------------
; レイジングデッドエンド エフェクト
