;--- Raging Storm JF L ---
; Opens a 3 frame window after the motion is completed
[State 9999, RagingStorm JF L Timer Start]
type = varset
trigger1 = command = "レイジングストーム 弱"
trigger1 = var(45) <= 0
v = 45
value = 3

; Checks for X during the window
[State 9999, RagingStorm JF L Input]
type = varset
trigger1 = var(45) > 0
trigger1 = command = "x"
v = 23
value = 2+root,var(33)

; Close window after success
[State 9999, RagingStorm JF L Success]
type = varset
trigger1 = var(23)
v = 45
value = 0

; Countdown
[State 9999, RagingStorm JF L Timer]
type = varadd
trigger1 = var(45) > 0
v = 45
value = -1


