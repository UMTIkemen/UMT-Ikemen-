value = 0
ctrl = 1

;=========================< ダッシュ >=========================
[Statedef 100]
type = S
physics = S
velset = 0,0
anim = 100
ctrl = 0
sprpriority = 1

;--- 効果音 ---
[State 100, Sound]
type = playsnd
trigger1 = time = 0
value = s100,0
channel = 1
loop = 1

;--- 速度 ---
[State 100, VelSet]
type = velset
trigger1 = animelemtime(2) >= 0
x = const(velocity.run.fwd.x)

;--- 歩行不可 ---
[State 100, NoWalk]
type = assertspecial
trigger1 = 1
flag = nowalk

;--- 振り向き不可 ---
[State 100, NoAutoTurn]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

;--- ステート変更 ---
[State 100, ChangeState]
type = changestate
triggerall = var(59) <= 0
trigger1 = command != "holdfwd" && time >= 13
value = 101

[State 100, ChangeState]
type = changestate
triggerall = var(59) > 0
triggerall = random <= var(59)*100
triggerall = time >= 13
triggerall = !numpartner
trigger1 = inguarddist
trigger2 = p2movetype = A
trigger3 = p2bodydist x < 100 && !(enemynear,inguarddist)
trigger4 = p2bodydist x < 50 && enemynear,inguarddist
value = 101

