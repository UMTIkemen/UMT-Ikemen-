;=========================< コンフィグ >=========================
[Statedef 10000]
anim = 9999
ctrl = 0

;--- 先行入力受付時間 必殺技 ---
[State 10000, Precede Input Time]
type = parentvarset
trigger1 = time = 0
v = 32
value = 6
; value = フレーム数
; デフォルト6

;--- 先行入力 受付時間 超必殺技 ---
[State 10000, Precede Input Time]
type = parentvarset
trigger1 = time = 0
v = 33
value = 12
; value = フレーム数
; デフォルト12

;--- 地上技・超必殺技空中ガード ---
[State 10000, Air Guard]
type = parentvarset
trigger1 = time = 0
v = 34
value = 0
; 0で不能、その他で可能
; デフォルト0

;--- 空中技・飛び道具空中ガード ---
[State 10000, Air Guard]
type = parentvarset
trigger1 = time = 0
v = 35
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 空中ガード可否 ---
[State 10000, Air Guard]
type = parentvarset
trigger1 = time = 0
v = 36
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 画面点滅 ---
[State 10000, Flash]
type = parentvarset
trigger1 = time = 0
v = 37
value = 1
; 0で点滅しない、1で点滅
; デフォルト1

;--- ゲージ増加倍率 ---
[State 10000, Air Guard]
type = parentvarset
trigger1 = 1
fv = 4
value = 1.25                  *root,fvar(0)
; 攻撃ヒット時、必殺技使用時のゲージ増加量
; デフォルト1.25

;--- AI常時起動 ---
[State 10000, AI]
type = parentvarset
trigger1 = time = 0
var(50) = 0
ignorehitpause = 1
; 0以外で常時on
; デフォルト0

;--- AIレベル ---
[State 10000, AI Level]
type = parentvarset
trigger1 = root,var(59) > 0
var(59) = 10
ignorehitpause = 1
; 1から10の間で変更
; 0で常時off
; デフォルト10

;--- 没技解放 ---
[State 10000, Rejected Skills]
type = parentvarset
trigger1 = time = 0
var(49) = 0
ignorehitpause = 1
; 0以外で解放
; ※AI起動時は強制off
; デフォルト0

;--- 相手燃焼時Pal ---
;リセット ※弄らない
[State 10000, Reset]
type = null
triggerall = parent,stateno != [1050,1099]
triggerall = parent,stateno != [1600,1699]
triggerall = parent,stateno != [3050,3099]
triggerall = parent,stateno != 3330
triggerall = parent,stateno != 3530
triggerall = parent,stateno != 3770
triggerall = parent,stateno != 4030
trigger1 = parent,var(26) >= 0
trigger1 = var(26) := -1
trigger2 = parent,var(27) >= 0
trigger2 = var(26) := -1
trigger3 = parent,var(28) >= 0
trigger3 = var(26) := -1


;設定方法
;trigger1 = root,palno = (1)←パレット番号
;trigger1 = var(26) := (30) || var(27) := (150) || var(28) := (210)
;　　　　　　　 　 R(赤)↑            G(緑)↑             B(青)↑


;感電 
[State 10000, Electric]
type = null
triggerall = (parent,stateno = [1600,1699]) || (parent,stateno = [3050,3099]) || parent,stateno = 3350 || parent,stateno = 3530 || (parent,stateno = [3600,3699])
trigger1 = root,palno = 1
trigger1 = var(26) := 30 || var(27) := 150 || var(28) := 210
trigger2 = root,palno = 2
trigger2 = var(26) := 30 || var(27) := 150 || var(28) := 210
trigger3 = root,palno = 3
trigger3 = var(26) := 240 || var(27) := 105 || var(28) := 105
trigger4 = root,palno = 4
trigger4 = var(26) := 30 || var(27) := 135 || var(28) := 225
trigger5 = root,palno = 5
trigger5 = var(26) := 30 || var(27) := 135 || var(28) := 225
trigger6 = root,palno = 6
trigger6 = var(26) := 240 || var(27) := 180 || var(28) := 90

;燃焼(EX邪影拳)
[State 10000, Fire]
type = null
triggerall = (parent,stateno = [1550,1599]) || parent,stateno = 3300
trigger1 = root,palno = 1
trigger1 = var(26) := 150 || var(27) := 120 || var(28) := 210
trigger2 = root,palno = 2
trigger2 = var(26) := 150 || var(27) := 120 || var(28) := 210
trigger3 = root,palno = 3
trigger3 = var(26) := 30 || var(27) := 150 || var(28) := 210
trigger4 = root,palno = 4
trigger4 = var(26) := 135 || var(27) := 120 || var(28) := 225
trigger5 = root,palno = 5
trigger5 = var(26) := 135 || var(27) := 120 || var(28) := 225
trigger6 = root,palno = 6
trigger6 = var(26) := 30 || var(27) := 150 || var(28) := 210

;燃焼(デッドリーレイブ)
[State 10000, Fire]
type = null
triggerall = parent,stateno = 3770 || parent,stateno = 4030 || parent,stateno = 200010
trigger1 = root,palno = 1
trigger1 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger2 = root,palno = 2
trigger2 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger3 = root,palno = 3
trigger3 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger4 = root,palno = 4
trigger4 = var(26) := 240 || var(27) := 150 || var(28) := 30
trigger5 = root,palno = 5
trigger5 = var(26) := 245 || var(27) := 150 || var(28) := 30
trigger6 = root,palno = 6
trigger6 = var(26) := 30 || var(27) := 150 || var(28) := 210



