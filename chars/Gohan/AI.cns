;AI専用

; ------------------ジャンプ開始
[Statedef 41]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 41, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 41, 2]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 41, longjump];ロングジャンプ
type = VarSet
triggerall = var(59)
trigger1 = p2bodydist X > 160
trigger2 = prevstateno = 101
trigger3 = prevstateno = 261
trigger4 = prevstateno = 920
trigger5 = prevstateno = 930
var(5) = 1

[State 41, 3]
type = VarSet
trigger1 = var(59)
trigger1 = p2Movetype = A && p2bodydist x < 160 && backedgedist >= 30
sysvar(1) = -1

[State 41, 4]
type = VarSet
trigger1 = var(59)
trigger1 = p2Movetype != A || random < 500 || p2bodydist x >= 160 || backedgedist < 30
sysvar(1) = 1

[State 41, 5]
type = VarSet
trigger1 = var(59)
trigger1 = p2bodydist X <= 30+enemynear,vel X*10 && random < 500
trigger1 = p2movetype != H
sysvar(1) = 0

[State 41, 6]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 41, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

; --------------------２段ジャンプ(AI)
[Statedef 46]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 46, 1]
type = Varadd
trigger1 = Time = 0
var(57) = 1

[State 46, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 46, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 46, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 46, 4]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 46, 5]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdback"
sysvar(1) = -1

[State 46, 3]
type = VarSet
trigger1 = var(59)
trigger1 = p2Movetype = A && p2bodydist x < 160
sysvar(1) = -1

[State 46, 4]
type = VarSet
trigger1 = var(59)
trigger1 = p2Movetype != A || random < 500 || p2bodydist x >= 160
sysvar(1) = 1

[State 46, 5]
type = VarSet
trigger1 = var(59)
trigger1 = p2bodydist X <= 30+enemynear,vel X*10 && random < 500
trigger1 = p2movetype != H
sysvar(1) = 0

[State 46, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 46, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

