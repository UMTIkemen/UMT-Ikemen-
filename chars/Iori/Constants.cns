;var(12) : EX 311 Shiki: Tsuma Kushi Juggle Flag (0 = Can't juggle; 1 = Can juggle)
;var(13) : Hit Count
;var(14) : Followup Detection (0 = Off; 218 = Ge-Shiki: Yumebiki ; 1200-1250 = 127 Shiki: Aoibana; 3220-3240 = Ura 316 Shiki: Saika)
;var(15) : Juggle Points
;var(16) : Juggle Flag
;var(17) : Ticks UnGuardable
;var(18) : ProjContact (0 = No; 1 = Yes)
;var(19) : Throw Escape
;var(20) : Custom Combo Time
;var(21) : Super Cancel Flag
;var(22) : Hyper Cancel Flag
;var(23) : Super Finish Type (900 = Custom Combo; 3000 = Ya Otome; 3100 = Ya Sakazuki; 3200 = Saika; 3300 = Oni Homura; 3400 = Saku Tsuma Gushi; 3500 = Yami Sogi; 3600 = Chi no Boso; 3700 = Sanjingi no Ni; 3800 = Homura Hotogi; 3900 = Ya Shiori; 4000 = Hozuki; 4100 = Aoi Hanataba; 4200 = Maga Kaze; 4300 = Yatagarasu)
;var(24) : Special ProjContact (0 = No ; 1 = Yes)
;var(25) : Ticks to Apply EX FX
;var(26) : Ticks Unable to Walk
;var(27) : 104 Shiki: Nueuchi Juggle Flag (0 = Can't juggle; 1 = Can juggle)
;var(28) : 401 Shiki: Shogetsu Juggle Flag (0 = Can't juggle; 1 = Can juggle)
;var(29) : Ura 1018 Shiki: Ya Shiori Juggle Flag (0 = Can't juggle; 1 = Can juggle)
;var(30) : Hit Detection
;var(31) : Hit Sound (0 = Light Punch; 1 = Medium Punch; 2 = Heavy Punch; 3 = Light Kick; 4 = Medium Kick; 5 = Heavy Kick; 6 = Projectile Hit; 800 = Grab)
;var(32) : Guard Sound
;var(33) : Hit Spark (8010 = Light; 8011 = Medium; 8012 = Heavy; 8013 = Special; 8014 = Super)
;var(34) : Guard Spark (8000 = Normal; 8001 = Special)
;var(35) : Spark xPos
;var(36) : Spark yPos
;var(37) : Special/Super Throws (0 = Allowed; 1 = Not Allowed)
;var(38) : Throw (0 = Allowed; 1 = Not Allowed)
;var(39) : Projectile Flag (0 = Off; 1 = On)
;var(40) : Mode (0 = Normal; 1 = Orochi Iori; 2 = EX Iori ; 3 = Claw Iori)
;var(41) : KO Sound

;var(43) : Player ID to apply flames to
;var(44) : Flame particles timer


