;----------------------------------------------------------------------
; Don't work your life away! - grabs
[Statedef 710]
type = S
movetype= A
physics = N
anim = 810

[State 710, Escaping]
type = ChangeState
triggerall = NumTarget
triggerall = var(57) = 0
triggerall = var(5)>0
triggerall = time < 8
trigger1 = AIlevel <= 0
trigger1 = (target,command = "holdfwd" || target,command = "holdback") && (target,command = "a" || target,command = "b" || target,command = "c")
trigger2 = target,AIlevel > 0
trigger2 = random >= 990
value = 950

[State 710, Escape]
type = VarAdd
trigger1 = var(5) > 0
var(5) = -1

[State 710, Holding fwd?]
type = VarSet
trigger1 = Time = 0
var(0) = (command = "holdback" && !AIlevel || AIlevel && backedgedist >= 75)

[State 710, holdfwd - Turn 6]
type = Turn
trigger1 = var(0)
