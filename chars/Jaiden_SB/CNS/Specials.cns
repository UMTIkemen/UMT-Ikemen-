;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)
[Statedef 1033]
type    = A
movetype= H
physics = N

[State 5131, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 2

[State 0, EnvShake]
type = EnvShake
trigger1 = time = 0
time = 8
freq = 240
ampl = -8

[State 5131, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 5131, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5131, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5131, 4]
type = PosSet
trigger1 = Time = 0
y = -1

[State 5131, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5131, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5131, 7]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110;HIT_LIEDOWN

[State 5131, 8]
type = Explod
trigger1 = Time = 1
anim = F60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 5131, 10]
type = PlaySnd
trigger1 = Time = 1
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5131, 11]
type = PosFreeze
trigger1 = 1

[State 5131, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 1034

[State 5131, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

