; Definition file for Jaiden
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Jaiden Animations"
displayname = "Jaiden"
versiondate = 07,18,2022
mugenversion = 1.0
author = "Shimmering Brony"
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd      = Coding/Jaiden.cmd
cns      = CNS/Jaiden.cns
stcommon = CNS/Jaidencommon.cns
sprite   = Coding/Jaiden.sff
anim     = Coding/Jaiden.air
sound    = Coding/Jaiden.snd
st       = CNS/Jaiden.cns
st1      = CNS/Negatives.cns
st2      = CNS/Normals.cns
st3      = CNS/Specials.cns
st4      = CNS/EXSpecials.cns
st5      = CNS/Hypers.cns
st6      = CNS/AnimeJaiden.cns
st7      = CNS/Helpers.cns
st8      = Options.txt

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x  = 1
y  = 2
z  = 3
a  = 4
b  = 5
c  = 6
x2 = 7
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12
