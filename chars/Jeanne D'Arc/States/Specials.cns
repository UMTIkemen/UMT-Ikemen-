;Aura Bird
[Statedef 1000]
type = S 
physics = S
movetype = A
ctrl = 0
velset = 0,0
poweradd = 72 * !var(20)
sprpriority = 2

[State -2, Hit Detection]
type=varset
trigger1 = 1
var(14)=0
ignorehitpause = 1


[State 1000, VarSet]
type = VarSet
trigger1 =!AILevel&& time =0
var(10) = ifelse(command="x",0,ifelse(command="y",1,2))
ignorehitpause = 1

[State 1000, Anim]
type = changeanim
trigger1 = !time
value = ifelse(var(10) = 0, 1000, ifelse(var(10) = 1, 1001,  1002))

[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || Random < 333), 0, ifElse(Random < 500, 1, 2))

[State 1000, sound]
type = PlaySnd
trigger1 = Animelem = 3
value = 1000, 0
volumescale = 255
channel = 0


[State 1000, sound] 
type = PlaySnd
trigger1 = AnimElem = 3
value = S1000, 1


[State 1000, sound] 
type = PlaySnd
trigger1 = AnimElem = 1
value = S183, 0
volumescale = 255

[State 1000, Explod]
type = Explod
trigger1 = animelem = 3
anim = 6028
sprpriority = 3
scale = .15,.15
pos = 40,0
ID = 6028
ownpal = 1
pauseMoveTime = 255
superMoveTime = 255
ignorehitpause = 1



[State 1000, Width]
type = Width
trigger1 =animelemtime(3)>=0&&animelemtime(5)<0
edge = 70,0
player = 40,0

[State 1000, Helper]
type = Helper
trigger1 = AnimElem = 2
stateno = 1001
size.xscale= .22 * const(size.xscale)
size.yscale= .22 * const(size.yscale)
ownpal = 1

[State 1000, Helper]
type = Helper
trigger1 = AnimElem = 3
stateno = 1002
size.xscale= .22 * const(size.xscale)
size.yscale= .22 * const(size.yscale)
ownpal = 1

[State 1000, Helper]
type = Helper
trigger1 = Animelem = 3
helpertype = normal
name = "Aura Bird"
id = 1005
stateno = 1005
pos=floor(47*const(size.xscale)),floor(-55*const(size.yscale))
size.xscale=.22
size.yscale=.22
facing = 1
sprpriority = 5
keyctrl = 0
ownpal = 1


[State 1000, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

