; 11 = 暗転用変数
; 12 = KOサウンド
; 13 = 勝利判定
; 14 = 
; 15 = 大ジャンプ
; 16 = 小ジャンプ
; 17 = ダメージ補正に使用
; 18 = 攻撃値の保存
; 19 = 
; 20 = 必殺キャンセル関係
; 21 = ダウンバウンド
; 22 = スーパージャンプ
; 23 = エリアル
; 24 = 
; 25 = 明鏡止水管理
; 26 = 明鏡止水色関係
; 27 = 
;
; 30 = Xファクター発動
; 31 = Xファクター持続時間
; 32 = Xファクター発動時の体力値

