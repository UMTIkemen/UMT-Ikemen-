;---------------------------------------------------------------------------
; ステップ
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
ctrl = 1

;---------------------[効果音]
[State 00]
type = PlaySnd
trigger1 = animelem = 2
value = 40, 0

[State 00]
type = PlaySnd
trigger1 = animelem = 2
value = 500, 2

[State 00]
type = PlaySnd
trigger1 = animelem = 8
value = 47, 0

;---------------------[エフェクト]
[State a];
type = removeExplod
trigger1 = time = 0
id = 3000

[State explod];
type = Explod
trigger1 = animelem = 2
anim = 101
id = 3000
sprpriority = 5
postype = p1
pos = 0,0
bindtime = 1
under = 0
ignorehitpause = 0
scale = 0.5,0.5
ownpal = 1

[State explod];
type = Explod
trigger1 = animelem = 8
anim = 6200
id = 3000
sprpriority = 5
postype = p1
pos = 48,0
bindtime = 1
under = 0
ignorehitpause = 0
scale = 0.5,0.5
ownpal = 1


;---------------------[速度]
[State 01]
type = VelSet
trigger1 = animelem = 2
x = const(velocity.run.fwd.x)

[State 01]
type = Velmul
trigger1 = animelem = 6,>=0
x = 0.95

[State 02] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 03] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

;---------------------[ステート移行]
[State 04]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1


