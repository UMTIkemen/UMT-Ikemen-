anim    = Jin-Saotome.air   ;Animation
sound   = Jin-Saotome.snd   ;Sound
pal1    = New Palettes/MT7_Default.act
pal2    = New Palettes/KenJouLirt_DomonKasshu.act
pal3    = New Palettes/SonicHalo3435_Silver_Surfer.act
pal4    = New Palettes/MT7_EvaSuitShinji.act
