; ブロディアパンチ
[Statedef 2000]
type    = S
movetype = A
physics = N
anim = 2000
sprpriority = 1
ctrl = 0
velset = 0,0
poweradd = -1000

[state a]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

;---------------------[残像]
[State 50, 4];残像
type = AfterImage
trigger1 = animelem = 4
time = 77
trans = add
timegap = 3
framegap = 3
length = 7
ignorehitpause = 1
palbright = 30,30,30
palcontrast = 115,115,115
palpostbright = 30,30,70
paladd = -60,-60,60
;palmul = 21,21,21

;---------------------[補正]
[state varset]
type = varset
trigger1 = time = 0
trigger1 = numtarget
fvar(5) = 1 - target,gethitvar(hitcount)*0.05

[state varset]
type = varset
trigger1 = time = 0
trigger1 = numtarget = 0
fvar(5) = 1

[state c]
type = attackmulset
trigger1 = var(25) = 0
trigger1 = numtarget = 0
value = 1

[state c]
type = attackmulset
trigger1 = var(25) > 0
trigger1 = numtarget = 0
value = 1.25

[state c]
type = attackmulset
trigger1 = var(25) = 0
trigger1 = numtarget
value = fvar(5)

[state c]
type = attackmulset
trigger1 = var(25) > 0
trigger1 = numtarget
value = fvar(5)*1.25

