; HITG_SLIDE
[Statedef 5001]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger2 = ((Anim != [5000,5003]) || (Anim != [5010,5013]))
trigger2 = abs(vel x) > 1
value = 5005 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10+ifelse(GetHitVar(animtype)<2,Var(48),0)
[State 5001, 2]
type = ChangeAnim
TriggerAll = Var(48) && GetHitVar(animtype)= 1
trigger1 = AnimTime = 0
trigger2 = ((Anim != [5000,5003]) || (Anim != [5010,5013]))
trigger2 = abs(vel x) > 0
value = 5008 + (GetHitVar(groundtype)=2)*10

[State 5001, 3] ;Stop sliding back
