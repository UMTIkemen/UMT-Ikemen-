type    = L
movetype= H
physics = N
sprpriority = -3
ctrl = 0

;Some custom stuff
[State 0]
type = VarSet
trigger1 = (anim = 5072 || anim = 5081 || anim = 5111 || anim = 5171 || (anim = [5321,5322]) || (anim = [5950,5951]))
var(11) = 1
[State 5150, 1] ;Normal Anim (No Partner)
type = ChangeAnim
TriggerAll = NumPartner = 0
trigger1 = Time = 0
value = ifelse(Var(11)&&MatchOver,5151,ifelse(Var(11)&&!MatchOver,5141,ifelse(!Var(11)&&MatchOver,5150,5140)))

[State 5150, 1] ;Normal Anim (Partnered)
type = ChangeAnim
TriggerAll = NumPartner > 0
triggerall = Time = 0
trigger1 = (anim != 5072 || anim != 5081 || anim != 5111 || anim != 5171 || (anim != [5321,5322]) || (anim != [5950,5951]))
value = ifelse(!MatchOver&&Partner,Alive=0,5140,5150)
[State 5150, 1] ;Up Anim (Partnered)
type = ChangeAnim
TriggerAll = NumPartner > 0
triggerall = Time = 0
trigger1 = (anim = 5072 || anim = 5081 || anim = 5111 || anim = 5171 || (anim = [5321,5322]) || (anim = [5950,5951]))
value = ifelse(!MatchOver&&Partner,Alive=0,5141,5151)

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

