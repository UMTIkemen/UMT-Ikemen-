;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = C
sprpriority = 0

[State 191, Helper]
type = Helper
trigger1 = !NumHelper(1)
helpertype = Normal
name = "Blink"
postype = p1
stateno = 1
ID = 1
[State 0, Explod]
type = Explod
trigger1 = !NumExplod(1)
anim = 1
ID = 1
pos = 0,0
postype = p1
sprpriority = -1
bindtime = -1
removetime = -1
removeongethit = 1
scale = .335,.335
shadow = 1,1,1

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 20
value = 22
[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 21
value = 23

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 2 && Anim != 5 && anim != [20,23]
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = (anim = 2 || anim = 22 || anim = 23)
trigger3 = animtime = 0
value = 0

[State 0, ChangeAnim]
type = ChangeAnim
TriggerAll = Time >= 560
trigger1 = Random <= 149
trigger1 = AnimTime = 0
value = 2
[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = Anim != 0
id = 1
[State 0, PlaySnd]
type = PlaySnd
trigger1 = Anim = 2 && AnimElemTime(1) = 1
value = S0,random%4
volume = 355
channel = 8
[State 0, PlaySnd]
type = PlaySnd
TriggerAll = Anim = 2
trigger1 = AnimElem = 2
trigger2 = AnimElem = 5
trigger3 = AnimElem = 8
trigger4 = AnimElem = 11
trigger5 = AnimElem = 13
value = S4,1
volume = 355

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 8 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 8
x = 0

[State 0, DestroySelf]
type = DestroySelf
trigger1 = IsHelper

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Blinking
[Statedef 1]
type = U
physics = S
sprpriority = 1
anim = 4

[State 0, BindToRoot]
type = BindToRoot
trigger1 = 1
time = 1

[State 0, VarSet]
type = VarSet
TriggerAll = !Var(1)
trigger1 = Random < 10
v = 1
value = 4
persistent =  1
[State 0, VarAdd]
type = VarAdd
trigger1 = Var(1)
v = 1
value = -1

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = !Var(1)
flag = invisible
persistent = 1

[State 0, DestroySelf]
type = DestroySelf
trigger1 = Root,Anim != 0

