;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;You don't HAVE to leave this alone, but you might break something. ;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 0, PowerSet]
type = PowerSet
trigger1 = !NumPartner
trigger2 = NumPartner
trigger2 = Var(10) = 0
value = 0

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0
[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0
[State 0]
type = varset
trigger1 = roundno = 1
var(55) = palno

[State 5900, turnsintro]
type = changestate
trigger1 = teammode = turns
trigger1 = !roundsexisted && roundno >= 2
value = 191
[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190
