;-----------ガーキャンオーラ
[statedef 775]
sprpriority=5
[state ]
type=changeanim
trigger1=anim!=770
value=770
[state ]
type=bindtoroot
trigger1=1
[state ]
type=palfx
trigger1=1
add=256,256,256
time=1
[state ]
type=hitby
trigger1=1
value=
[state ]
type=trans
trigger1=1
trans=addalpha
alpha=256-animelemtime(1)*20,256
[state ]
type=angledraw
trigger1=1
scale=1+animelemtime(1)*.08,1+animelemtime(1)*.03
[state ]
type=destroyself
trigger1=animelem=1,>8
trigger2=root,anim!=770
;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
; 一撃背景エフェクト
[Statedef 780001]
type = A
movetype = I
physics = N
anim = 9999
velset = 0, 0
ctrl = 0

[State 7800, 1]
type = Explod
trigger1 = !NumExplod(780001)
anim = 780001
id = 780001
postype = back
bindtime = -1
RemoveTime = 99999999
scale = 0.5,0.5;0.55,0.55
sprpriority = -50
ownpal = 0
persistent = 0
supermovetime = 999999999
pausemovetime = 999999999

[State -2,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoBG
flag2 = NoFG
flag3 = Noshadow
ignorehitpause = 1

[State -2, end]
type = RemoveExplod
triggerall = Time > 0
trigger1 = parent,movetype = H||root,numexplod(3125)
trigger2 = Parent,StateNo != [3000,3999]
ID = 780001

[State 7800,end]
type = DestroySelf
triggerall = Time > 0
trigger1 = parent,movetype = H||root,numexplod(3125)
trigger2 = Parent,StateNo != [3000,3999]
