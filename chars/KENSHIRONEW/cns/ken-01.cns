;===========================================================================
; 通常技
;===========================================================================
;---------------------------------------------------------------------------
;------------近A
[statedef 200]
movetype=a
[state ]
type=changeanim
trigger1=anim!=200
value=200
[state ]
type=turn
trigger1=animelem=1
trigger1=(var(1):=var(1)+4*(facing*(enemynear(!enemynear,alive&&numenemy>1&&enemynear(numenemy>1),alive),pos x-pos x)<0))&4
[state ]
type=playsnd
trigger1=animelem=1
trigger1=random%4=0
value=s200,10+random%2
volume=255
channel=0
[state ]
type=playsnd
trigger1=animelem=1
value=s200,0
[state ]
type=varadd
trigger1=animelem=2
trigger1=var(0)<(var(1)&1)
var(1)=-(var(1)&2)
[state ]
type=hitdef
trigger1=var(0)<(var(1)&1)&&!(var(1)&2)
trigger1=animelem=2,>=0&&animelem=4,<0
attr=s,na
hitflag=maf
guardflag=m
damage=ifelse(9*5.6*fvar(10)*fvar(16)>5,ceil(9*5.6*fvar(10)*fvar(16)),5),5*(fvar(4)>0)
getpower=ceil(1000*(.05+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0),ceil(1000*(.05+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0)
givepower=ceil(500*.05*fvar(10))*ifelse(var(1)&128,.6,1),ceil(333*.05*fvar(10))*ifelse(var(1)&128,.6,1)
animtype=light
priority=7,hit
pausetime=0,9
ground.hittime=10
ground.slidetime=10
guard.hittime=8
ground.velocity=-4
air.hittime=0
air.velocity=-3.5*!(var(1)&256),ifelse(var(1)&256,-6.6,-10.4)
air.fall=1
yaccel=fvar(0)
fall.recovertime=27
ground.cornerpush.veloff=0
sparkno=-1
hitsound=-1
guard.sparkno=-1
guardsound=-1
[state ]
type=selfstate
trigger1=!animtime
value=0
