;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓

[StateDef 999900];                                北斗システム

;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
type        = A
movetype    = I
physics     = N
anim        = 89999
velset      = 0, 0
ctrl        = 0
poweradd    = 0
facep2      = 0
hitdefpersist   = 0
movehitpersist  = 0
hitcountpersist = 0
sprpriority = 10

;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;              ブーストゲージ光沢設定 H999900,VAR(11)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, ブーストゲージ白設定]
type     = VarSet
trigger1 = !var(40)
------------------------------------○
var(40)  = 1
;━━━━━━━━━○
　　;1で表示
    ;0で非表示
    ;(デフォルト：1)
------------------------------------○
persistent = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;                オーラゲージ光沢設定 H999900,VAR(19)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, オーラゲージ白設定]
type     = VarSet
trigger1 = !var(41)
------------------------------------○
var(41)  = 1
;━━━━━━━━━○
　　;1で表示
    ;0で非表示
    ;(デフォルト：1)
------------------------------------○
persistent = 0
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;          ブーストオーラゲージＸ座標 H999900,VAR(21)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, ブーストオーラゲージＸ座標]
type     = VarSet
trigger1 = !var(32)
------------------------------------○
var(32)  = 8
;━━━━━━━━━○
　　;お好みで
    ;(デフォルト：8)
    ;
------------------------------------○
persistent = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;          ブーストオーラゲージＹ座標 H999900,VAR(22)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, ブーストオーラゲージＹ座標]
type     = VarSet
trigger1 = !var(33)
------------------------------------○
var(33)  = 213
;━━━━━━━━━○
　　;お好みで
    ;(デフォルト：213)
    ;
------------------------------------○
persistent = 0

;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;                ブーストゲージ＆オーラゲージ表示(網)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, ゲージ網表示]
type     = Explod
trigger1 = !numexplod(150002)&&roundstate>1
anim     = 150002
ID       = 150002
pos      = var(32), var(33)
postype  = back
facing   = 1
bindtime = -1
ontop    = 1
ownpal   = 1
sprpriority=90
scale    = 0.5,0.5
supermovetime = 999999999999
pausemovetime = 999999999999

