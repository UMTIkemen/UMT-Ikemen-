;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, ブーストゲージ白移動制御01]
type       = VarAdd
triggerall = numexplod(10200)
trigger1   = var(41)
var(47)    = 4
supermovetime = 9999999999
pausemovetime = 9999999999

[State 999900, ブーストゲージ白移動制御02]
type       = VarSet
trigger1   = var(47) >= 148
;trigger2   = !root,var(6)
trigger2   = var(55) < 185
var(47)    = 0
supermovetime = 9999999999
pausemovetime = 9999999999

[State 999900, ブーストゲージ白移動00]
type     = ModifyExplod
trigger1 = numexplod(10200)
ID       = 10200
pos      = ifelse(ceil(var(55)*0.200) < var(47), 0, ifelse(var(47), var(47), 0))+var(32), var(33)+2; var(32), var(33)  ; 6,221  ;12,232
