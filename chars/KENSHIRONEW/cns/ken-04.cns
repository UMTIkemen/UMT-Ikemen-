;━━━━━━━━━━━━━━━━━━━━━━━━━━●
;　オーラゲージ橙用 VAR(53), オーラゲージ青用 VAR(54)
;━━━━━━━━━━━━━━━━━━━━━━━━━━●
[State 999900, オーラゲージ橙判定]
type     = VarAdd
trigger1 = var(53) < power - 1000
var(53)  = 10
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ橙判定]
type     = VarAdd
trigger1 = var(53) > power - 1000
var(53)  = -10
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ橙判定]
type     = VarSet
trigger1 = var(53) >= 1000
var(53)  = 1000
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ橙判定]
type     = VarSet
trigger1 = var(53) <= 0
var(53)  = 0
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ青判定]
type     = VarAdd
trigger1 = var(54) < power
var(54)  = 10
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ青判定]
type     = VarAdd
trigger1 = var(54) > power
var(54)  = -10
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ青判定]
type     = VarSet
trigger1 = var(54) >= 1000
var(54)  = 1000
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, ミニオーラゲージ青移動]
type     = ModifyExplod
trigger1 = numexplod(10100)
ID       = 10100
pos      = ifelse(var(54) >= 1000, var(32)+68, var(32)+4 + floor(var(54)*0.064)), var(33) + 11;0.043
postype  = back
bindtime = -1
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, ミニオーラゲージ橙移動]
type     = ModifyExplod
trigger1 = numexplod(10102)
ID       = 10102
pos      = ifelse(var(53) >= 1000, var(32)+68, var(32)+4 + floor(var(53)*0.064)), var(33) + 11;0.043
postype  = back
bindtime = -1
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ青スケール変更]
type     = ModifyExplod
trigger1 = numexplod(10101)
ID       = 10101
scale 　 = ifelse(var(54) >= 1000, 0.5, var(54)*0.00051), 0.5
supermovetime = 999999999999
pausemovetime = 999999999999

[State 999900, オーラゲージ橙スケール変更]
type     = ModifyExplod
trigger1 = numexplod(10103)
ID       = 10103
scale    = ifelse(var(53) >= 1000, 0.5, var(53)*0.00051), 0.5
supermovetime = 999999999999
pausemovetime = 999999999999

