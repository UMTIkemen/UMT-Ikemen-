type     = Explod
trigger1 = !numexplod(150000) && !numexplod(150001)&&roundstate>1
anim     = 150000 + (teamside = 2)
ID       = 150000 + (teamside = 2)
pos      = var(32), var(33)
postype  = back
facing   = 1
bindtime = -1
ontop    = 1
ownpal   = 1
sprpriority=194
scale    = 0.5,0.5
supermovetime = 999999999999
pausemovetime = 999999999999


