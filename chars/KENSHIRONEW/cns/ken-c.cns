x=1
y=1
[state ]
type=veladd
trigger1=1
y=gethitvar(yaccel)
[state ]
type=changestate
trigger1=vel y>0
trigger1=pos y>=15
value=30766
[statedef 35100]
type=a
movetype=h
[state ]
type=hitvelset
trigger1=hitshakeover&&time>=10
x=1
persistent=0
[state ]
type=velset
trigger1=hitshakeover&&time>=10
y=gethitvar(yvel)+15
persistent=0
[state ]
type=posset
trigger1=!time
trigger1=pos y>0
y=0
[state ]
type=posfreeze
trigger1=!hitshakeover||time<10
[state ]
type=changeanim
trigger1=!hitshakeover
value=5030
[state ]
type=changeanim
trigger1=selfanimexist(5035)
trigger1=anim=5030
trigger1=hitshakeover
trigger1=!animtime
