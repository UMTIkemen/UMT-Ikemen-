trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
ignorehitpause = 1

[State 1020, 2]
type = HitOverride
trigger1 = 1
attr = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
stateno = 1020
ignorehitpause = 1

[State 1020, 3]
type = ScreenBound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 1020, 4]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2 = Invisible
ignorehitpause = 1

[State 1020, 5] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 1020, 6]
type = ChangeState
trigger1 = 1
value = 1021
ctrl = 0


