; Var(0) = 攻撃判定消失フラグ
; Var(7) = ダメージ値
; Var(18) = カウンター判定

[Statedef 1020]
type = S
movetype = A
physics = N
anim = 1020
sprpriority = 3
ctrl = 0

[State 1020, 0]
type = SelfState
