type = U
movetype = U
physics = U
sprpriority = 3
ctrl = 0

[State 1020, 0]
type = SelfState
trigger1 = !IsHelper
value = 50
ctrl = 0

[State 1020, 1]
type = NotHitBy
trigger1 = 1
value = , NA, SA, HA, NT, ST, HT
ignorehitpause = 1

[State 1020, 2]
type = HitOverride
trigger1 = 1
attr = SCA, NA, SA, HA, NP, SP, HP, NT, ST, HT
stateno = StateNo +1
ignorehitpause = 1

[State 1020, 3]
type = ScreenBound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 1020, 4]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2 = Invisible
ignorehitpause = 1

[State 1021, ] ;ガークラ値
type = ParentVarAdd
triggerall = Floor((Root, Var(30)%2)/1) = 1
trigger1 = MoveGuarded = 1
fvar(18) = 0 +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 1021, ] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(1020)
triggerall = Floor((Root, Var(30)%2)/1) = 1
triggerall = Parent, FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 1020
value = 5910
ignorehitpause = 1
persistent = 0

[State 1020, 5]
type = ChangeState
trigger1 = MoveHit
value = 1025
ctrl = 0
ignorehitpause = 1

[State 1021, 6]
type = ChangeState
trigger1 = MoveGuarded
trigger2 = ScreenPos X != [-80, 360]
value =  StateNo +1

[State 1020, 7]
type = VarSet
trigger1 = 1
var(18) = Parent, Var(18)
ignorehitpause = 1

[State 1020, 8] ;ダメージ基礎値
type = Null
trigger1 = IsHelper(1020)
trigger1 = Var(7) := 0
trigger2 = IsHelper(1021)
trigger2 = Var(7) := 0

[State 1021, 10] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = Root, ProjContactTime(1020) = [0, 1]
fvar(2) = FVar(2)*0.5
persistent = 0

[State 1021, 11] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 1020, 9]
type = ChangeAnim
trigger1 = Anim != 1020
value = 1020

[State 1020, 10]
type = VelSet
trigger1 = 1
x = 7

[State 1020, 11]
type = Explod
trigger1 = Time = 0
id = 4141
anim = 4141
pos = 0, 0
postype = P1
ownpal = 1
supermovetime = 0
pausemovetime = 0
removeonhit = 1
bindtime = -1
removetime = -1
sprpriority = 3

[State 1001, 12]
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 1020, 13]
type = Hitdef
triggerall = !Parent, Var(8)
triggerall = !MoveContact && !MoveReversed
trigger1 = 1
attr = A, SP
hitflag = MAF
guardflag = MA
animtype = Back
damage = Var(7), Floor(IfElse((Var(7)/8.33) > 8, (Var(7)/8), 8.33))*(Var(7) > 0)
pausetime = 0, 13
guard.pausetime = 0, 11
sparkno = S4006
guard.sparkno = 41
sparkxy = 0, 0
hitsound = S5, 30
guardsound = S6, 1
ground.type = High
ground.slidetime = 160
guard.slidetime = 22
ground.hittime  = 33
guard.hittime = 25
air.hittime = 160
guard.ctrltime = 17
yaccel = 0.5
ground.cornerpush.veloff = 0
ground.velocity = 0
guard.velocity = -10
air.velocity =  -5, -7.5
airguard.velocity = -5, 0
forcestand = 0
air.fall = 1
fall.recovertime = 43
fall.yvelocity = -2
id = 1020
getpower = Floor(12*Parent, FVar(3)), Floor(12*Parent, FVar(3))
givepower = 15, 15


