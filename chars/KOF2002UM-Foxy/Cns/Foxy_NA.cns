
;通常技のステート

;---------------------------------------------------------------------------
;▼近距離立ち弱パンチ▼
[Statedef 200]
type    = S                      
movetype= A                      
physics = S                                            
;Commonly-used controllers:
anim = 200
juggle = 0
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)

[State 200, 0] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 200, 1]
type = ChangeState
trigger1 = 1
value = StateNo +1
ctrl = 0


;---------------------------------------------------------------------------
;▼近距離立ち弱パンチ 攻撃▼

[Statedef 201]
type    = S                      
movetype= A                      
physics = S                                            
;Commonly-used controllers:
juggle = 0
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)

[State 201, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 3, 4)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 3, 4)

[State 201, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 5

[State 201, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 201, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = P2StateType = A
trigger1 = MoveHit = 1
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 201, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 201, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(200)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 200
value = 5910
ignorehitpause = 1
persistent = 0

[State 201, 6] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 201, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 201, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 200
value = 200

[State 201, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 201, 10] ;はっ！
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S10, 0 +(Random%3)
channel = 0

[State 201, 11] ;素振り音
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S0, 0

[State 201, 12]
type = HitDef
triggerall = !Var(8)
triggerall = !MoveContact && !MoveReversed
trigger1 = AnimElemTime(5) >= 0 && AnimElemTime(6) < 0
attr = S, NA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = Var(7), 0
animtype = Light                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = M                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MAF                    ;当てる事のできる条件
priority = 3, Hit                ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 7, 9                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
guard.pausetime = 7, 7	;リョウの弱攻撃硬直は強攻撃と同じ
sparkno = S4005                      ;ヒットエフェクトのスプライトステート（無ければ0）
sparkxy = -10, -90               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound = S5, 30                  ;ヒットした時の音（ｓ*,*にすると自分の音を使う）
guardsound = S6, 0                ;ガードした時の音（同上）
ground.type = High               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 9             ;相手が後にすべる時間
guard.slidetime = 9
ground.hittime = 9             ;コンボが繋がる時間（高くしすぎない事）
guard.hittime = 9
guard.ctrltime = 9
ground.cornerpush.veloff = 0
yaccel = 0.5
ground.velocity = -5             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
guard.velocity = -5
air.type = High                  ;空中で相手がくらった場所（上と同じ）
air.velocity = -3, -6.25           ;空中で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
airguard.velocity = -5, 0
air.hittime = 30                 ;空中でコンボが繋がる時間
fall.recovertime = 34
fall.yvelocity = -2
id = 200
nochainid = 9998, 9999
getpower = Floor(6*FVar(3)), Floor(6*FVar(3))
givepower = 15, 15

[State 201, 13]
type = StateTypeSet
trigger1 = AnimElemTime(6) >= 0
movetype = I

[State 201, 14]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


