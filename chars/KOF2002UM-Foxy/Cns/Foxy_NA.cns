name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 2601, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = MoveHit = 1
trigger1 = P2StateType = A
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 2601, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

