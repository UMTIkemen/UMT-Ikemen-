; CNS difficulty: easy
; 　    これはパンチが二回当たるようになっています。
;       攻撃を２回当てるには２個のHitDefを書く必要があります
;       一発目の攻撃のHitDefにはguardflagが「M」（middle＝中段ガード）
;       にセットされているので、相手は空中でガードできません。二発目
;       の攻撃のguardflagは「MA」（middle+air＝中段＋空中ガード）で、
;       地上、空中でもガードすることができます。
;       ちなみに一つに統合する事もできますが、内容を変えたい時はやはり２個書くのが
;       いいと思います
[Statedef 410]
type    = C
movetype= A
physics = C
juggle = 0
ctrl = 0
anim = 410
sprpriority = 2

[State 410, 0] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 410, 1]
type = ChangeState
trigger1 = 1
value = StateNo +1
ctrl = 0


;---------------------------------------------------------------------------
;▼しゃがみ強パンチ 攻撃▼

[Statedef 411]
type    = U
movetype= U
physics = U
juggle = 0
ctrl = 0
sprpriority = 2

[State 411, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 10, 12)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 10, 12)

[State 411, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 12

[State 411, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 411, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = MoveHit = 1
trigger1 = P2StateType = A
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 411, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 411, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(410)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 410
value = 5910
ignorehitpause = 1
persistent = 0

[State 411, 6] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 411, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 411, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 410
value = 410

[State 411, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 411, 10] ;いやぁ！
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S10, 3 +(Random%3)
channel = 0

[State 411, 11] ;素振り音
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S0, 0

[State 411, 12]
type = HitDef
triggerall = !Var(8)
triggerall = !MoveContact && !MoveReversed
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
attr = C, NA
damage = Var(7), 0
animtype = Medium
air.animtype = Medium
hitflag = MAF
guardflag = M
pausetime = 11, 13
guard.pausetime = 11, 11
sparkno = S4006
sparkxy = -10, IfElse(AnimElemTime(4) >= 0, -82, -50)
hitsound = S5, 31
guardsound = S6, 0
ground.type = Low
ground.slidetime = 17
guard.slidetime = 17
ground.hittime = 17
guard.hittime = 17
guard.ctrltime = 17
ground.velocity = -10
guard.velocity = -10
air.velocity = -3, -6.25
airguard.velocity = -5, 0
ground.cornerpush.veloff = 0
fall.recovertime = 38
fall.yvelocity = -2
yaccel = 0.5
id = 410
nochainid = 9998, 9999
getpower = Floor(14*FVar(3)), Floor(14*FVar(3))
givepower = 15, 15

[State 411, 13] ;剣閃
type = Helper
trigger1 = AnimElemTime(3) = 0
id = 4132
stateno = 4130
pos = 0, 0
postype = P1
helpertype = Normal
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 411, 14]
type = StateTypeSet
trigger1 = AnimElemTime(5) >= 0
movetype = I

[State 411, 15]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1


