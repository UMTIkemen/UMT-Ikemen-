trigger1 = Var(7) := IfElse(Var(18) = 0, 3, 4)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 3, 4)

[State 2601, 1] ;ガークラ基礎値
