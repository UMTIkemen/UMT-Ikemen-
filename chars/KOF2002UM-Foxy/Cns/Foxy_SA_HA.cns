;必殺技・超必殺技のステート


;===========================================================================
;---------------------------------------------------------------------------
;▼ユニコーンの角▼

[Statedef 1000]
type    = S
movetype= A
physics = S
juggle = 0
poweradd= Floor(0*FVar(3))
anim = 1000
ctrl = 0
sprpriority = 2
velset = 0, 0
facep2 = 1

[State 1000, 0] ;半数補正リセット
type = VarSet
trigger1 = 1
fvar(2) = 1

[State 1000, 1]
type = ChangeState
trigger1 = 1
value = StateNo +1
ctrl = 0


;---------------------------------------------------------------------------
;▼ユニコーンの角 攻撃▼

[Statedef 1001]
type    = U
movetype= U
physics = U
ctrl = 0
sprpriority = 2

[State 1001, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 0, 0)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 0, 0)

[State 1001, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 0

[State 1001, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 1001, 3] ;追撃不能
type = VarSet
triggerall = 0
triggerall = Var(57)%3 != 2
triggerall = P2StateType = A
trigger1 = MoveHit = 1
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 1001, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 1001, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(1000)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 1000
value = 5910
ignorehitpause = 1
persistent = 0

[State 1001, 6] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 1001, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 1001, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 1000
value = 1000

[State 1001, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 1001, 10]
type =  NotHitBy
trigger1 = AnimElemTime(3) < 0
trigger2 = Var(57) = [2, 4]
trigger2 = AnimElemTime(13) < 0
trigger3 = Var(57) = 5
value = , NA, SA, HA, NP, SP, HP
ignorehitpause = 1

[State 1001, 11] ;手元で光る飛び道具
type = Explod
trigger1 = AnimElemTime(11) = 0
anim = 4140
id = 4140
pos = 0, 0
postype = P1
removeongethit = 1
bindtime = -1
ownpal = 1
sprpriority = 3
supermovetime = 999999
pausemovetime = 999999

[State 1001, 12] ;攻撃判定
type = Helper
trigger1 = AnimElemTime(13) = 0
id = 1020
helpertype = Normal
name = "Unicorn"
stateno = 1020
pos = 0, -80
postype = P1
supermovetime = 0
pausemovetime = 0

[State 1001, 13]
type = StateTypeSet
trigger1 = AnimElemTime(13) >= 3
movetype = I

[State 1001, 14]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
;▼ユニコーンの角 どこキャン▼

[Statedef 1009]
type    = U
movetype= U
physics = U

[State 1009, 0] ;どこキャン処理（体光る）
type = PalFX
trigger1 = Time = 0
time = 7
add = 255, 255, 255

[State 1009, 1] ;どこキャン処理（残り時間減少）
type = VarAdd
trigger1 = Time = 0
var(15) = -150

[State 1009, 2]
type = ChangeState
trigger1 = Time = 0
value = 1000
ctrl = 0


