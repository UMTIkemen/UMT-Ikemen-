;---------------------------------------------------------------------------
;▼地上ふっ飛ばし攻撃 攻撃▼

[Statedef 2051]
type    = U                      
movetype= U                     
physics = U                                           
;Commonly-used controllers:
juggle = 0
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)

[State 2051, 0] ;ダメージ基礎値
type = Null
trigger1 = Var(57) = [0, 2]
trigger1 = Var(7) := IfElse(Var(18) = 0, 13, 14)
trigger2 = Var(57) = [3, 5]
trigger2 = Var(7) := IfElse(Var(18) = 0, 13, 14)

[State 2051, 1] ;ガークラ基礎値
type = Null
trigger1 = Var(27) := 17

[State 2051, 2] ;カウンター
type = Helper
triggerall = RoundState < 3
triggerall = Var(18)
triggerall = !(HitdefAttr = SCA, NT, ST, HT)
trigger1 = MoveHit = 1
id = 9990
helpertype = Normal
name = "Counter"
stateno = 8080
pos = 0, 0
postype = P1
ownpal = 0
supermovetime = 999999
pausemovetime = 999999
ignorehitpause = 1
persistent = 0

[State 2051, 3] ;追撃不能
type = VarSet
triggerall = Var(57)%3 != 2
triggerall = MoveHit = 1
trigger1 = P2StateType = A
var(8) = IfElse(Var(18) = 0, 1, Var(8))
ignorehitpause = 1
persistent = 0

[State 2051, 3]
type = TargetState
triggerall = NumTarget(2050)
trigger1 = MoveHit = 1
id = 2050
value = 6000 +(5*(Var(18) = 1))
ignorehitpause = 1
persistent = 0

[State 2051, 4] ;ガークラ計算
type = VarAdd
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = Var(27) > 0
trigger1 = MoveGuarded = 1
fvar(18) = IfElse((Var(27)*FVar(2)) > 2, (Var(27)*FVar(2)), 2) +40*(P2StateType = A)
ignorehitpause = 1
persistent = 0

[State 2051, 5] ;ガードクラッシュ
type = TargetState
triggerall = NumTarget(2050)
triggerall = Floor((Var(30)%2)/1) = 1
triggerall = FVar(18) >= 130
trigger1 = MoveGuarded = 1
id = 2050
value = 5910
ignorehitpause = 1
persistent = 0

[State 2051, 6] ;半数補正
type = VarSet
triggerall = 0 ;補正をかける場合はこの行をコメントアウト
trigger1 = MoveContact = 1
fvar(2) = FVar(2)*0.5
ignorehitpause = 1
persistent = 0

[State 2051, 7] ;ダメージ最終値
type = VarSet
trigger1 = Var(7) > 0
var(7) = Floor(IfElse((Var(7)*FVar(2)*FVar(1)*FVar(0)) > 8, (Var(7)*FVar(2)*FVar(1)*FVar(0)), 8))
ignorehitpause = 1

[State 2051, 8] ;アニメ固定
type = ChangeAnim
trigger1 = Anim != 2050
value = 2050

[State 2051, 9] ;攻撃判定リセット
type = ChangeState
triggerall = Time > 0
trigger1 = 0
value = StateNo
ctrl = 0

[State 2051, 10] ;えぇい！
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S10, 6
channel = 0

[State 2051, 11] ;素振り音
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = S0, 1

[State 2051, 12]
type = HitDef
triggerall = !Var(8)
triggerall = !MoveContact && !MoveReversed
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(6) < 0
