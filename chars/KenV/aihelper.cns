;helper(33000),var(1) ,记录对手判定出来后的经过时间
;helper(33000),var(2),是state号,读取对手当前招式的发生时间。
;helper(33000),var(3),时间，单位为F。读取对手当前招式的发生时间
;helper(33000),var(11) = 1下段，2中段，3投，4空防不能技，5防御不能技
;helper(33000),var(12),利用helper(33001)和helper(33002)来定位，决定是否靠近版边,helper(33000),var(12) = 0版中，1近版边且面对版边 -1后背靠近版边
;helper(33000),var(13),记录挨打前的动作。看哪些动作风险比较大。（当然被超反映凹那是没办法）会受p2stateno的影响
;helper(33000),var(14),记录上一次的攻击动作
;helper(33000),var(58),juggle计算
;helper(33000),var(57),双人战站位判断
;helper(33000),var(44),对手的helper数调查
;fvar(31),敌摩擦系数
;fvar(32),敌Y速度
;fvar(33),敌X速度
;fvar(34),敌后退滑行时间
;fvar(35),记录对手的防御硬直和受创硬直所剩时间
;fvar(36),敌重力加速度
;fvar(37),juggle flag
;helper(11000),var(51): Helper/Projectile alert
;helper(11000),var(52): Helper ID

;helper(11000),fvar(16): Helper dist x
;helper(11000),fvar(17): Helper dist y
;helper(11000),fvar(18): Helper vel x
;helper(11000),fvar(19): Helper vel y
;helper(11000),fvar(20): Projectile dist
;helper(11000),fvar(21): Projectile speed
[Statedef 33000]

[State 33000]
type=selfstate
trigger1=!ishelper
value=0

[State 33000]
Type = AssertSpecial
Trigger1 = IsHelper
flag = invisible

[State 33000]
type = nothitby
trigger1 = 1
value = sca


;めくりガード対応ヘルパー
[State 4444]
Type = PosSet
Trigger1 = 1
X = Ceil(EnemyNear,Pos X)-10*Facing
Y = Ceil(EnemyNear,Pos Y)
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[State 4444]
Type = Turn
Trigger1 = Facing = EnemyNear,Facing
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999



;juggle
[State -1, juggle计算 Reset]
type = VarSet
triggerall = Var(58) != root,Const(data.airjuggle)
triggerall = root,stateno !=3100&&root,stateno !=3400&&root,stateno !=3300
trigger1 = Enemynear,Movetype = A
trigger2 = Enemynear,Stateno < 200
trigger3 = (Enemynear,Stateno = 5120 && AnimTime = 0) || (Enemynear,Stateno = [5200,5220))
V = 58
value = root,Const(data.airjuggle)
IgNoreHitPause=1



[State -1, juggle-8]
type = VarAdd
triggerall = Root,Time>=1&&Var(58) >=8
Triggerall = Enemynear(Root,Var(56)),Statetype=A
Triggerall = Enemynear(Root,Var(56)),time=1
Triggerall = Enemynear(Root,Var(56)),gethitvar(fall)
trigger1 = root,stateno=1100||root,stateno=1101||root,stateno=1102
trigger1 = Root,hitcount=1&&Root,Movehit=1
V = 58
value = -8
IgnoreHitPause = 1

[State -1, juggle-7]
type = VarAdd
triggerall = Root,Time>=1&&Var(58) >=7
Triggerall = Enemynear(Root,Var(56)),time=1
trigger1 = root,stateno=1200||root,stateno=1220||root,stateno=2200||root,stateno=2210||root,stateno=2100
trigger1 = Root,hitcount=1&&Root,Movehit=1
trigger1 = Enemynear(Root,Var(56)),Statetype=A
trigger1 = Enemynear(Root,Var(56)),gethitvar(fall)
trigger2 = root,stateno=1300||root,stateno=1301||root,stateno=1302
trigger2 = Root,Movehit=1
trigger2 = Enemynear(Root,Var(56)),Statetype=A
trigger2 = Enemynear(Root,Var(56)),gethitvar(fall)
trigger3 = root,stateno=2300
trigger3 = Root,hitcount=1&&Root,Movehit=1
trigger3 = Enemynear(Root,Var(56)),Statetype=A||Enemynear(Root,Var(56)),Statetype=L
V = 58
value = -7
IgnoreHitPause = 1


[State -1, juggle-15]
type = null;VarAdd
triggerall = Root,Time>=1&&!root,var(15)
Triggerall = Root,Movehit=1
Triggerall = Enemynear(Root,Var(56)),Statetype=A
Triggerall = Enemynear(Root,Var(56)),time=1
Triggerall = Enemynear(Root,Var(56)),gethitvar(fall)
triggerall = Var(58) >=8
trigger1 = root,stateno =200||root,stateno =210||root,stateno =220||root,stateno =230||root,stateno =240||root,stateno =250||root,stateno =400||root,stateno =410||root,stateno =420||root,stateno =430||root,stateno =440||root,stateno =450
V = 58
value = -15
IgnoreHitPause = 1


[State -1, juggle-15]
type = Varset
triggerall = Root,Time>=1
Triggerall = Root,Movehit=1
Triggerall = Enemynear(Root,Var(56)),Statetype=A
Triggerall = Enemynear(Root,Var(56)),time=1
Triggerall = Enemynear(Root,Var(56)),gethitvar(fall)
trigger1 = (root,stateno =[800,850])
V = 58
value = 0
IgnoreHitPause = 1

;对多人战判定-------------------------
;1V1
[State -1,1:1]
type = VarSet
triggerall = var(57)>=0
triggerall = (root,teammode = simul && !partner,Alive&&root,numpartner)||(root,teammode != simul)
trigger1 = Enemy,teammode = single || Enemy,teammode = turns 
trigger2 = Enemy,teammode=simul
trigger2 = !Enemynear(0),Alive || !Enemynear(1),Alive
var(57) = 0

;2V1 同攻
[State -1,2:1T]
type = VarSet
triggerall = var(57)>=0
triggerall = root,numpartner
triggerall = root,teammode = simul && partner,Alive
trigger1 = Enemy,teammode = single || Enemy,teammode = turns 
trigger1 = root,facing=partner,facing
trigger2 = Enemy,teammode=simul
trigger2 = !Enemynear(0),Alive || !Enemynear(1),Alive
trigger2 = root,facing=partner,facing
var(57) = 1

;2V1 围攻
[State -1,2:1W]
type = VarSet
triggerall = var(57)>=0
triggerall = root,numpartner
triggerall = root,teammode = simul && partner,Alive
trigger1 = Enemy,teammode = single || Enemy,teammode = turns 
trigger1 = root,facing!=partner,facing
trigger2 = Enemy,teammode=simul
trigger2 = !Enemynear(0),Alive || !Enemynear(1),Alive
trigger2 = root,facing!=partner,facing
var(57) = 2



;2V2 同攻
[State -1,2:2T]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
triggerall = root,facing=partner,facing
trigger1 = Enemynear(0),facing=Enemynear(1),facing
var(57) = 3

;2V2 围攻
[State -1,2:2W]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
triggerall = root,facing!=partner,facing
trigger1 = root,facing=1
trigger1 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X>root,Pos X
trigger1 = Enemynear(0),Pos X<partner,Pos X && Enemynear(1),Pos X<partner,Pos X
trigger2 = root,facing=-1
trigger2 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X>root,Pos X
trigger2 = Enemynear(0),Pos X<partner,Pos X && Enemynear(1),Pos X<partner,Pos X
var(57) = 4

;2V2 2人被夹攻
[State -1,2:22B]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
trigger1 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X<root,Pos X&&Enemynear(0),Pos X>partner,Pos X && Enemynear(1),Pos X<partner,Pos X
trigger2 = Enemynear(0),Pos X<root,Pos X && Enemynear(1),Pos X>root,Pos X&&Enemynear(0),Pos X<partner,Pos X && Enemynear(1),Pos X>partner,Pos X
var(57) = 5

;2V2 队友被夹攻
[State -1,2:21B]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
trigger1 = Enemynear(0),Pos X>partner,Pos X && Enemynear(1),Pos X<partner,Pos X
trigger1 = Enemynear(0),Pos X<root,Pos X||Enemynear(1),Pos X>root,Pos X
trigger2 = Enemynear(0),Pos X<partner,Pos X && Enemynear(1),Pos X>partner,Pos X
trigger2 = Enemynear(0),Pos X>root,Pos X||Enemynear(1),Pos X<root,Pos X
var(57) = 6

;2V2 自己被夹攻
[State -1,2:21B]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
trigger1 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X<root,Pos X
trigger1 = Enemynear(0),Pos X<partner,Pos X||Enemynear(1),Pos X>partner,Pos X
trigger2 = Enemynear(0),Pos X<root,Pos X && Enemynear(1),Pos X>root,Pos X
trigger2 = Enemynear(0),Pos X>partner,Pos X||Enemynear(1),Pos X<partner,Pos X
var(57) = 7

;1V2 对面
[State -1,2:22D]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && !partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
trigger1 = root,facing=1
trigger1 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X>root,Pos X
trigger2 = root,facing=-1
trigger2 = Enemynear(0),Pos X<root,Pos X && Enemynear(1),Pos X<root,Pos X
var(57) = 8

;1V2 夹攻
[State -1,2:21J]
type = VarSet
triggerall = var(57)>=0
triggerall = root,teammode = simul && !partner,Alive
triggerall = Enemy,teammode=simul
triggerall = Enemynear(0),Alive && Enemynear(1),Alive
trigger1 = Enemynear(0),Pos X>root,Pos X && Enemynear(1),Pos X<root,Pos X
trigger2 = Enemynear(0),Pos X<root,Pos X && Enemynear(1),Pos X>root,Pos X
var(57) = 9

;对方压起身判定----------------------；
[State -1, 敌方压起身技能判定]
type = VarSet
trigger1 = root,statetype =L && var(45) = 0 && enemynear,AnimTime < -10 && !enemynear,ishelper
trigger1 = enemynear,stateno >= 200 && (p2bodydist X<80||enemynear,movetype=A)
var(45) = enemynear,stateno

[State -1, 起身后敌方技能判定]
type = VarSet
trigger1 = root,statetype !=L &&  root,prevstateno>=5000
trigger1 = enemynear,stateno = var(45)
trigger1 = (p2bodydist X<80||enemynear,movetype=A)&& !enemynear,ishelper
var(45) = enemynear,stateno

[State -1, 判定reset]
type = VarSet
trigger1 = enemynear,statetype =L || enemynear,movetype =H
trigger2 = enemynear,stateno < 200 || enemynear,ctrl
;trigger3 = var(45)>0 && enemynear,stateno!=var(45)
trigger3 = p2bodydist X>80
var(45) = 0



;对手的helper数调查
[state -1];初始化
type=varset
trigger1 = roundstate!=2
var(44)=9999
supermove = 1
ignorehitpause = 1
pausemovetime = 99999
supermovetime = 99999


[state -1];调查平时非攻击状态时的helper数
type=varset
var(44)=enemynear,numhelper
trigger1 = roundstate=2
trigger1 = enemynear,ctrl=1
trigger1 = var(44)>=enemynear,numhelper
trigger2 = enemynear,movetype != A
trigger2 = root,inguarddist = 0
trigger2 = (enemynear,stateno =[5000,5999]) || enemynear,stateno = [50,200)
trigger2 = root,stateno != [120,162]
trigger2 = root,stateno != [5000,5300]
trigger2 = root,movetype != H
trigger2 = root,hitpausetime = 0 && enemynear,hitpausetime = 0
ignorehitpause = 1



[State -1, Border]
type = VarSet
triggerall = var(12) != 1
trigger1 = root,Facing!=Helper(33001),Facing && helper(33001),rootdist x <= 150
trigger2 = root,Facing!=Helper(33002),Facing && helper(33002),rootdist x <= 150
var(12) = 1

[State -1, Border]
type = VarSet
triggerall = var(12) != -1
trigger1 = root,Facing = Helper(33001),Facing && helper(33001),rootdist x <= 150
trigger2 = root,Facing = Helper(33002),Facing && helper(33002),rootdist x <= 150
var(12) = -1

[State -1, Border]
type = VarSet
triggerall = var(12) != 0
trigger2 = var(12) = 1
trigger1 = helper(33001),rootdist x > 150
trigger1 = helper(33002),rootdist x > 150
trigger2 = var(12) = - 1
trigger2 = helper(33001),rootdist x > 150 && helper(33002),rootdist x > 150
var(12) = 0

[State -1, 直前行動]
type = VarSet
trigger1 = root,movetype = H
trigger1 = root,prevstateno != [5000,5799]
trigger1 = root,prevstateno != [120,159]
var(13) = root,prevstateno

[State -1, 直前行動]
type = VarSet
trigger1 = root,movetype = A 
var(14) = root,stateno

[State -1, Preview State]
