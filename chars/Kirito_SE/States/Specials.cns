;----------------------------------------------------------------------
;Horizontal Square
[Statedef 1000]
type = S
movetype = A
physics = N
ctrl = 0
velset = 0,0
poweradd = 72 * !var(20)
sprpriority = 1
facep2 = 1

[State 1000, Sword Style]
type = VarSet
