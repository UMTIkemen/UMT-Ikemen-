;=========================< カイザーウェイブ >=========================
[Statedef 3000]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 3000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
trigger1 = time = 0
v = 1
value = (helper(9999),var(22) >= helper(9999),var(21))

[State 3000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(44) = 3000,0,1)

;--- 超必殺技演出 ---
[State 3000, SuperPause]
type = superpause
trigger1 = time = 1
time = 28
movetime = 28
darken = 0
anim = -1
p2defmul = 1

[State 3000, Super Helper]
type = helper
trigger1 = time = 1
helpertype = normal
name = "Super Helper"
ownpal = 1
stateno = 7000
ID = 7000
postype = p1
pos = 0,-105
pausemovetime = 999999
supermovetime = 999999

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && fvar(2) = 0
value = -1000

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && fvar(2)
fv = 2
value = 0

;--- 無敵 ---
[State 3000, Invincible]
type = nothitby
trigger1 = animelemtime(4) < 0
value = SCA
ignorehitpause = 1

;---- スーパーキャンセル ---
[State 3000, VarSet]
type = varset
trigger1 = time = 0
v = 13
value = 0

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && prevstateno = [1000,1999]
v = 13
value = 1

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && var(13) = 1
value = -1000

[State 3000, PalFx]
type = palfx
trigger1 = (time = [0,15]) && time%2 = 0
trigger1 = var(13) = 1
time = 1
add = 256,256,256

;--- 効果音 ---
[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
value = s3000,0
channel = 0

[State 3000, Sound]
type = playsnd
trigger1 = animelem = 4
value = s3005,0
channel = 2

;--- エフェクト ---
[State 3000, Effect Helper]
type = helper
trigger1 = animelem = 4
helpertype = normal
name = "KaiserWave Effect"
ownpal = 1
stateno = 3005
ID = 3005
postype = p1
pos = 0,0
supermovetime = 28

;--- 溜め時間 ---
[State 3000, ChargeTimeVar]
type = varset
trigger1 = time = 0
v = 40
value = 0

[State 3000, ChargeTimeVar]
type = varadd
trigger1 = animelemtime(4) >= 0
v = 40
value = 1

[State 3000, ChargeTimeVar]
type = varset
trigger1 = time = 0
v = 41
value = 0

[State 3000, ChargeTimeVar]
type = varset
trigger1 = var(40) = [30,59]
v = 41
value = 1

[State 3000, ChargeTimeVar]
type = varset
trigger1 = var(40) = [60,89]
v = 41
value = 2

;--- ステート変更 ---
[State 3000, ChangeState]
type = changestate
triggerall = animelemtime(4) >= 0
triggerall = (var(40) >= 4 && var(1) = 0) || (var(40) >= 8 && var(1) = 1)
trigger1 = command != "holdx" && command != "holdy"
trigger2 = var(40) >= 90
trigger3 = var(59) > 0
value = 3010

