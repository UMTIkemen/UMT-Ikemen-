pos = 0,0

;--- アニメ ---
[State 3005, ChangeAnim]
type = changeanim
trigger1 = anim != 3006
trigger1 = parent,var(41) = 1
value = 3006

[State 3005, ChangeAnim]
type = changeanim
trigger1 = anim != 3007
trigger1 = parent,var(41) = 2
value = 3007

;--- 消滅 ---
[State 3005, DestroySelf]
type = destroyself
trigger1 = parent,stateno != 3000

