;--- 浮かせ ---
[State 16000, TargetState]
type = targetstate
triggerall = numtarget(1600)
triggerall = var(9) = 1
triggerall = movehit = 1
trigger1 = animelemtime(6) < 0
ID = 1600+((var(29) := 1600)*0)
value = 5640
ignorehitpause = 1

[State 1600, TargetState]
type = targetstate
triggerall = numtarget(1301)
triggerall = var(9) = 1
triggerall = movehit = 1 && p2statetype = A
trigger1 = animelemtime(6) >= 0
ID = 1301+((var(29) := 1301)*0)
value = 5640
ignorehitpause = 1

;--- 着地 ---
[State 1600, End]
type = changestate
triggerall = animelemtime(6) >= 0
trigger1 = vel y > 0 && pos y >= 0
value = 1110
