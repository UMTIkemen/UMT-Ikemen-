[State 10000, Gauge Bar]
type = varset
trigger1 = time = 0
v = 30
value = 0

;--- パワーゲージ移動 ---
;x座標
[State 10000, Gauge Bar]
type = varset
trigger1 = time = 0
v = 31
value = 16
; value = (16)画面端からのドット距離
; デフォルト16

;y座標
[State 10000, Gauge Bar]
type = varset
trigger1 = time = 0
v = 32
value = 8
; value = (8)画面下からのドット距離
; デフォルト8

[State 10000, ChangeState]
type = destroyself
trigger1 = ishelper(8000) && var(30) = 0

[State 10000, ChangeState]
type = changestate
trigger1 = ishelper(8000)
value = 8000

;--- 画面端検出
[State 30000]
type=velset
trigger1=time = 0
x = ifelse(teamside = 1,10,-10)


[State 30000];画面にとらわれない
type=ScreenBound
trigger1=1
value=0
movecamera=0,0

[State 30000];判定用飛び道具射出
type=Projectile
trigger1=time=0
projID=10000
projanim=9999
velocity=ifelse(teamside = 1,10,-10), 0;へルパーの初期速度と同じに
projpriority=4
projsprpriority=2
projstagebound=0;0がオススメ
projedgebound=99999
offset=0, 0
postype=p1
supermovetime=99999
pausemovetime=99999
projremovetime=-1

[State -2];不可視化＆影消し。
type=null;assertspecial
trigger1=1
flag=noshadow
flag2=invisible
ignorehitpause=1

[State -2];飛び道具が消えたら停止。
type=posadd
trigger1=!(root,numprojID(10000))
x=ifelse(teamside = 1,-9,9)
persistent = 0

[State -2];飛び道具が消えたら停止。
type=velset
trigger1=!(root,numprojID(10000))
x=ifelse(teamside = 1,1,-1)
persistent = 0

[State 30000];判定用飛び道具射出
type=Projectile
trigger1=!(root,numprojID(10000))
projID=10001
projanim=9999
velocity=ifelse(teamside = 1,1,-1), 0;へルパーの初期速度と同じに
projpriority=4
projsprpriority=2
projstagebound=0;0がオススメ
projedgebound=99999
offset=0, 0
postype=p1
supermovetime=99999
pausemovetime=99999
projremovetime=-1
persistent = 0

[State -2];飛び道具が消えたら停止。
type=velset
trigger1=!(root,numprojID(10000))
trigger1=!(root,numprojID(10001));ヘルパーが出したprojectileも本体管理になるので、「root,」を忘れないように
x=0
[State -2];飛び道具が消えたら停止。
type=varset
trigger1=1
fv = 39
value = -rootdist x*facing


