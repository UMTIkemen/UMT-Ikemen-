;=========================< config >=========================
[Statedef 5900]
type = S

;--- 変数リセット ---
[State 5900, VarRangeSet]
type = varrangeset
trigger1 = roundsexisted = 0
value = 0

[State 5900, VarRangeSet]
type = varrangeset
trigger1 = roundsexisted = 0
fvalue = 0

;以上はいじらない
;以下設定項目

;--- モード ---
;設定方法
;trigger1 = root,palno = (1)←パレット番号
;trigger1 = var(49) := (0)←ここに入力
; 0で表モード(闇払い) (Normal Mode)
; 1で裏モード(荒咬み) (EX Mode)

[State 10000, Style]
type = null
triggerall = roundsexisted = 0
triggerall = time = 0
trigger1 = palno = 1
trigger1 = var(49) := 0
trigger2 = palno = 2
trigger2 = var(49) := 0
trigger3 = palno = 3
trigger3 = var(49) := 0
trigger4 = palno = 4
trigger4 = var(49) := 0
trigger5 = palno = 5
trigger5 = var(49) := 0
trigger6 = palno = 6
trigger6 = var(49) := 0
trigger7 = palno = 7
trigger7 = var(49) := 1
trigger8 = palno = 8
trigger8 = var(49) := 1
trigger9 = palno = 9
trigger9 = var(49) := 1
trigger10 = palno = 10
trigger10 = var(49) := 1
trigger11 = palno = 11
trigger11 = var(49) := 1
trigger12 = palno = 12
trigger12 = var(49) := 1

;デフォルト
;1~6P 表
;7~12P 裏

;--- 先行入力受付時間 必殺技 ---
[State 10000, Precede Input Time]
type = varset
trigger1 = time = 0
v = 32
value = 6
; value = フレーム数
; デフォルト6

;--- 先行入力 受付時間 超必殺技 ---
[State 10000, Precede Input Time]
type = varset
trigger1 = time = 0
v = 33
value = 12
; value = フレーム数
; デフォルト12

;--- 地上技・超必殺技空中ガード ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 34
value = 0
; 0で不能、その他で可能
; デフォルト0

;--- 空中技・飛び道具空中ガード ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 35
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 空中ガード可否 ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 36
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 画面点滅 ---
[State 10000, Flash]
type = varset
trigger1 = time = 0
v = 37
value = 1
; 0で点滅しない、1で点滅
; デフォルト1


;★マークまではいじらない

;--- モード判定 ---
[State -2, VarSet]
type = varset
trigger1 = 1;var(15) != 1
v = 15
value = 0

;--- パワーMAXゲージ x座標 ---
[State 10000, Power MAX Gauge Pos X]
type = varset
trigger1 = time = 0
v = 30
value = 0
;value = の数だけ移動

;--- パワーMAXゲージ y座標 ---
[State 10000, Power MAX Gauge Pos Y]
type = varset
trigger1 = time = 0
v = 31
value = 0
; value = の数だけ移動

[State 10000, Power MAX Gauge Pos Y]
type = varset
trigger1 = var(18) = 1
trigger1 = ID < partner,ID
trigger1 = time = 0
v = 31
value = -10
; パートナーが同製作者時


;--- イントロ ---
[State 5900, ChangeState]
type = changeState
trigger1 = roundsexisted = 0
trigger2 = enemy,teammode = turns
value = 190


;=========================< コンフィグ >=========================
[Statedef 10000]
type=A
movetype=I
physics=N
anim = 9999
ctrl = 0
;velset = 10,0

;★以下設定項目

;--- AIレベル ---
;AI常時起動
[State 10000, AI]
type = varset
trigger1 = time = 0
var(50) = 0
ignorehitpause = 1
; 0で通常時
; 1で常時on
; -1で常時off
; デフォルト0

;コンボレベル
[State 10000, Combo Level]
type = parentvarset
trigger1 = 1;root,var(59) > 0
var(51) = 2
ignorehitpause = 1
;from 1 to 3
;デフォルト2
;1 簡単なもののみ
;2 できるだけ多彩に 多少火力は劣る
;3 ダメージ優先

;ガードレベル
[State 10000, Guard Level]
type = parentvarset
trigger1 = root,var(59) > 0
var(52) = 8
ignorehitpause = 1
;0から10
;from 0 to 10
;デフォルト8
;毎Fレベルの二乗%でガード

;反応レベル
[State 10000, AI Level]
type = parentvarset
trigger1 = root,var(59) > 0
var(53) = 8
ignorehitpause = 1
;0から10
;from 0 to 10
;デフォルト8

;行動確率
[State 10000, Frequency Level]
type = parentvarset
trigger1 = root,var(59) > 0 || var(50) > 0
var(59) = 10
ignorehitpause = 1
;0から1
;from 0 to 10
;デフォルト10


;--- ゲージ増加倍率 ---
[State 10000, Air Guard]
type = parentvarset
trigger1 = 1
fv = 4
value = 1.25                  *root,fvar(0)
; 攻撃ヒット時、必殺技使用時のゲージ増加量
; デフォルト1.25


;--- 相手燃焼時Pal ---
;リセット ※弄らない
[State 10000, Reset]
type = null
trigger1 = parent,var(26) >= 0
trigger1 = var(26) := -1
trigger2 = parent,var(27) >= 0
trigger2 = var(26) := -1
trigger3 = parent,var(28) >= 0
trigger3 = var(26) := -1


;設定方法
;trigger1 = root,palno = (1)←パレット番号
;trigger1 = var(26) := (30) || var(27) := (150) || var(28) := (210)
;　　　　　　　 　 R(赤)↑            G(緑)↑             B(青)↑


;燃焼
[State 10000, Fire]
type = null
triggerall = 1
trigger1 = root,palno = 1
trigger1 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger2 = root,palno = 2
trigger2 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger3 = root,palno = 3
trigger3 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger4 = root,palno = 4
trigger4 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger5 = root,palno = 5
trigger5 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger6 = root,palno = 6
trigger6 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger7 = root,palno = 7
trigger7 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger8 = root,palno = 8
trigger8 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger9 = root,palno = 9
trigger9 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger10 = root,palno = 10
trigger10 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger11 = root,palno = 11
trigger11 = var(26) := 240 || var(27) := 150 || var(28) := 60
trigger12 = root,palno = 12
trigger12 = var(26) := 240 || var(27) := 150 || var(28) := 60


