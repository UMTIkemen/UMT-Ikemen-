;=========================< config >=========================
[Statedef 5900]
type = S

;--- 変数リセット ---
[State 5900, VarRangeSet]
type = varrangeset
trigger1 = roundsexisted = 0
value = 0

[State 5900, VarRangeSet]
type = varrangeset
trigger1 = roundsexisted = 0
fvalue = 0

;以上はいじらない
;以下設定項目

;--- モード ---
;設定方法
;trigger1 = root,palno = (1)←パレット番号
;trigger1 = var(30) := (0)←ここに入力
; 0で表モード (Normal Mode)
; 1で裏モード (EX Mode)

[State 10000, Style]
type = null
triggerall = roundsexisted = 0
triggerall = time = 0
trigger1 = palno = 1
trigger1 = var(49) := 0
trigger2 = palno = 2
trigger2 = var(49) := 0
trigger3 = palno = 3
trigger3 = var(49) := 0
trigger4 = palno = 4
trigger4 = var(49) := 0
trigger5 = palno = 5
trigger5 = var(49) := 0
trigger6 = palno = 6
trigger6 = var(49) := 0
trigger7 = palno = 7
trigger7 = var(49) := 1
trigger8 = palno = 8
trigger8 = var(49) := 1
trigger9 = palno = 9
trigger9 = var(49) := 1
trigger10 = palno = 10
trigger10 = var(49) := 1
trigger11 = palno = 11
trigger11 = var(49) := 1
trigger12 = palno = 12
trigger12 = var(49) := 1

;デフォルト
;1~6P 表
;7~12P 裏

;--- 先行入力受付時間 必殺技 ---
[State 10000, Precede Input Time]
type = varset
trigger1 = time = 0
v = 32
value = 6
; value = フレーム数
; デフォルト6

;--- 先行入力 受付時間 超必殺技 ---
[State 10000, Precede Input Time]
type = varset
trigger1 = time = 0
v = 33
value = 12
; value = フレーム数
; デフォルト12

;--- 地上技・超必殺技空中ガード ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 34
value = 0
; 0で不能、その他で可能
; デフォルト0

;--- 空中技・飛び道具空中ガード ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 35
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 空中ガード可否 ---
[State 10000, Air Guard]
type = varset
trigger1 = time = 0
v = 36
value = 1
; 0で不能、その他で可能
; デフォルト1

;--- 画面点滅 ---
[State 10000, Flash]
type = varset
trigger1 = time = 0
v = 37
value = 1
; 0で点滅しない、1で点滅
; デフォルト1



