v = 30
value = 0
;value = の数だけ移動

;--- パワーMAXゲージ y座標 ---
[State 10000, Power MAX Gauge Pos Y]
type = varset
trigger1 = time = 0
v = 31
value = 0
; value = の数だけ移動

[State 10000, Power MAX Gauge Pos Y]
type = varset
trigger1 = var(18) = 1
trigger1 = ID < partner,ID
trigger1 = time = 0
v = 31
value = -10
; パートナーが同製作者時

;--- イントロ ---
[State 5900, ChangeState]
