;=========================< 常時監視-2 >=========================
[Statedef -2]

;--- デバッグ ---
[State -2, Clipboard]
type = displaytoclipboard
trigger1 = 1
text = "AI = %d Chain = %d Attack = %f Combo = %f Cancel = %d \n"
params = var(59),var(0),fvar(3),fvar(0),(var(10) || var(11) || var(12))
ignorehitpause = 1

[State -2, Clipboard]
type = appendtoclipboard
trigger1 = 1
text =  "Life = %d Power = %d P2X = %f P2Y = %f \n"
params = life,power,p2bodydist x,p2dist y
ignorehitpause = 1

;--- 喰らい判定 ---
[State -2, NoJuggleCheck]
type = assertspecial
trigger1 = 1
flag = nojugglecheck
ignorehitpause = 1

[State -2, Chain Var]
type = varset
triggerall = var(0)
trigger1 = p2movetype != H
trigger2 = p2statetype = L
v = 0
value = 0

[State -2, HitDef]
type = hitdef
trigger1 = var(0) = 1
attr = S,NA
hitflag = 

;--- ヒット硬直時間 ---
[State -2, HitPause Var]
type = varadd
trigger1 = movecontact = 1
v = 9
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movecontact != 1
v = 9
value = 0
ignorehitpause = 1

;--- ヒット判定 ---
[State -2, HitPause Var]
type = varset
trigger1 = movecontact = 1
trigger2 = movereversed = 1
v = 14
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movetype = I
trigger2 = !movecontact && !movereversed
v = 14
value = 0
ignorehitpause = 1

;--- イントロ用変数 ---
;リセット
[State -2, VarSet]
type = varset
trigger1 = var(2)
trigger1 = roundstate <= 2
v = 2
value = 0

;VS 庵
[State -2, VarSet]
type = varset
triggerall = var(2) != 1
trigger1 = p2name = "Iori" || p4name = "Iori"
trigger2 = p2name = "Yagami Iori" || p4name = "Yagami Iori"
trigger3 = p2name = "YagamiIori" || p4name = "YagamiIori"
trigger4 = p2name = "Iori Yagami" || p4name = "Iori Yagami"
trigger5 = p2name = "IoriYagami" || p4name = "IoriYagami"
trigger6 = p2name = "ioriXI" || p4name = "ioriXI"; 別府氏 XI仕様
trigger7 = p2name = "iorinbc" || p4name = "iorinbc"; 別府氏 NBC仕様
trigger8 = p2name = "cvsiori" || p4name = "cvsiori"; H”氏 CVS2仕様
trigger9 = p2name = "Yagami-AKOF" || p4name = "Yagami-AKOF"; jin氏 AKOF八神
trigger10 = p2name = "d-Yagami" || p4name = "d-Yagami"; jin氏 力を失った八神
trigger11 = p2name = "F-Iori Yagami" || p4name = "F-Iori d-Yagami"; Vans氏 02UM爪庵
v = 2
value = 1

;VS 暴走庵
[State -2, VarSet]
