;--- 最終決戦神技 ---
[State -2, ChangeState]
type = ChangeState
triggerall = numpartner
triggerall = var(17) = 25 || var(17) = 125
triggerall = partner,stateno = 4620 && partner,time >= 18
triggerall = statetype != A
trigger1 = ctrl || stateno = 100 || (stateno = [120,139])
trigger2 = var(11) = 1
value = 4601

;--- コンボ補正 ---
[State -2, Combo Var]
type = varset
trigger1 = p2movetype != H
fv = 0
value = 1

[State -2, Combo Var]
type = varadd
triggerall = p2movetype = H
triggerall = stateno != 800
triggerall = stateno != 850
triggerall = stateno != 2121
triggerall = stateno != 1180
triggerall = stateno != [1700,1799]
triggerall = !(stateno = 2750 && var(15) = 3 && var(49) = 2)
triggerall = stateno != [4000,4099]
triggerall = stateno != [4500,4559]
triggerall = stateno != [4700,4799]
trigger1 = movehit = 1
fv = 0
value = -0.05

[State -2, Combo Var]
type = varset
trigger1 = stateno = [4000,4999]
trigger1 = !((stateno = [4400,4499]) && var(15) = 3 && var(49) = 0)
trigger1 = !((stateno = [4700,4799]) && var(15) = 3 && var(49) = 0)
trigger1 = fvar(0) < 0.5
fv = 0
value = 0.5

[State -2, Combo Var]
type = varset
triggerall = fvar(0) < 0.4
trigger1 = stateno = [3000,3999]
trigger2 = ((stateno = [4400,4499]) && var(15) = 3 && var(49) = 0)
trigger3 = ((stateno = [4700,4799]) && var(15) = 3 && var(49) = 0)
fv = 0
value = 0.4

[State -2, Combo Var]
type = varset
trigger1 = fvar(0) < 0.2
fv = 0
value = 0.2

;--- パワーMAX ---
[State -2, PowerMAX Var]
type = varadd
trigger1 = sysfvar(2) = 0
trigger1 = fvar(2)
fv = 2
value = -1

[State -2, PowerMAX Var]
type = varset
trigger1 = fvar(2) <= 0
trigger2 = !alive
trigger3 = roundstate < 2
fv = 2
value = 0

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 1 && fvar(2)
trigger1 = movetype != H
time = 1
add = 80,80,60
ignorehitpause = 1

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 2 && fvar(2)
trigger1 = movetype != H
time = 1
add = 40,40,30
ignorehitpause = 1

[State -2, Helper]
type = helper
trigger1 = !numhelper(8000)
trigger1 = roundstate = 2
trigger1 = helper(10001),var(30)
helpertype = normal
name = "Power MAX Gauge"
ownpal = 1
stateno = 10000
ID = 8000
postype = back
pos = 0,0
facing = 1
supermovetime = 999999
pausemovetime = 999999

;--- カウンター ---
[State -2, Counter Var]
type = varset
trigger1 = var(3) = 0 && p2movetype = A
v = 3
value = 2

[State -2, Counter Var]
type = varadd
trigger1 = var(3) && p2movetype != A
v = 3
value = -1

[State -2, Counter Var]
type = varset
trigger1 = var(3) < 0
v = 3
value = 0

[State -2, Counter Helper]
type = helper
triggerall = var(3)
triggerall = var(9) = 1
triggerall = p2movetype = H && numtarget
triggerall = stateno != [3200,3299]
trigger1 = movehit = 1
helpertype = normal
name = "Counter Helper"
size.xscale = 0.5
size.yscale = 0.5
stateno = 7100
ID = 7100
postype = left
pos = 10,-100
pausemovetime = 2147483647
supermovetime = 2147483647
ignorehitpause = 1

;--- 基本攻撃力 ---
[State -2, Attack Var]
type = varset
trigger1 = 1
fv = 3
value = 1

;パワーMAX
[State -2, Attack Var]
type = varset
trigger1 = fvar(2)
fv = 3
value = fvar(3)*1.2

;カウンター
[State -2, Attack Var]
type = varset
trigger1 = var(3)
fv = 3
value = fvar(3)*1.2


;ダウン追撃
[State -2, Attack Var]
type = VarSet
trigger1 = p2movetype = H
trigger1 = p2statetype = L || enemynear,gethitvar(fallcount) > 0 || var(25)
fv = 3
value = 0.67*fvar(3)/(enemynear,const(data.fall.defence_mul)**(enemynear,gethitvar(fallcount)))

;--- スロー処理 ---
[State -2, Slow]
type = pause
triggerall = roundstate = 2
trigger1 = var(4) && (time%2) = 0
