x = 6
y = -10

[State 1050, VelMul]
type = velmul
trigger1 = animelemtime(4) >= 0
x = 0.85

[State 1050, VelAdd]
type = veladd
trigger1 = animelemtime(4) >= 0
y = 0.5

;--- 無敵 ---
[State 1050, Invincible]
type = nothitby
trigger1 = animelemtime(4) < 0
value = SCA
ignorehitpause = 1

;--- 空中判定 ---
[State 1050, StateTypeSet]
type = statetypeset
trigger1 = animelem = 4
statetype = A

;--- 半数補正 ---
[State 1050, ComboVar]
type = varset
trigger1 = time = 0
fv = 5
value = 1

[State 1050, ComboVar]
type = varset
trigger1 = movecontact = 1
fv = 5
value = fvar(5)/2

[State 1050, ComboVar]
type = varset
trigger1 = fvar(5) < 0.125
fv = 5
value = 0.125

;--- ヒット判定リセット ---
[State 1050, VarSet]
type = varset
trigger1 = animelem = 3 || animelem = 4 || animelem = 5 || animelem = 6
trigger2 = animelem = 7 || animelem = 8 || animelem = 9 || animelem = 10
v = 14
value = 0

;--- ガードポイント ---
[State 1050, ReversalDef]
type = reversaldef
triggerall = p2movetype != H
trigger1 = animelemno(0) = 2
reversal.attr = SCA,AA,AP
affectteam = E
pausetime = 12,12
getpower = floor(100*(fvar(2) = 0)*fvar(4)),floor(100*(fvar(2) = 0)*fvar(4))
hitsound = s6120,0
sparkno = s6120
