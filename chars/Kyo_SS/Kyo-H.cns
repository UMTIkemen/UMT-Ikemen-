;=========================< 裏百八式・大蛇薙 >=========================
[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0,0
ctrl = 0
anim = 3000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 3000, Command Var]
type = varset
triggerall = var(59) <= 0
trigger1 = time = 0
v = 1
value = helper(9999),var(30) >= helper(9999),var(29)

[State 3000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(43) = 3000,0,1)

[State 3000, ChangeAnim]
type = changeanim
trigger1 = time = 0
value = ifelse(var(1) = 0,3000,3001)

;--- 超必殺技演出 ---
[State 3000, SuperPause]
type = superpause
trigger1 = time = 1
time = 28
movetime = 28
darken = 0
anim = -1
p2defmul = 1

[State 3000, Super Helper]
type = helper
trigger1 = time = 1
helpertype = normal
name = "Super Helper"
ownpal = 1
stateno = 7000
ID = 7000
postype = p1
pos = 25,-115
pausemovetime = 999999
supermovetime = 999999

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && fvar(2) = 0
value = -1000

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && fvar(2)
fv = 2
value = 0

;---- スーパーキャンセル ---
[State 3000, VarSet]
type = varset
trigger1 = time = 0
v = 13
value = 0

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && prevstateno = [1000,2999]
trigger1 = prevstateno != 2960
v = 13
value = 1

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && var(13) = 1
value = -1000

[State 3000, PalFx]
type = palfx
trigger1 = (time = [0,15]) && time%2 = 0
trigger1 = var(13) = 1
time = 1
add = 256,256,256

;--- 効果音 ---
[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
trigger1 = (var(15) = 3 && var(49) = 3)
value = s3500,0
channel = 0

[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
trigger1 = !(var(15) = 3 && var(49) = 3)
value = s3000,0
channel = 0

;--- エフェクト ---
[State 3000, Effect Helper]
type = helper
trigger1 = animelem = 1
helpertype = normal
name = "Effect"
ownpal = 1
stateno = 193
ID = 193
postype = p1
pos = 0,0
pausemovetime = 999999
supermovetime = 999999

;--- 無敵 ---
[State 3000, Invincible]
type = nothitby
trigger1 = animelemtime(11) < 0
value = SCA
ignorehitpause = 1

;--- 溜め時間 ---
[State 3000, ChargeTimeVar]
type = varset
trigger1 = time = 0
v = 40
value = 0

[State 3000, ChargeTimeVar]
type = varadd
trigger1 = animelemtime(11) >= 0
v = 40
value = 1

;--- ステート変更 ---
[State 3000, ChangeState]
type = changestate
triggerall = animelemtime(11) >= 0
trigger1 = command != "holdx" && command != "holdy" && command != "holdz"
trigger2 = var(40) > 120
trigger3 = var(59) > 0
value = 3010

;---------------------------------------------------------------------
; 裏百八式･大蛇薙 攻撃
[Statedef 3010]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 3010
sprpriority = 2

;--- 効果音 ---
[State 3010, Voice]
type = playsnd
trigger1 = animelem = 5
trigger1 = (var(15) = 3 && var(49) = 3)
value = s3500,1
channel = 0

[State 3010, Voice]
type = playsnd
trigger1 = animelem = 5
trigger1 = !(var(15) = 3 && var(49) = 3)
value = s3010,0
channel = 0

[State 3010, Sound]
type = playsnd
trigger1 = animelem = 6
value = s3015,0

;--- 速度 ---
[State 3010, VelSet]
type = velset
trigger1 = animelem = 5
x = 12

[State 3010, VelSet]
type = velset
trigger1 = animelem = 9
x = 0

[State 3010, VelMul]
type = velmul
trigger1 = animelemtime(5) >= 0 && animelemtime(9) < 0
x = 0.9

;--- エフェクト ---
[State 3010, Explod]
type = explod
trigger1 = animelem = 5
ID = 3015
pos = 0,0
postype = p1
bindtime = -1
removeongethit = 1
anim = 3015
shadow = -1
ownpal = 1
sprpriority = 5
ignorehitpause = 1

;--- 飛び道具 ---
[State 3010, Projectile Helper]
type = helper
trigger1 = animelem = 6
helpertype = normal
name = "OrochiNagi Projectile"
ownpal = 1
stateno = 3020
ID = 3020
postype = p1
pos = 70,-60

;--- 攻撃判定消滅 ---
[State 3010, StateTypeSet]
type = statetypeset
trigger1 = animelem = 8
movetype = I

;--- 終了 ---
[State 3010, ChangeState]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

