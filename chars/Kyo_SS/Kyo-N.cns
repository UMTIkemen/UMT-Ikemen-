;=========================< 外式・霞 >=========================
[Statedef 330]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 330
facep2 = 1
sprpriority = 2

;--- キャンセル版判定 ---
[State 330, VarSet]
type = varset
trigger1 = time = 0
v = 1
value = 0

[State 330, VarSet]
type = varset
trigger1 = prevstateno = [200,699]
v = 1
value = 1

[State 330, ChangeAnim]
type = null;changeanim
trigger1 = time = 0
value = ifelse(var(1) = 0,330,331)

;--- 効果音 ---
[State 330, Voice]
type = playsnd
trigger1 = animelem = 1
value = s330,0
channel = 0

;--- 座標 ---
[State 330, PosAdd]
type = posadd
trigger1 = animelem = 1
x = 5

[State 330, PosAdd]
type = posadd
trigger1 = animelem = 2
x = 10

[State 330, PosAdd]
type = posadd
trigger1 = animelem = 5
x = -5

[State 330, PosAdd]
type = posadd
trigger1 = animtime = 0
x = -10

;--- 無敵 ---
[State 330, HitBy]
type = hitby
trigger1 = var(1) = 0
trigger1 = animelemtime(5) < 0
value = SCA,AT
time = 1
ignorehitpause = 1

;--- 接触判定 ---
[State 330, PlayerPush]
type = playerpush
trigger1 = var(1) = 0
value = 0

;--- 追加 ---
[State 330, ChangeState]
type = varset
trigger1 = time = 0
v = 40
value = 0

[State 330, ChangeState]
type = varset
triggerall = var(59) <= 0
triggerall = sysfvar(2) = 0
triggerall = roundstate = 2
triggerall = animelemtime(2) > 0
trigger1 = helper(9999),fvar(7) > 0 || helper(9999),fvar(13) > 0
trigger2 = helper(9999),fvar(9) > 0 || helper(9999),fvar(15) > 0
v = 40
value = 1

[State 1300, ChangeState]
type = changestate
trigger1 = roundstate = 2
trigger1 = animelemtime(3) > 0
trigger1 = var(40)
trigger2 = animelem = 2 && var(1) = 1
value = 331

;--- 終了 ---
[State 330, ChangeState]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

