;--- ヒットエフェクト ---
[State 1000, Sound]
type = playsnd
trigger1 = numtarget
trigger1 = var(9) = 1
trigger1 = movehit = 1
value = s6080,0
ignorehitpause = 1

[State 1000, Explod Helper]
type = helper
trigger1 = numtarget
trigger1 = var(9) = 1
trigger1 = movehit = 1
helpertype = normal
name = "Fire"
ownpal = 1
stateno = 6080
ID = 6080
postype = p2
pos = 0,-50
ignorehitpause = 1

[State 1000, Explod Helper]
type = helper
triggerall = !numhelper(6081)
trigger1 = numtarget(1000)
trigger1 = 1+((var(29) := 1000)*0)
trigger1 = movehit = 1
helpertype = normal
name = "Fire"
ownpal = 1
stateno = 6081
ID = 6081
postype = p2
pos = 0,0
ignorehitpause = 1

;--- 攻撃判定消滅 ---
[State 1000, StateTypeSet]
type = statetypeset
trigger1 = animelem = 7
movetype = I

;--- 追撃判定 ---
[State 1000, Chain Var]
type = varset
triggerall = numtarget
triggerall = var(3) = 0
triggerall = var(9) = 1
triggerall = movehit = 1 || (moveguarded = 1 && target,statetype = A)
trigger1 = var(1) = 0
trigger2 = var(1) = 1
trigger2 = animelemno(0) = [4,6]
v = 0
value = 1
ignorehitpause = 1

;--- 着地 ---
[State 1000, End]
type = changestate
triggerall = animelemtime(4) >= 0
trigger1 = vel y > 0 && pos y >= 0
value = 1010

