;=========================< 百式・鬼焼き >=========================
[Statedef 1000]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 1000
poweradd = floor(50*(fvar(2) = 0)*fvar(4))
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 1000, Command Var]
type = varset
triggerall = var(59) <= 0
trigger1 = time = 0
v = 1
value = (helper(9999),var(4) >= helper(9999),var(3))

[State 1000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(43) = 1000,0,1)

[State 1000, ChangeAnim]
type = changeanim
trigger1 = time = 0
value = ifelse(var(1) = 0,1000,1001)

;--- 効果音 ---
[State 1000, Voice]
type = playsnd
trigger1 = animelem = 1
value = s1000,0
channel = 0

[State 1000, Sound]
type = playsnd
trigger1 = animelem = 4
value = s1005,0

;--- エフェクト ---
[State 1000, Explod]
type = explod
trigger1 = animelem = 4
ID = 1005
pos = 0,0
postype = p1
removeongethit = 1
anim = 1005
shadow = -1
ownpal = 1
sprpriority = 5
ignorehitpause = 1
persistent = 0

[State 1000, Explod]
type = explod
trigger1 = animelem = 7
ID = 1006
pos = 0,0
postype = p1
removeongethit = 1
anim = 1006
shadow = -1
ownpal = 1
sprpriority = 5
ignorehitpause = 1
persistent = 0

;--- 座標 ---
[State 1000, PosAdd]
type = posadd
trigger1 = animelem = 2
x = 5

[State 1000, PosAdd]
type = posadd
trigger1 = animelem = 3 || animelem = 4
x = 10

;--- 速度 ---
[State 1000, VelSet]
type = velset
trigger1 = animelem = 4
x = ifelse(var(1) = 0,4,6)
y = ifelse(var(1) = 0,-7,-9)

[State 1000, VelMul]
type = velmul
trigger1 = animelemtime(4) >= 0
x = 0.85

[State 1000, VelAdd]
type = veladd
trigger1 = animelemtime(4) >= 0
y = 0.5

;--- 無敵 ---
[State 1000, Invincible]
type = nothitby
trigger1 = animelemtime(3) < 0 && var(1) = 0
trigger2 = animelemtime(4) < 0 && var(1) = 1
value = SCA
ignorehitpause = 1

;--- 空中判定 ---
[State 1000, StateTypeSet]
type = statetypeset
trigger1 = animelem = 4
statetype = A

;--- 半数補正 ---
[State 1000, ComboVar]
type = varset
trigger1 = time = 0
fv = 5
value = 1

[State 1000, ComboVar]
type = varset
trigger1 = movecontact = 1
fv = 5
value = fvar(5)/2

[State 1000, ComboVar]
type = varset
trigger1 = fvar(5) < 0.125
fv = 5
value = 0.125

;--- ヒット判定リセット ---
[State 1000, VarSet]
type = varset
trigger1 = animelem = 4
v = 14
value = 0

;--- 攻撃判定 ---
[State 1000, HitDef]
type = hitdef
triggerall = var(0) = 0
triggerall = var(1) = 0
triggerall = var(14) = 0
triggerall = var(34) = 0
trigger1 = animelemno(0) = 3
attr = S,SA
hitflag = MAF
guardflag = M
affectteam = E
priority = 4,Hit
animtype = Up
ground.type = High
damage = floor(80*fvar(0)*fvar(3)),10
getpower = floor(100*(fvar(2) = 0)*fvar(4)*fvar(5)),floor(100*(fvar(2) = 0)*fvar(4)*fvar(5))
givepower = 20,20
pausetime = 12,12
hitsound = s6010,0
guardsound = s6120,0
sparkno = s6020+(fvar(2) > 0)
guard.sparkno = s6120
sparkxy = -15,-70
ground.hittime = 18
ground.slidetime = 18
ground.velocity = -2,-12
ground.cornerpush.veloff = 0
air.hittime = 18
air.velocity = -2,-12
guard.hittime = 16
guard.slidetime = 16
guard.velocity = -6
airguard.ctrltime = 999999
airguard.velocity = -4.5,0
yaccel = 0.6
fall = 1
fall.recover = 0
fall.yvelocity = -3.5
palfx.time = 55
palfx.add = floor(var(26)),floor(var(27)),floor(var(28))
palfx.mul = floor(var(26)),floor(var(27)),floor(var(28))
palfx.sinadd = floor(var(26)/2),floor(var(27)/2),floor(var(28)/2),30
