trigger1 = anim = 130
x = 0

;--- 切り替え --
[State 130, Hi to Lo]
type = changestate
triggerall = anim = 130
trigger1 = var(59) <= 0
trigger1 = helper(9999),fvar(3) > 0
trigger2 = var(59) > 0
trigger2 = enemynear,statetype = C
trigger2 = random <= var(59)*20 || var(59) > 9
trigger3 = var(59) > 0
trigger3 = enemynear,time = 1
trigger3 = enemynear,statetype = S
trigger3 = random < 500
