trigger1 = anim = 5 && animelem = 1

[State 130, ChangeAnim]
type = changeanim
trigger1 = anim = 5 && animtime = 0
value = 21

;--- しゃがみ ---
[State 130, ChangeState]
type = changestate
triggerall = anim = 5 || anim = 21
trigger1 = var(59) <= 0
trigger1 = helper(9999),fvar(3) > 0
value = 10
ctrl = 1

;--- 終了 ---
[State 130, ChangeState]
