triggerall = anim = 130
trigger1 = var(59) <= 0
trigger1 = helper(9999),fvar(0) > 0 || helper(9999),fvar(1) <= 0
trigger2 = !inguarddist
trigger3 = var(59) = [1,9]
trigger3 = p2bodydist x < 0
trigger3 = random <= (10-var(59))*40
value = 140

