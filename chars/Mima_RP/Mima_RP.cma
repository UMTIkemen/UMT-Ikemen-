;---------------------------------------------------------------------------
; 2. State entry
; --------------
; Don't remove the following line. It's required by the CMD standard.
[Statedef -1]
[State -1, Negative Edge] ;- Reset // Release // Hold
type = null
trigger1 = var(40)&4032
trigger1 = (var(40):=0)||1
trigger2 = var(40)
trigger2 = (var(40):=var(40) +64*(var(40)&1 && command != "holda") +128*(var(40)&2 && command != "holdb") +256*(var(40)&4 && command != "holdc") +512*(var(40)&8 && command != "holdx") +1024*(var(40)&16 && command != "holdy") +2048*(var(40)&32 && command != "holdz")) - var(40)
trigger3 = var(40):=var(40)-(var(40)&63) + 1*(command = "holda") + 2*(command = "holdb") + 4*(command = "holdc") + 8*(command = "holdx") + 16*(command = "holdy") + 32*(command = "holdz")

[State -1, Tick Fix]
type = CtrlSet
triggerall = !ctrl
trigger1 = (stateno=52 || stateno=101 || stateno=5120 || stateno=5201) && !animtime
trigger2 = ((stateno=[200,299]) || (stateno=[400,499])) && !animtime
trigger3 = (stateno=800 || stateno=810 || stateno=1001 || stateno=2001) && !animtime
trigger4 = ((stateno=1000 && statetype!=A) || (stateno=1100 && statetype!=A) || (stateno=1200 && statetype!=A)) && !animtime 
trigger5 = ((stateno=1201 && statetype!=A) || (stateno=1300 && statetype!=A) || (stateno=2000 && statetype!=A)) && !animtime
trigger6 = ((stateno=2010 && statetype!=A) || (stateno=2100 && statetype!=A) || (stateno=4000 && statetype!=A)) && !animtime 
trigger7 = ((stateno=4002 && statetype!=A) || (stateno=4101 && statetype!=A)) && !animtime 
trigger8 = (stateno=5001 || stateno=5011 || stateno=151 || stateno=153) && hitover
trigger9 = stateno=301
trigger10 = stateno=300 && anim=41 && animelemtime(2)=1
value = 1

[State -1, Flight Mode Tick Fix]
type = CtrlSet
triggerall = !ctrl
triggerall = statetype=A && var(24)>0
trigger1 = ((stateno=600 && animelemtime(8)=0) || (stateno=610 && animelemtime(9)=0) || (stateno=620 && animelemtime(9)=0))
trigger2 = ((stateno=820 && animelemtime(10)=0) || (stateno=830 && animelemtime(11)=0))
trigger3 = ((stateno=1000 && animelemtime(20)=0) || (stateno=1100 && animelemtime(12)=0) || (stateno=1200 && animtime=0))
trigger4 = ((stateno=1201 && animtime=0) || (stateno=1300 && animelemtime(16)=0) || (stateno=2000 && animelemtime(16)=0))
trigger5 = ((stateno=2010 && animelemtime(27)=0) || (stateno=2100 && animelemtime(11)=0) || (stateno=2101 && animtime=0))
trigger6 = ((stateno=4000 && animelemtime(12)=0) || (stateno=4002 && animelemtime(10)=0) || (stateno=4101 && animelemtime(20)=0))
value = 1

[State -1, Hello Training I have ctrl please cease your 1f buggery]
type = Null
triggerall = numenemy
triggerall = enemy,numhelper(20000)
triggerall = enemy,name="Training"
trigger1 = ctrl && enemy,cond(numhelper(20000),helper(20000),cond(1,var(31)>0,0),0)
trigger1 = enemy,cond(numhelper(20000),helper(20000),cond(1,var(31):=0,0),0)||1
ignorehitpause = 1

;===========================================================================
[State -1, Combo condition Reset]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=0
trigger1 = !ctrl
var(1) = 0
ignorehitpause = 1

[State -1, Combo condition Check]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=1
trigger1 = movetype != A
trigger1 = ctrl
trigger2 = ((stateno=[200,299]) || (stateno=[400,499]) || (stateno=[600,699])) && movecontact
trigger3 = stateno = 1001 || (stateno = 1000 && animelemtime(8)>=0)
trigger4 = stateno = 1100 && movecontact
trigger5 = stateno = 1300 && animelemtime(6)>=2
var(1) = 1
ignorehitpause = 1

;===========================================================================
;///////////////////////////////////////////////////////////////////////////
;===========================================================================
; CPU Controls
;===========================================================================
;///////////////////////////////////////////////////////////////////////////
;===========================================================================
[State -1, Jump Back AI]
type = changestate
value = 1
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,3])
; AI SHIT GOES HERE:
trigger1 = var(58)=1
trigger1 = (var(58):=0)||1

[State -1, Jump Fwd AI]
type = changestate
value = 2
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,3])
; AI SHIT GOES HERE:
trigger1 = var(58)=2
trigger1 = (var(58):=0)||1

[State -1, Jump Neutral AI]
type = changestate
value = 3
triggerall = AILevel > 0
triggerall = roundstate=2 && statetype != A
triggerall = ctrl && stateno != 40 && (stateno != [1,3])
; AI SHIT GOES HERE:
trigger1 = var(58)=3
trigger1 = (var(58):=0)||1

[State -1, Guard]
type = changestate
value = 120
triggerall = numenemy
triggerall = !(stateno = [2000,4200])
trigger1 = var(58) > 0
trigger1 = roundstate=2
trigger1 = inguarddist
trigger1 = ctrl || (stateno = [100,106])
trigger1 = (stateno!=[120,155])
trigger1 = !(enemynear,hitdefattr=SCA,AT) && (enemynear,time<120)
trigger1 = (random%100) < ifelse((p2stateno=[200,699]),49,ifelse((p2stateno=[1000,2999]),49,100))

[State -1, Recover AI] ;Recover near ground (use ChangeState)
type = SelfState
triggerall = !(stateno = [2000,4200])
triggerall = stateno = 5050 ;movetype = H
triggerall = time >= 10
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = var(58) > 0
trigger1 = (random%100) <= 24
value = 5200 ;HITFALL_RECOVER

