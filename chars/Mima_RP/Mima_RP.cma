;-| Button Remapping |-----------------------------------------------------
; If the following lines are NOT preceded by semicolons, please
; add them or remove the remap entirely since Ricepigeon is a
; lazy bastard who forgets to remove it before releasing stuff
; *facepalms*
;[Remap]
;x = x
;y = y
;z = b;z
;a = s;a
;b = a;b
;c = c
;s = z

;-| Default Values |-------------------------------------------------------
[Defaults]
; Default value for the "time" parameter of a Command. Minimum 1.
command.time = 15
; Default value for the "buffer.time" parameter of a Command. Minimum 1,
; maximum 30.
command.buffer.time = 1

