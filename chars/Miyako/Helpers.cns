;-----------------------------------------------------------------------------
;Prevent 220 Loop
[Statedef 2200]
type     = A
movetype = I
physics  = N
ctrl     = 0
anim     = 9999
sprpriority = 1

[state 3061, 0]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible

[State 3061, 0 DestroySelf]
type = DestroySelf
trigger1 = p2movetype != H

;--------------------------------------------------------------------------
;Custom (zoom)
[Statedef 2902]
type    = A
movetype= A
physics = N
anim = 9741
ctrl = 0
sprpriority = 1

[State Zoom control]
type = varadd
trigger1 = time <= 5
fvar(0) = 0.05

[State Zoom control]
type = varadd
trigger1 = time >= 30
fvar(0) = -0.05

[State 0]
type = posset
trigger1 = time = 0
y = 0

[State Zoom control]
Type = EnvShake
trigger1 = time = 0
Time  = 30
Ampl  = 3
Freq  = 90

[State Zoom state]
type = Zoom
trigger1 = 1
pos = pos x/2,0
scale = 1+fvar(0)
ignorehitpause = 1

[State 0]
type = destroyself
trigger1 = time = 35

;---------------------------------------------------------------------------
;Helper: Camera
[Statedef 1820]
type = S
physics = S
anim = 9741
ctrl = 0

[state 1820]
type = turn
trigger1 = ishelper(1820)
trigger1 = facing!=root,facing
ignorehitpause = 1

[State 1820]
type = VelSet
trigger1 = parent,pos X > 0
x = ifelse(facing = 1,4,-4)
[State 1820]
type = VelSet
trigger1 = parent,pos X < 0
x = ifelse(facing = 1,-4,4)
[State 1820]
type = VelSet
trigger1 = parent,pos X = [-5,5]
x = 0

[State 1820]
type = Width
trigger1 = 1
value = 1,1

[State 1820]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 320,0

[State 1820]
type = PlayerPush
trigger1 = 1
value = 0

[State 6001, Destroyself]
type = destroyself
trigger1 = Time = 50
trigger1 = enemy, Life >= 1
trigger2 = numhelper(1820)>= 2

;========================<COUNTER F.X.>=============================
[Statedef 7400]
type = A
physics = N
anim = 9999

[State 7400, Flash]
type = bgpalfx
trigger1 = !time
time = 8
add = 255, 255, 255
sinadd = -255, -255, -255, 32

[State Zoom control]
type = varadd
trigger1 = 1
trigger1 = time <= 8
fvar(0) = 0.075
[State Zoom control]
type = varadd
trigger1 = 1
trigger1 = time >= 8
fvar(0) = -0.075

[State 3007,]
type = Helper
trigger1 = !numhelper(8985)
helpertype = Normal
name = "Zoom"
stateno = 2902
ID = 2902
pos = 15,-105
postype = p2
facing = 1
keyctrl = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
persistent = 0

[State 7400, slow]
type = pause
trigger1 = time < 8
time = 2
endcmdbuftime = 1

[State 7400, End]
type = destroyself
trigger1 = time >= 8
