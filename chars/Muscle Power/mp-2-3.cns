[State -2, varset]
type = varset
trigger1 = 1
fvar(1) = ceil(1000*enemy,life/enemy,const(data.life))*(1+((numpartner=0)&&(enemy,numpartner=1)))

[State -2, varset]
type = varset
trigger1 = 1
fvar(2) = ceil(1000*life/const(data.life))*(1+((numpartner=1)&&(enemy,numpartner=0)))

[State -2, varset]
type = varset
trigger1 = 1
fvar(3) = 1 + (fvar(1)-fvar(2))*0.00025

[State -2, varset]
type = varset
trigger1 = 1
fvar(4) = ifelse(var(41)=100,1.05,1)*ifelse(p2Life < 250,.75,ifelse(p2Life < 500,.875,1))

[State -2, 1]
