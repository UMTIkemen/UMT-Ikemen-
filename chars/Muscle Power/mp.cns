movetype = H
physics = N
ctrl = 0
facep2 = 1
velset = 0,0

[State 7500, ChangeAnim2]
type = ChangeAnim
trigger1 = Time = 0
value = 5001+(statetype=C)*20

[State 7500, ChangeAnim2]
type = ChangeAnim
trigger1 = anim = 5001 || anim = 5021
trigger1 = Time < 10
value = 5001+(statetype=C)*20

[State 7500, ChangeAnim2]
type = ChangeAnim
trigger1 = anim = 5001 || anim = 5021
trigger1 = animtime = 0
value = anim+5

[State 7500, ChangeAnim]
type = ChangeAnim
triggerall = Time = 0
