;-------
;The Spawning clone
;Basing on Buyog's Main Men Lobo super
[State -2, SetCloneTimer]
type = VarAdd
triggerall = (IsHelper) && (StateNo != 6203) && (RoundState = 2)
trigger1 = Var(12) = [0,300]
trigger2 = (GameTime % 1) = 0
v = 12
value = 1

;Thanks XGargoyle ;)
[State -2, CloneTurn] ;the helper will face the enemy
type = Turn
triggerall = ishelper(6200)
trigger1 = helper(6200), pos Y = 0
trigger1 = helper(6200),facing = enemy,facing

[State -2, CloneTimeout]
type = ChangeState
triggerall = IsHelper
trigger1 = numhelper(6200) > 2
trigger2 = (Var(12) >= 300); && (StateType != A)
;trigger3 = roundstate > 2
trigger3 = stateno = 6000 || stateno = 6100 || stateno = 6300
value = 6203

;-------
;Chaos Dimension grab
[State -2, chd]
type = VarAdd
trigger1 = var(13) > 0
v = 13
value = -1

[State -2, palFX]
type = PalFX
triggerall = var(13) > 0
trigger1 = TimeMod = 2,0
ignorehitpause = 1
time = 1
mul = 125,125,125
invertall = 1

