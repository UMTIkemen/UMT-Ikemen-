; Player information
[Info]
name = "Michelle Heart Redux"        ;Name of character
displayname = "Michelle Heart" ;Name of character to display
versiondate = 11,17,2018    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Gladiacloud, Beximus & Shinzankuro"         ;Character author name
pal.defaults = 1            ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height



; Files for the player
[Files]
cmd     = michelle heart.cmd           ;Command set
cns     = michelle heart.cns           ;Constants
st      = michelle heart.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = michelle heart.sff           ;Sprite
anim    = michelle heart.air           ;Animation
sound   = michelle heart.snd           ;Sound
st1 = misc.cns
st2 = override.cns
st3 = engine.cns
st4 = VS_engine.cns

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
x2 = 7 ;Hold Start and press button X for palette 7, etc.
y2 = 8
z2 = 9
a2 = 10
b2 = 11
c2 = 12
