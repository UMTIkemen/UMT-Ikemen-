movetype= h
physics = n

[state 6102, 1]
type = changeanim
trigger1 = animtime = 0
trigger1 = anim = 5035
trigger2 = time = 0
trigger2 = anim != 5035
trigger2 = (anim != [5051, 5059]) && (anim != [5061, 5069])
trigger2 = anim != 5090
value = 5050

[state 6102, 3]
type = veladd
trigger1 = 1
y = .42;gethitvar(yaccel)

[state 6102, 4]
type = selfstate
triggerall = alive = 1
trigger1 = (time = 15) || (vel y >= 0)
value = 5040

[state 6102, 4]
type = selfstate
triggerall = alive = 0
trigger1 = (time = 15) || (vel y >= 0)
value = 5050

[state 6102, 5]
type = selfstate
trigger1 = vel y > 0
trigger1 = pos y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100





