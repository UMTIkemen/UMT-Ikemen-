; var(43) - Play Anim / Time Offset
; Statedef -2 Variable Height (Estimated)

[data]
life = 960 ;1150
attack = 100
defence = 110
power = 3000
fall.defence_up = 50
liedown.time = 20
airjuggle = 15
sparkno = 2
guard.sparkno = 40
ko.echo = 0
volume = 0
IntPersistIndex = 58
FloatPersistIndex = 40

[size]
xscale = .8333333333333333333333333333333333
yscale = 1 ;1.06      
ground.back = 19
ground.front = 19    
air.back = 12        
air.front = 12       
height = 60
attack.dist = 400   
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -5, -78   
mid.pos = 0, -47   
shadowoffset = 0     
draw.offset = 0,0    

[velocity]
walk.fwd  = 2.3      
walk.back = -2.2    
run.fwd  = 8, 0    
run.back = -8,-3.8 ;
jump.neu = 0,-8.8    
jump.back = -4,-9.4   
jump.fwd = 3.8,-9.4    
runjump.back = -2.55,-8.1 
runjump.fwd = 6,-8.1      
airjump.neu = 0,-8.8      
airjump.back = -3.55      
airjump.fwd = 3.5         

[movement]
airjump.num = 0    
airjump.height = 35  
yaccel = .45      
stand.friction = .89 
crouch.friction = .82 
;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).


;---------------------------------------------------------------------------
; stand
[statedef 0]
type = s
physics = s
velset = 0,0
sprpriority = 0

[state 0, 1]
type = changeanim
trigger1 = anim != 0 && anim != 5
trigger2 = anim = 5 && animtime = 0 ;turn anim over
value = 0

[state 0, 3] ;stop moving if low velocity or 4 ticks pass
type = velset
trigger1 = abs(vel x) < 2
trigger2 = time = 4
x = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 22
trigger2 = animelem = 49
value = S5,0

;---------------------------------------------------------------------------
; stand to crouch
[statedef 10]
type    = c
physics = c
anim = 10

[State 10, changestate 1]
type = ChangeState
triggerall = var(53)= 2
trigger1 = partner,command != "holddown"
value = 0

[state 10, 1]
type = velmul
trigger1 = time = 0
x = .75

[state 10, 1]
type = velset
trigger1 = time = 0
y = 0

[state 10, 2]
type = changestate
trigger1 = animtime = 0
value = 11

;---------------------------------------------------------------------------
; crouching
[statedef 11]
type    = c
physics = c
anim = 11
sprpriority = 0

[State 0, 4] 
type = Turn
triggerall = var(53)=2
trigger1 = P2Dist X <0

[state 10, 1]
type = velset
trigger1 = time = 0
y = 0
x = 0

[state 11, 1] ;
type = changeanim
trigger1 = anim = 6 && animtime = 0
value = 11

[State 11, 1] 
type = CtrlSet
triggerall = var(53)=2
trigger1 = time = 0
value = 0

