;----------------------------------------------------------------------------
; Fire
[Statedef 2001]
type     = S
movetype = A
physics  = N
velset = 0,0
sprpriority = 3

[State 0, ParentVarAdd]
type = ParentVarAdd
triggerall = MoveHit = 1
trigger1 = P2StateType = A
var(19) = 7

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = 1001

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S1000,0

[State 1001, 1]
type = HitDef
triggerall = root,Var(19) <= 55
trigger1 = movecontact = 0 && movereversed = 0
attr = S, SP                     ;Attribute: Standing, Normal Attack
damage = 55, 11                   ;Damage that move inflicts, guard damage
animtype = Medium                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 4, 6                 ;Time attacker pauses, time opponent shakes
guard.pausetime = 4,4
sparkno = -1                      ;Spark anim no (Def: set above)
sparkxy = 0, 0               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = s1000, 1                  ;Sound to play on hit
guard.sparkno = s8003
guardsound = s6, 0                ;Sound to play on guard
ground.type = Low               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 22
ground.hittime = 22
guard.hittime = 18
ground.velocity = -11.5,0
guard.velocity = -9.5
air.type = Low
air.velocity = -6.5,-3.8
airguard.velocity = -3.5, -3.8
air.hittime = 30
getpower = 0,0
air.fall = 1
fall.recover = 1
fall.recovertime = 120
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
envshake.time = 8
envshake.ampl = 6
yaccel = .6
palfx.time = 30
palfx.add = 240,50,0
palfx.mul = 250,224,120
palfx.sinadd = 110,55,85,10
palfx.invertall = 0
palfx.color = 0
p2stateno = cond((p2statetype != A), 1015, 1016)

[State 1015, Vulnerability]
type = HitBy
trigger1 = 1
value = SCA, AP
time = -1
ignorehitpause = 1

[State 1015, Hit Override]
type = HitOverride
trigger1 = 1
attr = SCA, AP
stateno = 1002
time = -1
ignorehitpause = 1

[State -2, Damage Dampener]; Helper set
type= attackmulset
trigger1 = 1
value= 1.0*ifelse(root,fvar(10),0.63,1)
ignorehitpause= 1
persistent = 0

[State 9000, Screen Shake]
type = EnvShake
trigger1 = !Time
time = 4
ampl = 4
freq = 100

[State 5100, 8]
type = Explod
trigger1 = Time = 1
anim = 6122
pos = 0, 0
under = 1
ownpal = 1

[State 12501, Explod]
type = Explod
triggerall = NumTarget
trigger1 = movehit = 1
anim = 3003
pos = 0,0
postype = p2  ;p2,front,back,left,right
bindtime = -1
sprpriority = 3
ownpal = 1

[State 0, ChangeState]
type = ChangeState
trigger1 = !AnimTime
value = 1002

