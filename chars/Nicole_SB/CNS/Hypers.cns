; Toasty
[StateDef 3003]
type     = A
movetype = H
physics  = N
ctrl     = 0
velset   = 0,0

[State 4008, Set Velocity]
type = VelSet
trigger1 = !time
x = -5
y = -9

[State 4008, Increment Velocity]
type = VelAdd
trigger1 = 1
y = 0.5

; If the opponent supports the burnt and/or MK toasty standards
[State 4006, Change Animation]
type = ChangeAnim2
trigger1 = !selfanimexist(7697) && !selfanimexist(9108120)
value = 5050

; If the opponent supports the MK toasty standard
[State 4006, Change Animation]
type = ChangeAnim
trigger1 = selfanimexist(9108120) && anim != 7697 && anim != 9108120
value = 9108120

; If the opponent supports the burnt standard
[State 4006, Change Animation]
type = ChangeAnim
trigger1 = selfanimexist(7697) && anim != 7697 && anim != 9108120
value = 7697

[State 4008, Self State]
type = SelfState
trigger1 = pos y + vel y > 0
value = 5100

