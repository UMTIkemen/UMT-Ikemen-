; Nicole's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; これはKFMの定数と状態のファイルです。
; このファイルの中には注釈が散らされているので、CNSを習いたいお方は
; 読んでみたらいいです。

[Data]
;Amount of life to start with
;体力ゲージの初期値
life = 1000
;attack power (more is stronger)
;攻撃ダメージ
attack = 100
;defensive power (more is stronger)
;体力パワー
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 9
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 255
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 12     ;Player width (back, ground)
ground.front = 12    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 55      ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -3, -78   ;Approximate position of head
mid.pos = 0, -28    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.25
walk.back = -3.5
run.fwd  = 6,0
run.back = -6.5,0
jump.neu = 0,-10
jump.back = -4
jump.fwd = 4
runjump.back = -6,-8.1 
runjump.fwd = 6,-14      
airjump.neu = 0,-8.6      
airjump.back = -3.4      
airjump.fwd = 3.6
air.gethit.groundrecover = -.15,-3.5  
air.gethit.airrecover.mul = .6,.3     
air.gethit.airrecover.add = 0,-4.5    
air.gethit.airrecover.back = -1       
air.gethit.airrecover.fwd = 0         
air.gethit.airrecover.up = -2         
air.gethit.airrecover.down = 1.5 

[Movement]
airjump.num = 0
airjump.height = 50   
yaccel = 0.48          
stand.friction = 0.85  
crouch.friction = 0.82 
stand.friction.threshold = 4          
crouch.friction.threshold = 3       
air.gethit.groundlevel = 25           
air.gethit.groundrecover.ground.threshold = -20 
air.gethit.groundrecover.groundlevel = 10   
air.gethit.airrecover.threshold = -1  
air.gethit.airrecover.yaccel = .35    
air.gethit.trip.groundlevel = 0
down.bounce.offset = 0,0
down.bounce.yaccel = 0.8
down.bounce.groundlevel = 12
down.friction.threshold = .05

;---------------------------------------------------------------------------
; English
[Quotes]
victory1 = "Anger dosen't begin to cover it!"
victory2 = "You see, sometimes in life you really have to face the consequences of your action, and sometimes you just RUN!"
victory3 = "I feel so relaxed!"
victory4 = "I feel so proud of her... yet really scared at the same time."
victory5 = "Five minutes is all I'll need."

;-------------------------------------------------------------------------------
; Character-specific
; Sunset Shimmer
victory10 = "Do not play with fire, or else you'll cause a huge fire!"
; Applejack
victory11 = "You'r wrestling skill needs improvement... did you only learn by playing their video games?"
; El Chavo
victory12 = "I'm surprised that you being a poor kid, you have potential for a martial artist."
; Akko Kagari
victory13 = "You'r magic is interesting, but doesn't impress a lot, so you may improve..."
; Herself
victory14 = "Not another copycat..."
; Kan'u Unchou
victory15 = "I don't get it, if you have a dragon inside, how come you don't spit fire instead of using that pipe sword thing?"
; Shim
victory16 = "You don't look much like a demon, instead a guy who escaped from an asylum..."
; Diana Cavendish
victory17 = "I'm impressed by your magic skills... can you teach some to Richard?"
; I won't make these two, but still had to write for them
; Gumball Watterson
victory18 = "Don't worry, Gummypuss..."
; Darwin Watterson
victory19 = "Okay but, would you please stop ruining my life with your friend? It kinda makes me angry."

