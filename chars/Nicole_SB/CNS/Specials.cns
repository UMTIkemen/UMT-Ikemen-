;-------------------------------------------------------------------------
; Target (1015)
[StateDef 1015]
type = U
movetype = H
physics = U
ctrl = 0
velset = 0, 0
sprpriority = 0

[State 1020, Change State]
type = ChangeState
trigger1 = !alive
value = 1016

[State 1020, Change Animation]
type = ChangeAnim
trigger1 = time
value = cond((statetype = C), 5020 + gethitvar(animtype), 5000 + gethitvar(animtype) + ((gethitvar(groundtype) - 1) * 10))
persistent = 0

[State 1020, Set State Type]
type = StateTypeSet
trigger1 = anim = [5020, 5029]
physics = C

[State 1020, Set State Type]
type = StateTypeSet
trigger1 = anim != [5020, 5029]
physics = S

; If the opponent doesn't have a burn animation
[State 1020, Change Animation]
type = ChangeAnim
trigger1 = !selfanimexist(7697) && hitshakeover
value = cond((statetype = C), 5025 + gethitvar(animtype), 5005 + gethitvar(animtype) + ((gethitvar(groundtype) - 1) * 10))
persistent = 0

; If the opponent has a burn animation
[State 1020, Change Animation]
type = ChangeAnim2
trigger1 = selfanimexist(7697) && hitshakeover
value = 7697
persistent = 0

[State 1020, Change Animation]
type = ChangeAnim
trigger1 = anim = 7697 && gethitvar(hittime) < 8
value = cond((statetype = C), 5025, 5005 + ((gethitvar(groundtype) - 1) * 10))
persistent = 0

[State 1020, Set Velocity]
type = VelSet
trigger1 = hitshakeover
x = facing * gethitvar(xvel)
persistent = 0

[State 1020, Set Velocity]
type = VelSet
trigger1 = hitover
x = 0

[State 1020, Set Defence Multiplier]
type = DefenceMulSet
trigger1 = hitover
value = 1

[State 1020, Change State]
type = SelfState
trigger1 = hitover
value = cond((statetype = C), 11, 0)
ctrl = 1

