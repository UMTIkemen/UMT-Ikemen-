type = A
movetype = H
physics = N
ctrl = 0
velset = 0, 0
sprpriority = 0

[State 1021, Change Animation]
type = ChangeAnim
trigger1 = !time
value = 5030

; If the opponent doesn't have a burn animation
[State 1021, Change Animation]
type = ChangeAnim
trigger1 = !selfanimexist(7697) && hitshakeover
value = 5050
persistent = 0

; If the opponent has a burn animation
[State 1021, Change Animation]
type = ChangeAnim
trigger1 = selfanimexist(7697) && hitshakeover
value = 7697
persistent = 0

[State 1021, Set Position]
type = PosSet
trigger1 = !hitshakeover && pos y >= 0
y = -1

[State 1021, Set Velocity]
type = VelSet
trigger1 = hitshakeover
x = facing * gethitvar(xvel)
y = gethitvar(yvel)
persistent = 0

[State 1021, Increment Velocity]
type = VelAdd
trigger1 = hitshakeover
y = gethitvar(yaccel)

[State 1021, Self State]
type = SelfState
trigger1 = hitshakeover && (pos y + vel y > 0)
value = 5100

