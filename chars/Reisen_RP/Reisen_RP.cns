proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0, -70   ;Approximate position of head
mid.pos = 0, -45    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -2.0     ;Walk backward
run.fwd  = 4.6,0.0;4.6, 0    ;Run forward (x, y)
run.back = -4.2,-2.5 ;Hop backward (x, y)
jump.neu = 0,-10.4    ;Neutral jumping velocity (x, y)
jump.back = -2.0   ;Jump back Speed (x, y)
jump.fwd = 2.0       ;Jump forward Speed (x, y)
runjump.back = -4.8,-6.3;8.1 ;Running jump speeds (opt)
runjump.fwd = 4.2,-6.3;8.1      ;.
airjump.neu = 0,-6.3;8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.
air.gethit.groundrecover = -.15,-3.5  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-4.5    ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -1       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 0         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 1.5      ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**


[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5       ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .5    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**


[Quotes]
victory1 = "Well, you're an earth creature. That's why you lost." ;Soku
victory2 = "You intended to move straight ahead, but from the start, you were dizzy." ;SWR
victory3 = "In the end, it looks like the shrine maiden resolved the matter. However, I'm not very knowledgeable of the details..." ;
victory4 = "Earth's environment is harsh, but there's never a dull moment, so it's pretty fun." ;
victory5 = "I'm not even a moon rabbit any more, this alone proves it." ;
victory6 = "Jeez, you're just like Lady Eirin said." ;
;;Victory vs Reimu
victory7 = "Hasn't the shrine been used for gut-trials a lot at night? I wonder why that is." ;SWR
victory8 = "I haven't had anyone to fight with lately, so this is just about perfect." ;IN
;;Victory vs Marisa
victory9 = "Even with firepower you can't match me, right?" ;SWR
victory10 = "If you have no business other than burglary, leave now." ;IN
;;Victory vs Sanae
victory11 = "Mountain-climbing is such a drag." ;Soku
victory12 = "Why build a shrine at the top of the mountain?" ;Soku
;;Victory vs Hong Meiling
victory13 = "An exercise that's good for your health? Well, I think medicines are better." ;Soku
victory14 = "Aren't there supposed to be thousands of ancient chinese medicines still used today?" ;Custom
;;Victory vs Lie Meiling
victory15 = "I remember hearing about someone with your kind of power fighting a demi-god on the moon's surface once..." ;Orig
victory16 = "Is this the kind of impurity the moon people were trying to avoid?" ;
;;Victory vs Remilia
victory17 = "However fast you may go, there is no way you can escape from my illusions." ;SWR
victory18 = "You're not thinking of going to the moon any more I hope?" ;SWR
;;Victory vs Sakuya
victory19 = "Even if you stop time, you can't escape from illusions, you know?"
victory20 = "Illusions take place within the brain. In other words, an illusion will beat the speed of light!"
;;Victory vs Youmu
victory21 = "Your wavelengths are comparitively longish. Well, that's what I'm seeing." ;PoFV
victory22 = "When it comes to illusions, humans become scared from seeing even a third of a phantom." ;SWR
;;Victory vs Kagerou
victory23 = "Your wavelengths change during a full moon. You don't see that very often."
victory24 = "Your wavelengths are one of a kind... but there used to be thousands more just like yours at one point, wasn't there?"
;;Victory vs Aya
victory25 = "If you're looking for a news story, maybe you should investigate the scarlet devil's gateguard? I hear she's been acting unusually agressive lately." ;Original
victory26 = "Any updates on the weapons being developed in the mountains?" ;SWR derived
;;Victory vs Mamizou
victory27 = "In old stories, often the villains are both rabbits and tanuki. Why is that?"
victory28 = "In the end, we're both the same, aren't we?"

