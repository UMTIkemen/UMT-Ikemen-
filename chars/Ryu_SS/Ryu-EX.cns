;=========================< EX波動拳 >=========================
[Statedef 1050]
type = S
movetype = A
physics = N
velset = 0,0
ctrl = 0
anim = 1050
poweradd = 0
facep2 = 1
sprpriority = 2

;--- EX必殺技演出 ---
[State 1050, Sound]
type = playsnd
trigger1 = time = 0
value = s7050,0

[State 1050, PalFx]
type = palfx
trigger1 = gametime % 3 = 0
time = 1
add = 0,76,224
color = 124
ignorehitpause = 1

[State 1050, PalFx]
type = palfx
trigger1 = gametime % 3 = 1
time = 1
add = 0,46,164
color = 256
ignorehitpause = 1

[State 1050, PowerAdd]
type = poweradd
trigger1 = time = 0 && fvar(2) = 0
value = -1000

[State 1050, VarAdd]
type = varadd
trigger1 = time = 0 && fvar(2)
fv = 2
value = -450

;--- 効果音 ---
[State 1050, Voice]
type = playsnd
trigger1 = animelem = 5 || animelem = 6
value = s3055,0

;--- エフェクト ---
[State 1050, Effect Helper]
type = helper
trigger1 = animelem = 4
helpertype = normal
name = "Raikou Effect"
ownpal = 1
stateno = 1055
ID = 1055
postype = p1
pos = 0,0

[State 1050, Explod]
type = explod
trigger1 = animelem = 6
ID = 3056
pos = -25,-60
postype = p1
removeongethit = 1
anim = 3056
ownpal = 1
sprpriority = 3
ignorehitpause = 1

;--- 溜め時間 ---
[State 1050, ChargeTimeVar]
type = varset
trigger1 = time = 0
v = 40
value = 0

[State 1050, ChargeTimeVar]
type = varadd
trigger1 = animelemtime(5) >= 0
v = 40
value = 1

[State 1050, ChargeTimeVar]
type = varset
trigger1 = time = 0
v = 1
value = 0

[State 1050, ChargeTimeVar]
type = varset
trigger1 = animelem = 6
v = 1
value = 1

[State 1050, ChargeTimeVar]
type = varset
trigger1 = animtime = 0
v = 1
value = 2

;--- ステート変更 ---
[State 1050, ChangeState]
type = changestate
triggerall = animelemtime(5) >= 0
trigger1 = var(59) <= 0 && command != "holdx" && command != "holdy"
trigger2 = animtime = 0
trigger3 = var(59) > 0
value = 1060

;----------------------------------------------------------------
; EX波動拳 エフェクト
[Statedef 1055]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0
anim = 3055
sprpriority = 5

;--- 固定 ---
[State 1055, BindToParent]
type = bindtoparent
trigger1 = parent,stateno = 1050
trigger1 = ishelper(1055)
pos = -25,-60

;--- サイズ ---
[State 1055, AngleDraw]
type = angledraw
trigger1 = parent,var(1) = 0
scale = 0.5,0.5

[State 1055, AngleDraw]
type = angledraw
trigger1 = parent,var(1) = 1
scale = 0.75,0.75

;--- 消滅 ---
[State 1055, DestroySelf]
type = destroyself
trigger1 = parent,stateno != 1050

