;=========================< 真空波動拳 >=========================
[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0,0
ctrl = 0
anim = 3000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 3000, CommandVar]
type = varset
triggerall = var(59) <= 0
trigger1 = time = 0
v = 1
value = (helper(9999),var(26) >= helper(9999),var(25))

[State 3000, Command Var]
type = varset
trigger1 = time = 0 && prevstateno = 358004
v = 1
value = ifelse(var(44) = 3000,0,1)

[State 3000, ChangeAnim]
type = null;changeanim
trigger1 = time = 0
value = ifelse(var(1) = 0,3000,3001)

;--- 超必殺技演出 ---
[State 3000, SuperPause]
type = superpause
trigger1 = time = 1
time = 28
movetime = 28
darken = 0
anim = -1
p2defmul = 1

[State 3000, Super Helper]
type = helper
trigger1 = time = 1
helpertype = normal
name = "Super Helper"
ownpal = 1
stateno = 7000
ID = 7000
postype = p1
pos = -25,-60
pausemovetime = 999999
supermovetime = 999999

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && fvar(2) = 0
value = -1000

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && fvar(2)
fv = 2
value = 0

;---- スーパーキャンセル ---
[State 3000, VarSet]
type = varset
trigger1 = time = 0
v = 13
value = 0

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && prevstateno = [1000,1999]
v = 13
value = 1

[State 3000, PowerAdd]
type = poweradd
trigger1 = time = 0 && var(13) = 1
value = -1000

[State 3000, PalFx]
type = palfx
trigger1 = (time = [0,15]) && time%2 = 0
trigger1 = var(13) = 1
time = 1
add = 256,256,256

;--- 効果音 ---
[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
value = s3000,0+(var(47)*100)
channel = 0

[State 3000, Voice]
type = playsnd
trigger1 = animelem = 6
value = s3000,1+(var(47)*100)
channel = 0

[State 3000, Sound]
type = playsnd
trigger1 = animelem = 5
value = s3005,0

;--- エフェクト ---
[State 3000, Effect Helper]
type = helper
trigger1 = animelem = 3
helpertype = normal
name = "ShinkuHadou Effect"
ownpal = 1
stateno = 3005
ID = 3005
postype = p1
pos = 0,0
supermovetime = 25

;--- 座標 ---
[State 3000, PosAdd]
type = posadd
trigger1 = animelem = 5 || animelem = 6
x = 5

[State 3000, PosAdd]
type = posadd
trigger1 = animelem = 11 || animelem = 12
x = -5

;--- 飛び道具 ---
[State 3000, Projectile Helper]
type = helper
trigger1 = animelem = 6
helpertype = normal
name = "ShinkuHadou Projectile"
ownpal = 1
stateno = 3010
ID = 3010
postype = p1
pos = 55,-65

;--- 攻撃判定消滅 ---
[State 3000, StateTypeSet]
type = statetypeset
trigger1 = animelem = 7
movetype = I

;--- 終了 ---
[State 3000, End]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

;----------------------------------------------------------------
; 真空波動拳 エフェクト
[Statedef 3005]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0
anim = 3005
sprpriority = 3

;--- 固定 ---
[State 3005, BindToParent]
type = bindtoparent
trigger1 = parent,stateno = 3000 && parent,animelemtime(5) <= 0
trigger1 = ishelper(3005)
pos = -25,-60

[State 3005, BindToParent]
type = bindtoparent
trigger1 = parent,stateno = 3000 && parent,animelemtime(5) >= 0
trigger1 = ishelper(3005)
pos = 5,-60

;--- 消滅 ---
[State 3005, DestroySelf]
type = destroyself
trigger1 = parent,stateno != 3000
trigger2 = parent,stateno = 3000 && parent,animelemtime(6) >= 0

