;Miracle Strike EX
[State -1, Miracle Strike]
type = ChangeState
triggerall= !AILevel && var(52)<=0
triggerall = Roundstate = [2,3]
triggerall = Cond(StateType = A,IfElse(Facing=1,NumExplod(90010203),NumExplod(90010301)),((ifElse(P2DisT x < -12, Facing = -1, Facing = 1) && NumExplod(90010203)) || (ifElse(P2DisT x < -12, Facing = 1, Facing = -1) && NumExplod(90010301))))
triggerall = (ifElse(NumExplod(90000230), 1, 0) + ifElse(NumExplod(90000240), 1, 0) + ifElse(NumExplod(90000250), 1, 0) >= 2) || (ifElse(NumExplod(90000235), 1, 0) + ifElse(NumExplod(90000245), 1, 0) + ifElse(NumExplod(90000255), 1, 0) >= 2)
TriggerAll = !WinKo
triggerall = power >= 500
trigger1 = ctrl
trigger2 = ((stateno = 200) || (stateno = 210) || ((stateno = 220) && (animelemtime(9)>0) && MoveHit) || (stateno = 225)) && movecontact
trigger3 = ((stateno = 230) || (stateno = 240) || (stateno = 250) || (stateno = 260)) && movecontact
trigger4 = ((stateno = 400) || (stateno = 410) || (stateno = 420) || (stateno = 421)) && movecontact
trigger5 = ((stateno = 430) || (stateno = 440) || (stateno = 450)) && movecontact
trigger6 = stateno = 100 || stateno = 101
Trigger7 = StateNo = 1700 && MoveHit		;Soku Time
trigger8 = ((stateno = 600) || (stateno = 610) || (stateno = 630) || (stateno = 640)) && movecontact
trigger9 = (stateno = [1200, 1221]) && movehit
trigger9 = NumExplod(1011) < 1
value = 1803

;Miracle Strike Light
[State -1, Miracle Strike]
type = ChangeState
