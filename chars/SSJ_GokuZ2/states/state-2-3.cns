flag = nojugglecheck
ignorehitpause = 1

; anim number for teleport afterimage
[State -2, teleport]
type = varset
trigger1 = StateNo != [1400,1480]
trigger1 = StateNo != [2010,2060]
var(40) = anim

; animelem number for teleport afterimage
[State -2, teleport]
