;--- 先行入力ヘルパー ---
[state -3, コマンド認識用ヘルパー]
type = helper
trigger1 =!numhelper(9999)
trigger1 =!ishelper
trigger1 = alive
helpertype = normal
name = "commandhelper"
stateno = 9999
ID = 9999
postype = p1
pos = 0,9999
keyctrl = 1
pausemovetime = 2147483647
supermovetime = 2147483647

;--- コンフィグヘルパー ---
[State -2, Config Helper]
type = helper
trigger1 = !numhelper(10000)
trigger1 = !ishelper
helpertype = normal
name = "Config Helper"
stateno = 10000
ID = 10000
postype = p1
pos = 0,0
pausemovetime = 2147483647
supermovetime = 2147483647

;=========================< 常時監視-3 >=========================
[Statedef -3]

;--- 画面端ヒットバック ---
[State -2, VarSet]
type = varset
trigger1 = numtarget
trigger1 = target,statetype = S || target,statetype = C
trigger1 = movecontact = 1
trigger1 = hitdefattr = SCA,AA || stateno = 3050
fv = 6
value = target,gethitvar(xvel)

[State -2, VarSet]
type = varset
trigger1 = numtarget
trigger1 = fvar(6)
trigger1 = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
trigger1 = target,hitshakeover
fv = 6
value = fvar(6)*0.85

[State -2, PosAdd]
type = posadd
trigger1 = fvar(6)
trigger1 = numtarget
trigger1 = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
trigger1 = statetype = S || statetype = C
trigger1 = target,statetype = S || target,statetype = C
trigger1 = target,backedgebodydist <= 0 || target,frontedgebodydist <= 0
trigger1 = target,hitshakeover
trigger1 = fvar(6)*facing > 0
x = -fvar(6)*facing

;--- ワイヤーダメージ判定 ---
[State -2, Wire Var]
type = varadd
trigger1 = numtarget(var(29))
trigger1 = target(var(29)),stateno = [5600,5604]
trigger1 = var(9) = 1
trigger1 = (var(16)%2) = 0
v = 16
value = 1
ignorehitpause = 1

[State -2, Wire Var]
type = null;varset
trigger1 = p2movetype != H
v = 16
value = 0

[State -2, Helper]
type = helper
triggerall = !numhelper(5604)
trigger1 = numtarget(var(29))
trigger1 = target(var(29)),stateno = 5600
trigger2 = numhelper(4040)
trigger2 = helper(4040),var(40) = 1
helpertype = normal
name = "Wire Damage"
stateno = 5604
ID = 5604
postype = p1
pos = 0,0
facing = 1

[State -2, PosAdd]
type = posset
triggerall = !numhelper(7000) && !numhelper(7010) && !numhelper(7020)
triggerall = numhelper(5604)
trigger1 = facing = 1 && helper(5604),facing = 1
trigger1 = pos x > helper(5604),pos x
trigger2 = facing = -1 && helper(5604),facing = -1
trigger2 = pos x < helper(5604),pos x
x = helper(5604),pos x

;--- 画面端めくり防止 ---
[State -2, CornerPush]
type = width
triggerall = movetype != H
trigger1 = enemynear, backedgedist < 10
trigger2 = enemynear, frontedgedist < 10
edge = 10
