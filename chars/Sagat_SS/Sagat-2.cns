type = varset
trigger1 = var(3) = 0 && p2movetype = A
v = 3
value = 2

[State -2, Counter Var]
type = varadd
trigger1 = var(3) && p2movetype != A
v = 3
value = -1

[State -2, Counter Var]
type = varset
trigger1 = var(3) < 0
trigger2 = stateno = 200110
v = 3
value = 0

[State -2, Counter Helper]
type = helper
triggerall = var(3)
triggerall = var(9) = 1
triggerall = p2movetype = H && numtarget
trigger1 = movehit = 1
helpertype = normal
name = "Counter Helper"
size.xscale = 0.5
size.yscale = 0.5
stateno = 7200
ID = 7200
postype = left
pos = 10,-100
pausemovetime = 2147483647
supermovetime = 2147483647
ignorehitpause = 1

;--- 基本攻撃力 ---
[State -2, Attack Var]
type = varset
trigger1 = 1
fv = 3
value = 1

;パワーMAX
[State -2, Attack Var]
