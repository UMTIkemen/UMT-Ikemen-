;=========================< 常時監視-2 >=========================
[Statedef -2]

;--- デバッグ ---
[State -2, Clipboard]
type = null;displaytoclipboard
trigger1 = 1
text = "AI = %d Chain = %d Attack = %f Combo = %f Cancel = %d \n"
params = var(40),!var(0),fvar(3),fvar(0),(var(10) || var(11) || var(12))
ignorehitpause = 1

[State -2, Clipboard]
type = null;appendtoclipboard
trigger1 = 1
text =  "Life = %d Power = %d P2X = %f P2Y = %f \n"
params = life,power,p2bodydist x,fvar(20)
ignorehitpause = 1

;--- 喰らい判定 ---
[State -2, NoJuggleCheck]
type = assertspecial
trigger1 = 1
flag = nojugglecheck
ignorehitpause = 1

[State -2, Chain Var]
type = varset
triggerall = var(0)
trigger1 = p2movetype != H
trigger2 = p2statetype = L
v = 0
value = 0

[State -2, HitDef]
type = hitdef
trigger1 = var(0) = 1
attr = S,NA
hitflag = 

;--- ヒット硬直時間 ---
[State -2, HitPause Var]
type = varadd
trigger1 = movecontact = 1
v = 9
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movecontact != 1
v = 9
value = 0
ignorehitpause = 1

;--- ヒット判定 ---
[State -2, HitPause Var]
type = varset
trigger1 = movecontact = 1
trigger2 = movereversed = 1
v = 14
value = 1
ignorehitpause = 1

[State -2, HitPause Var]
type = varset
trigger1 = movetype = I
trigger2 = !movecontact && !movereversed
v = 14
value = 0
ignorehitpause = 1

;--- モード判定 ---
[State -2, VarSet]
type = null;varset
trigger1 = var(15) != 0
v = 15
value = 0

;--- イントロ用変数 ---
;リセット
[State -2, VarSet]
type = varset
trigger1 = roundstate <= 2
trigger1 = var(2)
v = 2
value = 0

;VS ムエタイキャラ king adon joe hwa shura samchay
[State -2, VarSet]
type = varset
triggerall = var(2) != 2
trigger1 = p2name = "king" || p4name = "king"
trigger2 = p2name = "cvsking" || p4name = "cvsking"
trigger3 = p2name = "Joe Higashi" || p4name = "Joe Higashi"
trigger4 = p2name = "Joe_Higashi" || p4name = "Joe_Higashi"
trigger5 = p2name = "cvsjoe" || p4name = "cvsjoe"
trigger6 = p2name = "Joe" || p4name = "Joe"
trigger7 = p2name = "shura" || p4name = "shura"
trigger8 = p2name = "SAMCHAY TOMYAMKUN" || p4name = "SAMCHAY TOMYAMKUN"
trigger9 = p2name = "SAMCHAY_TOMYAMKUN" || p4name = "SAMCHAY_TOMYAMKUN"
trigger10 = p2name = "SAMCHAY" || p4name = "SAMCHAY"
trigger11 = p2name = "hwa jai" || p4name = "hwa jai"
trigger12 = p2name = "hwa_jai" || p4name = "hwa_jai"
trigger13 = p2name = "hwa" || p4name = "hwa"
trigger14 = p2name = "MJ_King" || p4name = "MJ_King"
v = 2
value = 2

;VS アドン
[State -2, VarSet]
type = varset
triggerall = var(2) != 5
trigger1 = p2name = "adon" || p4name = "adon"
trigger2 = p2name = "cvsadon" || p4name = "cvsadon"
v = 2
value = 5

;VS ジョー
[State -2, VarSet]
type = varset
triggerall = var(2) != 4
trigger1 = enemy,name = "Joe Higashi" && enemy,authorname = "Soy Sauce" && enemy,var(15) = 0
trigger1 = !(teammode = Simul)
v = 2
value = 4

;VS クラウザー
[State -2, VarSet]
type = varset
triggerall = var(2) != 3
triggerall = !(teammode = Simul)
trigger1 = enemy,name = "Wolfgang Krauser" && enemy,authorname = "Soy Sauce"
trigger2 = enemy,name = "Rugal Bernstein" && enemy,authorname = "Soy Sauce"
v = 2
value = 3

;VS リュウ
[State -2, VarSet]
type = varset
triggerall = var(2) != 1
trigger1 = p2name = "Ryu" || p4name = "Ryu"
trigger2 = p2name = "SF2'リュウ" || p4name = "SF2'リュウ";M ASA@DAS氏 ストII'仕様
trigger3 = p2name = "MvC2 Ryu By Kamekaze" || p4name = "MvC2 Ryu By Kamekaze"; Kamekaze氏 MvC2仕様
trigger4 = p2name = "Ryu_Sf3_Marvel" || p4name = "Ryu_Sf3_Marvel"; KAZ氏 スト3+MvC仕様
trigger5 = p2name = "cvsryu" || p4name = "cvsryu"; 悪咲3号氏 CvS2仕様
trigger6 = p2name = "cvsryu_normal" || p4name = "cvsryu_normal"; 悪咲3号氏 CvS2仕様 通常
trigger7 = p2name = "svcryu" || p4name = "svcryu"; 悪咲3号氏 SvC仕様
trigger8 = p2name = "Ryu Hoshi" || p4name = "Ryu Hoshi"; Don Drago氏 SvC仕様
trigger9 = p2name = "SVC_Ryu" || p4name = "SVC_Ryu"; Zman氏 SvC仕様
trigger10 = p2name = "The Fighter" || p4name = "The Fighter"; ケージュ氏 アレンジ仕様
v = 2
value = 1

;VS 殺意リュウ
[State -2, VarSet]
type = varset
triggerall = var(2) != 5
triggerall = numenemy
trigger1 = enemy,name = "Ryu" && enemy,authorname = "Soy Sauce" && enemy,var(15) = 1; しょうゆ制
trigger2 = enemy,name = "Ryu" && enemy,authorname = "adamskie" && (enemy,palno = [7,12]); あだむすきー氏 ZERO仕様
trigger3 = enemy,name = "Ryu" && enemy,authorname = "Umihei" && enemy,var(15) = 1; 海平氏 SF3仕様
trigger4 = enemy,name = "MvC2 Ryu By Kamekaze" && enemy,authorname = "Kamekaze" && (enemy,var(58) = [7,12]); Kamekaze氏 MvC2仕様
trigger5 = enemy,name = "cvsryu" && enemy,authorname = "Warusaki3" && enemy,var(12) = 10; 悪咲3号氏 CvS2仕様
trigger6 = enemy,name = "cvsryu_ex" && enemy,authorname = "Warusaki3" && enemy,var(12) = 10; 悪咲3号氏 CvS2仕様 EX
trigger7 = enemy,name = "Ryu" && enemy,authorname = "Phantom.of.the.Server" && enemy,var(1) = 2; PotS氏 CvS仕様
trigger8 = enemy,name = "svcryu" && enemy,authorname = "Warusaki3" && enemy,var(12) = 10; 悪咲3号氏 SvC仕様 EX
trigger9 = enemy,name = "Ryu Hoshi" && enemy,authorname = "Don Drago" && (enemy,var(0) = [2,3]); Don Drago氏 SvC仕様
trigger10 = enemy,name = "SVC_Ryu"&& enemy,authorname = "Z man" && (enemy,palno = 3 || enemy,palno = 6); Zman氏 SvC仕様
v = 2
value = 5

[State -2, VarSet]
type = varset
triggerall = var(2) != 5
triggerall = numenemy > 1
trigger1 = enemy(1),name = "Ryu" && enemy(1),authorname = "Soy Sauce" && enemy(1),var(15) = 1; しょうゆ制
trigger2 = enemy(1),name = "Ryu" && enemy(1),authorname = "adamskie" && (enemy(1),palno = [7,12]); あだむすきー氏 ZERO仕様
trigger3 = enemy(1),name = "Ryu" && enemy(1),authorname = "Umihei" && enemy(1),var(15) = 1; 海平氏 SF3仕様
trigger4 = enemy(1),name = "MvC2 Ryu By Kamekaze" && enemy(1),authorname = "Kamekaze" && (enemy(1),var(58) = [7,12]); Kamekaze氏 MvC2仕様
trigger5 = enemy(1),name = "cvsryu" && enemy(1),authorname = "Warusaki3" && enemy(1),var(12) = 10; 悪咲3号氏 CvS2仕様
trigger6 = enemy(1),name = "cvsryu_ex" && enemy(1),authorname = "Warusaki3" && enemy(1),var(12) = 10; 悪咲3号氏 CvS2仕様 EX
trigger7 = enemy(1),name = "Ryu" && enemy(1),authorname = "Phantom.of.the.Server" && enemy(1),var(1) = 2; PotS氏 CvS仕様
trigger8 = enemy(1),name = "svcryu" && enemy(1),authorname = "Warusaki3" && enemy(1),var(12) = 10; 悪咲3号氏 SvC仕様 EX
trigger9 = enemy(1),name = "Ryu Hoshi" && enemy(1),authorname = "Don Drago" && (enemy(1),var(0) = [2,3]); Don Drago氏 SvC仕様
trigger10 = enemy(1),name = "SVC_Ryu"&& enemy(1),authorname = "Z man" && (enemy(1),palno = 3 || enemy(1),palno = 6); Zman氏 SvC仕様
v = 2
value = 5

[State -2, VarSet]
type = varset
triggerall = var(2) != 5
trigger1 = p2name = "Evil Ryu" || p4name = "Evil Ryu"
trigger2 = p2name = "Evil_Ryu" || p4name = "Evil_Ryu"
trigger3 = p2name = "EvilRyu" || p4name = "EvilRyu"
