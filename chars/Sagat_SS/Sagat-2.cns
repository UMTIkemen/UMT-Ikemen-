;--- コンボ補正 ---
[State -2, Combo Var]
type = varset
trigger1 = p2movetype != H
fv = 0
value = 1

[State -2, Combo Var]
type = varadd
triggerall = p2movetype = H
triggerall = stateno != [800,899]
triggerall = stateno != [900,999]
triggerall = stateno != [3300,3399]
triggerall = stateno != [4000,4099]
trigger1 = movehit = 1
fv = 0
value = -0.05

[State -2, Combo Var]
type = varset
trigger1 = stateno = [4000,4999]
trigger1 = fvar(0) < 0.5
fv = 0
value = 0.5

[State -2, Combo Var]
type = varset
trigger1 = stateno = [3000,3999]
trigger1 = fvar(0) < 0.4
fv = 0
value = 0.4

[State -2, Combo Var]
type = varset
trigger1 = fvar(0) < 0.2
fv = 0
value = 0.2

;--- パワーMAX ---
[State -2, PowerMAX Var]
type = varadd
trigger1 = sysfvar(2) = 0
trigger1 = fvar(2)
fv = 2
value = -1
ignorehitpause = 1

[State -2, PowerMAX Var]
type = varset
trigger1 = fvar(2) <= 0
trigger2 = !alive
trigger3 = roundstate < 2
fv = 2
value = 0

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 1 && fvar(2)
trigger1 = movetype != H
time = 1
add = 80,80,60
ignorehitpause = 1

[State -2, PalFX]
type = palfx
trigger1 = sysfvar(2) = 0
trigger1 = gametime%3 = 2 && fvar(2)
trigger1 = movetype != H
time = 1
add = 40,40,30
ignorehitpause = 1

[State -2, Helper]
type = helper
trigger1 = fvar(2) && !numhelper(7120)
helpertype = normal
name = "Power MAX Gauge"
ownpal = 1
stateno = 7120
ID = 7120
postype = back
pos = 0,0
facing = 1
supermovetime = 999
pausemovetime = 999

;--- カウンター ---
