triggerall = var(59) <= 0
triggerall = helper(9999),var(18) >= helper(9999),var(17)
triggerall = helper(9999),var(18) >= helper(9999),var(20)
triggerall = helper(9999),var(18) >= helper(9999),var(21)
trigger1 = time = 0
v = 1
value = 1

[State 3000, CommandVar]
