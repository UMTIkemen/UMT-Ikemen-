add = 256,256,256

;--- 効果音 ---
[State 3000, Voice]
type = playsnd
trigger1 = animelem = 1
value = s3000,0
channel = 0

[State 3000, Voice]
type = playsnd
trigger1 = animelem = 6
value = s3000,1
channel = 0

[State 3000, Sound]
type = playsnd
trigger1 = animelem = 5
value = s3005,0

;--- 座標 ---
[State 3000, PosAdd]
