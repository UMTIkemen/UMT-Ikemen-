ownpal = 1
stateno = 3005
ID = 3005
postype = p1
pos = 0,0
supermovetime = 28

;--- 座標 ---
[State 3000, PosAdd]
type = posadd
trigger1 = animelem = 5 || animelem = 6
x = 5

[State 3000, PosAdd]
type = posadd
trigger1 = animelem = 11 || animelem = 12
x = -5

;--- 接触判定 ---
[State 3000, Width]
