trigger1 = time = 0 && fvar(2)
fv = 2
value = 0

;---- スーパーキャンセル ---
[State 3000, VarSet]
type = varset
trigger1 = time = 0
v = 13
value = 0

[State 3000, VarSet]
type = varset
trigger1 = time = 0 && prevstateno = [1000,1999]
v = 13
value = 1

[State 3000, PowerAdd]
type = poweradd
