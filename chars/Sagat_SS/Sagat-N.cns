givepower = 10,10
pausetime = 12,12
hitsound = s6000,0
guardsound = s6100,0
sparkno = s6000+(fvar(2) > 0)
guard.sparkno = s6100
sparkxy = -15,-85
ground.hittime = 12
ground.slidetime = 12
ground.velocity = -5,0
ground.cornerpush.veloff = 0
air.hittime = 12
air.velocity = -3,-6
guard.hittime = 10
guard.slidetime = 10
guard.velocity = -5
airguard.ctrltime = 999999
airguard.velocity = -3,0
