;=========================< タイガーショット >=========================
[Statedef 1000]
type = S
movetype = A
physics = S
velset = 0,0
ctrl = 0
anim = 1000
poweradd = 0
facep2 = 1
sprpriority = 2

;--- コマンド判定 ---
[State 1000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(2) >= helper(9999),var(3)
triggerall = helper(9999),var(2) >= helper(9999),var(5)
triggerall = helper(9999),var(2) >= helper(9999),var(6)
trigger1 = time = 0
v = 1
value = 0

[State 1000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(3) >= helper(9999),var(2)
triggerall = helper(9999),var(3) >= helper(9999),var(5)
triggerall = helper(9999),var(3) >= helper(9999),var(6)
trigger1 = time = 0
v = 1
value = 1

[State 1000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(5) >= helper(9999),var(2)
triggerall = helper(9999),var(5) >= helper(9999),var(3)
triggerall = helper(9999),var(5) >= helper(9999),var(6)
trigger1 = time = 0
v = 1
value = 2

[State 1000, CommandVar]
type = varset
triggerall = var(59) <= 0
triggerall = helper(9999),var(6) >= helper(9999),var(2)
triggerall = helper(9999),var(6) >= helper(9999),var(3)
triggerall = helper(9999),var(6) >= helper(9999),var(5)
trigger1 = time = 0
v = 1
value = 3

[State 1000, ChangeAnim]
type = changeanim
trigger1 = time = 0
value = 1000+var(1)

;--- 効果音 ---
[State 1000, Voice]
type = playsnd
trigger1 = animelem = 1
value = s1000,0
channel = 0

[State 1000, Sound]
type = playsnd
trigger1 = animelem = 6
value = s1005,0

;--- 座標 ---
[State 1000, PosAdd]
type = posadd
trigger1 = var(1) = [0,1]
trigger1 = animelem = 5
x = 5

[State 1000, PosAdd]
type = posadd
trigger1 = animelem = 6
x = 10

[State 1000, PosAdd]
type = posadd
trigger1 = var(1) = [0,1]
trigger1 = animelem = 9
trigger2 = animelem = 10 || animelem = 11
x = -5

;--- エフェクト ---
[State 1000, Explod]
type = null;explod
trigger1 = animelem = 7
ID = 1005
pos = 40,0
postype = p1
removeongethit = 1
anim = 1005
shadow = -1
ownpal = 1
sprpriority = 5
ignorehitpause = 1
persistent = 0

;--- 接触判定 ---
[State 1000, Width]
type = width
trigger1 = var(1) = [0,1]
trigger1 = animelemtime(2) >= 0 && animelemtime(3) < 0
value = 5

[State 1000, Width]
type = width
trigger1 = var(1) = [0,1]
trigger1 = animelemtime(3) >= 0 && animelemtime(8) < 0
value = 10

