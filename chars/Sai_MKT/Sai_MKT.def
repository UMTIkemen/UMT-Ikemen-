;--| 基本情報 |---------------------------------------------------------------
[Info]
Name         = "Sai"       ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Sai"       ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 03,23,2013  ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002  ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Mikita"    ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6 ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
Cmd     = Sai.cmd
Cns     = Sai.cns
St      = Sai.cns
St1     = Reflector.cns
St2     = Super.cns
St3     = -2_-3.txt
