trigger1 = 1
value = SCA
time = 1

[State 181]
type = PlayerPush
trigger1 = 1
value = 0

[State 181]
type = AssertSpecial
trigger1 = time<(2+var(4))*tickspersecond
flag = roundnotover

[State 181]
