[Data]
life = 1050
power = 3000
attack = 110
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 25
sparkno = 2
guard.sparkno = S7000
KO.echo = 0
volume = 100
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 56
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 16     ;Player width (back, ground)
ground.front = 17    ;Player width (front, ground)
air.back = 14        ;Player width (back, air)
air.front = 14       ;Player width (front, air)
height = 75          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1     ;Set to 1 to scale projectiles too
head.pos = 0, -95   ;Approximate position of head
mid.pos = 0, -60  ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 2.1      ;Walk forward
walk.back = -1.8    ;Walk backward
run.fwd  = 4.2, 0    ;Run forward (x, y)
run.back = -5,-5 	;Hop backward (x, y)
jump.neu = 0,-8    ;Neutral jumping velocity (x, y)
jump.back = -3    ;Jump back Speed (x, y)
jump.fwd = 3       ;Jump forward Speed (x, y)
airjump.neu = 0,-6.5     ;Air jump speeds (opt)
airjump.back = -2.4
airjump.fwd = 2.4
runjump.fwd = 3.5
air.gethit.groundrecover = -4,0    ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = 0,0     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = -1,-4     ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -2       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 2         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 2        ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 25   ;Minimum distance from ground before you can air jump (opt)
yaccel = .44          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .5    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

;IKEMEN only
[Constants]
Default.LegacyGameDistanceSpec = 0  ; 1 prevents GameWidth/GameHeight from being affected by stage zoom for mugenversion 1.0 chars

;Default language victory quotes (optional).  **MUGEN 1.0**
;If this section is included, the default language victory quotes must be in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory0 = "I am the Pretty Guardian who fights for Love and for Courage! I am Sailor Jupiter!"
victory1 = "You've been struck by 10,000V of justice!"
victory2 = "My fists may be strong, but my heart is stronger!"
victory3 = "Come on, I know you can do better! This was barely a warm-up."
victory4 = "Complaining about losing? Tell someone who cares."
victory5 = "I am the one with the most talent here!"

;character-specific:
;vs Sailor Moon
victory6 = "Aw, stop crying, Usagi... Here, I made a yummy bento for you."
;vs Sailor Venus
victory7 = "I won't lose in battle or in love, Venus!"
;vs lightning users
victory8 = "Fighting me with lightning? You've got some nerve!"

;---------------------------------------------------------------------------
; Vars
;---------------------------------------------------------------------------
;************************
; State vars
;************************
; var(1) - states 40, 50, 60 (superjump flag)
; var(2) - states 1200, 1210
; var(3) - transparency for EX aura
; vars(4-6) - local vars (for immediate usage)
; var(7) - Aqua Mist invisibility timer

; vars(8-10) - shock FX
; var(11-13) - shock PalFX colors

; var(14) - states 1400-1410
; var(15) - superarmor state buffer
; var(16) - states 1200-1210, 2200
; var(17) - state 3000

;************************
; System stuff
;************************
; var(20) - global input buffer (used for long inputs in state -1)
; var(21) - global input buffer timer
; var(22) - p2 ID
; var(23) - p4 ID
; var(24) - p1 life buffer (used for defence boost)
; var(25) - p2 life buffer (used for damage dampening)
; var(26) - p4 life buffer (used for damage dampening)
; var(30) - local input buffer (used for short inputs in some states)
; var(31) - autocombo flag
; var(32) - airjump num
; var(33) - airdash num
; var(35) - projectile index
; var(36) - darken bg
; var(40) - first attack flag
; var(41) - counter flag
; var(42) - enemy hitfall flag
; var(43) - special juggle buffer
; var(49) - AI p2 state index

;************************
; Customisable
;************************
; ~integers~
; var(52) - special KO effects on/off
; var(53) - projectile limit on/off
; var(54) - eyecatch intro on/off
; var(55) - supermove music volume
; var(56) - input buffer additional frames
; var(57) - attack/guard canceling by dashes on/off
; var(58) - Aqua Mist duration

; ~floats~
; fvar(1) - power gain multiplier
; fvar(32) - scaling effect factor

;************************
; Other
;************************
; ~integers~
; var(59) - AI difficulty modifier

; ~floats~
; fvar(2) - damage multiplier
; fvar(3) - attack value
; fvar(4) - state 193
; fvar(10) - rng
; fvar(11) - attack value buffer
; fvar(15) - superarmor hit ID
; fvar(20) - p2 dist x for AI
; fvar(21) - p2 dist y for AI
; fvar(30) - screen height
; fvar(31) - screen width
; fvar(33) - character X scaling effect
; fvar(34) - character Y scaling effect
; fvar(35) - character X offset
; fvar(36) - character Y offset


;---------------------------------------------------------------------------
; Sound Channels
;---------------------------------------------------------------------------
; 0 - character voice
; 5 - jumps/landing stomps
; 6 - dashes
; 7 - long sounds (supermoves mostly)

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = Pause
trigger1 = prevstateno = 19198
persistent = 0
time = 0
movetime = 0

[State 0]
type = RemoveExplod
trigger1 = prevstateno = 19198
persistent = 0
ID = 7438

[State 0]
type = PosSet
trigger1 = roundstate = 2
trigger1 = prevstateno = [950,999]
persistent = 0
x = fvar(10)

[State 0]
type = AssertSpecial
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = time<200
trigger1 = enemy,stateno != 0
flag = intro

[State 0]
type = ChangeState
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = enemy,stateno != 0
trigger1 = !var(59)
trigger1 = command = "start"
value = 195

[State 0]
type = StopSnd
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
channel = -1

[State 0]
type = RemapPal
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
source = 1,1
dest = 1,palno

[State 0]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != [1,5]
trigger2 = (Anim = [1,5]) && AnimTime = 0 ;Turn anim over
value = 0
elem = 1+3*(Anim = 5)

[State 0]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0]
type = ChangeAnim
triggerall = !time
triggerall = anim = 0
trigger1 = (prevstateno = 20)||(prevstateno = 193)
trigger2 = (prevstateno = 200)||(prevstateno = 210)||(prevstateno = 230)
trigger3 = (prevstateno = 705)||(prevstateno = 750)
trigger4 = (prevstateno = [1200,1210])
trigger5 = (prevstateno = 3000)||(prevstateno = 3500)
value = 0
elem = 4
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0
triggerall = prevstateno != [5000,5999]
triggerall = prevstateno != 19198
triggerall = time<10
trigger1 = animelemtime(1) = [0,10]
fvar(34) = 1+fvar(32)*.004*(animelemtime(1)-10)
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0
triggerall = prevstateno != [5000,5999]
triggerall = time<10
trigger1 = animelemtime(4) = [0,10]
fvar(34) = 1+fvar(32)*.004*(10-animelemtime(4))
ignorehitpause = 1
[State 0]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 0]
type = Offset
trigger1 = anim = 0
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))
;---------------------------------------------------------------------------
; Superjump Start
[Statedef 60]
type    = S
physics = S
ctrl = 0
sprpriority = 1+(prevstateno = [150,153])
movehitpersist = 1
velset = 0,0
facep2 = 0
ctrl = 0

[State 60]
type = VarSet
trigger1 = 1
var(1) = -1

[State 60]
type = VarSet
trigger1 = (prevstateno = [150,153])||(prevstateno = [200,799])
var(1) = 1

[State 60]
type = VarSet
trigger1 = movehit&&numtarget
trigger1 = prevstateno = 410
var(1) = 2

[State 60]
type = VarSet
trigger1 = 1
trigger1 = prevstateno = 100
var(1) = 3

[State 60]
type = AfterImage
trigger1 = prevstateno!=8000
persistent = 0
time = 2
length = 11
palbright = 80,80,80
palpostbright = 0,0,0
palcontrast = 120,120,180
palcolor = 64
paladd = 0,0,0
palmul = .75,.75,.75
trans = add1
timegap = 1
framegap = 5

[State 60]
type = ChangeState
trigger1 = 1
value = 40
ctrl = 0

;---------------------------------------------------------------------------
; Run forwards
[Statedef 100]
type    = S
physics = S
sprpriority = 1
ctrl = 0
anim = 100
facep2 = 1

[State 100, Normal Throw]
type = ChangeAnim
triggerall = !time
triggerall = prevstateno != [100,499]
trigger1 = (command = "x"&&command = "y")||command = "z"
trigger1 = (command = "holdfwd")
trigger2 = var(59)>0
trigger2 = fvar(20) = [0,35]
value = 799

[State 100, Normal Throw]
type = ChangeState
value = 800
triggerall = anim = 799
triggerall = p2dist x>0
triggerall = p2bodydist x<10
triggerall = p2statetype != A
triggerall = p2statetype != L
trigger1 = time<10
trigger1 = prevstateno!=8000

[State 100]
type = Helper
trigger1 = anim != 799
trigger2 = time = 20
persistent = 0
stateno = 7130
ID = 7131
name = "Dust"
pos = 0,0
postype = P1
facing = 1
ownpal = 1
size.xscale = .5*const(size.xscale)
size.yscale = .5*const(size.yscale)
pausemovetime = 0
supermovetime = 0
ignorehitpause = 1

[State 100]
type = Explod
triggerall = time>5+20*(anim=799)
trigger1 = time%5 = 0
anim = 7050+5*(numhelper(3500)>0)
ID = 7050
pos = 0,-ceil((25+45*(time%10 = 0))*const(size.yscale))
random = ceil(20*const(size.xscale)),ceil(30*const(size.xscale))
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
vel = -3*const(size.xscale),0
accel = 0,0
scale = .3*const(size.xscale),.3*const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

[State 100]
type = PlaySnd
trigger1 = anim != 799
trigger2 = time = 20
persistent = 0
value = S100,0
channel = 6

[State 100]
type = PlaySnd
trigger1 = animelem = 1
trigger2 = animelem = 4
trigger3 = animelem = 7
value = S100,1
channel = 5

[State 100]
type = VelSet
trigger1 = time<10+10*(anim=799)
x = const(velocity.run.fwd.x)*.75

[State 100]
type = VelSet
trigger1 = anim != 799
trigger1 = time = [10,30]
x = const(velocity.run.fwd.x)*(1+.3*(numhelper(3500)>0))*(.9+.01*time)
[State 100]
type = VelSet
trigger1 = anim = 799
trigger1 = time = [20,40]
x = const(velocity.run.fwd.x)*(1+.3*(numhelper(3500)>0))*(.8+.01*time)

[State 100]
type = VelSet
trigger1 = time>30+10*(anim = 799)
x = const(velocity.run.fwd.x)*(1+.3*(numhelper(3500)>0))*1.2

[State -1, input buffer]
type = VarSet
trigger1 = prevstateno!=8000
persistent = 0
var(30) = 0
[State -1, input buffer]
type = VarSet
triggerall = var(56)||(animelemtime(1)>=10)
trigger1 = var(59) = 0
trigger1 = command = "a"||command = "b"||command = "c"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = 1.0*random<var(59)*(10-10*(prevstateno = [200,499]))
trigger2 = p2bodydist x = [0,85]
trigger2 = p2bodydist y > -30
trigger2 = (p2statetype != L)&&(p2statetype != C)
trigger2 = p2movetype!=H||p2statetype!=A||enemynear,vel y<=0||fvar(21)<-60
trigger2 = !inguarddist
trigger2 = p2stateno != [120,159]
var(30) = 710
[State -1, input buffer]
type = VarSet
triggerall = var(56)||(animelemtime(1)>=10)||(time>=10)
trigger1 = var(59) = 0
trigger1 = command = "x"||command = "y"||command = "z"
trigger1 = time>1
trigger2 = time>=10
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = 1.0*random<var(59)*(10+40*(prevstateno = [200,499]))
trigger2 = p2bodydist x = [0,40]
trigger2 = p2bodydist y > -20
trigger2 = p2statetype != L
trigger2 = p2movetype!=H||p2statetype!=A||enemynear,vel y<=0||fvar(21)<-60
trigger2 = !inguarddist
trigger2 = p2stateno != [120,159]
var(30) = 700
[State -1, input buffer]
type = VarSet
triggerall = var(56)||(animelemtime(1)>=10)||(time>=10)
trigger1 = var(59) = 0
trigger1 = command = "holdup"||command = "up"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = 1.0*random<10*var(59)
trigger2 = inguarddist
trigger2 = enemynear,statetype != A
var(30) = 40
[State -1, input buffer]
type = VarSet
triggerall = var(56)||(animelemtime(1)>=10)||(time>=10)
trigger1 = var(59) = 0
trigger1 = command = "superjump"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = 1.0*random<10*var(59)
trigger2 = inguarddist
trigger2 = enemynear,statetype != A
var(30) = 60
[State -1, input buffer]
type = ChangeState
triggerall = roundstate = 2
triggerall = var(30)
trigger1 = (animelemtime(1)>=10)||(time>=10)
trigger1 = !numexplod(11502)
value = var(30)

[State 100]
type = RemoveExplod
triggerall = numexplod(11502)
trigger1 = fvar(20)<60
trigger2 = roundstate>2
id = 11502

[State 100]
type = ChangeState
triggerall = (animelemtime(1)>17)||(time>17)
trigger1 = var(59) = 0
trigger1 = command != "holdfwd"
trigger2 = (var(59)>0)&&(roundstate>=2)
trigger2 = !numexplod(11502)
trigger2 = p2bodydist x<10||roundstate>2||inguarddist
value = 101

[State -1, AI charge]
type = RemoveExplod
triggerall = !time
triggerall = var(59)
trigger1 = numexplod(5946)
id = 5946
[State -1, AI charge]
type = Explod
triggerall = !time
triggerall = var(59)
trigger1 = 1
anim = 9999
ID = 5946
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 20
sprpriority = -4
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

