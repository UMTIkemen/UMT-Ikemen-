[State 1050, HitDef]
type = HitDef
trigger1 = !movecontact
id = stateno
attr = S, SP
priority = 3,Hit
Hitflag = MAF
guardflag = MA
damage    = 70,15
pausetime = 0,12+4*(fvar(5)<5)
guard.pausetime = 0,10
;hitspark---------------
sparkno = -1
guard.sparkno = S7000
sparkxy = -ceil(12*const(size.xscale)),ceil(10*const(size.yscale))
hitsound   = -1
guardsound = S3,0
;gethit anim------------
animtype = hard
ground.type = high
air.type = low
;movement---------------
ground.slidetime = 16
ground.hittime  = 18
air.hittime = 18
ground.velocity = -3-(fvar(5)>4.01),0
air.velocity = -2-(fvar(5)>4.01),-3.5
guard.velocity = -4-(fvar(5)>4.01)
airguard.velocity = -2-(fvar(5)>4.01),-3
fall = 0
fall.recover = 1
fall.recovertime = 35
yaccel = cond(root,var(43)>0,.35+.2*root,var(43),.35)
;power------------------
getpower = !numhelper(3500)*floor(56*root,fvar(1))
givepower = floor(28*root,fvar(1))
;misc-------------------
palfx.time = 30+4*(fvar(5)<5)
palfx.color = 128
palfx.mul = 180,180,180
palfx.add = root,var(11),root,var(12),root,var(13)
palfx.sinadd = root,var(11)/2+20,root,var(11)/2+20,root,var(11)/2+20,10
envshake.time = 20
fall.envshake.freq = 60.56
ground.cornerpush.veloff = 0
guard.kill = numhelper(3500)>0
