; Common state file for M.U.G.E.N 1.0
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defense increases at time = 0
; Downed get-hit (hit ground from fall) (5100):
;   defense increases at time = 0, player becomes invincible if within 10
;   ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = Pause
trigger1 = prevstateno = 19198
persistent = 0
time = 0
movetime = 0

[State 0]
type = RemoveExplod
trigger1 = prevstateno = 19198
persistent = 0
ID = 7438

[State 0]
type = AssertSpecial
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = time<200
trigger1 = enemy,stateno != 0
flag = intro

[State 0]
type = ChangeState
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = enemy,stateno != 0
trigger1 = !var(59)
trigger1 = command = "start"
value = 195

[State 0]
type = StopSnd
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
channel = -1

[State 0]
type = RemapPal
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
source = 1,1
dest = 1,palno

[State 0]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != [1,5]
trigger2 = (Anim = [1,5]) && AnimTime = 0 ;Turn anim over
value = 0
elem = 1+2*(Anim = 5)

[State 0]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0]
type = ChangeAnim
triggerall = !time
triggerall = anim = 0
trigger1 = (prevstateno = 20)
value = 0
elem = 3
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0
triggerall = prevstateno != [5000,5999]
triggerall = prevstateno != 19198
triggerall = time<10
trigger1 = animelemtime(1) = [0,10]
fvar(34) = 1+fvar(32)*.004*(animelemtime(1)-10)
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0
triggerall = prevstateno != [5000,5999]
triggerall = time<10
trigger1 = animelemtime(3) = [0,10]
fvar(34) = 1+fvar(32)*.004*(10-animelemtime(3))
ignorehitpause = 1
[State 0]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 0]
type = Offset
trigger1 = anim = 0
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))
;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
sprpriority = 0
anim = 11

[State 11]
type = VarSet
trigger1 = time<5
fvar(33) = 1+fvar(32)*.015*(5-time)+0*(fvar(34):=1+fvar(32)*.015*(time-5))
ignorehitpause = 1
[State 11]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 11] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20]
type = Width
trigger1 = 1
value = -5,-5

[State 20]
type = PlaySnd
triggerall = var(3)>0
triggerall = anim = [20,21]
trigger1 = animelem = 4
trigger2 = animelem = 10
value = S20,0
channel = 6

[State 20]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)*(1+.3*(numhelper(3500)>0))

[State 20]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)*(1+.3*(numhelper(3500)>0))

[State 20]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != [1,5]
trigger2 = (Anim = [1,5]) && AnimTime = 0
value = 20

[State 20]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != [1,5]
trigger2 = (Anim = [1,5]) && AnimTime = 0
value = 21

[State -1, AI charge]
type = RemoveExplod
triggerall = time>1
triggerall = var(59)
trigger1 = numexplod(5946)
trigger1 = vel x>0
id = 5946
[State -1, AI charge]
type = Explod
triggerall = time>1
triggerall = var(59)
trigger1 = vel x>0
anim = 9999
ID = 5946
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 20
sprpriority = -4
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0
[State -1, AI charge]
type = RemoveExplod
triggerall = time>1
triggerall = var(59)
trigger1 = numexplod(5928)
id = 5928
[State -1, AI charge]
type = Explod
triggerall = time>1
triggerall = var(59)
trigger1 = 1
anim = 9999
ID = 5928
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 20
sprpriority = -4
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40]
type = ChangeState ;reduce AI jumping
triggerall = prevstateno!=100
triggerall = prevstateno!=60
triggerall = !time
triggerall = var(59)>0
triggerall = p2statetype != L
triggerall = var(49)%11
trigger1 = (random%2=0)*(var(42)=0)
trigger1 = !inguarddist
value = 0
ctrl = 1
[State 40]
type = ChangeAnim
trigger1 = !time
value = 40

[State 40]
type = VarSet
trigger1 = prevstateno != 60
persistent = 0
var(1) = 0

[State 40]
type = AfterImageTime
trigger1 = prevstateno = 60
time = 2

[State 40]
type = VarSet
trigger1 = animelem = 1
var(32) = 1+0*(var(33):=1) ;airjump/airdash num

[State 40]
type = VarSet
trigger1 = !time
sysvar(1) = (var(1) >= 2)

[State 40]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"||command = "fwd"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = (p2bodydist x>60)||(var(1)=2)
sysvar(1) = 1

[State 40]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdback"||command = "back"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x = [0,60]
trigger2 = var(1)!=2
sysvar(1) = -1+1*(var(59)>0)*(random%5=0)

[State 40]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,0+(var(1)!=0)
channel = 5-6*(var(1)!=0)

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = var(1) != 0
persistent = 0
y = 1.2

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = var(1)>0
;trigger1 = sysvar(1)!=1
x = 0.5+.5*(var(1)=2)

[State 40]
type = VelSet
triggerall = AnimTime = 0
triggerall = sysvar(1) = 1
trigger1 = prevstateno = 100 ;RUN_FWD
trigger2 = prevstateno = 60
trigger2 = var(1) = 3
x = const(velocity.runjump.fwd.x)

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = numhelper(3500)
trigger1 = sysvar(1) = 1
x = 1.3

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45]
type = VarSet
trigger1 = prevstateno != 8000
persistent = 0
var(1) = 0

[State 45]
type = AfterImageTime
trigger1 = vel y<-2
trigger1 = anim = [60,62]
time = 4

[State 45]
type = VarAdd
trigger1 = prevstateno!=8000
persistent = 0
var(32) = -1 ;airjump num

[State 45]
type = VarSet
trigger1 = animelem = 1
sysvar(1) = (random%3-1)*(var(59)>0)

[State 45]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x>100
sysvar(1) = 1-1*(var(59)>0)*(random%3>0)

[State 45]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdback"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x = [0,50]
sysvar(1) = -1+1*(var(59)>0)*(random%3>0)

[State 45]
type = VelSet
trigger1 = animelemtime(1) >= 2
x = cond(sysvar(1)=0, const(velocity.airjump.neu.x), cond(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45]
type = ChangeAnim
trigger1 = prevstateno != 8000
persistent = 0
value = cond(sysvar(1)=0, 41, cond(sysvar(1)=1, 42, 43))

[State 45]
type = PlaySnd
trigger1 = animelemtime(1) >= 2
value = S40,0
channel = 5

[State 45]
type = ChangeState
trigger1 = animelemtime(1) >= 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50]
type = ChangeAnim
trigger1 = prevstateno = 45||anim != [41,43]
trigger1 = anim != [60,62]
persistent = 0
value = cond((vel x)=0, 41, cond((vel x)>0, 42, 43))

[State 50]
type = ChangeAnim
triggerall = !time
triggerall = var(1)!=0
trigger1 = anim != [60,62]
persistent = 0
value = 60+(sysvar(1)>0)*(SelfAnimExist(61))+2*(sysvar(1)<0)*(SelfAnimExist(62))

[State 50]
type = ChangeAnim
triggerall = !time
triggerall = sysvar(1)>=0
trigger1 = var(1) = [1,2]
persistent = 0
value = 60

[State 50]
type = ChangeAnim
triggerall = prevstateno = 40
triggerall = time = 2
triggerall = anim = [41,43]
trigger1 = var(59) = 0
trigger1 = command != "holdup"
trigger2 = var(59)
trigger2 = vel x>=0
trigger2 = !inguarddist
trigger2 = fvar(20)<150
trigger2 = fvar(21)>=0
trigger2 = var(49)%13 = 0
value = anim + 3

[State 50]
type = VelMul
trigger1 = anim = [44,46]
persistent = 0
x = .85
y = .7

[State 50]
type = VarSet
trigger1 = prevstateno!=8000
persistent = 0
sysvar(1) = 0

[State 50]
type = Explod
triggerall = anim = [60,62]
trigger1 = animelemtime(1) = [1,10]
trigger1 = time%3 = 0
anim = 7051+5*(numhelper(3500)>0)
ID = 7051
pos = 0,-ceil((30+50*(time%6=0))*const(size.yscale))
random = ceil(60*const(size.xscale)),ceil(20*const(size.xscale))
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
vel = 0,3
accel = 0,0
scale = .3*const(size.xscale),.3*const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

[State 50]
type = VelAdd
triggerall = vel y < 0
triggerall = anim = [60,62]
triggerall = vel x < const(velocity.airjump.fwd.x)*(1-.5*(var(1)=1))
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = var(1) = 2
x = .25

[State 50]
type = VelAdd
triggerall = vel y < 0
triggerall = anim = [60,62]
triggerall = vel x > const(velocity.airjump.back.x)*(1-.5*(var(1)>0))
trigger1 = var(59) = 0
trigger1 = command = "holdback"
x = -.25

[State 50]
type = AfterImageTime
triggerall = anim = [60,62]
trigger1 = animelemtime(1)<20
time = 2

[State -1, input buffer]
type = VarSet
triggerall = anim = [60,62]
trigger1 = prevstateno!=8000
persistent = 0
var(30) = 0
[State -1, input buffer]
type = VarSet
triggerall = anim = [60,62]
triggerall = var(56)
triggerall = var(59) = 0
trigger1 = command = "x"
var(30) = 600+5*(command = "holddown")
[State -1, input buffer]
type = VarSet
triggerall = anim = [60,62]
triggerall = var(56)
triggerall = var(59) = 0
trigger1 = command = "y"||command = "z"
var(30) = 610
[State -1, input buffer]
type = VarSet
triggerall = anim = [60,62]
triggerall = var(56)
triggerall = var(59) = 0
trigger1 = command = "a"
var(30) = 630
[State -1, input buffer]
type = VarSet
triggerall = anim = [60,62]
triggerall = var(56)
triggerall = var(59) = 0
trigger1 = command = "b"||command = "c"
var(30) = 640
[State -1, input buffer]
type = ChangeState
triggerall = roundstate = 2
triggerall = anim = [60,62]
triggerall = var(30)
triggerall = !var(20)
trigger1 = ctrl
value = var(30)
persistent = 0

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51]
type = VelAdd
trigger1 = prevstateno = [2000,3999]
y = .25
