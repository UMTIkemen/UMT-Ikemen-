trigger1 = 1
x = 0.85

[State 5110] ;Friction
type = VelSet
trigger1 = abs(Vel x) < Const(movement.down.friction.threshold)
persistent = 0
x = 0

[State 5110]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 5110]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

[State 5110]
type = VarSet
triggerall = time<10
trigger1 = prevstateno = 5100
trigger2 = prevstateno = 5101
trigger3 = prevstateno = 5071
fvar(33) = 1+fvar(32)*.01*(10-time)
ignorehitpause = 1
[State 5110]
type = AngleDraw
