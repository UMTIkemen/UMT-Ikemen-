triggerall = !var(59)
trigger1 = AnimTime = 0
trigger1 = command = "holdup"
value = 5120

[State 5110]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 5110] ;Friction
