value = 0
ctrl = 1

[State 52]
type = VarSet
trigger1 = time<10
fvar(33) = 1-fvar(32)*.1*abs(cos(Pi*time*.1))+0*(fvar(34):=1-fvar(32)*.1*sin(Pi*time*.1))
ignorehitpause = 1
[State 52]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 52]
