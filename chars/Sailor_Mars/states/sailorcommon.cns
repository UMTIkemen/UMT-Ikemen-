; Air get-hit (fall recovery in air)
[Statedef 5210]
type    = A
movetype= H
physics = N
anim = 5210
ctrl = 0

[State 5210]
type = PlaySnd
trigger1 = time = 1
value = S52,4

[State 5210]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
ignorehitpause = 1

[State 5210]
type = PosFreeze
trigger1 = Time < 4

[State 5210] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < Const720p(-80)

[State 5210, 1.0 behavior 1]
type = VelMul
trigger1 = Time = 4
x = Const(velocity.air.gethit.airrecover.mul.x)
y = Const(velocity.air.gethit.airrecover.mul.y)

[State 5210, 1.0 behavior 2]
type = VelAdd
trigger1 = Time = 4
x = Const(velocity.air.gethit.airrecover.add.x)
y = Const(velocity.air.gethit.airrecover.add.y)

[State 5210] ;Go up
type = VelAdd
triggerall = Time = 4
trigger1 = !var(59)
trigger1 = Command = "holdup"
trigger2 = var(59)
trigger2 = random%2
y = Const(velocity.air.gethit.airrecover.up)

[State 5210] ;Go down
type = VelAdd
triggerall = Time = 4
trigger1 = !var(59)
trigger1 = Command = "holddown"
trigger2 = var(59)
trigger2 = random%2
y = Const(velocity.air.gethit.airrecover.down)

[State 5210] ;Go fwd
type = VelAdd
triggerall = Time = 4
trigger1 = !var(59)
trigger1 = Command = "holdfwd"
trigger2 = var(59)
trigger2 = !inguarddist
x = Const(velocity.air.gethit.airrecover.fwd)

[State 5210] ;Go back
type = VelAdd
triggerall = Time = 4
trigger1 = !var(59)
trigger1 = Command = "holdback"
trigger2 = var(59)
trigger2 = inguarddist
x = Const(velocity.air.gethit.airrecover.back)

[State 5210] ;Normalize vel
type = VelSet
trigger1 = Time = 4
x = cond(abs(vel x)>5,5*vel x/(abs(vel x)),vel x)
y = cond(vel y>-1,-1,vel y)

[State 5210]
type = VelAdd
trigger1 = Time >= 4
y = Const(movement.air.gethit.airrecover.yaccel)

[State 5210]
type = PosSet
trigger1 = Time < 4
trigger1 = pos y > Const(movement.air.gethit.groundrecover.ground.threshold)
y = Const(movement.air.gethit.groundrecover.ground.threshold)

[State 5210, Voice]
type = PlaySnd
trigger1 = Time = 0
value = S52,10+random%2
channel = 0

[State 5210]
type = ChangeState
trigger1 = Time = 20
value = 51
ctrl = 1

[State 5210] ;Land on ground
type = ChangeState
trigger1 = Time >= 4
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;Jump land
ctrl = 1

[State 5210]
type = VarSet
trigger1 = time<20
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.1*sin(Pi*time*.05))
ignorehitpause = 1
[State 5210]
