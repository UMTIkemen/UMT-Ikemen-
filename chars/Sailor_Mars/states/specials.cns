[State -1, projectile cancel]
type = DestroySelf
trigger1 = !time
trigger1 = parent,movetype = H
ignorehitpause = 1
[State -1, projectile index]
type = ParentVarSet
trigger1 = ishelper(1000)
persistent = 0
var(35) = parent,var(35)*2
ignorehitpause = 1

[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = 1
value = root,fvar(3)-.15*(root,fvar(2)<1.0)
ignorehitpause = 1
[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = root,fvar(3)-.15*(root,fvar(2)<1.0)<.2
value = .2
ignorehitpause = 1

[State 1050]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1050]
type = VarSet
trigger1 = parent,stateno = 1010
trigger1 = !time
var(1) = 1
ignorehitpause = 1

[State 1050]
type = VarAdd
trigger1 = time>=5
var(3) = 1
ignorehitpause = 1

[State 1050]
type = VelSet
trigger1 = time = [12,31]
trigger1 = var(1)
x = (3.8+.1*time)*cos(Pi*(time-11)*.05)
y = -(2.8+.1*time)*sin(Pi*(time-11)*.05)
ignorehitpause = 1

[State 1050]
type = VelSet
trigger1 = time = [32,51]
trigger1 = var(1)
x = (10.1-.1*time)*cos(Pi*(time-11)*.05)
y = -(10.1-.1*time)*sin(Pi*(time-11)*.05)
ignorehitpause = 1

[State 1050]
type = PosAdd
trigger1 = time = [22,31]
trigger1 = var(1)
x = 1
ignorehitpause = 1

[State 1050]
