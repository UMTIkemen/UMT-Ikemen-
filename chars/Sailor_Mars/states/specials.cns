[State 1050, HitDef]
type = HitDef
trigger1 = !movecontact
id = stateno
attr = S, SP
priority = 3,Hit
Hitflag = MAF
guardflag = MA
damage    = 70,15
pausetime = 0,10
guard.pausetime = 0,10
;hitspark---------------
sparkno = -1
guard.sparkno = S7000
sparkxy = -ceil(12*const(size.xscale)),-ceil(10*const(size.yscale))
hitsound   = -1
guardsound = S3,0
;gethit anim------------
animtype = hard
ground.type = high
air.type = low
;movement---------------
ground.slidetime = 16
ground.hittime  = 16
air.hittime = 16
ground.velocity = -4,0
air.velocity = -3,-6
guard.velocity = -3.0416
airguard.velocity = -2.5416,-4
fall = 0
fall.recover = 1
fall.recovertime = 35
yaccel = cond(root,var(43)>0,.35+.2*root,var(43),.35)
;power------------------
getpower = !numhelper(3500)*floor(56*root,fvar(1))
givepower = floor(28*root,fvar(1))
;misc-------------------
palfx.time = 30
palfx.mul = 160,160,160
palfx.sinadd = 60,60,60,10
envshake.time = 20
fall.envshake.freq = 60.55
ground.cornerpush.veloff = 0
fall.envshake.phase = .4160
guard.kill = numhelper(3500)>0
