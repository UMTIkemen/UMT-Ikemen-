; soul bird
[Statedef 3050]
type    = S
movetype= A
physics = N
velset = 2.5,0
ctrl = 0
anim = 3050
poweradd = 0
sprpriority = 3

[State -1, projectile index]
type = ParentVarSet
trigger1 = ishelper(3000)
persistent = 0
var(35) = parent,var(35)*3
ignorehitpause = 1

[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = !movecontact
trigger2 = movecontact>=30
value = root,fvar(3)-.15*(root,fvar(2)<1.0)
ignorehitpause = 1
[State -2, AttackMulSet (Helper)]
type = AttackMulSet
triggerall = root,fvar(3)-.15*(root,fvar(2)<1.0)<.3
trigger1 = !movecontact
trigger2 = movecontact>=30
value = .3
ignorehitpause = 1

[State 3050]
type = AfterImage
trigger1 = time = 1
time = -1
length = 11
palbright = 0,0,0
palpostbright = 0,0,0
palcontrast = 30,30,30
paladd = 0,0,0
palmul = .75,.75,.75
trans = add
timegap = 1
framegap = 2
ignorehitpause = 0

[State 3050]
type = PosFreeze
trigger1 = time<5
trigger2 = movehit = [1,5]
ignorehitpause = 1

[State 3050]
type = PlaySnd
trigger1 = time = 10
value = S3000,1

[State 3050]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 3050]
type = VelAdd
triggerall = !numtarget
trigger1 = time>5
trigger1 = vel x<5
x = .5
ignorehitpause = 1

[State 3050]
type = VelSet
triggerall = numtarget
trigger1 = movecontact = 1
persistent = 0
x = 2.5
ignorehitpause = 1

[State 3050]
type = VelSet
trigger1 = movecontact>20
persistent = 0
x = 5
ignorehitpause = 1

[State 3050]
type = VelAdd
triggerall = time>5
triggerall = !numtarget
triggerall = p2dist x>0
triggerall = hitcount<4
triggerall = vel y>-2.1
trigger1 = p2dist y<50
y = -.3
ignorehitpause = 1

[State 3050]
type = VelAdd
triggerall = time>5
triggerall = !numtarget
triggerall = p2dist x>0
triggerall = hitcount<4
triggerall = vel y<2.1
trigger1 = p2dist y>80
y = .3
ignorehitpause = 1

[State 3050]
