supermovetime = 9999
ignorehitpause = 1
removeongethit = 1

[State 3050]
type = Trans
trigger1 = time<5
trans = addalpha
alpha = 40*time,256
ignorehitpause = 1

[State 3050]
type = Trans
trigger1 = time>=5
trans = addalpha
alpha = 200,256
ignorehitpause = 1

[State 3050, HitDef]
type = HitDef
triggerall = time>5
triggerall = var(1)<4
trigger1 = !movecontact
trigger2 = movecontact = 20
id = stateno+var(1)
attr = S, HP
priority = 6,Hit
Hitflag = MAF
guardflag = MA
damage    = 80,20
pausetime = 0,10
guard.pausetime = 0,10
;hitspark---------------
sparkno = -1
guard.sparkno = S7000
sparkxy = -ceil(12*const(size.xscale)),-ceil(10*const(size.yscale))
hitsound   = S1000,1
guardsound = S3,0
;gethit anim------------
animtype = hard
ground.type = high
air.type = low
;movement---------------
ground.slidetime = 16
ground.hittime  = 16
air.hittime = 16
ground.velocity = -3.5,-4+vel y*.5
air.velocity = -3.5,-4+vel y*.5
guard.velocity = -3.5416
airguard.velocity = -2.0416,-4
fall = 1
fall.recover = 0
yaccel = .5
;power------------------
getpower = 0
givepower = floor(28*root,fvar(1))
;misc-------------------
palfx.time = 30
palfx.mul = 160,160,160
palfx.sinadd = 60,60,60,10
envshake.time = 20
ground.cornerpush.veloff = 0
fall.envshake.freq = 61.55
fall.envshake.phase = .4160
