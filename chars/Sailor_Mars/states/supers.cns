[State 3050]
type = AngleDraw
trigger1 = time<5
scale = .5+.1*time,.5+.1*time
ignorehitpause = 1

[State 3050]
type = AngleDraw
trigger1 = time>=5
scale = 1,1
ignorehitpause = 1

[State 3050]
