; buffer
[Statedef 3550]
type    = A
movetype= I
physics = N
anim = 9999
velset = 0,0
sprpriority = -5
poweradd = 0

[State 3550]
type = VarSet
trigger1 = root,stateno = [200,799]
trigger1 = root,time = 1
var(1) = (numexplod(root,stateno)>0)

[State 3550]
type = VarSet
trigger1 = !time
var(53) = root,var(53)

[State 3550]
type = ParentVarSet
trigger1 = time = 1
var(53) = 0

[State 3550]
type = Explod
trigger1 = !numexplod(root,stateno)
trigger1 = root,stateno = [200,799]
trigger1 = root,time>1
anim = 9999
ID = root,stateno
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = -1
vel = 0,0
accel = 0,0
scale = 1,1
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 0
removeongethit = 0

[State 3550]
type = RemoveExplod
triggerall = root,stateno != 100
trigger1 = RoundState != 2
trigger2 = !root,alive
trigger3 = (root,movetype = H)||root,stateno=[120,159]
trigger4 = root,stateno = [2000,3499]
trigger4 = root,stateno<3000||(root,time>1)
trigger5 = time>180
trigger6 = root,ctrl

[State 3550]
type = ParentVarSet
triggerall = root,stateno != 100
triggerall = !numhelper(195)
trigger1 = RoundState != 2
trigger2 = !root,alive
trigger3 = (root,movetype = H)||root,stateno=[120,159]
trigger4 = root,stateno = [2000,3499]
trigger4 = root,stateno<3000||(root,time>1)
trigger5 = time>180
var(53) = var(53)

[State 3550]
type = DestroySelf
triggerall = root,stateno != 100
triggerall = root,stateno != 195
trigger1 = RoundState != 2
trigger2 = !root,alive
trigger3 = (root,movetype = H)||root,stateno=[120,159]
trigger4 = root,stateno = [2000,3499]
trigger4 = root,stateno<3000||(root,time>1)
trigger5 = time>180