trigger1 = prevstateno = 5200
persistent = 0
add = 0,0,0
time = 1

[State 52]
type = StopSnd
trigger1 = prevstateno = [600,640]
persistent = 0
channel = 5

[State 52]
type = PlaySnd
triggerall = !time
triggerall = (var(2)<=0)||(prevstateno>999)
trigger1 = prevstateno != 8000
persistent = 0
value = S52,0

[State 52]
type = VelSet
trigger1 = prevstateno != 8000
persistent = 0
y = 0

[State 52]
type = PosSet
trigger1 = prevstateno != 8000
persistent = 0
y = 0

[State 52]
type = VelSet
trigger1 = vel x!=0
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 52]
type = Explod
triggerall = !time
triggerall = (var(2)<=0)||(prevstateno>999)
trigger1 = prevstateno != 8000
