triggerall = roundstate = 2
triggerall = anim = 47
trigger1 = prevstateno<1000
trigger2 = time = 7
value = 1
persistent = 0

[State 52]
type = AssertSpecial
trigger1 = ctrl = 0
flag = nostandguard

[State 52]
