; Shabon Spray X
[Statedef 1000]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 1000+(prevstateno = [200,799])
poweradd = (prevstateno!=8000)*!numhelper(3500)*floor(70*fvar(1))
facep2 = (prevstateno = 645||prevstateno = 750)
sprpriority = 2

[State 1000, Voice]
type = PlaySnd
trigger1 = time = 1
value = S1000,10
channel = 0

[State 1000]
type = PlaySnd
trigger1 = time = 1
value = S1000,0

[State 1000]
type = PlaySnd
trigger1 = animelem = 5
value = S1000,1

[State 1000]
