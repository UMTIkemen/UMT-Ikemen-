trigger1 = animelem = 1
anim = 1030+anim%10
ID = 1000
pos = 0,-ceil(3*const(size.yscale))
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
vel = 0,0
accel = 0,0
scale = .2*const(size.xscale),.2*const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 0
supermovetime = 0
ignorehitpause = 0
removeongethit = 1

[State 1000]
type = ModifyExplod
trigger1 = numexplod(1000)
id = 1000
trans = addalpha
alpha = floor(180*var(3)/256),256

[State 1000]
type = Helper
trigger1 = animelem = 6
stateno = 1050
ID = 1050
name = "Spray"
pos = ceil(15*const(size.xscale)),-ceil(75*const(size.yscale))
postype = p1
facing = 1
ownpal = 1
size.xscale = .17*const(size.xscale)
size.yscale = .17*const(size.yscale)
pausemovetime = 0
supermovetime = 0
ignorehitpause = 1

[State 1000]
type = StateTypeSet
trigger1 = animelemtime(6)>0
persistent = 0
movetype = I

[State 1000]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1]
type = VarSet
triggerall = !var(59)
trigger1 = !time
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command = "holdx"||command = "holdy"||command = "holdz"
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command != "holdx"&&command != "holdy"&&command != "holdz"
var(20) = 0+0*(var(21):=0)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
triggerall = time>10
trigger1 = command = "x"||command = "y"||command = "z"
trigger2 = command = "holdx"&&command = "holdy"
trigger3 = command = "holdz"
var(20) = stateno-(stateno%100)+1000+0*(var(21):=var(56))

[State 1000]
type = ChangeState
triggerall = roundstate = 2
triggerall = power>=500
trigger1 = movetype = I
trigger1 = var(20) = 2000
value = var(20)+0*(var(21):=0)

[State 1000]
type = VarSet
triggerall = anim = [1000,1001]
trigger1 = animelemtime(6) = [0,10]
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.005*(10-animelemtime(6)))
ignorehitpause = 1

[State 1000]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 1000]
type = Offset
trigger1 = anim = [1000,1001]
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))
ignorehitpause = 1

