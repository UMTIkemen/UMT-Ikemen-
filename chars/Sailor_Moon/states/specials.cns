; tiara
[Statedef 1050]
type    = S
movetype= A
physics = N
velset = 6.5,0
ctrl = 0
anim = 1060
poweradd = 0
sprpriority = 3

[State -1, projectile cancel]
type = DestroySelf
trigger1 = !time
trigger1 = parent,movetype = H
ignorehitpause = 1
[State -1, projectile index]
type = ParentVarSet
trigger1 = ishelper(1000)
persistent = 0
var(35) = parent,var(35)*2
ignorehitpause = 1

[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = 1
value = root,fvar(3)-.15*(root,fvar(2)<1.0)
ignorehitpause = 1
[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = root,fvar(3)-.15*(root,fvar(2)<1.0)<.2
value = .2
ignorehitpause = 1

[State 1050]
type = PlaySnd
trigger1 = !time
value = S1000,2

[State 1050]
type = VarSet
trigger1 = !time
var(1) = (parent,stateno = 1010)

[State 1060]
type = AfterImage
trigger1 = !time
time = -1
length = 8
palbright = 0,0,0
palpostbright = 0,0,0
palcontrast = 25,25,25
paladd = 0,0,0
palmul = .9,.9,.9
trans = add
timegap = 1
framegap = 1
ignorehitpause = 0

[State 1050]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1050]
type = HitBy
trigger1 = !time
value = SCA,SP,HP
time = -1
ignorehitpause = 1

[State 1050]
type = HitOverride
trigger1 = !time
attr = SCA,AA,AP,AT
stateno = 1072
time = -1
ignorehitpause = 1

[State 1050]
type = VarAdd
trigger1 = time
var(5) = 18
ignorehitpause = 0

[State 1050, HitDef]
type = HitDef
trigger1 = !movecontact
id = 1000
attr = S, SP
priority = 3,Hit
Hitflag = MAF
guardflag = MA
damage    = 70,20
pausetime = 0,10
guard.pausetime = 0,10
;hitspark---------------
sparkno = -1
guard.sparkno = S7000
sparkxy = -ceil(12*const(size.xscale)),-ceil(15*const(size.yscale))
hitsound   = -1
guardsound = S3,0
;gethit anim------------
animtype = hard
ground.type = high
air.type = low
;movement---------------
ground.slidetime = 16
ground.hittime  = 16
guard.hittime = 11
air.hittime = 16
ground.velocity = -4,0
air.velocity = -3,-6
guard.velocity = -3
airguard.velocity = -2.5,-4
fall = 0
fall.recover = 1
fall.recovertime = 35
yaccel = cond(root,var(43)>0,.35+.2*root,var(43),.35)
;power------------------
getpower = !numhelper(3500)*floor(56*root,fvar(1))
givepower = floor(28*root,fvar(1))
;misc-------------------
palfx.time = 15
palfx.color = 256
palfx.mul = 220,220,220
palfx.add = root,var(8)-30,root,var(9)-30,root,var(10)-30
palfx.sinadd = root,var(8),root,var(9),root,var(10),10
envshake.time = 20
fall.envshake.freq = 60.53
ground.cornerpush.veloff = 0
guard.kill = numhelper(3500)>0
[State -2, Juggling (Helper)]
type = ParentVarAdd
triggerall = movehit
triggerall = numtarget(1000)
trigger1 = target(1000),hitfall
var(43) = 1
persistent = 0 
ignorehitpause = 1

