; Moon Tiara X
[Statedef 1000]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 1000+(prevstateno = [200,799])
poweradd = (prevstateno!=8000)*!numhelper(3500)*floor(70*fvar(1))
sprpriority = 2
facep2 = (prevstateno = 645||prevstateno = 750)

[State 1000, Voice]
type = PlaySnd
trigger1 = time = 1
value = S1000,10
channel = 0

[State 1000]
type = PlaySnd
trigger1 = animelem = 3
value = S1000,0

[State 1000]
type = RemoveExplod
trigger1 = animelem = 2
id = 1000

[State 1000]
type = Explod
trigger1 = animelem = 3
anim = 1040
ID = 1040
pos = ceil(20*const(size.xscale)),-ceil(73*const(size.yscale))
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
vel = 0,0
accel = 0,0
scale = .3*const(size.xscale),.45*const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 0
supermovetime = 0
ignorehitpause = 0
removeongethit = 1

[State 1000]
type = Helper
trigger1 = animelem = 3
stateno = 1050
ID = 1000
name = "Tiara"
pos = ceil(15*const(size.xscale)),-ceil(75*const(size.yscale))
postype = p1
facing = 1
ownpal = 1
size.xscale = .325*const(size.xscale)
size.yscale = .325*const(size.yscale)
pausemovetime = 0
supermovetime = 0
ignorehitpause = 1

[State 1000]
type = StateTypeSet
trigger1 = animelemtime(3)>0
persistent = 0
movetype = I

[State 1000]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1]
type = VarSet
triggerall = !var(59)
trigger1 = !time
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command = "holdx"||command = "holdy"||command = "holdz"
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command != "holdx"&&command != "holdy"&&command != "holdz"
var(20) = 0+0*(var(21):=0)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
triggerall = time>10
trigger1 = command = "x"||command = "y"||command = "z"
trigger2 = command = "holdx"&&command = "holdy"
trigger3 = command = "holdz"
var(20) = stateno-(stateno%100)+1000+0*(var(21):=var(56))

[State 1000]
type = ChangeState
triggerall = roundstate = 2
triggerall = power>=500
trigger1 = movetype = I
trigger1 = var(20) = 2000
value = var(20)+0*(var(21):=0)

[State 1000]
type = VarSet
triggerall = anim = [1000,1001]
trigger1 = animelemtime(3)<0
trigger1 = time<10
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.003*(10-time))
ignorehitpause = 1

[State 1000]
type = VarSet
triggerall = anim = [1000,1001]
trigger1 = animelemtime(3) = [0,10]
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.05*sin(Pi*animelemtime(3)*.1))
ignorehitpause = 1

[State 1000]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 1000]
type = Offset
trigger1 = anim = [1000,1001]
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))
ignorehitpause = 1

