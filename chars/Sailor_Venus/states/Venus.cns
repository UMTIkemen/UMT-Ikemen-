; Air guard (guarding)
[Statedef 132]
type    = A
physics = N

[State 132]
type = ChangeAnim
trigger1 = Anim != 132+var(14)
value = 132+var(14)

[State 132]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, Air to Hi]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = (command = "holdback"&&var(59)>0)
trigger1 = inguarddist
value = 130

[State 132]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
trigger1 = var(59) = 0
trigger1 = command != "holdback"
trigger2 = !inguarddist
trigger2 = time>10
trigger3 = var(59)>0
trigger3 = enemynear,hitdefattr = SCA, AT
value = 140

;---------------------------------------------------------------------------
; Guard (end)
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1

[State 140]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A)*2 + var(14)

[State 140]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && (command = "holddown"&&var(59)=0)
statetype = C
physics = C

[State 140, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && (command != "holddown"&&var(59)=0)
statetype = S
physics = S

