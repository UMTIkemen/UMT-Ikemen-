[Data]
life = 950
power = 3000
attack = 110
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 25
sparkno = 2
guard.sparkno = S7000
KO.echo = 0
volume = 100
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 56
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 16     ;Player width (back, ground)
ground.front = 17    ;Player width (front, ground)
air.back = 14        ;Player width (back, air)
air.front = 14       ;Player width (front, air)
height = 65          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1     ;Set to 1 to scale projectiles too
head.pos = 0, -85   ;Approximate position of head
mid.pos = 0, -55  ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -2.0    ;Walk backward
run.fwd  = 4.35, 0    ;Run forward (x, y)
run.back = -5,-5 	;Hop backward (x, y)
jump.neu = 0,-8    ;Neutral jumping velocity (x, y)
jump.back = -3    ;Jump back Speed (x, y)
jump.fwd = 3       ;Jump forward Speed (x, y)
airjump.neu = 0,-6.5     ;Air jump speeds (opt)
airjump.back = -2.4
airjump.fwd = 2.4
runjump.fwd = 3.5
air.gethit.groundrecover = -4,0    ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = 0,0     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = -1,-4     ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -2       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 2         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 2        ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 25   ;Minimum distance from ground before you can air jump (opt)
yaccel = .44          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .5    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

;IKEMEN only
[Constants]
Default.LegacyGameDistanceSpec = 0  ; 1 prevents GameWidth/GameHeight from being affected by stage zoom for mugenversion 1.0 chars

;Default language victory quotes (optional).  **MUGEN 1.0**
;If this section is included, the default language victory quotes must be in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory0 = "The legendary mask is a thing of the past and the beautiful face revealed! I am Sailor Venus!"
victory1 = "Sailor V is for victory! One step closer to becoming an idol!"
victory2 = "The judgement of love is done and justice prevails!"
victory3 = "No matter how hard the fight, I never give up."
victory4 = "You think I'm just a pretty blonde? In my case what you see is definitely not what you get."
victory5 = "Don't worry, you will do better next time. As they say, there's no use crying over misspelled silk."

;character-specific:
;vs Sailor Moon
victory6 = "...and the main character spotlight goes to Sailor V!"
;vs Sailor Jupiter
victory7 = "Mako-chan, let's go grab some sweets now! As they say, chocolate a day keeps the flu away."
;vs celebrities
victory8 = "Here is my Fan Club Membership card! Can I get an autograph, please?"

;---------------------------------------------------------------------------
; Vars
;---------------------------------------------------------------------------
;************************
; State vars
;************************
; var(1) - states 40, 50, 60 (superjump flag)
; var(2) - states 1230, 1400-1430, 3000
; var(3) - transparency for EX aura
; vars(4-6) - local vars (for immediate usage)
; var(7) - Aqua Mist invisibility timer

; vars(8-10) - light PalFX colors
; vars(11-13) - state 3000
; var(14) - Sailor V mask

;************************
; System stuff
;************************
; var(20) - global input buffer (used for long inputs in state -1)
; var(21) - global input buffer timer
; var(22) - p2 ID
; var(23) - p4 ID
; var(24) - p1 life buffer (used for defence boost)
; var(25) - p2 life buffer (used for damage dampening)
; var(26) - p4 life buffer (used for damage dampening)
; var(30) - local input buffer (used for short inputs in some states)
; var(31) - autocombo flag
; var(32) - airjump num
; var(33) - airdash num
; var(35) - projectile index
; var(36) - darken bg
; var(40) - first attack flag
; var(41) - counter flag
; var(42) - enemy hitfall flag
; var(43) - special juggle buffer
; var(49) - AI p2 state index

;************************
; Customisable
;************************
; ~integers~
; var(52) - special KO effects on/off
; var(53) - projectile limit on/off
; var(54) - eyecatch intro on/off
; var(55) - supermove music volume
; var(56) - input buffer additional frames
; var(57) - attack/guard canceling by dashes on/off
; var(58) - Rolling Heart Vibration duration

; ~floats~
; fvar(1) - power gain multiplier
; fvar(32) - scaling effect factor

;************************
; Other
;************************
; ~integers~
; var(59) - AI difficulty modifier

; ~floats~
; fvar(2) - damage multiplier
; fvar(3) - attack value
; fvar(4) - state 193
; fvar(10) - rng
; fvar(11) - attack value buffer
; fvar(15) - superarmor hit ID
; fvar(20) - p2 dist x for AI
; fvar(21) - p2 dist y for AI
; fvar(30) - screen height
; fvar(31) - screen width
; fvar(33) - character X scaling effect
; fvar(34) - character Y scaling effect
; fvar(35) - character X offset
; fvar(36) - character Y offset


;---------------------------------------------------------------------------
; Sound Channels
;---------------------------------------------------------------------------
; 0 - character voice
; 5 - jumps/landing stomps
; 6 - dashes
; 7 - long sounds (supermoves mostly)

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = Pause
trigger1 = prevstateno = 19198
trigger2 = prevstateno = 19180
persistent = 0
time = 0
movetime = 0

[State 0]
type = RemoveExplod
trigger1 = prevstateno = 19198
persistent = 0
ID = 7438

[State 0]
type = StopSnd
trigger1 = prevstateno = 19180
persistent = 0
channel = 7

[State 0]
type = PalFx
trigger1 = prevstateno = 19180
persistent = 0
time = 1

[State 0]
type = PosSet
trigger1 = roundstate = 2
trigger1 = prevstateno = [950,999]
persistent = 0
x = fvar(10)

[State 0]
type = AssertSpecial
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = time<200
trigger1 = enemy,stateno != 0
flag = intro

[State 0]
type = ChangeState
triggerall = (prevstateno<195)||(prevstateno=19198)
triggerall = roundstate = 1
triggerall = enemy,stateno != 0
trigger1 = !var(59)
trigger1 = command = "start"
value = 195

[State 0]
type = StopSnd
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
channel = -1

[State 0]
type = RemapPal
triggerall = roundstate>1
trigger1 = prevstateno = [190,194]
trigger2 = prevstateno = [900,999]
trigger3 = prevstateno = 19198
persistent = 0
source = 1,1
dest = 1,palno

[State 0]
type = ChangeAnim
trigger1 = Anim = 5
trigger1 = Anim != 5+var(14)
value = 5+var(14)

[State 0]
type = ChangeAnim
trigger1 = Anim-var(14) != [0,5]
trigger2 = (Anim-var(14) = [1,5]) && AnimTime = 0 ;Turn anim over
value = 0+var(14)
elem = 1+3*(Anim = 5+var(14))

[State 0]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0]
type = ChangeAnim
triggerall = !time
triggerall = anim = 0+var(14)
trigger1 = (prevstateno = 101)||(prevstateno = 195)
trigger2 = (prevstateno = 200)||(prevstateno = 210)||(prevstateno = 230)
trigger3 = (prevstateno = 705)||(prevstateno = 750)||(prevstateno = 800)||(prevstateno = [901,903])
trigger4 = (prevstateno = [1200,1210])
trigger5 = (prevstateno = 3000)||(prevstateno = 3500)
value = 0+var(14)
elem = 3
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0+var(14)
triggerall = prevstateno != [5000,5999]
triggerall = prevstateno != 19198
triggerall = time<10
trigger1 = animelemtime(1) = [0,10]
fvar(34) = 1+fvar(32)*.004*(animelemtime(1)-10)
ignorehitpause = 1
[State 0]
type = VarSet
triggerall = anim = 0+var(14)
triggerall = prevstateno != [5000,5999]
triggerall = time<10
trigger1 = animelemtime(3) = [0,10]
fvar(34) = 1+fvar(32)*.004*(10-animelemtime(3))
ignorehitpause = 1
[State 0]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 0]
type = AssertSpecial
trigger1 = prevstateno = 192
trigger1 = time<.6*tickspersecond
flag = Intro

[State 0]
type = Offset
trigger1 = anim = 0+var(14)
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10+var(14)

[State 10]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10]
type = ChangeAnim
trigger1 = prevstateno = 245
trigger2 = prevstateno = 440
value = 10+var(14)
elem = 2
persistent = 0

[State 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
sprpriority = 0
anim = 11+var(14)

[State 11]
type = VarSet
trigger1 = time<5
fvar(33) = 1+fvar(32)*.015*(5-time)+0*(fvar(34):=1+fvar(32)*.015*(time-5))
ignorehitpause = 1
[State 11]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 0]
type = ChangeAnim
trigger1 = Anim = 6
trigger1 = Anim != 6+var(14)
value = 6+var(14)

[State 11] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6+var(14) && AnimTime = 0
value = 11+var(14)

[State 11] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+var(14)

[State 12]
type = AssertSpecial
trigger1 = prevstateno = 440
flag = nowalk

[State 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20]
type = Width
trigger1 = 1
value = -5,-5

[State 20]
type = PlaySnd
triggerall = var(3)>0
triggerall = anim = [20,21]
trigger1 = animelem = 4
trigger2 = animelem = 10
value = S20,0
channel = 6

[State 20]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)*(1+.3*(numhelper(3500)>0))

[State 20]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)*(1+.3*(numhelper(3500)>0))

[State 20]
type = ChangeAnim
trigger1 = Anim = 5
trigger1 = Anim != 5+var(14)
value = 5+var(14)

[State 20]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(14) && Anim-var(14) != [1,5]
trigger2 = (Anim-var(14) = [1,5]) && AnimTime = 0
value = 20+var(14)

[State 20]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(14) && Anim-var(14) != [1,5]
trigger2 = (Anim-var(14) = [1,5]) && AnimTime = 0
value = 21+var(14)

[State -1, AI charge]
type = RemoveExplod
triggerall = time>1
triggerall = var(59)
trigger1 = numexplod(5946)
trigger1 = vel x>0
id = 5946
[State -1, AI charge]
type = Explod
triggerall = time>1
triggerall = var(59)
trigger1 = vel x>0
anim = 9999
ID = 5946
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 20
sprpriority = -4
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0
[State -1, AI charge]
type = RemoveExplod
triggerall = time>1
triggerall = var(59)
trigger1 = numexplod(5928)
id = 5928
[State -1, AI charge]
type = Explod
triggerall = time>1
triggerall = var(59)
trigger1 = 1
anim = 9999
ID = 5928
pos = 0,0
postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 20
sprpriority = -4
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40]
type = ChangeState ;reduce AI jumping
triggerall = prevstateno!=100
triggerall = prevstateno!=60
triggerall = !time
triggerall = var(59)>0
triggerall = p2statetype != L
triggerall = var(49)%11
triggerall = p2stateno != 12713
trigger1 = (random%2=0)*(var(42)=0)
trigger1 = !inguarddist
value = 0
ctrl = 1
[State 40]
type = ChangeAnim
trigger1 = !time
value = 40+var(14)

[State 40]
type = VarSet
trigger1 = prevstateno != 60
persistent = 0
var(1) = 0

[State 40]
type = AfterImageTime
trigger1 = prevstateno = 60
time = 2

[State 40]
type = VarSet
trigger1 = animelem = 1
var(32) = 1+0*(var(33):=1) ;airjump/airdash num

[State 40]
type = VarSet
trigger1 = !time
sysvar(1) = (var(1) >= 2)

[State 40]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"||command = "fwd"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = (p2bodydist x>60)||(var(1)=2)
sysvar(1) = 1

[State 40]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdback"||command = "back"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x = [0,60]
trigger2 = var(1)!=2
sysvar(1) = -1+1*(var(59)>0)*(random%5=0)

[State 40]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,0+(var(1)!=0)
channel = 5-6*(var(1)!=0)

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = var(1) != 0
persistent = 0
y = 1.2

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = var(1)>0
;trigger1 = sysvar(1)!=1
x = 0.5+.5*(var(1)=2)

[State 40]
type = VelSet
triggerall = AnimTime = 0
triggerall = sysvar(1) = 1
trigger1 = prevstateno = 100 ;RUN_FWD
trigger2 = prevstateno = 60
trigger2 = var(1) = 3
x = const(velocity.runjump.fwd.x)

[State 40]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = numhelper(3500)
trigger1 = sysvar(1) = 1
x = 1.3

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45]
type = VarSet
trigger1 = prevstateno != 8000
persistent = 0
var(1) = 0

[State 45]
type = AfterImageTime
trigger1 = vel y<-2
trigger1 = anim-var(14) = [60,62]
time = 4

[State 45]
type = VarAdd
trigger1 = prevstateno!=8000
persistent = 0
var(32) = -1 ;airjump num

[State 45]
type = VarSet
trigger1 = animelem = 1
sysvar(1) = (random%3-1)*(var(59)>0)

[State 45]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x>100
sysvar(1) = 1-1*(var(59)>0)*(random%3>0)

[State 45]
type = VarSet
trigger1 = var(59) = 0
trigger1 = command = "holdback"
trigger2 = (var(59)>0)&&(roundstate=2)
trigger2 = p2bodydist x = [0,50]
sysvar(1) = -1+1*(var(59)>0)*(random%3>0)

[State 45]
type = VelSet
trigger1 = animelemtime(1) >= 2
x = cond(sysvar(1)=0, const(velocity.airjump.neu.x), cond(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45]
type = ChangeAnim
trigger1 = prevstateno != 8000
persistent = 0
value = cond(sysvar(1)=0, 41, cond(sysvar(1)=1, 42, 43))+var(14)

[State 45]
type = PlaySnd
trigger1 = animelemtime(1) >= 2
value = S40,0
channel = 5

[State 45]
type = ChangeState
trigger1 = animelemtime(1) >= 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50]
type = ChangeAnim
trigger1 = prevstateno = 45||anim-var(14) != [41,43]
trigger1 = anim-var(14) != [60,62]
persistent = 0
value = cond((vel x)=0, 41, cond((vel x)>0, 42, 43))+var(14)

[State 50]
type = ChangeAnim
triggerall = !time
triggerall = var(1)!=0
trigger1 = anim-var(14) != [60,62]
persistent = 0
value = 60+(sysvar(1)>0)*(SelfAnimExist(61))+2*(sysvar(1)<0)*(SelfAnimExist(62))+var(14)

[State 50]
type = ChangeAnim
triggerall = !time
triggerall = sysvar(1)>=0
trigger1 = var(1) = [1,2]
persistent = 0
value = 60+var(14)

[State 50]
type = ChangeAnim
triggerall = prevstateno = 40
triggerall = time = 2
triggerall = anim-var(14) = [41,43]
trigger1 = var(59) = 0
trigger1 = command != "holdup"
trigger2 = var(59)
trigger2 = vel x>=0
trigger2 = !inguarddist
trigger2 = fvar(20)<150
trigger2 = fvar(21)>=0
trigger2 = var(49)%13 = 0
value = anim + 3

[State 50]
type = VelMul
trigger1 = anim-var(14) = [44,46]
persistent = 0
x = .85
y = .7

[State 50]
type = VarSet
trigger1 = prevstateno!=8000
persistent = 0
sysvar(1) = 0

[State 50]
type = Explod
triggerall = anim-var(14) = [60,62]
trigger1 = animelemtime(1) = [1,10]
trigger1 = time%3 = 0
anim = 7051+5*(numhelper(3500)>0)
ID = 7051
pos = 0,-ceil((30+50*(time%6=0))*const(size.yscale))
random = ceil(60*const(size.xscale)),ceil(20*const(size.xscale))
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
vel = 0,3
accel = 0,0
scale = .3*const(size.xscale),.3*const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
removeongethit = 0

[State 50]
type = VelAdd
triggerall = vel y < 0
triggerall = anim-var(14) = [60,62]
triggerall = vel x < const(velocity.airjump.fwd.x)*(1-.5*(var(1)=1))
trigger1 = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = var(1) = 2
x = .25

[State 50]
type = VelAdd
triggerall = vel y < 0
triggerall = anim-var(14) = [60,62]
triggerall = vel x > const(velocity.airjump.back.x)*(1-.5*(var(1)>0))
trigger1 = var(59) = 0
trigger1 = command = "holdback"
x = -.25

[State 50]
type = AfterImageTime
triggerall = anim-var(14) = [60,62]
trigger1 = animelemtime(1)<20
time = 2

[State -1, input buffer]
type = VarSet
triggerall = anim-var(14) = [60,62]
trigger1 = prevstateno!=8000
persistent = 0
var(30) = 0
[State -1, input buffer]
type = VarSet
triggerall = anim-var(14) = [60,62]
triggerall = var(56)
triggerall = var(59) = 0
trigger1 = command = "x"
var(30) = 600+5*(command = "holddown")
[State -1, input buffer]
