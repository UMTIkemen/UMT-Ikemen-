supermovetime = 0
ignorehitpause = 1

[State 1000]
type = StateTypeSet
trigger1 = animelemtime(5) = 5
persistent = 0
movetype = I

[State 1000]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1]
type = VarSet
triggerall = !var(59)
trigger1 = !time
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command = "holdx"||command = "holdy"||command = "holdz"
var(20) = 1+0*(var(21):=2)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
trigger1 = command != "holdx"&&command != "holdy"&&command != "holdz"
var(20) = 0+0*(var(21):=0)
[State -1]
type = VarSet
triggerall = !var(59)
triggerall = var(20) = 1
triggerall = time>10
trigger1 = command = "x"||command = "y"||command = "z"
trigger2 = command = "holdx"&&command = "holdy"
trigger3 = command = "holdz"
var(20) = stateno-(stateno%100)+1000+0*(var(21):=var(56))

[State 1000]
type = ChangeState
triggerall = roundstate = 2
triggerall = power>=500
trigger1 = movetype = I
trigger1 = var(20) = 2000
value = var(20)+0*(var(21):=0)

[State 1000]
type = VarSet
triggerall = anim = 1000+var(14)
trigger1 = animelemtime(2) = [0,13]
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.05*sin(Pi*animelemtime(2)*.077))
ignorehitpause = 1

[State 1000]
type = VarSet
triggerall = anim = 1001+var(14)
trigger1 = animelemtime(1) = [0,9]
fvar(33) = 1+0*(fvar(34):=1+fvar(32)*.05*sin(Pi*animelemtime(1)*.11))
ignorehitpause = 1

[State 1000]
type = AngleDraw
trigger1 = fvar(33) != 1.0
trigger2 = fvar(34) != 1.0
scale = fvar(33),fvar(34)
value = 0
ignorehitpause = 1

[State 1000]
type = Width
trigger1 = animelemno(0) = [5,9]
value = ceil(15*const(size.xscale)),0
ignorehitpause = 1

[State 1000]
type = Offset
trigger1 = anim-var(14) = [1000,1001]
y = floor(3*const(size.yscale))+0*(fvar(36):=floor(3*const(size.yscale)))
ignorehitpause = 1

