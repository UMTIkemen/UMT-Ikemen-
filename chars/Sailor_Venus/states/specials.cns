; beam
[Statedef 1050]
type    = S
movetype= A
physics = N
velset = 7*const(size.xscale),0
ctrl = 0
anim = 1050
poweradd = 0
sprpriority = 3

[State -1, projectile cancel]
type = DestroySelf
trigger1 = !time
trigger1 = parent,movetype = H
ignorehitpause = 1
[State -1, projectile index]
type = ParentVarSet
trigger1 = ishelper(1000)
persistent = 0
var(35) = parent,var(35)*2
ignorehitpause = 1

[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = 1
value = root,fvar(3)-.15*(root,fvar(2)<1.0)
ignorehitpause = 1
[State -2, AttackMulSet (Helper)]
type = AttackMulSet
trigger1 = root,fvar(3)-.15*(root,fvar(2)<1.0)<.2
value = .2
ignorehitpause = 1

[State 1050]
type = VarSet
trigger1 = !time
trigger1 = parent,stateno = 1010
persistent = 0
var(1) = 1
ignorehitpause = 0

[State 1050]
type = PlaySnd
trigger1 = time = 1
persistent = 0
value = S1000,1

[State 1050]
type = PalFx
trigger1 = !time
mul = 300,300,300
time = -1

[State 1050]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1050]
type = HitBy
trigger1 = !time
value = SCA,SP,HP
time = -1
ignorehitpause = 1

[State 1050]
type = HitOverride
trigger1 = !time
attr = SCA,AA,AP,AT
stateno = 1060
time = -1
ignorehitpause = 1

[State 1050]
type = Explod
trigger1 = time>2
anim = 7315
ID = 1020
pos = -ceil(4.5*var(2)*const(size.xscale)),ceil((4-8*(gametime%2=0))*const(size.yscale))
random = ceil(7*var(2)*const(size.xscale)),ceil(8*const(size.yscale))
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = 3
vel = 0,0
accel = 0*(fvar(10):=.1+.00005*random),.5-(gametime%2=0)
scale = .5*fvar(10),.5*fvar(10)
sprpriority = -3
ontop = 0
ownpal = 1
pausemovetime = 0
supermovetime = 0
ignorehitpause = 0
removeongethit = 0

[State 1050, HitDef]
type = HitDef
trigger1 = !movecontact
id = stateno
attr = S, SP
priority = 3,Hit
Hitflag = MAF
guardflag = MA
damage    = 60+5*var(1),15+5*var(1)
pausetime = 0,10
guard.pausetime = 0,10
;hitspark---------------
sparkno = -1
guard.sparkno = S7000
sparkxy = -ceil(12*const(size.xscale)),0
hitsound   = -1
guardsound = S3,0
;gethit anim------------
animtype = hard
ground.type = high
air.type = low
;movement---------------
ground.slidetime = 16
ground.hittime  = 16
air.hittime = 16
ground.velocity = -5-var(1),0
air.velocity = -3.5,-5
guard.velocity = -2
airguard.velocity = -3,-3.5
fall = 0
fall.recover = 1
fall.recovertime = 35
yaccel = cond(root,var(43)>0,.35+.2*root,var(43),.35)
;power------------------
getpower = !numhelper(3500)*floor(56*root,fvar(1))
givepower = floor(28*root,fvar(1))
;misc-------------------
palfx.time = 15
palfx.color = 200
palfx.mul = 220,220,220
palfx.add = root,var(8),root,var(9),root,var(10)
palfx.sinadd = root,var(8),root,var(9),root,var(10),10
envshake.time = 20
fall.envshake.freq = 60.57
ground.cornerpush.veloff = 0
guard.kill = numhelper(3500)>0
[State -2, Juggling (Helper)]
type = ParentVarAdd
triggerall = movehit
triggerall = numtarget(stateno)
trigger1 = target(stateno),hitfall
var(43) = 1
persistent = 0 
ignorehitpause = 1

