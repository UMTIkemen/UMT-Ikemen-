postype = p1
facing = 1
vfacing = 1
bindtime = -1
removetime = 10
vel = 0,0
accel = 0,0
scale = .2*const(size.xscale),.35*const(size.yscale)
trans = add
sprpriority = 4
ontop = 0
ownpal = 0
pausemovetime = 0
supermovetime = 0
removeongethit = 1
ignorehitpause = 0

[State 1000]
type = ModifyExplod
trigger1 = anim = 1000+var(14)
trigger1 = numexplod(1030)
trigger1 = animelemtime(1)<6
ID = 1030
scale = .2*const(size.xscale),(.35-.032*animelemtime(1))*const(size.yscale)
trans = addalpha
alpha = 42*animelemtime(1),256

[State 1000]
type = ModifyExplod
