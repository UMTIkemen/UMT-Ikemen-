; Crescent Beam X
[Statedef 1000]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 1000+(prevstateno = [200,799])+var(14)
poweradd = (prevstateno!=8000)*!numhelper(3500)*floor(70*fvar(1))
facep2 = (prevstateno = 615||prevstateno = 750)
sprpriority = 2

[State 1000]
type = PosAdd
trigger1 = prevstateno = 210
persistent = 0
x = 10

[State 1000, Voice]
