type = VarSet
trigger1 = movetype = H
var(7) = 0
ignorehitpause = 1
;+++++++++++++++++++++++++

;Prefect Guard----------------------------
[State -2, Prefect Guard]
type = LifeSet
triggerall = numhelper(7000)
trigger1 = helper(7000),var(10)>0
trigger1 = life<helper(7000),var(24)
trigger1 = stateno = [120,159]
value = helper(7000),var(24)
ignorehitpause = 1

[State -2, Prefect Guard]
type = PalFx
triggerall = gametime%9 = 0
triggerall = numexplod(120)
trigger1 = stateno = [120,159]
time = 6
sinadd = 64,64,64,12
ignorehitpause = 1

[State -2, Perfect Guard]
type = RemoveExplod
triggerall = stateno != [120,159]
trigger1 = numhelper(7000)
trigger1 = prevstateno = [120,159]
trigger1 = time = 1
trigger1 = helper(7000),cond(root,numexplod(120)>0,0*(var(10):=0),0*(var(10):=-20*(root,numexplod(121)=0)))
trigger2 = numexplod(120)
id = 120

[State -2, Perfect Guard]
type = RemoveExplod
triggerall = stateno != [120,159]
trigger1 = numexplod(121)
id = 121
;-----------------------------------------

;MASK OFF++++++++++++++++
[State -2, Sailor V Mask]
type = Explod
triggerall = !numexplod(14999)
triggerall = time = 1
triggerall = var(14)!=0
triggerall = !gethitvar(isbound)
trigger1 = movetype = H
trigger1 = stateno != [120,159]
persistent = 0
anim = 14999
ID = 14999
pos = -ceil(5*const(size.xscale)),-ceil((80-35*(statetype=C&&gethitvar(type)<3))*const(size.yscale))
postype = p1
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
vel = -1.5,-1-.5*(statetype = C)
accel = 0,.2
scale = const(size.xscale),const(size.yscale)
sprpriority = 3
ontop = 0
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
removeongethit = 0
ignorehitpause = 1

[State -2, Sailor V Mask]
type = VarSet
triggerall = time = 1
triggerall = var(14)!=0
trigger1 = movetype = H
trigger1 = stateno != [120,159]
var(14) = 0
ignorehitpause = 1
;+++++++++++++++++++++++++

[State -2, Venus Love Me Chain explod]
type = RemoveExplod
triggerall = numexplod(1220)
trigger1 = stateno != [1200,1215]
trigger2 = movetype = H
id = 1220
[State -2, Venus Love Me Chain explod]
type = RemoveExplod
triggerall = numexplod(11220)
trigger1 = stateno != [1200,1215]
trigger2 = movetype = H
id = 11220

[State -2]
type = DisplayToClipboard
trigger1 = 1
text="Dist x %d\nDist y %d"
params = fvar(20),fvar(21)
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

[State -3, Get Hit Sound]
type = PlaySnd
triggerall = numenemy
triggerall = alive && time=1
triggerall = random<400
trigger1 = stateno=5000||stateno=5010||stateno=5020||stateno=5080
trigger2 = stateno=5100
trigger3 = (stateno=5001||stateno=5011||stateno=5030)&&prevstateno!=[5000,5999]
value = S5000,0+random%3
channel = 0
ignorehitpause = 1
persistent = 0

[State -3, Get Hit Sound]
type = PlaySnd
triggerall = numenemy
triggerall = alive && time=1
triggerall = (numenemy*(enemynear,hitdefattr = SCA,HA,HP))||(gethitvar(fall)=1)
triggerall = random<400
trigger1 = stateno=5000||stateno=5010||stateno=5020||stateno=5070
trigger2 = (stateno = 5030||stateno=5050||stateno=5100)&&prevstateno!=[5000,5999]
value = S5000,3+random%2
channel = 0
ignorehitpause = 1
persistent = 0

[State -3, Get Hit Sound]
type = PlaySnd
triggerall = numenemy
triggerall = alive && time=1
trigger1 = stateno=5000||stateno=5010||stateno=5020
trigger1 = gethitvar(fall.envshake.phase) = .23561
value = S23561,0
channel = 0
ignorehitpause = 1
persistent = 0

[State -3, Transparency Reset]
type = VarSet
trigger1 = 1
var(3) = 256
ignorehitpause = 1

[State -3, Autocombo flag]
type = VarSet
triggerall = roundstate = 2
triggerall = var(31) != 0
trigger1 = ctrl
trigger2 = statetype = C
trigger3 = numhelper(3500)
var(31) = 0
ignorehitpause = 1

;OTHER EFFECTS++++++++++++
[State -3, planet power]
type = Trans
triggerall = alive
triggerall = numhelper(3500)
triggerall = numhelper(7530)
trigger1 = helper(3500),time<30
trans = addalpha
alpha = 128,128
ignorehitpause = 1
[State -3, planet power]
type = NotHitBy
triggerall = alive
triggerall = numhelper(3500)
trigger1 = (stateno<2000)||(stateno=3500)
trigger1 = helper(3500),time<30
value = SCA
time = 1
ignorehitpause = 1
[State -3, planet power]
type = PosAdd
triggerall = numhelper(3500)
triggerall = p2bodydist x>0
trigger1 = stateno = [200,799]
trigger1 = prevstateno = [200,799]
trigger1 = helper(3500),var(1) = 0
trigger1 = time<15
trigger1 = !movecontact
x = 5
[State -3, planet power]
type = AssertSpecial
trigger1 = numhelper(3500)
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1
[State -3, EX special]
type = Helper
triggerall = prevstateno != 8000
triggerall = !numhelper(7540)
triggerall = time = 1
trigger1 = movetype != H
trigger1 = stateno=[2000,2999]
trigger1 = stateno%100 = 0
stateno = 7540
ID = 7540
name = "Power Wave"
pos = 0,0
postype = p1
facing = 1
ownpal = 1
pausemovetime = 9999
supermovetime = 9999
ignorehitpause = 1
[State -3, EX special]
type = Helper
triggerall = !numhelper(7530)
trigger1 = movetype != H
trigger1 = stateno=[2000,2999]
trigger1 = stateno%100 = 0
trigger1 = time = 1
trigger2 = numhelper(3500)
trigger2 = (stateno<3000)||(stateno=3500&&time>27)
trigger3 = stateno = [5201,5210]
trigger4 = stateno = 750 && time<30
stateno = 7530
ID = 7530
name = "Aura FX"
pos = 0,0
postype = p1
facing = 1
ownpal = 1
pausemovetime = 0
supermovetime = (stateno=3500)*(30-time)
ignorehitpause = 1
[State -3, EX special]
type = PalFx
triggerall = numhelper(7530)
triggerall = var(36)>0
trigger1 = movetype != H
trigger1 = stateno=[2000,2999]
trigger1 = 1+0*(var(4):=ceil((.25+.25*sin(gametime*.64))*var(36)))
add = var(4),var(4),var(4)
time = 1
ignorehitpause = 1
;+++++++++++++++++++++++++

;AQUA MIST++++++++++++++++
[State -3, Aqua Mist]
type = VarAdd
triggerall = numpartner
trigger1 = partner,alive
trigger1 = partner,SelfAnimExist(3016302)
trigger1 = partner,var(2)>0
var(7) = 1+partner,var(2)
ignorehitpause = 1
[State -3, Aqua Mist]
type = VarSet
triggerall = var(7)>0
trigger1 = movetype != I
trigger2 = stateno>=1000
trigger3 = roundstate != 2
trigger4 = (stateno = 40)||(stateno = 45)||(stateno = 50 && vel y<-6)
trigger5 = (stateno = 100)||(stateno = 105)||(stateno = 110)||(stateno = 196)
trigger6 = !numpartner
trigger7 = partner,alive = 0
trigger8 = partner,SelfAnimExist(3016302) = 0
trigger9 = partner,var(2)<=0
var(7) = floor(var(7)*.7)
ignorehitpause = 1
[State -3, Aqua Mist]
type = VarSet
trigger1 = numhelper(3500)>0
trigger1 = helper(3500),time<30
trigger2 = stateno = [2000,2999]
trigger2 = numhelper(7530)
var(7) = 0
[State -3, Aqua Mist]
type = VarSet
trigger1 = var(7)>0
var(3) = cond(var(7)<128,256-2*var(7),0)
ignorehitpause = 1
[State -3, Aqua Mist]
type = Trans
trigger1 = var(7)>0
trans = addalpha
alpha = var(3),256-var(3)
ignorehitpause = 1
;+++++++++++++++++++++++++