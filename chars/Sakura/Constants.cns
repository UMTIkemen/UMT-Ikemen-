;var(0)  : Palette Number
;var(1)  : Secondary Palette Number

;var(3)  : Jump Type (0 = Normal; 1 = Low Jump; 2 = Long Low Jump; 3 = Long Jump)
;var(4)  : Chain Combo (0 = Off; 1 = On)
;var(5)  : Secondary Cancel Flag
;var(6)  : Cancel Flag
;var(7)  : Able to Super Cancel
;var(8)  : Able to Hyper Cancel
;var(9)  : Counter Flag
;var(10) : Button Detect (0 = Light; 1 = Medium; 2 = Heavy)
;var(11) : Wall Bounce Flag
;var(12) : Mashing Buttons during Throw
;var(13) : Hit Count
;var(14) : FollowUp Detect
;var(15) : Juggle Points
;var(16) : Juggle Flag
;var(17) : Ticks UnGuardable
;var(18) : ProjContact (0 = No; 1 = Yes)
;var(19) : Throw Escape
;var(20) : Custom Combo Time
;var(21) : Super Cancel Flag
;var(22) : Hyper Cancel Flag
;var(23) : Super Finish Type (900 = Custom Combo; 3000 = Super 1; 3500 = LV3 Super)
;var(24) : Power during Max Mode
;var(25) : Ticks to Apply EX FX
;var(26) : Ticks Unable to Walk

;var(30) : Hit Detection
;var(31) : Hit Sound (0 = Light Punch; 1 = Medium Punch; 2 = Heavy Punch; 3 = Light Kick; 4 = Medium Kick; 5 = Heavy Kick; 6 = Projectile Hit; 800 = Grab)
;var(32) : Guard Sound
;var(33) : Hit Spark (8010 = Light; 8011 = Medium; 8012 = Heavy; 8013 = Special; 8014 = Super)
;var(34) : Guard Spark (8000 = Normal; 8001 = Special)
;var(35) : Spark xPos
;var(36) : Spark yPos

;var(38) : Throw (0 = Allowed; 1 = Not Allowed)
;var(39) : Projectile Flag (0 = Off; 1 = On)
;var(40) : Mode (0 = Normal; 1 = Dark)
;var(41) : KO sound
;var(42) : Mashing Buttons during Throw Flag

;var(44) : Throw Timer / Hadouken Timer
;var(45) : Opponent detect for Intro

;var(50) : Command for Lv3 Supers (0 = Normal; 1 = Alternate)
;var(51) : Voices
;var(52) : Change to Dark/Normal Sakura mid fight (0 = Disable; 1 = Enable)
;var(53) : Max Mode Time
;var(54) : Custom Combo / Max Mode Select (0 = Custom Combo; 1 = Max Mode)
;var(55) : Hit Spark Color (0 = Default Orange; 1 = Multicolored)
;var(56) : Hit Spark Size (0 = Normal; 1 = Small)
;var(57) : Dark Stance (0 = Default; 1 = Custom)
;var(58) : Game Time

;fvar(5) : Amount of Corner Push
;fvar(10): Damage Dampener
;fvar(11): Damage Dampener with Counter Multiplier Added