;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[statedef -2]
;START OF EXA UPDATE---
;Down Hold Detection
[State -2]
type = varset
trigger1 = fvar(37) >= 6
trigger1 = fvar(38) != 0
trigger1 = command != "holddown"
fvar(38) = 0
ignorehitpause = 0

[State -2]
type = varset
trigger1 = fvar(37) != 0
trigger1 = command = "holddown"
trigger2 = fvar(38) = 0
fvar(37) = 0
ignorehitpause = 0

[State -2]
type = varadd
trigger1 = command = "holddown"
fvar(38) = 1
ignorehitpause = 0

[State -2]
type = varadd
trigger1 = fvar(38) != 0
trigger1 = command != "holddown"
fvar(37) = 1
ignorehitpause = 0

[state -2, Burst HUD]
