ignorehitpause = 1

[State -2]
type = varset
triggerall = stateno != [3900,4999]
triggerall = var(58) < 10000
triggerall = fvar(19) <= 0
triggerall = fvar(35) <= 0
Trigger1 = roundstate = 2
Triggerall = alive
Trigger1 = 1
var(58) = var(58)+(ifelse(life<=lifemax*.65,2,1)+(ifelse(life<=lifemax*.35,1,0)+((numhelper(9884))*1)))
