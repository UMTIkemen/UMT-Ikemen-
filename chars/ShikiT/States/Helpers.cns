trigger1=1 
value=-207
ignorehitpause=1

[State 197, Frame]
type=ChangeAnim
trigger1=root,animelemtime(27)=[0,1]
value=anim
elem=2
ignorehitpause=1
[State 197, Frame]
type=ChangeAnim
trigger1=root,animelemtime(28)=[0,1]
value=anim
elem=3
ignorehitpause=1
[State 197, Frame]
type=ChangeAnim
trigger1=root,animelemtime(29)=[0,1]
