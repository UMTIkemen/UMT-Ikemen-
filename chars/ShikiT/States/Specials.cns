;--------------------------------------------------------------------------
;Flash Sheath - Single Strike
[StateDef 1000]
type=S
moveType=A
physics=N
anim=1000
ctrl=0
velSet=0,0
sprPriority=1
powerAdd=72 * !var(20)
faceP2=1

[State 1000, VarSet]
type=VarSet
trigger1=!AILevel && !time
trigger1=prevstateno!=1005
var(10)=ifelse(command="x"||command="rlsx",0,ifelse(command="y"||command="rlsy",1,2))
ignorehitpause=1
[State 1000, VarSet]
type=VarSet
trigger1=AILevel && !time
trigger1=prevstateno!=1005
var(10)=Ifelse(p2bodydist x<75,0,Ifelse(p2bodydist x>150,2,1))
ignorehitpause=1

[State 1000, Varset]
type=Varset
trigger1=!time
var(12)=0
[State 1000, Varadd]
type=Varadd
trigger1=movecontact
var(12)=1

[State 1000, Anim]
type=ChangeAnim
trigger1=!time && prevstateno!=1005
value=1000+var(10)
[State 1000, Anim]
type=ChangeAnim
trigger1=!time && prevstateno=1005
value=1000+var(10)
elem=4

[State 1000, On Ground]
type=PosSet
trigger1=!time
y=0

[State 1000, Slash]
type=Helper
trigger1=animelemtime(4)=1 
helpertype=normal
name="Slash"
stateno=1010
ID=1010
pos=ceil(0*const(size.xscale)),ceil(0*const(size.yscale))
postype=p1
ownpal=1
size.xscale=(0.5 * const(size.xscale))
size.yscale=(0.5 * const(size.yscale))
ignorehitpause=1

[State 1000, Voice]
type=PlaySnd
trigger1=animelem=5
value=s1000,0
channel=0
[State 1000, Snd]
type=PlaySnd
trigger1=animelem=4
value=s1,8
channel=1
[State 1000, Snd]
type=PlaySnd
trigger1=var(10)=0 && animelem=6
trigger2=var(10) && animelem=8
value=s101,0
channel=2

[State 1000, Dust]
type=helper
trigger1=animelem=2
helpertype=normal
stateno=8103
ID=8100
name="Dash Dust"
postype=p1
pos=ceil(-10*const(size.xscale)),ceil(0*const(size.yscale))
ownpal=1

[State 1000, Step snd]
type=PlaySnd
trigger1=AnimElem=2
value=s100,0
channel=2
[State 1000, Skid Dust]
type=Explod
trigger1=var(10)=0 && animelem=6
trigger2=var(10) && animelem=8
anim=8104
sprPriority=3
posType=P1
pos=ceil(32*const(size.xscale)),ceil(0*const(size.yscale))
scale=0.5,0.5
ownpal=1
persistent=0

[State 1000, width]
type=width
trigger1=animelemtime(4)>0 && animelemtime(6)<0
value=25,0

[State 1000, VelSet]
type=VelSet
trigger1=animelem=2
x=4+(2*var(10))
[State 1000, VelSet]
type=VelSet
trigger1=var(10)=0 && animelem=6
trigger2=var(10) && animelem=8
x=0
[State 1000, VelMul]
type=VelMul
trigger1=animelemtime(5)>1
x=0.9825

[State 1000, ChangeState]
type=ChangeState
triggerall=var(10) && !AILevel
triggerall=prevstateno!=1005
trigger1=animelemtime(2)>1 && animelemtime(4)<0
trigger1=(command != "rlsy") && (command != "rlsz") && (command != "y") && (command != "z")
value=1005

[State 1000, Hit]
type=HitDef
triggerall=(!var(16) && var(15)<3 || var(20))
trigger1=animelem=5
trigger2=var(10)=1 && var(12)<2
trigger2=animelem=6||animelem=7
trigger3=var(10)=2 
trigger3=animelem=6||animelem=7
attr=S,SA
damage=Ifelse(var(10)=2 && var(12)>2,35,Ifelse(var(10)=2,28,Ifelse(var(10)=1,42,77))),Ifelse(var(10)=2 && var(12)>2,7,Ifelse(var(10)=2,4,Ifelse(var(10)=1,7,14)))
priority=4, hit
animtype=Hard
getpower=Ifelse(var(10)=2,54,Ifelse(var(10)=1,72,144))* !var(20), Ifelse(var(10)=2,18,Ifelse(var(10)=1,26,36)) * !var(20)
givepower=36,36
guardflag=M
hitflag=MAF
hitsound=s2,14
guardsound=S130,2
pauseTime=ifelse(var(20), 4, 8), ifelse(var(20), 4, 8)
guard.pauseTime=ifelse(var(20), 4, 8), ifelse(var(20), 4, 8)
sparkNo=-1 + 0 * (var(33) :=8016)
guard.sparkNo=-1 + 0 * (var(34) :=8001)
sparkXY=-10 + 0 * (var(35) :=90), var(36) :=-70
air.animtype=Back
fall.animtype=Back
ground.type=High
air.type=Low
ground.slidetime=16
ground.hittime=16
guard.hittime=18
ground.velocity=Ifelse(var(20),-2.625,-4.32),0
air.velocity=Ifelse(var(20),-2.625,-4.32),-4.47
guard.velocity=Ifelse(var(20),-3.25,-7.51)
ground.cornerPush.velOff=0
guard.cornerPush.velOff=0
air.cornerPush.velOff=0
yaccel=.58
fall=0
air.fall=1
fall.recover=0
forcestand=1
palFX.time=12 * var(9)
palFX.add=255,255,255
palFX.sinAdd=-255,-255,-255,48
envshake.time=12
envshake.ampl=3
envShake.freq=120

[State 1000, StateTypeSet: Idle]
type=StateTypeSet
trigger1=var(10)=0 && animelemTime(6)>=0
trigger2=var(10) && animelemTime(8)>=0
moveType=I

[State 1000, ChangeState]
type=ChangeState
trigger1=!AnimTime
value=0
ctrl=1
