;===================================================
;主にオプション設定に関する項目
;---------------------------------------------------
[Statedef -3]
;===================================================
;ゲージ表示位置調整
;(七星ゲージ、ブーストゲージ、レジスタンスゲージ)
[State -3]
type = Varset
trigger1 = 1
var(40) = 0	; 0 = デフォルト   1 = 原作北斗仕様   2 = アレンジ北斗仕様

;---------------------------------------------------
;世紀末体力ゲージシステム ON/OFF
;(ヴァイタルソースの表示は北斗ライフバーのみ対応)
[State -3]
type = Varset
trigger1 = 1
var(39) = 2	; 0 = 回復しない  1 = ヴァイタルソース表示   2=表示しない

;---------------------------------------------------
;ゲージ表示位置　新MUGEN用ワイド設定　
;(ブーストゲージ、レジスタンスゲージ、ガードゲージ、心眼ゲージ他)
[State -3]
type = Varset
trigger1 = 1
var(22) = 0	; 0 = 640:480(localcoord=320), 854:480(localcoord=426)　
		; 1 = 1280:720(localcoord=320)

;画面サイズ設定　横(GameWidth対応)
[State -3]
type = Varset
trigger1 = 1
var(20) = 640	; 640 = デフォルト(Winmugen, mugen1.1b)　854 = mugen1.0ワイド

;画面サイズ設定　縦(GameHeight対応)
[State -3]
type = Varset
trigger1 = 1
var(21) = 480	; 480 = デフォルト
　
;---------------------------------------------------
;PTA スイッチ
;(シバ自爆＆十字稜自決封印モード)
[State -3]
type = Varset
trigger1 = 1
var(38) = 1	; 0 = 封印   1 = 通常   2 = シバ自爆のみ封印   3 = 十字稜自決のみ封印

;---------------------------------------------------
;テレッテー短縮 スイッチ
[State -3]
type = Varadd
trigger1 = var(36) = 0
var(36) = 0	; 0 = TV版   1 = AC版

;---------------------------------------------------
デバッグ
[state -3, nolifebar]
type = assertspecial
trigger1 = roundstate < 2
flag = NoBarDisplay

[state -3, debug output]
type = DisplayToClipboard
trigger1 = 1
text = "Var(0) : %d, Var(1) : %d, Var(2) : %d, var(17) : %d, var(10) : %d\n "
params = var(0), var(1), var(2), var(17), var(10)
ignorehitpause = 1

[State -3, debug output]
type = AppendToClipBoard
trigger1 = 1
text = "fVar(11) : %f, fVar(0) : %f, var(8) : %d "
params = fvar(11), fvar(0), var(8)
ignorehitpause = 1

;---------------------------------------------------
[State -3]
type = Varset
trigger1 = var(22) = 1
var(20) = 640

[State -3]
type = Varset
trigger1 = var(22) = 1
var(21) = 480


