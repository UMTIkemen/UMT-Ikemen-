[Statedef 1510]
type    = A
movetype= A
physics = N
anim = ifelse(!(Parent,var(10)&2)&&!(Parent,var(10)&4),1510,1511) 
poweradd = 0
ctrl = 0
velset = 2,0
sprpriority = 4
facep2 = 1

[State -2]
type = ParentVarset
trigger1 =  Time < ifelse(!(Parent,var(10)&2)&&!(Parent,var(10)&4),36,24)
var(0) = 0

[State 1000, 0]
type = PlayerPush
trigger1 = 1
value = 1

[State -2, 7]
type = ParentVaradd
trigger1 = Time = 0
var(6) = 50

[State 1500]
type = HitOverride
trigger1 = 1
attr = SCA, AA, AP 
stateno = 1590
time = -1

[State 1500]
type = NotHitBy
trigger1 = 1
value = , AT
time = -1

[State 1510, Vel]
type = VelAdd
trigger1 = 1
y = ifelse(!(Parent,var(10)&2)&&!(Parent,var(10)&4),.3,.7)

[State 1510, Snd]
type = PlaySnd
trigger1 = Time = 5
value = 40,0

[State 1510, voice]
type = PlaySnd
trigger1 = Time = 0
value = 2000,0
channel = 3

[State 52, Snd]
type = Playsnd
trigger1 = AnimElem = 3
value = 3,3

[State 1010, HitS]
type = HitDef
