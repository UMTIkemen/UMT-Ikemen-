attr = A, SA
animtype = Hard
damage = ifelse(100*root,fvar(0) < 20,20,floor(100*root,fvar(0))),10
getpower = ifelse(root,var(33)=0,188,0),ifelse(root,var(33)=0,188,0)
givepower = 20,20
priority = 5, Hit
guardflag = H
hitflag = MAFD
sparkno = -1
guard.sparkno = -1
sparkxy = 0,0
hitsound   = s1,2
guardsound = s6,2
ground.type = low
pausetime = 13+(enemynear,movetype=A)*2,12+(enemynear,movetype=A)*2
ground.slidetime = 30
guard.slidetime = 30
ground.hittime = 14+(enemynear,StateType = C)*1 - (enemynear,StateType=C && Parent,var(17)=[16,20])*2
guard.ctrltime = 12+(enemynear,StateType = C)*1
ground.velocity = -6.97
guard.velocity = -5.58
air.velocity = -3.6,-6
airguard.velocity = -3.2,-3.6
down.velocity = -9.6
fall = 1
fall.recovertime = 36+(enemynear,movetype=A)*2
p2stateno = ifelse(root,var(11)>3,4020,4015)
yaccel = 1.08 + (root,var(9) - 1)*.084
sprpriority = 4


