; Stand Light Punch
[Statedef 200]
type     = S
movetype = A 
physics  = S 
anim     = 200
ctrl     = 0
juggle   = 0

[state 200]
type = Velset
trigger1 = Time = 0
y = 0
[state 200]
type = Posset
trigger1 = Time = 0
y = 0

[State 200, Snd]
type = PlaySnd
trigger1 = Time = 3
value = 3,0

[State 200, Voice]
type = PlaySnd
trigger1 = animelem = 1 && random < 400
value = 0, 0+(Random < 500)*1
channel = 0

[State 200, StateType]
type = StateTypeSet
trigger1 = AnimElem = 4
movetype = I

[State 200, Hit]
type = HitDef
trigger1 = animelem = 3
attr = S, NA
damage = ifelse(42*fvar(0) < 5,5,floor(42*fvar(0)))
getpower = ifelse(var(33)=0,120,0),ifelse(var(33)=0,120,0)
givepower = 20,20
priority = 3, Hit
animtype = Light
guardflag = MA
hitflag = MAF
sparkno = -1
guard.sparkno = -1
sparkxy = -12, -85
hitsound = s1, 0
guardsound = s6, 0
ground.type = High
pausetime = 10,9
ground.slidetime = 24
guard.slidetime = 24
ground.hittime = 10
guard.ctrltime = 8
ground.velocity = -5.09
guard.velocity = -4.07
down.velocity = -3.6
air.velocity = -3.6,-9
airguard.velocity = -3.2,-5.4
ground.cornerpush.veloff = -5.09+fvar(11)*.95
guard.cornerpush.veloff = -4.07+fvar(11)*.95
air.cornerpush.veloff = -5.09+fvar(11)*.9
airguard.cornerpush.veloff = -4.07+fvar(11)*.9
down.cornerpush.veloff = -3.6
air.fall = 1
fall.recovertime = 24
yaccel = 1.08 + (var(9) - 1)*.084


[State -2, Hit effect(S)]
type = Explod
trigger1 = MoveHit = 1
ID = 6000
anim = 6000
postype = P1
