trigger1 = prevstateno != [100,101]
trigger1 = prevstateno != 500
x = 0
[state 1000]
type = Velset
trigger1 = Time = 0
y = 0
[state 1000]
type = Posset
trigger1 = Time = 0
y = 0

[State 1000]
