guardsound = s6,2
ground.type = high
pausetime = 14+(enemynear,movetype=A)*6,13+(enemynear,movetype=A)*6
ground.slidetime = 30
guard.slidetime = 30
ground.hittime = 20+(enemynear,StateType = C)*1 - (enemynear,StateType=C && var(17)=[16,20])*3 + (enemynear,StateType=C && var(17)=[26,30])*5
guard.ctrltime = 18+(enemynear,StateType = C)*1
ground.velocity = -2
guard.velocity = -4
air.velocity = -2,-3
airguard.velocity = -4,-1.8
ground.cornerpush.veloff = 0+fvar(11)*.8
air.cornerpush.veloff = 0+fvar(11)*.78
air.fall = 1
fall.recovertime = 50+(enemynear,movetype=A)*6
yaccel = .54 + (var(9) - 1)*.084
kill = 0

