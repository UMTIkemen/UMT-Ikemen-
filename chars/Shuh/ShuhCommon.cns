;------ F/B ------
[Statedef 20]
type     = S
physics  = S

[State 20, 1]
type = VelSet
triggerall = !(var(10) & 512)
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)
[State 20, 2]
type = VelSet
triggerall = !(var(10) & 512)
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 1]
type = VelSet
triggerall = (var(10) & 512) && var(17)=16
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)*.5
[State 20, 2]
type = VelSet
triggerall = (var(10) & 512) && var(17)=16
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)*.5

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;------ Jump ------
[Statedef 40]
type     = S
physics  = S
anim     = 40
ctrl     = 0

[state 0]
type = Velset
trigger1 = time = 0
y = 0
[state 0]
type = Posset
trigger1 = time = 0
y = 0

[State -2,  W     v L     Z  ]
type = Varadd
trigger1 = Time = 0
trigger1 = (var(10) & 1)
var(10) = -1
[State 40, 0]
type = Varadd
triggerall = Time = 0
triggerall = !(var(10) & 1)
trigger1 = prevstateno = [200,250]
trigger2 = prevstateno = [400,499]
var(10) = 1
[State 40, 0]
type = Varadd
triggerall = (var(10) & 128)
trigger1 = Time = 0
var(10) = -128

[State -2,     ]
type = Explod
triggerall = !(var(10) & 512)
trigger1 = AnimTime = 0
ID = 6200
anim = 6200
pos= 0, 10
postype = P1
facing = 1
removetime = 16
ownpal = 1
scale = .5, .5
ignorehitpause = 1
sprpriority = -2

[State 40, Snd]
type = PlaySnd
triggerall = !(var(10) & 512)
trigger1 = anim = 40 && AnimTime = 0
value = 40,1
channel = 7

[State 40,  O   W     v]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = sysvar(1) != 2
trigger1 = prevstateno != 325 && prevstateno != 235
sysvar(1) = 1
[State 40,  O   W     v]
type = VarSet
triggerall = command = "holdfwd"
triggerall = sysvar(1) != 2
trigger1 = prevstateno = 325 && !(var(10) & 2) && !(var(10) & 4)
trigger2 = prevstateno = 235 && !(var(10) & 2) && !(var(10) & 4)
sysvar(1) = 1

[State 40,  O    W     v]
type = VarSet
triggerall = Time = 0 && sysvar(1) != -2
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
sysvar(1) = 2

[State 40,  j   [ g      W     v]
type = VarSet
triggerall = Time = 0 && sysvar(1) = 0
trigger1 = command = "longjump"
trigger1 = command != "holdback" && command != "holdfwd"
sysvar(1) = 3

[State 40,     W     v]
type = VarSet
trigger1 = command = "holdback"
trigger1 = sysvar(1) != -2
trigger1 = prevstateno != 325 && prevstateno != 235
sysvar(1) = -1
[State 40,     W     v]
type = VarSet
triggerall = command = "holdback"
triggerall = sysvar(1) != -2
trigger1 = prevstateno = 325 && !(var(10) & 2) && !(var(10) & 4)
trigger2 = prevstateno = 235 && !(var(10) & 2) && !(var(10) & 4)
sysvar(1) = -1

[State 40,      W     v]
type = VarSet
triggerall = Time = 0 && sysvar(1) != 2
triggerall = command = "holdback"
trigger1 = command = "longjump"
sysvar(1) = -2

[State 40,  j   [ g     G   A  ]
type = VarSet
triggerall = Time = 0 && sysvar(1) = 0
triggerall = (var(10) & 2) || (var(10) & 4)
triggerall = command != "holdback" && command != "holdfwd"
trigger1 = prevstateno = 325
trigger2 = prevstateno = 235
sysvar(1) = -3

[State 40,  O   G   A  ]
type = VarSet
triggerall = Time = 0
triggerall = (var(10) & 2) || (var(10) & 4)
triggerall = command = "holdfwd"
trigger1 = prevstateno = 325
trigger2 = prevstateno = 235
sysvar(1) = 4

[State 40,     G   A  ]
type = VarSet
triggerall = Time = 0
triggerall = (var(10) & 2) || (var(10) & 4)
triggerall = command = "holdback"
trigger1 = prevstateno = 325
trigger2 = prevstateno = 235
sysvar(1) = -4

[State 40,   W     v]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = sysvar(1) != [-1,1]
trigger2 = prevstateno = 52
trigger2 = sysvar(1) = 2 || sysvar(1) = -2 || sysvar(1) = 3
value = 46

[State 40, x   x]
type = VelSet
triggerall = !(var(10) & 512)
trigger1 = !(var(10) & 1) && AnimTime = 0
x = ifelse(sysvar(1)=0,0,ifelse(sysvar(1)>0,ifelse(prevstateno=100,3.6,const(velocity.jump.fwd.x)),const(velocity.jump.back.x)))
[State 40, x   xJC]
type = Veladd
triggerall = !(var(10) & 512)
trigger1 = (var(10) & 1) && AnimTime = 0
x = ifelse(sysvar(1)=0,0,ifelse(sysvar(1)>0,ifelse(prevstateno=100,3.6,const(velocity.jump.fwd.x)),const(velocity.jump.back.x)))
[State 40, y   x]
type = VelSet
triggerall = !(var(10) & 512)
trigger1 = AnimTime = 0
y = const(velocity.jump.y)

[State -2,    C   [A]
type = ChangeAnim
trigger1 = (var(10) & 512)
value = 5396
[State 40,  W     v]
type = ChangeState
triggerall = (var(10) & 512)
trigger1 = Time = 4
value = 0
ctrl = 1

[State 40,  W     v]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

