airjump.height  = 40
yaccel          = .58
stand.friction  = .83
crouch.friction = .78

;===================================================
;------ initialize ------
[Statedef 5900]
type = S

[State -2, Var]
type = Varadd
trigger1 = time = 0
var(3) = -1
[State -2, Var]
type = Varset
trigger1 = time = 0
trigger1 = var(3) >= 7 && var(3) < 100
var(3) = 6
[State -2, Var]
type = Varset
triggerall = time = 0
trigger1 = var(3) >= 100
trigger2 = enemy,teammode = turns
var(3) = 0

[State -2, Var]
type = Varset
trigger1 = time = 0
var(6) = 0
[State -2, Var]
type = Varset
trigger1 = time = 0
var(13) = LifeMax
[State -2, Var]
type = Varset
trigger1 = time = 0
var(25) = 0

[State -2, 7]
type = Varadd
trigger1 = time = 0
trigger1 = var(7) >= 450
var(7) = 50

[State 5900, 1]
type = VarRangeSet
trigger1 = roundno = 1
value = 0

[State 5900, 2]
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, 3]
type = ChangeState
trigger1 = roundno = 1
value = 190

