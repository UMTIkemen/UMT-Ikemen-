ignorehitpause = 1

;===========================================================================
[State -1, Combo condition Reset]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=0
trigger1 = !ctrl
var(1) = 0
ignorehitpause = 1

[State -1, Combo condition Check]
type = VarSet
triggerall = !ishelper
trigger1 = var(1)!=1
trigger1 = movetype != A
trigger1 = ctrl
trigger2 = ((stateno=[200,299]) || (stateno=[400,499]) || (stateno=[600,699])) && movecontact
trigger3 = (stateno = [1000,1001]) && movecontact
trigger4 = (stateno = [1100,1103]) && movecontact
trigger5 = (stateno = [1300,1301]) && movecontact
var(1) = 1
ignorehitpause = 1

