;///////////////////////////////////////////////////////////////////////////
; 究極奥義・一撃必殺
;///////////////////////////////////////////////////////////////////////////
;---------------------------------------------------------------------------
; 彷翔十字鳳
;---------------------------------------------------------------------------
[statedef 2000]
movetype=a
[state ]
type=changeanim
trigger1=anim!=2000
value=2000
[state ]
type=varset
trigger1=animelem=1
fvar(18)=480
[state ]
type=poweradd
trigger1=animelem=1
value=-1000
[state ]
type=turn
trigger1=animelem=1
trigger1=(var(1):=var(1)+4*(facing*(enemynear(!enemynear,alive&&numenemy>1&&enemynear(numenemy>1),alive),pos x-pos x)<0))&4
[state ]
type=playsnd
trigger1=animelem=1
value=s2000,1
channel=0
[state ]
type=posadd
trigger1=animelem=1
x=5
[state ]
type=posadd
trigger1=animelem=2
x=10
[state ]
type=posadd
trigger1=animelem=3
trigger1=var(0)<(var(1)&1)
x=10
[state ]
type=posadd
trigger1=animelem=4
x=10
[state ]
type=varset
trigger1=animelem=9,>=0
sysfvar(4)=-18
[state ]
type=varset
trigger1=1
sysfvar(3)=0
[state ]
type=varadd
trigger1=animelem=3&&palno>9||animelem=9
trigger1=var(0)<(var(1)&1)
var(1)=-(var(1)&2)
[state ]
type=hitdef
trigger1=palno>9
trigger1=var(0)<(var(1)&1)&&!(var(1)&2)
attr=s,ha
hitflag=maf
guardflag=ma
damage=ifelse(13*5.6*ifelse(fvar(10)*fvar(16)>.3,fvar(10)*fvar(16),.3)>6,ceil(13*5.6*ifelse(fvar(10)*fvar(16)>.3,fvar(10)*fvar(16),.3)),6),5
getpower=ceil(1000*(.14+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0),ceil(1000*(.14+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0)
givepower=ceil(500*.14*fvar(10))*ifelse(var(1)&128,.6,1),ceil(333*.14*fvar(10))*ifelse(var(1)&128,.6,1)
animtype=hard
priority=7,hit
pausetime=0,13+6*!!var(4)
ground.hittime=20+(enemynear,statetype=c)
ground.slidetime=20+(enemynear,statetype=c)
guard.hittime=18+(enemynear,statetype=c)
ground.velocity=0
air.hittime=0
air.velocity=0*!(var(1)&256),ifelse(var(1)&256,-6,-10)
air.fall=1
yaccel=ifelse(enemynear,statetype=a||sysvar(4),.9,.6)+fvar(0)
fall.recovertime=45+6*!!var(4)
ground.cornerpush.veloff=0
sparkno=-1
hitsound=-1
guard.sparkno=-1
guardsound=-1
;--------------
[state ]
type=hitdef
trigger1=animelem=9,>=0
trigger1=var(0)<(var(1)&1)&&!(var(1)&2)
attr=s,na
hitflag=maf
guardflag=ma
damage=ifelse(13*5.6*ifelse(fvar(10)*fvar(16)>.3,fvar(10)*fvar(16),.3)>6,ceil(13*5.6*ifelse(fvar(10)*fvar(16)>.3,fvar(10)*fvar(16),.3)),6),5
