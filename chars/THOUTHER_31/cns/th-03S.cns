getpower=ceil(1000*(.14+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0),ceil(1000*(.14+fvar(17))*fvar(10))*ifelse(var(1)&128,.6,1)*(fvar(18)<=0)
givepower=ceil(500*.14*fvar(10))*ifelse(var(1)&128,.6,1),ceil(333*.14*fvar(10))*ifelse(var(1)&128,.6,1)
animtype=hard
priority=7,hit
pausetime=0,13+6*!!var(4)
ground.hittime=20+(enemynear,statetype=c)
