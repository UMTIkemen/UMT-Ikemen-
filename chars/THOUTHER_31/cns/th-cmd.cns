trigger1=(anim=[41,43])||anim=132
trigger1=command="AJ"
trigger1=(var(1)&8)+(var(1)&16)=0
trigger1=pos y<=-60
value=45
;---------ジャンプ
[state ]
type=selfstate
triggerall=roundstate=2&&!(var(1)&131072)
triggerall=var(0)<=0
triggerall=command="holdup"||var(3)&4194304
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||anim=100||(anim=[130,131])
trigger2=movecontact&&anim=230+anim%5
trigger3=palno=12
trigger3=movecontact
trigger3=(anim=[200,236])||anim=[400,431]
trigger4=palno>9
trigger4=movehit
trigger4=anim=1400&&animelem=15,>0||anim=1401&&animelem=10,>0
value=40
;---------地上ダッシュ
[state ]
type=selfstate
trigger1=roundstate=2&&!(var(1)&131072)
trigger1=var(0)<=0
trigger1=command="FF"
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||(anim=[130,131])||anim=780&&animelem=6,>0
value=100
;---------バックステップ
[state ]
type=selfstate
trigger1=roundstate=2&&!(var(1)&131072)
trigger1=var(0)<=0
trigger1=command="BB"
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||(anim=[130,131])||anim=780&&animelem=6,>0
value=105
;---------ガード
[state ]
type=selfstate
trigger1=roundstate=2&&!(var(1)&131072)
trigger1=var(0)<=0
trigger1=command="holdback"
trigger1=inguarddist
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||(anim=[41,43])||anim=100&&animelem=3,>0||(anim=[130,132])
value=130
;---------屈み
[state ]
type=selfstate
trigger1=roundstate=2&&!(var(1)&131072)
trigger1=var(0)<=0
trigger1=movetype!=h
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||anim=100||(anim=[130,131])
trigger1=command="holddown"
value=10
;---------歩行
[state ]
type=selfstate
trigger1=roundstate=2&&!(var(1)&131072)
trigger1=var(0)<=0
trigger1=movetype!=h
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||(anim=[130,131])
trigger1=command="holdfwd"||command="holdback"
value=20
;---------ニュートラル
[state ]
type=selfstate
trigger1=stateno=130
trigger1=!anim||(anim=[10,12])||(anim=[20,21])||(anim=[41,43])
trigger2=!time&&(stateno=10||stateno=40)
value=ifelse((anim=[41,43])||statetype=a,50,0)
