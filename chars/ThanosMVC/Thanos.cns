v = 42
value = 1

; ===================== (System Messages) =======================

[State -2, VS_Combo]
type = VarSet
triggerall = (var(31)!=10) || (var(31)=10 && movehit && statetype != A)
trigger1 = var(52) >= 3
trigger2 = var(52)=-1 && (movehit || p2movetype = H  && p2stateno != [120,179]);p2stateno = [5000,5899])
trigger3 = var(52)=-1 && stateno != [0,179]
var(31) = 1+(var(52)>4)+(var(52)>5)+(var(52)>7)+(var(52)>9)+(var(52)>19)+(var(52)>29)+(var(52)>39)-(var(52)=-1)
ignorehitpause = 1

[State -2, Air Combo]
type = VarSet
triggerall = var(52) >= 3 && statetype = A
trigger1 = stateno = [600,699]
trigger2 = stateno= [1030,1050]
trigger3 = stateno= [1130,1150]
trigger4 = stateno= [1400,1420]
triggerall = (movehit)
var(31) = 10
ignorehitpause = 1

[State -2, Danger]
type = VarSet
trigger1 = var(53) !=1 && roundstate=2 && life = [1,250]
var(31) = 9
ignorehitpause = 1

