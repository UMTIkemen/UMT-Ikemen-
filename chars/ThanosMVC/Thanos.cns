


;Thanos MVC Style coded by k99
[Data]
life = 1000
attack = 100
defence = 100
power = 3000
fall.defence_up = 40
liedown.time = 40
airjuggle = 11
sparkno = 2
guard.sparkno = 40
ko.echo = 0
volume = 50
intpersistindex = 51
floatpersistindex = 40

[Size]
xscale = 1           
yscale = 1 
ground.back = 15
ground.front = 15
air.back = 12        
air.front = 12       
height = 60          
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -3, -109  
mid.pos = -3, -62
shadowoffset = 0     
draw.offset = 0,0    

[velocity]
walk.fwd=2.2
walk.back=-2
run.fwd  = 7, -3.8
run.back = -7,-3.8
jump.neu = 0,-9.4
jump.back = -3,-9.4
jump.fwd = 3,-9.4
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.8
airjump.back = -3.55
airjump.fwd = 3.5


[movement]
airjump.num = 0
airjump.height = 40
yaccel = .46
stand.friction = .89
crouch.friction = .82

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0]
type = removeExplod
trigger1 = time = 0
id = 8888

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0


[State 0, 0]
type = varrandom
trigger1 = 1
v = 0
range = 0,6


[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

