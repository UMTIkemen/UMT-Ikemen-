trigger1 = NumExplod(8701) = 0
trigger1 = var(52)=0 && var(31)!=0
persistent = 0;1
value = 230,var(31)
channel = 14
volumescale=255
ignorehitpause = 1

[State -2, Left]
type = explod
trigger1 = var(52)=0 && var(31)!=0
trigger2 = var(52)=-1 && (movehit || p2movetype = H && p2stateno != [120,179]);p2stateno = 6300 ||p2movetype = H);p2stateno = [5000,5899])
