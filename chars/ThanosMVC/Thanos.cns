trigger1 = var(53) = 1 && roundstate!=2
var(53) = (roundstate>1)
ignorehitpause = 1

[State -2, Is First Attack p3]
type = VarSet
triggerall = numpartner=1
trigger1 = partner, movehit
trigger1 = partner, var(52) != -1
var(52) = 0
ignorehitpause = 1

[State 620, ?G???A?????~?b?^?[???A]
