[state 0]
type = explod
trigger1=Projhit3105 = 1
trigger1 = NumExplod(9113) = 0
trigger1 = NumTarget > 0
trigger1 = target, Life = P2Life
trigger1 = target, StateNo = P2StateNo
trigger1 = P2MoveType = H
