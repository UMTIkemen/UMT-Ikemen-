
; Player information
[Info]
name = "GG Vega"        ;Name of character
displayname = "Vega" ;Name of character to display
versiondate = 2023    ;Version date of character
mugenversion = 1.0  ;Version of M.U.G.E.N character works on
author = "Gloves of Doom"      ;Character author name
pal.defaults = 1,2   ;Default palettes in order of preference
;credit goes to Warusaki3, ikaruga, muteki, parse for code referencing, sounds or sprites.

[map]
buffer_snk = 1
B_ChargeTime = 30
D_ChargeTime = 30

; Files for the player
[Files]
cmd     = player.cmd   ;Command set
cns     = player.cns   ;Constants
st      = player.cns   ;States
st2 = player_s.cns
stcommon = common1.cns ;Common states
sprite  = player.sff   ;Sprite
anim    = player.air   ;Animation
sound  = player.snd   ;Sound
;pal1   = player.act   ;Palettes (can have up to 12)
movelist = movelist.dat

[Palette Keymap]
a = 4
b = 2
c = 3
x = 1
y = 5
z = 6