; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1056			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
;volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 58	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
power = 2000
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = .225			;Horizontal scaling factor.
yscale = .24			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = -5, -100	;Approximate position of head
mid.pos = -5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 4.31		; O i ̑  x
walk.back = -3.15		;   ނ̑  x
run.fwd  = 6.13, 0		; O _ b V   ̑  x i z b v   鎞  y  - ɂ    j
run.back = -4.8,-4.5		;   _ b V   ̑  x i z b v   鎞  y  - ɂ    j
jump.neu = 0,-10.55		;     W     v ̑  x
jump.back = -4.4
jump.fwd = 4.3
runjump.back = -6
runjump.fwd = 6.1
airjump.neu = 0,-6.5		; Q i W     v ȍ~ ̐    W     v ̑  x( I v V    )
airjump.back = -2.8		; Q i W     v ȍ~ ̌  W     v ̑  x( I v V    )
airjump.fwd = 2.8		; Q i W     v ȍ~ ̑O W     v ̑  x

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .64		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------- Integer variable list ----------------------

; var(3):= 6200
; var(4):= 6200
; var(5):=  Teleport
; var(9):=  Knee Press Nightmare
;var(10):= 6200
;var(11):= 6200,  DOUBLE JUMP, 110, 115,  States that are always executed (use statedef -2)
;var(12):= 6200,  States that are always executed (use statedef -2)
;var(13):= 6200,  States that are always executed (use statedef -2)
;var(14):= 6200
;var(15):= 6200, 115
;var(16):=  St HS
;var(20):= 6200
;var(21):= 6200
;var(22):= 6200
;var(23):= 6200
;var(24):= 6200, 110, 115
;var(25):= 6200
;var(30):= 6200
;var(31):= 6200
;var(32):= 6200
;var(33):= 6200
;var(34):= 6200
;var(35):= 6200
;var(50):=  St P,  St S,  St D,  St K,  St HS,  Cl S,  Cr P,  Cr S,  Cr D,  Cr K,  Cr HS,  J P,  J S,  J D,  J K,  J HS,  States that are always executed (use statedef -2)
;var(51):=  States that are always executed (use statedef -2)

;---------------------- Float variable list ----------------------

;fvar(13):=  States that are always executed (use statedef -2)
;fvar(23):= 110, 115






;----------------------------------------------------------------------------
[Quotes]
victory1 = "Anyone who opposes me will be destroyed!"
victory2 = "Get lost, you can't compare with my powers."
victory3 = "You're no match for my Psycho Power!"
victory4 = "You're good enough to be my servant. Join Shadaloo and obey me."
victory5 = "I will weep when there are no more worlds to conquer."

;---------------------------------------------------------------------------
;UI helper
[Statedef 780]
type = A
movetype = I
physics = N
anim = 780
ctrl = 0
velset = 0,0

