;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;light PC startup
[statedef 1000]
type    = S
movetype= A
physics = S
ctrl = 0
anim = 1000
poweradd = ceil(40*fvar(37))
velset = 0,0

[State 1000, VarSet]
type = VarSet
trigger1 = Time = 0
var(5) = ifelse(pos y <= -20, 1, 0)

[State 170, 1]
type = NotHitBy
trigger1 = AnimElemTime(2) < 0
value = SCA

[State 1001, 1]
type = PlaySnd
trigger1 = animelem = 4
value = 210,7

[state 1000,1]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001

