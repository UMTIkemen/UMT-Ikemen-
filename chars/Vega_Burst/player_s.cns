movetype= A
physics = N
;juggle  = ifelse((p2movetype=H&&p2statetype=A),16,8)
anim = 1001
sprpriority = 5
;velset = 0,0

[State 1100, Velocity]
type = VelSet
trigger1 = AnimElem = 1
x = 6.5+(0*2)

[State 1001, 1]
type = PlaySnd
trigger1 = time = 0
value = 1000,0

[State 1001 , 7]
type = Playerpush
trigger1 = time >= 0
value = 0

