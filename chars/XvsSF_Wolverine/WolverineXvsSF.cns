;Get Hit Sounds                              
[State -3]
type = playsnd
triggerall = alive && time = 1
triggerall = stateno = 5000 || stateno = 5010
trigger1 = gethitvar(animtype) >= 2 && random < 500
trigger2 = gethitvar(animtype) = 1 && random < 375
trigger3 = gethitvar(animtype) = 0 && random < (250 * (AIlevel ** 2 / 64.0))
value = S5000, 0 + (random % 9)
channel = 0
ignorehitpause = 1

[State -3]
type = playsnd
triggerall = alive && time = 1
trigger1 = (stateno = 5000 || stateno = 5010) && numenemy
trigger1 = gethitvar(fall) || (enemynear, hitdefattr = SCA, SA, HA)
trigger2 = (stateno = 5020 || stateno = 5070 || stateno = 5080)
trigger3 = stateno = 5100 && random < 250
value = S5000, 0 + (random % 9)
channel = 0
ignorehitpause = 1

;Super Jump Enemy Locator             
[State -3, s1]
type = Explod
triggerall = stateno != [3200,3299]
triggerall = enemynear, alive
trigger1 = enemynear, screenpos y < 0
trigger2 = enemynear, screenpos y > 200 - (const(size.head.pos.y))
trigger3 = P2bodyDist y > 200
anim = 8350 + 2*(!ishometeam)
id = 8350
pos = -20 +(enemynear, screenpos x), 40 + (enemynear, screenpos y > 0) * 200
postype = left
ignorehitpause = 1
ontop = 1
bindtime = -1
persistent = 1
removetime = 1
scale = 1, 1
facing = (enemynear, facing)
ownpal =1
sprpriority = 9


