triggerall = life = 0 
triggerall = stateno != [180,189]
trigger1 = NumHelper(9070) = 0
name = "KO FX"
ID = 9070
StateNo = 9070
postype = p1
pos = 0, 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State -2]
type = ChangeState
triggerall = hitshakeover
trigger1 = (stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080)
trigger1 = !Alive || !Life
value = 5090

[State -2]
type = ScreenBound
trigger1 = winko
trigger1 = p2stateno = [5090,5091]
value = 0
movecamera = 0,0

[state 0]
type = changestate
triggerall = winko
