;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, VarSet]
Type           = VarSet
Trigger1       = !NumTarget
FV             = 29
Value          = 0.0
IgnoreHitPause = 1

[State -2, TargetState]
Type       = TargetState
TriggerAll = NumTarget
Trigger1   = Target,MoveType = H && Target,StateNo != 9090
Trigger1   = fvar(29) >= 25
Value      = 9090

[State -2, AssertSpecial]
type = AssertSpecial
triggerall = roundno = 1
trigger1 = roundstate < 2
flag = NoMusic

[State -2]
type = Helper
triggerall = WinKO
triggerall = NumHelper(9070) = 0
triggerall = stateno != [180,189]
trigger1 = StateNo = 3000
trigger2 = StateNo = [3100,3150]
trigger3 = StateNo = 3202
name = "Super Finish FX"
ID =9070
StateNo = 9071
postype = p1
pos = 0, 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State -2]
