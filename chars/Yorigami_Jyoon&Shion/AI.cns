type = ChangeState
value = 105
triggerall = var(59) > 0
triggerall = statetype != L
triggerall = Inguarddist
trigger1 = stateno = 700&&animelem = 3,>0

;溜め射撃
[State -1, ]
type = ChangeState
value = 750
triggerall = var(59) > 0
triggerall = statetype != L
triggerall = !Inguarddist
trigger1 = stateno = 1||stateno = 25

;チャージバックステップ
[State -1, ]
type = ChangeState
value = 600
triggerall = var(59) > 0
triggerall = statetype != L
triggerall = var(15) >= 25
triggerall = enemynear(var(58)),movetype = A
trigger1 = (stateno = [200,201])&&!movecontact&&animelem = 3,>0
trigger2 = (stateno = [210,211])&&!movecontact&&animelem = 4,>0
trigger3 = (stateno = [220,221])&&!movecontact&&animelem = 5,>0
trigger4 = stateno = 230&&!movecontact&&animelem = 5,>0
trigger5 = (stateno = [240,241])&&!movecontact&&animelem = 5,>0
trigger6 = stateno = 300&&!movecontact&&animelem = 3,>0
trigger7 = stateno = 310&&!movecontact&&animelem = 4,>0
trigger8 = stateno = 320&&!movecontact&&animelem = 5,>0
trigger9 = stateno = 330&&!movecontact&&animelem = 4,>0

;試合後位置調整
[State -1, ]
type = ChangeState
value = 100
triggerall = var(59) = -155
triggerall = roundstate = 3
triggerall = statetype = S
triggerall = backedgedist < 50
trigger1 = ctrl

;試合後位置調整
[State -1, ]
type = ChangeState
value = 105
triggerall = var(59) = -155
triggerall = roundstate = 3
triggerall = statetype = S
triggerall = frontedgedist < 50
trigger1 = ctrl

[State 0, VarRandom]
type = VarRandom
trigger1 = roundsexisted = 0
trigger1 = roundstate = 0
trigger1 = var(10) != [1,3]
v = 10
range = 1,3

[State 0, VarSet]
type = VarSet
trigger1 = roundstate > 2
trigger1 = var(59)
v = 59
value = -155

