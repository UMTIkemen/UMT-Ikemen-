[Statedef 7122]
type    = A
movetype= I
physics = N
velset = 0,0
anim = 8122
ctrl = 0
sprpriority = 1

[State 0, Turn]
type = Turn
trigger1 = time = 0
trigger1 = Floor((Pos X-EnemyNear(var(58)),Pos X)*Facing*-1) < 0

[State 0, PosSet]
type = PosSet
trigger1 = time = 0
x = enemynear(root,var(58)),pos X-facing*1.5*enemynear(root,var(58)),Const(size.ground.front)

[State 0, PosSet]
type = PosSet
trigger1 = 1
y = enemynear(root,var(58)),pos Y

[State 0, VelSet]
type = VelSet
trigger1 = time = 0
x = 160.0/((Pos X-EnemyNear(var(58)),Pos X)*Facing*-1)+abs(enemynear(root,var(58)),vel x)+3

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 0, PlayerPush]
type = PlayerPush
trigger1 = 1
value = 1

[State 0, ParentVarSet]
type = ParentVarSet
trigger1 = time = 0
v = 14
value = 90

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S0,24

[State 0, DestroySelf]
type = DestroySelf
trigger1 = time >= 15

