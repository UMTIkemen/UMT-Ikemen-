Trigger1=1||var(56):=Ifelse((EnemyNear(var(58)),StateType=A),Ifelse((Pos X<= EnemyNear(var(58)),Pos X^^EnemyNear(var(58)),Facing=1),(EnemyNear(var(58)),Const(Size.Air.Front)),(EnemyNear(var(58)),Const(Size.Air.back))),var(56));空中
