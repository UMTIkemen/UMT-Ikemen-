[State -3,tag];相手ﾀｯｸﾞ時生死確認
type = Null
trigger1 = !Numtarget||Numenemy = 1
trigger1 = var(58):= IfElse((!EnemyNear,Alive && NumEnemy = 2),1,0)
trigger2 = Numenemy > 1
trigger2 = !enemy(0),Alive||!enemy(1),Alive
trigger2 = var(58):= IfElse((!EnemyNear,Alive && NumEnemy = 2),1,0)
trigger3 = Numenemy > 1
trigger3 = enemy(0),Alive&&enemy(1),Alive
