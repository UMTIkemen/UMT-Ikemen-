;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[statedef -2]
;Virus Zero
;--
[State 0, Trans]
type = Trans
triggerall = palno = 12
trigger1 = movetype = H
trans = addalpha
alpha = 150,256
ignorehitpause = 1
persistent = 1

[State 0, AssertSpecial]
type = AssertSpecial
triggerall = movetype != H
triggerall = palno = 12
trigger1 = (stateno!=[3900,3999])
flag = invisible
ignorehitpause = 1
persistent = 1

[State 0, ]
type = AfterImage
triggerall = stateno !=[190,199]
triggerall = stateno !=[1100,1199]
trigger1 = palno = 12
trigger1 = time = 0
time = 9999
length = 15
framegap = 3
palcontrast = 150,150,150
paladd = 0,0,0
palmul = .9,.9,.9
trans = add1
ignorehitpause = 0
persistent = 0
;--
[State 0, AfterImageTime]
type = AfterImageTime
triggerall = palno != 12
trigger1 = movetype = H
time = 1

; Charged Z-Buster
[State -2, State]
type = ChangeState
triggerall = var(33) = 10
triggerall = roundstate = 2
triggerall = numhelper(1050) 
triggerall = helper(1050),anim=9999
triggerall = Var(27) = [45,140]
trigger1 = command != "holdc"
value = 701 + ifelse(statetype=A,10,0)
persistent = 1
ignorehitpause = 1

[State -2, State]
type = ChangeState
triggerall = var(33) = 10
triggerall = roundstate = 2
triggerall = numhelper(1050)
triggerall = helper(1050),anim=6000
triggerall = Var(27) > 140
trigger1 = command != "holdc"
value = 702 + ifelse(statetype=A,10,0)
persistent = 1
ignorehitpause = 1

[State 8000, ]
type = varset
triggerall = roundstate = 2
trigger1 = movetype = H
trigger2 = stateno = [8000,8999]
trigger3 = stateno = [3000,4999]
trigger4 = command != "holdc"
trigger4 = var(27)
var(27) = 0
ignorehitpause = 1
persistent = 1

[State 8000, ]
type = varset
triggerall = roundstate = 2
triggerall = roundstate = 2
triggerall = ailevel = 0 
trigger1 = command != "holdc"
var(27) = 0
ignorehitpause = 1
persistent = 1

[State 300, Var]
type = varadd
triggerall = roundstate = 2
triggerall = stateno !=[700,799]
triggerall = ailevel = 0 
triggerall = command = "holdc"
triggerall = stateno < 1000
trigger1 = ctrl
var(27) = 1

[State -2, Helper]
type = Helper
triggerall = roundstate = 2
triggerall = Var(27) >= 10
triggerall = NumHelper(1050) = 0
trigger1 = Command = "holdc"
helpertype = normal
name = "Z-Charge"
id = 1050
facing = 1
pos = 0,-50
postype = p1
stateno = 1050
keyctrl = 0
ownpal = 1
size.xscale = .5
size.yscale = .5

[State -2, 1st Flash]
type = PalFX
triggerall = movetype != H
triggerall = TimeMod = 4,0
trigger1 = NumHelper(1050) > 0
trigger1 = Helper(1050), Anim = 9999
trigger2 = NumHelper(1051) > 0
trigger2 = Helper(1051), Anim = 9999
trigger3 = NumHelper(1052) > 0
trigger3 = Helper(1052), Anim = 9999
trigger4 = NumHelper(2050) > 0
trigger4 = Helper(2050), Anim = 9999
time = 2
add = 0,100,50
mul = 20,120,24
sinadd = 85,110,55,15
invertall = 0
color = 0

[State -2, 2nd Flash]
type = PalFX
triggerall = movetype != H
triggerall = TimeMod = 4,0
trigger1 = NumHelper(1050) > 0
trigger1 = Helper(1050), Anim = 6000
trigger2 = NumHelper(1051) > 0
trigger2 = Helper(1051), Anim = 6000
trigger3 = NumHelper(1052) > 0
trigger3 = Helper(1052), Anim = 6000
trigger4 = NumHelper(2050) > 0
trigger4 = Helper(2050), Anim = 6000
time = 2
add = 240,50,0
mul = 250,224,120
sinadd = 110,55,85,10
invertall = 0
color = 0

