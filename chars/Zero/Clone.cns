;Y-velocity at which opponent is pushed
air.hittime = 30                 ;Time before opponent regains control in air
air.fall = 1
fall.recovertime = 30
guard.ctrltime = 14
p2facing = 1  
p1sprpriority = ifelse(root,palno=12,-5,0)
ground.cornerpush.veloff = -.5
air.cornerpush.veloff = -.5
nochainID = 8000

