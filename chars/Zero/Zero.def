; Definition file for Kung Fu Man
; Contains all the filenames needed for the character
; Player information
[Info]
name = "Zero"
displayname = "Zero"
versiondate = 09,30,2009    
mugenversion = 1.0          
author = "Ichida"         
pal.defaults = 1

[Files]
cmd     = Zero.cmd
cns     = Zero.cns
st      = Zero.cns
st2     = Helpers.cns
st3     = -2-3.cns
st4     = BurstHUD10.cns
st5 	= Clone.cns
stcommon = Zero_common.cns
sprite  = Zero.sff
anim    = Zero.air
sound   = Zero.snd

[Palette Keymap]
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
