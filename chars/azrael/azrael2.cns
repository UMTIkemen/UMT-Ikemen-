;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 40, 0]
type = ChangeState 
triggerall = var(59) = 1
triggerall = fvar(1) = 0
trigger1 = time = 0 
value = 0
ctrl = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = fvar(1) = 55
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 7
trigger2 = animelem = 12
value = S20,0

[State 0, DestroySelf]
type = DestroySelf
triggerall = time 
trigger1 = ishelper
ignorehitpause = 1

;---------------------------------------------------------------------------
; Walk for AI
[Statedef 21]
type    = S
physics = S
sprpriority = 0

[State 100, 4]
type = ChangeState
trigger1 = var(59) = 1
trigger1 = P2dist X <= 45
;trigger1 = P2Movetype = A
trigger2 = command != "holdfwd"
trigger2 = var(59) != 1
trigger3 = win = 1
trigger4 = var(59) = 1
trigger4 = P2dist X <= 150
trigger4 = P2Movetype = A
trigger5 = var(59) = 1
trigger5 = P2dist X <= 150
trigger5 = enemy,stateno = [5120,5210]
;trigger6 = frontedgedist < 75
;trigger6 = var(59) = 1
value = 0 + ((fvar(1) = 30) * 1)
ctrl = 1 - ((fvar(1) = 30) * 1)

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = var(59) = 1
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 7
trigger2 = animelem = 12
value = S20,0

[State 0, DestroySelf]
type = DestroySelf
triggerall = time 
trigger1 = ishelper
ignorehitpause = 1

;---------------------------------------------------------------------------
; Back Walk for AI
[Statedef 22]
type    = S
physics = S
sprpriority = 0

[State 100, 4]
type = ChangeState
triggerall = enemy,stateno != 5120
triggerall = enemy,stateno != [5151,5299]
trigger1 = var(59) = 1
trigger1 = P2bodydist X >= 100
;trigger1 = P2Movetype = A
trigger2 = win = 1
trigger3 = var(59) = 1
trigger3 = P2bodydist X <= 150
trigger3 = P2Movetype = A
trigger4 = var(59) = 1
trigger4 = p2dist x < -10
;trigger6 = frontedgedist < 75
;trigger6 = var(59) = 1
value = 0
ctrl = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
trigger2 = var(59) = 1
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 7
trigger2 = animelem = 12
value = S20,0

[State 0, DestroySelf]
type = DestroySelf
triggerall = time 
trigger1 = ishelper
ignorehitpause = 1

