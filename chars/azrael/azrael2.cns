; Jump Start For AI
[Statedef 40000]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[state 40, 1]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[State 40, 2]
type = NotHitBy
trigger1 = 1
value = SCA, AT

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = var(59) > 0
trigger2 = p2Movetype = H && p2dist x > 60 || Random <= 500 && p2Movetype != H
trigger3 = var(59) > 0
trigger3 = p2Movetype != H && p2dist x > 60 || Random <= 300 && p2Movetype != H
trigger4 = fvar(1) > 0
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = fvar(1) = 0
trigger1 = command = "holdback"
;trigger2 = var(59) > 0
;trigger2 = p2Movetype != H
;trigger2 = p2Statetype != A
;trigger2 = !time
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
value = S41,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
trigger1 = random < 100 * var(56)
value = S10040,0+random%5
channel = 0

