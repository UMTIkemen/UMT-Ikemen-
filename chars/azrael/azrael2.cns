; Downed get-hit (getting up)
[Statedef 5120]
type    = L
movetype= I
physics = N

[State 0, PlaySnd]
type = PlaySnd
trigger1 = !time
trigger1 = random < 200 * var(56)
value = S15120,0+random%4
channel = 0

[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

[State 40, 2]
type = NotHitBy
trigger1 = time = [0,13]
value = , AT, NT, ST, HT

[State 40, 2]
type = StatetypeSet
trigger1 = time = 14
statetype = S

[State 1210, 3]
type = ChangeState
triggerall = time > 13
trigger1 = command = "holdback"
trigger1 = enemynear,movetype = A
;trigger1 = inguarddist
value = 120

[State 5120, 4]
