type    = A
physics = N
ctrl = 0
velset = 0,0

[State ]
type = VarSet
triggerall = time >= 0
trigger1 = var(19) != 2
trigger2 = prevstateno = 600
trigger3 = prevstateno = 610
trigger4 = prevstateno = 620
var(19) = 2

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = fvar(1) > 0
trigger3 = var(59) = 1
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
