; 5YY GCH/j.2A WPA Ground Bounce Get-Hit (shaking)
[Statedef 15000]
type    = A
movetype= H
physics = N
facep2 = 1
velset = 0,0

[State 5020, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
value = 5050

[State 5020, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 10005]
Type = VelSet
Trigger1 = !HitShakeOver
X = 0
Y = 0

[State 0, PosSet]
type = PosSet
trigger1 = !time
trigger1 = pos y > 0
y = 0

[State 5020, 5]
type = ChangeState
trigger1 = HitShakeOver
value = 15001

[State 5020, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5020, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5020, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
trigger4 = anim = [5051,5059]
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 0, DestroySelf]
type = DestroySelf
trigger1 = ishelper
ignorehitpause = 1

;---------------------------------------------------------------------------
; 5YY GCH/j.2A WPA Ground Bounce (knocked away)
[Statedef 15001]
type    = A
movetype= H
physics = N
ctrl = 0

[State 5030, 1]
type = ChangeAnim
trigger1 = Anim != [5000, 5199]
trigger1 = SelfAnimExist(5050)
value = 5050

[State 5030, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5030, 3]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5030, 5]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= Const(movement.air.gethit.groundlevel)
value = 15003 ;HITA_FALL

[State 5030, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 15002 ;Air get-hit (transition)

;---------------------------------------------------------------------------
; 5YY GCH/j.2A WPA Ground Bounce (transition)
[Statedef 15002]
type    = A
movetype= H
physics = N

;[State 5035, 1]
;type = ChangeAnim
;trigger1 = Time = 0
;trigger1 = SelfAnimExist(5035)
;trigger1 = Anim != [5051,5059] ;Not if in hit up anim
;trigger1 = Anim != 5090 ;Not if hit off ground anim
;value = 5035

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5035, 4]
type = ChangeState
trigger1 = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = HitFall
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = HitFall
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= Const(movement.air.gethit.groundlevel)
trigger4 = HitFall
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
trigger5 = pos y >= 10
value = 15003 ;Air get-hit (falling)

;---------------------------------------------------------------------------
; 5YY GCH/j.2A WPA Ground Bounce (falling)
[Statedef 15003]
type    = A
movetype= H
physics = N

;[State 5050, 1] ;Change anim when done with transition
;type = ChangeAnim
;trigger1 = AnimTime = 0
;trigger1 = Anim = 5035
;trigger2 = Time = 0     ;If no transition anim
;trigger2 = Anim != 5035
;trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
;trigger2 = Anim != 5090 ;Not if hit off ground anim
;value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, Const720p(4), Const720p(-8))
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, Const(movement.air.gethit.groundlevel))
value = 15004 ;Downed get-hit (hit ground from fall)

;---------------------------------------------------------------------------
; 5YY GCH/j.2A WPA Ground Bounce (hit ground from fall)
[Statedef 15004]
type    = L
movetype= H
physics = N

[State 5100, 2004.04.14 behavior]
type = null;VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x < -1
x = -1

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069]) && (anim != [5070,5072])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5100, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75;75

;[State 5100, 7]
;type = SelfState
;trigger1 = Time = 0
;trigger1 = GetHitVar(fall.yvel) = 0
;value = 5110 ;Downed get-hit (lying down)

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 10]
type = PlaySnd
trigger1 = Time = 1
value = F7, (sysvar(1) > Const720p(20)) + (sysvar(1) > Const720p(56))

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 15005 ;Downed get-hit (bounce off ground)

[State 5100, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

;---------------------------------------------------------------------------
; 5YY GCH/j.2A WPA Ground Bounce (Bounce)
[Statedef 15005]
type    = L
movetype= H
physics = N

[State 5035, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5050)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 5101, 3]
type = HitFallVel
trigger1 = Time = 0

[State 5101, 4]
type = PosSet
trigger1 = Time = 0
y = Const(movement.down.bounce.offset.y)

[State 5101, 5]
type = PosAdd
trigger1 = Time = 0
x = Const(movement.down.bounce.offset.x)

[State 5101, 6] ;Acceleration
type = Velset
trigger1 = !time
y = -12.5

[State 5101, 6] ;Acceleration
type = VelAdd
trigger1 = 1
y = Const(movement.down.bounce.yaccel)*1.8

[State 5050, 4] ;Recover near ground
type = selfState
triggerall = Vel Y > 0 || 1
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
;trigger2 = 1;Test Mark
value = 5200 

[State 5050, 5]; Recover in mid air
type = selfState
triggerall = Vel Y > -1 || 1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
;trigger2 = 1;Test Mark
value = 5210 

[State 5101, 7] ;Hit ground
trigger1 = Vel Y > 0
trigger1 = Pos Y >= Const(movement.down.bounce.groundlevel)
type = SelfState
value = 5110

