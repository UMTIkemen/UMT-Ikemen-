;AI Combo Paths
[Statedef -3]
;===========================================================================
;===========================================================================

;---------------------------------------------------------------------------
;Am I being Custom Stated?
[State 2OS]
type=varset
trigger1=1
var(31)=gametime*2
ignorehitpause=1
persistent=1
;---------------------------------------------------------------------------

[State -3, When To Warp Like You Just Don't Care]
type = hitoverride
triggerall = statetype = S || statetype = C || statetype != A
triggerall = var(59) = 1 && roundstate = 2
triggerall = palno = [10,12]
;triggerall = p2dist x = [-999,999]
trigger1 = stateno = [150,153]
trigger1 = random <= 150
trigger2 = stateno = [120,131]
trigger2 = random <= 100
trigger3 = stateno = [0,20]
trigger3 = random <= 25
attr = SC, NA, SA, NP, SP
stateno = 100+(5*(p2dist x = [0,110])*(backedgedist != [-999,50])*(random <= (300 + (700*frontedgedist < 110))))
slot = 0
time = 8
ignorehitpause = 1
;---------------------------------------------------------------------------

;Combo Reset
[State -2, VarAdd]
Type = VarSet
triggerall = fvar(1) != 0
trigger1 = p2movetype != H ;&& (enemy,teammode != simul)
trigger2 = enemy,alive = 0
trigger3 = movetype = H
trigger4 = var(59) = 0
trigger5 = stateno = [200,620]
trigger5 = moveguarded || animtime = 0 && !movehit && anim != 310 
trigger6 = stateno = [1000,1999]
trigger6 = moveguarded || animtime = 0 && !movehit
;trigger7 = var(22) > 820
trigger7 = stateno = [2000,2999]
trigger7 = moveguarded || animtime = 0 && !movehit && anim != 2400 && anim != 2300 && anim != 2800 && anim != 2600 && anim != 2601
trigger8 = stateno = 1 && time > 20
IgnoreHitPause = 1
fvar(1) = 0

