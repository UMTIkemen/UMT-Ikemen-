trigger2 = !AILevel
trigger2 = StateType = A && (helper(10372), var(3)&136) > 0 && Var(6) < 2
trigger3 = AILevel && NumEnemy
trigger3 = StateType = S || StateType = C || (StateType = A && Var(6) < 2)
	trigger3 = Random <= 200+AILevel*10
