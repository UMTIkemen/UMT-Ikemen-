trigger1 = 1
text = "OC = %d, P2Dist X = %f, P2Dist Y = %f, PCT = %d, stuff = %d"
params = Var(31), P2Dist X, P2Dist Y, ProjCancelTime(0), Var(24)

[State -2, DTC]
type = null;AppendToClipboard
trigger1 = 1
text = "\nnumProj(1) = %d, numProj(1000) = %d"
