;================================================
; Constants and state file for Goddess Athena CvS2
;================================================
;--------------------- Variable List ----------------------

;  Var(0) - Used in Just Defend
;  Var(1) - NoWalk Parry
;  Var(2) - Returns ShakeTime for Just Defense
;  Var(3) - Finest KO, WaruFVar(15)
;  Var(4) - Used in the Long Jump
;  Var(5) - 2: Run/Dash
;           4: Just Defend
;           8: Parry
;          16: Super Combo Cancel
;          32: Counter Attack
;          64: Counter Movement
;         128: Safe Fall
;         256: Air Guard
;         512: Dizzy Enabled (with exceptions)
;        1024: Roll Cancel Enabled
;        2048: Tactical Recovery
;        4096: Tactical Recovery Temp
;   536870912: Sign Bit for Pushback (1 = negative)
;  1073741824: Dizzy notification (P2)
; -2147483648: Dizzy notification (P4)
;  Var(6) - Indicates whether or not Small Jump is activated
;  Var(7) - 
;  Var(8) - Animation time offset
;  Var(9) - Roll/Dodge 
; Var(10) - Gauge Selection
; Var(11) - 
; Var(12) - GOOD SHOT
; Var(13) - GetHitVar(hitTime)
; Var(14) - Just Defend
; Var(15) - Safe Fall Detection
; Var(16) -
; Var(17) - S-Groove MAX Power
; Var(18) - N-Groove MAX Power
; Var(19) - K-Groove Rage
; Var(20) - Groove Select
;           0 =  None
;           1 =  C-Groove
;           2 =  A-Groove
;           3 =  P-Groove
;           4 =  S-Groove
;           5 =  N-Groove
;           6 =  K-Groove
;           7 = EX-Groove
; Var(21) - Detects the enemy's MoveType. WaruVar(41)
; Var(22) - Differentiation of commands.
; Var(23) -
; Var(24) - Reflector
; Var(25) -
; Var(26) - Manchester Gold Lvl.2 Cancel
; Var(27) - Set upon victory/loss.
; Var(28) - State detection, WaruVar(48)
; Var(29) - Power Reset
; Var(30) - Custom Combo
; Var(31) - x2
; Var(32) - Target ID
; Var(33) - Hit Counter, Waruvar(47)
; Var(34) - Announcer Time Counter
; Var(35) - Descale Groove Bar, WaruVar(52)
; Var(36) - x5, WaruVar(54)
; Var(37) - First Attack
; Var(38) - Set upon victory/loss, WaruVar(55)
; Var(39) - x2, WaruVar(56)
; Var(40) - Power Increase
; Var(41) - x2
; Var(42) - Returns Damage
; Var(43) - Custom Combo Timer
; Var(44) - Power
; Var(45) - Returns Life/WaruVar(53)
; Var(46) - Negative edge conflict check
; Var(47) - Groove Point/WaruVar(50)
; Var(48) - Superpause unguardable time
; Var(49) - Current HitDef dizzy points
; Var(50) - Combo
; Var(51) - Hit Counter, WaruVar(17)
; Var(52) - Used in the combo dampener, WaruVar(7)
; Var(53) - x2, WaruVar(8)
; Var(54) - x3, WaruVar(9)
; Var(55) - Message Count
; Var(56) - Cornerpush
; Var(57) - PalFX Add, Combo dampener
; Var(58) - Used in the combo dampener, WaruVar(21)
; Var(59) - State Decision, WaruVar(49)

;--------------------- Float Variable List ----------------------

;  FVar(0) - Descale Groove Bar, WaruFVar(20)
;  FVar(1) - Cheap K.O. Anim
;  FVar(2) - KO Voice
;  FVar(3) - Fire/Shock Spark, WaruFVar(25)
;  FVar(4) - Current HitDef X Air HitVel
;  FVar(5) - Current HitDef Y Air HitVel
;  FVar(6) - Trigger Once
;  FVar(7) - Announcer Voice
;  FVar(8) - WaruVar(12), Returns Life
;  FVar(9) - Used in the combo dampener.
; FVar(10) - Combo dampener.
; FVar(11) - Throw
; FVar(12) - WaruFVar(24)
; FVar(13) - Lvl.2 Cancel Juggle Time
; FVar(14) - Throw
; FVar(15) - Power Reset, WaruFVar(14)
; FVar(16) - Juggle System, WaruFVar(27)
; FVar(17) - CvS2 Character
; FVar(18) - Juggle Timer Set Value
; FVar(19) - Juggle Timer Current Value
; FVar(20) - GROOVE POINT ON/OFF
; FVar(21) - KSSSSSSSSSHHHHHHHHHH, WaruVar(32)
; FVar(22) - KSSSSSSSSSHHHHHHHHHH, WaruFVar(11)
; FVar(23) -
; FVar(24) - Win Message Axis, WaruFVar(37)
; FVar(25) -
; FVar(26) - x2, WaruVar(38)
; FVar(27) - x3, WaruVar(39)
; FVar(28) - x4, WaruVar(44)
; FVar(29) - x5, WaruVar(45)
; FVar(30) - Reversal Message, WaruFVar(22)
; FVar(31) - x2, WaruFVar(23)
; FVar(32) - Parry Message, WaruFVar(8)
; FVar(33) - Finish Message, WaruFVar(9)
; FVar(34) -
; FVar(35) - KO Voice, WaruVar(37)
; FVar(36) - KO Voice, WaruVar(27)
; FVar(37) - Power Up! Sound, WaruFVar(21)
; FVar(38) - Zangief Intro Pos X
; FVar(39) - Cornerpush

;--------------------- System Variable List ----------------------
; SysVar(0) - See data/common1.cns
; SysVar(1) - See data/common1.cns
; SysVar(2) - Used for proper velocity direction in state 5100.


[Data]
life = 900
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 13
airjuggle = 15
sparkno = 25					;Roll invul time (Turbo)
guard.sparkno = 40
KO.echo = 0
volume = 100
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = .544444444 ;.60		
yscale = .5 ;.509			
ground.back = 15		
ground.front = 15		
air.back = 15		
air.front = 15		
height = 60	
attack.dist = 160		
proj.attack.dist = 90	
proj.doscale = 0		 
head.pos = 0, -75		
mid.pos = 0, -55	
shadowoffset = 0		
draw.offset = 0,0		

[Velocity]
walk.fwd  = 3.3
walk.back = -3.3
run.fwd  = 5.3, 0
run.back = -5.3,-5.5
jump.neu = 0,-9.2 ; Neutral Jump applies to var(4) and var(6)
jump.back = -6.5 ; Regular Jump Only, doesnt effect var(4) or var(6)
jump.fwd = 6.5 ; Regular Jump Only, doesnt effect var(4) or var(6)
runjump.back = -11.2 ;Long Jump
runjump.fwd = 11.1 ; Long Jump
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .58
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = ifElse(Var(6)>0,50,40)
ctrl = 0
sprpriority = 1
facep2 = 1
velset = 0,0

[State 40, Helper]
type = Helper
trigger1 = AnimTime = 0
id = 8020
name = "Jump Effect"
pos =0,0
postype = p1
stateno = 8020
keyctrl = 0
ownpal = 1
ignorehitpause = 1

; AI movement, thanks, Warusaki!
[State 40, AI]
type = ChangeState
triggerall = AILevel
trigger1 = Time = 0
trigger1 = P2MoveType = A || Random%(AILevel+4) != 3
value = ifelse(inguarddist,130,21)

[State 40, 1]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,80]
sysvar(1) = 0
[State 40, 2]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [81,750]
sysvar(1) = 1
[State 40, 3]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [751,999]
sysvar(1) = -1
[State 40, 1]
type = null;VarSet
triggerall = AILevel
triggerall = Time = 0
trigger1 = Var(30)
sysvar(1) = frontedgedist >= 60

[State 40, 5]
type = VarAdd
triggerall = Var(6) = 1
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,130]
var(6) = 2

[State 40, 4]
type = VarAdd
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,420]
var(4) = 1

[State 40, 1]
type = VarSet
triggerall = !AILevel
trigger1 = Time = 0
sysvar(1) = (((helper(10372), Var(4)&128) > 0) - ((helper(10372), Var(4)&64) > 0))

[State 40, 5]
type = VarSet
triggerall = Var(6) = 1
triggerall = !AILevel
triggerall = numHelper(10372)
trigger1 = (helper(10372), Var(4)&16) = 0 ; COMMAND != "/U"
var(6) = 2

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 0

[State 40, 4]
type = VarSet
triggerall = !AILevel
triggerall = NumHelper(10372)
triggerall = Time = 0
trigger1 = (PrevStateNo = 100 || PrevStateNo = 101) && sysvar(1) = 1
trigger2 = (helper(10372), var(59)&(2**29)) > 0	; COMMAND = "$D"
var(4) = 1 | (var(6) := 0) ; Longjump takes priority over Small jump

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !Var(4)
x = ifElse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*Const(Size.XScale)*(5.0/4.0)

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4)
x = ifElse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))*Const(Size.XScale)*(5.0/4.0)

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
y = ifElse(sysvar(1)=0, const(velocity.jump.y)*ifElse(Var(4),1.15,1), ifElse(sysvar(1)=1, -9.15, -9.25))*ifElse(Var(6)=2,.75,1)*(5.0/4.0)
; sysvar(1)=1, -8.875, -9.25 <--- This motherfucker here is the actual value for Long Jump Y Height only

[State 40, Jump Sound]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,Var(4)
channel = 13

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N
movetype = I

[State 50, 2] ; This is needed for Neutral/FWD/Back Anims
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, AfterImage]
type = AfterImage
triggerall = !Var(30)
trigger1 = Time = 0
trigger1 = Var(4) || PrevStateNo = 660
time = -1
PalBright = 1,1,1
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = .8,.8,.8
length = 12
trans = add1
TimeGap  = 1
FrameGap = 5

[State 50, VelAdd]
type = VelAdd
trigger1 = SysVar(1) = 1
x = -ifElse(Vel X <= 0,0,ifElse(Var(4),0.029296875,0.01953125))*(25.0/16.0)*(160.0/179.0)
[State 50, VelAdd]
type = VelAdd
trigger1 = SysVar(1) = -1
x = ifElse(Vel X >= 0,0,ifElse(Var(4),0.029296875,0.01953125))*(25.0/16.0)*(160.0/179.0)

[State 920, 0]
type = Gravity
trigger1 = 1

[State 50, ChangeState]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0
velset = 0,0

[State 100, Explod]
type = Explod
trigger1 = Time = 1
anim = 8040
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = 3
scale = .5,.5

[State 100, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S40,3
channel = 13

[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = S100,1
channel = 13
[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 7
value = S100,2
channel = 13

[State 100, 1]
type = VelSet
trigger1 = AnimElemTime(2) >= 0
x = const(velocity.run.fwd.x)*(5.0/4.0)*(160.0/179.0)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = numHelper(10372)
trigger1 = (helper(10372), var(4)&16) > 0 ; COMMAND = "/U"
value = 40

[State 100, 4]
type = ChangeState
triggerall = !AILevel
triggerall = AnimElemTime(2) >= 1
triggerall = numHelper(10372)
trigger1 = (helper(10372), var(4)&128) = 0 ; COMMAND != "/F"
value = 101

[State 100, 5]
type = ChangeState
triggerall = AILevel
triggerall = AnimElemTime(2) >= 1
trigger1 = P2BodyDist X <= 45 && Random <= 700
trigger2 = P2MoveType = A && Random <= 500 && P2BodyDist X <= 70
trigger3 = roundstate != 2
value = 101
ctrl = 1

;---------------------------------------------------------------------------
; RUN_END
[Statedef 101]
type = S
physics = N
ctrl = 0
anim = 101

[State 101, 0]
type = ChangeState
trigger1 = (helper(10372), var(4)&16) > 0 ; COMMAND = "/U"
value = 40

[State 101, 1]
type = VelAdd
trigger1 = 1
x = ifElse(Vel X <= 0, 0, -0.4270782470703125)*(25.0/16.0)
[State 101, 2]
type = VelSet
trigger1 = AnimTime = 0
x = 0

[State 101, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = S100,0
channel = 13

[State 101, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Dash Forward
[Statedef 102]
type    = A
physics = N
ctrl = 0
anim = 102
velset = 0,0

[State 102, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S40,3
channel = 13

[State 102, Explod]
type = Explod
trigger1 = Time = 0
anim = 8040
pos = 0, 0
postype = p1
ownpal = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = 3
scale = .5,.5

[State 102, 1]
type = VelSet
trigger1 = AnimElemTime(2) = 0
x = 5.9*(5.0/4.0)*(160.0/179.0)
y = -5.1*(5.0/4.0)
[State 105, 1]
type = VelAdd
trigger1 = AnimElemTime(2) > 0
x = ifElse(Vel X <= 0, 0, -0.0625)*(25.0/16.0)*(160.0/179.0)
[State 105, 1]
type = VelAdd
trigger1 = AnimElemTime(2) > 0
y = .5*(25.0/16.0)


[State 102, 3]
type = ChangeState
triggerall = AnimElemTime(2) > 0
trigger1 = Pos Y + Vel Y >= 0
value = 103

;---------------------------------------------------------------------------
; Dash Forward Land
[Statedef 103]
type    = S
physics = N
ctrl = 1
anim = 103

[State 103, Spark]
type = Explod
trigger1 = Time = 0
anim = 8030
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
scale = .5,.5

[State 103, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = S100,1
channel = 13

[State 103, 1]
type = VelSet
trigger1 = Time = 0
y = 0
[State 103, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 105, 1]
type = VelAdd
trigger1 = AnimElemTime(2) < 0
x = ifElse(Vel X <= 0, 0, -0.0625)*(25.0/16.0)
[State 103, 1]
