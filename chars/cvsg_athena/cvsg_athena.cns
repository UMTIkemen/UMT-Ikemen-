trigger2 = StateNo=1100
trigger3 = StateNo=1200
trigger4 = StateNo=1300
trigger5 = StateNo=1405
trigger6 = StateNo=1500
trigger7 = StateNo=3000
trigger8 = StateNo=[3100,3299]
trigger9 = MoveHit = 1
trigger10 = ProjHit = 1
trigger11 = numHelper(1005)
