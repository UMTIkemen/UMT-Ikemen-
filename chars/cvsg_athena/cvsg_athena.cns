triggerall = P2StateType != A && P2StateType != L
triggerall = Target, GetHitVar(YVel) = 0
triggerall = Var(50) = [1,2]
trigger1 = StateNo != [800,839]
x = FVar(39) * (160.0/179.0) * cond((var(5)&536870912) > 0, -1, 1) * (facing * target,facing)

[State -2, TargetVelAdd]
type = TargetVelAdd
triggerall = NumTarget
triggerall = P2StateType = A && P2StateType != L
triggerall = Target, GetHitVar(XVel) < 0
triggerall = cond(NumTarget(800), (Target, ID != Target(800), ID), 1)
triggerall = !MoveReversed
trigger1 = StateNo != [800,839]
x = cond(target, Vel X >= 0,0,0.01953125)*(25.0/16.0)*(160.0/179.0)*cond((var(5)&536870912) > 0, 1, -1) * (facing * target,facing)
[State -2, TargetVelAdd]
type = TargetVelAdd
triggerall = NumTarget
triggerall = P2StateType = A && P2StateType != L
triggerall = Target, GetHitVar(XVel) > 0
triggerall = cond(NumTarget(800), (Target, ID != Target(800), ID), 1)
triggerall = !MoveReversed
trigger1 = StateNo != [800,839]
x = cond(target, Vel X <= 0,0,-0.01953125)*(25.0/16.0)*(160.0/179.0)*cond((var(5)&536870912) > 0, 1, -1) * (facing * target,facing)

[State -2, Cornerpush]
type = PosAdd
triggerall = FVar(39)
triggerall = RoundState = 2
triggerall = numtarget >= 1
triggerall = (target, BackEdgeBodyDist <= 0) || (target, FrontEdgeBodyDist <= 0)
triggerall = Var(50) < 3;ProjContact = 0, < 50
triggerall = StateNo != [800,839]
triggerall = StateNo != [102,106]
triggerall = P2StateType != A
triggerall = StateType != A; OR IS IT
triggerall = target, GetHitVar(YVel) = 0
triggerall = target, cond(Pos Y < 0, ceil(Pos Y) = 0, floor(Pos Y) = 0)
triggerall = !MoveReversed
trigger1 = StateNo != 970 && StateNo != 975 && StateNo != 3000 && StateNo != 3100 && StateNo != 3200
trigger2 = (StateNo = [3000,3200]) && !Var(48)
x = ifElse(P2StateType = L, (target, Vel X), FVar(39) * (160.0/179.0) * cond((var(5)&536870912) > 0, -1, 1) * (facing * target,facing))

