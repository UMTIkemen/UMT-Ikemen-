triggerall = Var(50) = [1,2]
trigger1 = StateNo != [800,839]
x = FVar(39) * (160.0/179.0) * cond((var(5)&536870912) > 0, -1, 1) * (facing * target,facing)

[State -2, TargetVelAdd]
