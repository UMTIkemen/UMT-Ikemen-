;---------------------------------------------------------------------------
; Win state decider
; 勝利ポーズ分岐
; CNS レベル: 基本
;
;ここで勝利ポーズを選択する。　MatchOverは試合終了を判定するので、
;一回目と二回目勝利を別のポーズにしたい時に便利。
[Statedef 180]
type = S

[State 180, 2]
type = ChangeState
trigger1 = Time = 0
value = 181 ;+(random%2)

;---------------------------------------------------------------------------
; Win Pose 1
; 勝利ポーズ1
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = S8,8+(random%5)

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 250
flag = RoundNotOver

;---------------------------------------------------------------------------
; Introduction
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, ChangeState]
type = null;ChangeState
triggerall = NumEnemy
trigger1 = (Enemy, Name = "cvszangief") && (Enemy, AuthorName = "Warusaki3")
trigger2 = (Enemy, Name = "Zangief") && (Enemy, AuthorName = "KoopaKoot")
value = 191

[State 190, ChangeState]
type = null;ChangeState
triggerall = NumEnemy
trigger1 = (Enemy, Name = "Sagat") && (Enemy, AuthorName = "DivineWolf")
trigger2 = (Enemy, Name = "cvssagat") && (Enemy, AuthorName = "Jesuszilla")
value = 192

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = Time = 0
value = 191 ; random%

;---------------------------------------------------------------------------
; イントロ（試合開始直前のアクション） // Yoroshiku Onegaishimasu
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA

[State 191, 特殊効果] ;「ROUND1, FIGHT!」のアナウンスが始まるまでは、このコントローラを使ってください
type = AssertSpecial
trigger1 = 1
flag = Intro ;イントロの状態になります

