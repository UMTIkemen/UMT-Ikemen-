;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = ifElse(Var(6)>0,50,40)
ctrl = 0
sprpriority = 1
facep2 = 1
velset = 0,0

[State 40, Helper]
type = Helper
trigger1 = AnimTime = 0
id = 8020
name = "Jump Effect"
pos =0,0
postype = p1
stateno = 8020
keyctrl = 0
ownpal = 1
ignorehitpause = 1

; AI movement, thanks, Warusaki!
[State 40, AI]
type = ChangeState
triggerall = AILevel
trigger1 = Time = 0
trigger1 = P2MoveType = A || Random%(AILevel+4) != 3
value = ifelse(inguarddist,130,21)

[State 40, 1]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,80]
sysvar(1) = 0
[State 40, 2]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [81,750]
sysvar(1) = 1
[State 40, 3]
type = VarSet
triggerall = PrevStateNo != 100 && PrevStateNo != 101
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [751,999]
sysvar(1) = -1
[State 40, 1]
type = null;VarSet
triggerall = AILevel
triggerall = Time = 0
trigger1 = Var(30)
sysvar(1) = frontedgedist >= 60

[State 40, 5]
type = VarAdd
triggerall = Var(6) = 1
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,130]
var(6) = 2

[State 40, 4]
type = VarAdd
triggerall = AILevel
triggerall = Time = 0
trigger1 = Random = [0,420]
var(4) = 1

[State 40, 1]
type = VarSet
triggerall = !AILevel
trigger1 = Time = 0
sysvar(1) = (((helper(10372), Var(4)&128) > 0) - ((helper(10372), Var(4)&64) > 0))

[State 40, 5]
type = VarSet
triggerall = Var(6) = 1
triggerall = !AILevel
triggerall = numHelper(10372)
trigger1 = (helper(10372), Var(4)&16) = 0 ; COMMAND != "/U"
var(6) = 2

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 0

[State 40, 4]
type = VarSet
triggerall = !AILevel
triggerall = NumHelper(10372)
triggerall = Time = 0
trigger1 = (PrevStateNo = 100 || PrevStateNo = 101) && sysvar(1) = 1
trigger2 = (helper(10372), var(59)&(2**29)) > 0	; COMMAND = "$D"
var(4) = 1 | (var(6) := 0) ; Longjump takes priority over Small jump

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !Var(4)
x = ifElse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))*Const(Size.XScale)*(5.0/4.0)

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4)
x = ifElse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))*Const(Size.XScale)*(5.0/4.0)

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
y = ifElse(sysvar(1)=0, const(velocity.jump.y)*ifElse(Var(4),1.15,1), ifElse(sysvar(1)=1, -7.275, -7.275))*ifElse(Var(6)=2,.75,1)*(5.0/4.0)
; sysvar(1)=1, -6.875, -7.25 <--- This motherfucker here is the actual value for Long Jump Y Height only
; First Value is Jump Fwd Y Vel, the second is Jump Back Y Vel

[State 40, Jump Sound]
type = PlaySnd
trigger1 = AnimTime = 0
value = S40,Var(4)
channel = 13

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N
movetype = I

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 41

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, AfterImage]
type = AfterImage
triggerall = !Var(30)
trigger1 = Time = 0
trigger1 = Var(4) || PrevStateNo = 660
time = -1
PalBright = 1,1,1
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = .8,.8,.8
length = 12
trans = add1
TimeGap  = 1
FrameGap = 5

[State 50, VelAdd]
type = VelAdd
trigger1 = SysVar(1) = 1
x = -ifElse(Vel X <= 0,0,ifElse(Var(4),0.029296875,0.01953125))*(25.0/16.0)*(160.0/179.0)
[State 50, VelAdd]
type = VelAdd
trigger1 = SysVar(1) = -1
x = ifElse(Vel X >= 0,0,ifElse(Var(4),0.029296875,0.01953125))*(25.0/16.0)*(160.0/179.0)

[State 920, 0]
type = Gravity
trigger1 = 1

[State 50, ChangeState]
type = ChangeState
trigger1 = Vel Y + Pos Y >= 0
value = 52

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0
velset = 0,0

[State 100, Explod]
type = Explod
trigger1 = Time = 1
anim = 8040
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = 3
scale = .5,.5

[State 100, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S40,3
channel = 13

[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = S100,1
channel = 13
[State 100, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 7
value = S100,2
channel = 13

[State 100, 1]
type = VelSet
trigger1 = AnimElemTime(2) >= 0
x = const(velocity.run.fwd.x)*(5.0/4.0)*(160.0/179.0)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
triggerall = numHelper(10372)
trigger1 = (helper(10372), var(4)&16) > 0 ; COMMAND = "/U"
value = 40

[State 100, 4]
type = ChangeState
triggerall = !AILevel
triggerall = AnimElemTime(2) >= 1
triggerall = numHelper(10372)
trigger1 = (helper(10372), var(4)&128) = 0 ; COMMAND != "/F"
value = 101

[State 100, 5]
type = ChangeState
triggerall = AILevel
triggerall = AnimElemTime(2) >= 1
trigger1 = P2BodyDist X <= 45 && Random <= 700
trigger2 = P2MoveType = A && Random <= 500 && P2BodyDist X <= 70
trigger3 = roundstate != 2
value = 101
ctrl = 1

;---------------------------------------------------------------------------
; RUN_END
[Statedef 101]
type = S
physics = N
ctrl = 0
anim = 101

[State 101, 0]
type = ChangeState
trigger1 = (helper(10372), var(4)&16) > 0 ; COMMAND = "/U"
value = 40

[State 101, 1]
type = VelAdd
trigger1 = 1
x = ifElse(Vel X <= 0, 0, -0.4270782470703125)*(25.0/16.0)
[State 101, 2]
type = VelSet
trigger1 = AnimTime = 0
x = 0

[State 101, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
value = S100,0
channel = 13

[State 101, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

