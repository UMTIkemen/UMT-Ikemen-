triggerall = NumTarget
triggerall = P2StateType = A && P2StateType != L
triggerall = Target, GetHitVar(XVel) < 0
triggerall = cond(NumTarget(800), (Target, ID != Target(800), ID), 1)
triggerall = !MoveReversed
trigger1 = StateNo != [800,839]
