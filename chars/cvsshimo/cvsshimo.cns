;----------------------------------------------------------------------------------
; Variable Height
[State -2, Variable Height]
type = PlayerPush
triggerall = StateType = A && NumEnemy
triggerall = P2Dist Y - Vel Y >= (EnemyNear(0), Const(Size.Height) - 33)
trigger1 = StateNo = [40,50]
trigger2 = StateNo = [600,650]
trigger3 = StateNo = [1000,1999]
value = 0

[State -2, Variable Height]
type = PlayerPush
triggerall = StateType = A && NumEnemy
triggerall = P2Dist Y - Vel Y >= (EnemyNear(0), Const(Size.Height) - 33)
triggerall = (StateNo = [40,50]) || (StateNo = [600,650]) || (StateNo = [1000,1999])
trigger1 = P2StateType = S
trigger1 = P2Dist Y - Vel Y >= (EnemyNear(0), Const(Size.Height) - 33)
trigger2 = P2StateType = C
trigger2 = P2Dist Y - Vel Y >= (floor(EnemyNear(0), Const(Size.Height)*0.825) - 33) ; 0.825 is chosen because it is a nice float (bitwise) and comes from Sagat's standing pushbox height to his crouching pushbox height.
trigger3 = P2StateType = C
trigger3 = P2Dist Y - Vel Y >= (12 - 33) ; This isn't really necessary since the chance of it triggering is low, but I pulled 12 from Sagat's CvS2 liedown hurt box height
value = 0

[State 3100, Sign Reset]
type = VarSet
trigger1 = StateNo = 3100
trigger1 = HitPauseTime = 1
trigger1 = !(AnimElemTime(6) >= 0 && AnimElemTime(7) < 0)
trigger1 = !(AnimElemTime(14) >= 0 && AnimElemTime(15) < 0)
trigger1 = !(AnimElemTime(22) >= 0 && AnimElemTime(23) < 0)
trigger1 = !(AnimElemTime(30) >= 0 && AnimElemTime(31) < 0)
trigger1 = !(AnimElemTime(38) >= 0 && AnimElemTime(39) < 0)
trigger2 = StateNo != 3100
var(5) = (var(5)&-536870913)
ignorehitpause = 1

