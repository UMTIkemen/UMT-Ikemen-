trigger1 = p2dist X < -20

[State 5210, 2] ;Go up
type = VelSet
trigger1 = Time = 0
trigger1 = Var(59) = 0
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
trigger2 = var(59)>0 && Roundstate=2 && Alive && !Ishelper
trigger2 = P2Bodydist X<=30
trigger2 = Random<20
x = -1.5
y = -4

[State 5210, 2] ;Go fwd
type = VelSet
trigger1 = Time = 0
trigger1 = Var(59) = 0
trigger1 = Command = "holdfwd"
trigger2 = var(59)>0 && Roundstate=2 && Alive && !Ishelper
trigger2 = P2Bodydist X>=100
trigger3 = var(59)>0 && Roundstate=2 && Alive && !Ishelper
trigger3 = P2Bodydist X<100
trigger3 = (Helper(111111),Rootdist X<100 && Facing=-1)||(Helper(111112),Rootdist X<100 && Facing=1)
x = 3
y = -6

[State 5210, 2] ;Go back
type = VelSet
trigger1 = Time = 0
trigger1 = Var(59) = 0
trigger1 = Command = "holdback"
trigger2 = var(59)>0 && Roundstate=2 && Alive && !Ishelper
trigger2 = P2Bodydist X<=30
trigger2 = (Helper(111111),Rootdist X>=100 && Facing=-1)||(Helper(111112),Rootdist X>=100 && Facing=1)
x = -3
y = -6

[State 5210, 3]
type = NotHitBy
trigger1 = Time = 0
value = SCA,AA,AT,AP
time = 15

