; HITA_UP_T (transition)
[Statedef 5035]
type    = A
movetype= H
physics = N

[State -1, Effect]
type     = RemoveExplod
Trigger1 = StateTime = 0
ID       = 10000

[State 5035, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != [5090,5091] ;Not if hit off ground anim
value = 5035

[State -1, Effect]
type     = Explod
Trigger1 = NumExplod(10000) = 0
Anim     = anim+10000
ID       = 10000
Pos      = 0,0
scale    = const(size.xscale),const(size.xscale)
postype  = p1
sprpriority = -1
ownpal   = 1
bindtime = -1
removeongethit = 1
removetime = -1
SuperMoveTime = 0
PauseMoveTime = 0

[State 5035, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5035, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5040 ;HITA_RECOV

[State 5035, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
