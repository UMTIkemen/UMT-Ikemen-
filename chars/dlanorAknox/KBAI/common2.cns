; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State -1, Effect]
type     = RemoveExplod
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
trigger3 = anim = [5050,5059]
trigger3 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger3 = SelfAnimExist(anim+10)
ID       = 10000

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State -1, Effect]
type     = Explod
Trigger1 = NumExplod(10000) = 0
Anim     = anim+10000
ID       = 10000
Pos      = 0,0
scale    = const(size.xscale),const(size.xscale)
postype  = p1
sprpriority = -1
ownpal   = 1
bindtime = -1
removeongethit = 1
removetime = -1
SuperMoveTime = 0
PauseMoveTime = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Var(59) = 0
trigger1 = Command="fwd" || Command="back" || Command="holdfwd" || Command="holdback"
trigger1 = Command!="holdup" || Command="holddown"
trigger2 = Var(59) = 0
trigger2 = Command="up" || Command = "holdup"
trigger2 = Command!="holdfwd" || Command!="holdback" || Command!="holddown"
trigger3 = Var(59)=[1,2]
trigger3 = EnemyNear,MoveType!=A || (EnemyNear,MoveType=A&&InGuardDist)
trigger3 = random%12 < 7
trigger4 = (var(59)=[3,6]) && enemynear,movetype=A && !enemynear,movehit
trigger5 = var(59)>6 && enemynear,movetype=A && !enemynear,movehit
trigger5 = enemynear,time <= 6 || enemynear,hitdefattr = SCA,AA,AT
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1 && Pos Y < -20
triggerall = alive
triggerall = CanRecover
trigger1 = Var(59) = 0
trigger1 = Command="recovery"||command="x"||command="y"
trigger2 = Var(59)=[1,2]
trigger2 = EnemyNear,MoveType!=A || (EnemyNear,MoveType=A&&InGuardDist)
trigger2 = random%12 < 7
trigger3 = (var(59)=[3,6]) && enemynear,movetype=A && !enemynear,movehit
trigger4 = var(59)>6 && enemynear,movetype=A && !enemynear,movehit
trigger4 = enemynear,time <= 6 || enemynear,hitdefattr = SCA,AA,AT
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100 ;HIT_BOUNCE

[State -1]
Type = DestroySelf
Trigger1 = IsHelper
IgnoreHitPause = 1
