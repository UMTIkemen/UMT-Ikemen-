;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State -1, Effect]
type     = RemoveExplod
Trigger1 = StateTime = 0
Trigger2 = (vel x > 0 && Anim = 21) || (vel x <= 0 && Anim = 22)
ID       = 10000

[State 20, 1] ;Change from turning animation
type = ChangeState
trigger1 = Anim = 5
value = 5

[State -1, AI用]
type = ChangeState
trigger1 = var(59) > 0
trigger1 = time = 0
value = 0
ctrl = 1

[State 20, 1]
type = VelSet
TriggerAll = Var(59) = 0
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
TriggerAll = Var(59) = 0
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State -1, Effect]
type     = Explod
TriggerAll = Var(59) = 0
Trigger1 = NumExplod(10000) = 0
Anim     = anim+10000
ID       = 10000
Pos      = 0,0
scale    = const(size.xscale),const(size.xscale)
postype  = p1
sprpriority = -1
ownpal   = 1
bindtime = -1
facing = 1
removeongethit = 1
removetime = -1
SuperMoveTime = 0
PauseMoveTime = 0

;---------------------------------------------------------------------------
; Walk_AI
[Statedef 21]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State -1, Effect]
type     = RemoveExplod
Trigger1 = time = 0
ID       = 10000

[State 21, 1] ;Change from turning animation
type = ChangeState
trigger1 = Anim = 5
value = 5

[State 21, AI-1]
type = VelSet
TriggerAll = var(59)>0 && !Ishelper
triggerAll = PlayerIDExist(var(57))
trigger1 = P2Bodydist X>20+ifelse(Numhelper(1300)!=0,30,0)
trigger1 = PlayerID(var(57)),Statetype !=A
trigger2 = PlayerID(var(57)),Statetype = A
trigger2 = PlayerID(var(57)),Movetype = H
trigger2 = PlayerID(var(57)),stateNo !=[120,155]
trigger3 = PlayerID(var(57)),Statetype = A
trigger3 = P2Bodydist X>60
x = const(velocity.walk.fwd.x)

[State 21, AI-2]
type = VelSet
TriggerAll = var(59)>0 && !Ishelper
TriggerAll = PlayerIDExist(var(57))
trigger1 = PlayerID(Var(57)),movetype != H
trigger1 = P2BodyDist X > 240
trigger1 = random<10+Var(59)*2
;trigger2 = var(12)=2
x = const(velocity.walk.back.x)

[State 21, 前進、後退の変更があった際は一度ステート0へ戻す]
type = ChangeState
TriggerAll = var(59)>0 && !Ishelper
trigger1 = vel x > 0
trigger1 = Anim = 21
trigger2 = vel x < 0
trigger2 = Anim = 20
value = 0
ctrl=1

[State 21, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 21, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 21, 5]
type = ChangeState
TriggerAll = Var(59) > 0 && !Ishelper
trigger1 = roundstate != 2
trigger2 = inguarddist
trigger2 = !(NumHelper(1300) && Helper(1300),var(1)=1305)
trigger3 = vel X = 0
trigger4 = vel X > 0
trigger4 = p2bodydist X < -5
trigger5 = vel X < 0
trigger5 = p2bodydist X > 150 || backedgedist <= 0
;trigger5 = time >= 20+(random%11)
trigger6 = p2statetype != A
trigger6 = p2statetype != L
trigger6 = p2bodydist X = [-15,15]
trigger7 = p2statetype = L
trigger7 = p2bodydist X != [-45,45]
;trigger8 = vel X < 0 && var(12)!=2
trigger8 = var(49)=7 && var(48)=2 && p2bodydist X < 20
value = 0
ctrl = 1

[State -1, Effect]
type     = Explod
TriggerAll = Var(59) > 0
Trigger1 = NumExplod(10000) = 0
trigger1 = (vel x > 0 && statetime%40=0) || (vel x < 0 && statetime%50=0)
Anim     = anim+10000
ID       = 10000
Pos      = 0,0
scale    = const(size.xscale),const(size.xscale)
postype  = p1
sprpriority = -1
ownpal   = 1
bindtime = -1
facing = 1
removeongethit = 1
removetime = -1
SuperMoveTime = 0
PauseMoveTime = 0
IgnoreHitPause = 1

[State -1, Effect];AI起動時のみエフェクト消去
type     = null;RemoveExplod
Trigger1 = Var(59) > 0
ID       = 10000

