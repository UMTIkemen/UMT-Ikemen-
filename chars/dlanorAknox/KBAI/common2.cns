scale    = const(size.xscale),const(size.xscale)
postype  = p1
sprpriority = -1
ownpal   = 1
bindtime = -1
facing = 1
removeongethit = 1
removetime = -1
SuperMoveTime = 0
PauseMoveTime = 0

[State 39, 1]
type = VarSet
trigger1 = Time = 0
var(52) = 0
[State 39, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 39, 2-AI]
type = VarSet
TriggerAll = var(59)>0 && var(12)!=10 && Alive && !Ishelper
TriggerAll = PlayerIDExist(var(57))
triggerAll = Time = 0
trigger1 = P2Bodydist X>40
trigger2 = PlayerID(var(57)),Statetype = A
trigger2 = PlayerID(var(57)),Movetype = H
trigger3 = PLayerID(var(57)),numproj>=1
trigger3 = P2Bodydist X>80
trigger4 = BackEdgeBodydist<30
sysvar(1) = 1

[State 39, 3-AI]
type = VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper
TriggerAll = PlayerIDExist(var(57))
triggerall = Time = 0
triggerall = PlayerID(var(57)),movetype != H
triggerall = BackEdgeBodydist>=30
trigger1 = P2Bodydist X<30
trigger1 = PlayerID(var(57)),Statetype != A
trigger1 = BackEdgeBodyDist > 40
trigger2 = PlayerID(var(57)),Statetype = L
trigger2 = BackEdgeBodyDist > 40
trigger2 = P2Bodydist X<30
sysvar(1) = -1

[State 39, 3-AI2]
type = VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper
TriggerAll = PlayerIDExist(var(57))
triggerall = Time = 0
triggerall = BackEdgeBodydist>=30
trigger1 = var(12)=10
trigger1 = PlayerID(var(57)),Statetype != A
trigger1 = BackEdgeBodyDist > 40
sysvar(1) = -1

[State 39, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 39, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State -1]
Type = Helper
trigger1 = AnimTime = 0
Stateno  = 41
ID       = 41
Name     = "JumpEffect"
Pos      = 0,0
PosType  = P1
Ownpal   = 1
Keyctrl  = 0
IgnoreHitPause = 1
Persistent = 0

[State 39, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

