;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
; 準常時監視ステート（－３）
;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[Statedef -3]
;==============================================================================
;　ゲージ位置設定
;==============================================================================
[State -3, Null]
Type = Null
TriggerAll = 1
Trigger1 = 0&&fvar(17) := (200)+0.001*(10)+0.0001*(1)	;パートナーゲージ用
Trigger2 = 0&&fvar(18) := (30)+0.001*(70)+0.0001*(1)	;通常ゲージ用
Trigger3 = 0&&fvar(19) := (50)+0.001*(135)+0.0001*(1)	;メタゲージ用
ignorehitpause = 1

;(y座標)+0.001*(x座標)+0.0001*(ゲージの有無)となっています。（座標有効数字３桁）
;非表示にしたい方は一番右を(0)としてください。

;==============================================================================
;　マジックサーキット
;==============================================================================
[State -1]
Type     = Helper
Trigger1 = NumHelper(8000) = 0
Stateno  = 8000
ID       = 8000
Pos      = 0,0
PosType  = Back
Ownpal   = 1
Keyctrl  = 0
SuperMoveTime = 99999999
PauseMoveTime = 99999999

;==============================================================================
;　ダメージタッチ（プレイヤー）
;==============================================================================
[State -1, ChangeState]
Type = ChangeState
Value = ifelse(StateType=A,716,715)
triggerall = !Ishelper
TriggerAll = Command = "x"
TriggerAll = Alive = 1
TriggerAll = Var(59) = 0 && FVar(13) = 0 && FVar(14) >= 2000
triggerAll = StateType != A || PalNo >= 7
triggerAll !=hitshakeover
trigger1 = (StateNo = [5000,5119]) || StateNo = [150,159]
trigger2 = anim = [5000,5119]
trigger2 = gethitvar(isbound)=0
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;　アーマー処理
;------------------------------------------------------------------------------
[State -3, LifeAdd]
Type       = LifeAdd
triggerall = !ishelper
TriggerAll = StateNo = 1200
Trigger1   = Var(30) != 0
Value      = floor(Var(30))
[State -3, VarSet]
Type       = VarSet
triggerall = !ishelper
Trigger1   = Var(30) != 0
V          = 30
Value      = 0

;==============================================================================
;　AIデバッグ用
;==============================================================================
[State -2, デバッグ1]
type = DisplayToClipboard
trigger1 = 1
text = " V48=%d, V49=%d, fV34=%f, V59=%d, V44=%d \n"
params = var(48), var(49), fvar(39), var(59), var(44)
ignorehitpause = 1

[State -2, デバッグ2]
type = AppendToClipboard
trigger1 = 1
text = " 111111=%f, \t 111112=%f, 1300-1=%f, Y=%f \n"
params = (Helper(111111),Rootdist X), (Helper(111112),Rootdist X), (Helper(1300),Rootdist X), (Vel X)
ignorehitpause = 1

;==============================================================================
;　トレーニングキャラ判定
;==============================================================================
[State -3, Training];相手がトレーニング専用キャラの場合、アピールでメタゲージを満タン。
Type = varset
TriggerAll = stateno = 195
Trigger1 = enemy,Name = "Training" && enemy,Authorname = "stupa"
Trigger2 = enemy,Name = "TRM Man" && enemy,Authorname = "M3"
;Trigger3 = 
fv = 10
value = 720
ignorehitpause = 1

;==============================================================================
;　AI用Var管理
;==============================================================================
;===========================================================================
[State -1, プレイヤーID取得]
type = VarSet
TriggerAll = var(59)>0 && Alive
TriggerAll = !IsHelper
Trigger1 = NumEnemy = 1
v = 57
value = EnemyNear(0),ID

[State -1, プレイヤーID取得（タッグ戦）]
type = VarSet
TriggerAll = var(59)>0 && Alive
TriggerAll = !IsHelper
Trigger1 = NumEnemy >= 2
v = 57
value = IfElse(EnemyNear(0),Alive,EnemyNear(0),ID,EnemyNear(1),ID)

;===========================================================================
[State -1, カラーチェッカー]
type = null
TriggerAll = var(59)>0 && Alive && !Ishelper
Trigger1 = (Palno=[1,6]) && var(44):=1
Trigger2 = (Palno=[7,10]) && var(44):=2
Trigger3 = (Palno=[11,12]) && var(44):=3
ignorehitpause=1
;===========================================================================
[State -1, ちびキャラ擬似判定]
type = varadd
TriggerAll = var(59)>0 && RoundState=2 && Alive && !Ishelper && PlayerIDExist(var(57))
Triggerall = var(47)<=3 && NumEnemy=1
TriggerAll = PlayerID(var(57)),statetype!=A
TriggerAll = PlayerID(var(57)),statetype=S
Trigger1 = StateNo=200 && Time=3 && MoveContact=0
Trigger1 = P2bodydist X-Ceil(PlayerID(var(57)),Vel X*6)=[0,45]
Trigger2 = StateNo=211 && Time=6 && MoveContact=0
Trigger2 = P2bodydist X-Ceil(PlayerID(var(57)),Vel X*6)=[0,50]
Trigger3 = StateNo=210 && Time=10 && MoveContact=0
Trigger3 = P2bodydist X-Ceil(PlayerID(var(57)),Vel X*6)=[0,90]
;Trigger4 = PlayerID(var(57)),const(size.head.pos.y)<-50
v = 47
value = 1
ignorehitpause=1
;---------------------------------------------------------------------------
[State -1, ちびキャラ擬似判定リセット]
type = varset
TriggerAll = var(59)>0 && RoundState>2 && Alive && !Ishelper && PlayerIDExist(var(57))
Trigger1 = var(47)>0 && !(TeamMode=Single)
v = 47
value = 0
ignorehitpause=1
;===========================================================================
[State -1, AI飛び道具使用判断]
type = varset
TriggerAll = var(59)>0 && RoundState=2 && Alive && !Ishelper && PlayerIDExist(var(57))
TriggerAll = var(54)=0
trigger1 = Helper(300020),Var(54) && (PlayerID(Var(57)),NumProj !=0 || PlayerIDExist(var(45)))
trigger1 = !(PlayerID(Var(57)),Movetype=A && PlayerID(Var(57)),Hitdefattr=SCA,AA,AT,HP)
trigger1 = P2bodydist X >70
v = 54
value = 1
ignorehitpause=1
;---------------------------------------------------------------------------
[State -1, AIチーム時飛び道具判断リセット]
type = varset
TriggerAll = var(59)>0 && Alive && !Ishelper
Trigger1 = var(54)!=0 && Enemy,TeamMode=Turns
Trigger1 = Roundstate > 2
V = 54
value = 0
ignorehitpause=1
;===========================================================================
[State -1, メタコンボ用Prevstate記憶]
type = varset
TriggerAll = var(59)>0 && RoundState=2 && Alive
TriggerAll = var(49)>0
trigger1 = stateno=2900 && time=1
v = 11
value = Prevstateno
ignorehitpause=1
;---------------------------------------------------------------------------
[State -1, Prevstateリセット]
type = varset
TriggerAll = var(59)>0 && Alive && var(49)>0
Trigger1 = (stateno!=[2900,2940]) && Movehit
Trigger2 = PlayerID(var(57)),Stateno=5120
Trigger3 = PlayerID(var(57)),Movetype!=H
Trigger4 = PlayerID(var(57)),Movetype!=H
Trigger4 = statetype!=A && fvar(39)=0
V = 11
value = 0
ignorehitpause=1
;===========================================================================
[state -3, AI用重力加速度計測]
type = varset
triggerall = !ishelper
trigger1 = fvar(24) != PlayerID(var(57)),const(movement.yaccel)
trigger1 = PlayerID(var(57)),stateno != [5000,5210]
trigger1 = PlayerID(var(57)),Vel Y != 0
FV = 24
value = PlayerID(var(57)),const(movement.yaccel)
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -3, AI用重力加速度計測]
type = varset
triggerall = !ishelper
trigger1 = fvar(24) != PlayerID(var(57)),GetHitVar(yaccel)
trigger1 = PlayerID(var(57)),stateno = [5000,5210]
trigger1 = PlayerID(var(57)),Vel Y != 0
FV = 24
value = PlayerID(var(57)),GetHitVar(yaccel);(打撃当てた時のyaccel値)
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -3, AI用重力加速度計測]
type = varset
triggerall = !ishelper
trigger1 = fvar(24) != 0
trigger1 = PlayerID(var(57)),Vel Y = 0
FV = 24
value = 0;(打撃当てた時のyaccel値)
ignorehitpause = 1
;===========================================================================
[state -3, AI用摩擦係数]
type = varset
trigger1 = PlayerID(var(57)),movetype=H
trigger1 = PlayerID(var(57)),statetype=S
FV = 25
value = PlayerID(var(57)),const(movement.stand.friction)
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -3, AI用摩擦係数]
type = varset
trigger1 = PlayerID(var(57)),movetype=H
trigger1 = PlayerID(var(57)),statetype=C
FV = 25
value = PlayerID(var(57)),const(movement.crouch.friction)
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -3, AI用摩擦係数リセット]
type = varset
trigger1 = PlayerID(var(57)),movetype!=H
trigger2 = PlayerID(var(57)),statetype=A
FV = 25
value = 1
ignorehitpause = 1
;===========================================================================
[State -3, 距離計算用相手速度計測]
type = varset
TriggerAll = var(59)>4 && RoundState=2 && Alive && PlayerIDExist(var(57))
Trigger1 = PlayerID(Var(57)),Alive
FV = 26
value = PlayerID(Var(57)),Vel X
ignorehitpause = 1
;===========================================================================

;==============================================================================
;　AI用ヘルパー
;==============================================================================
[State -3, AI_Activate]
Type = Helper
TriggerAll = IsHelper = 0
TriggerAll = NumHelper(9876 + ID) = 0
TriggerAll = RoundState <= 2
TriggerAll = Alive
Trigger1 = Var(59) = 0
HelperType = Normal
Name = "AI"
StateNo = 9999
ID = 9876 + ID
Pos = 9999,9999
KeyCtrl = 1
PauseMoveTime = 2147483647
SuperMoveTime = 2147483647

[State -3, Safety]
Type = ChangeState
TriggerAll = IsHelper
TriggerAll = IsHelper(9876 + Root,ID)
Trigger1 = StateNo != 9999
Value = 9999
Ctrl = 0

[State -3, Option_Helper]
Type = Helper
TriggerAll = IsHelper = 0
TriggerAll = NumHelper(9999 + ID) = 0
Trigger1 = StateNo = 5900
Name = "config"
ID = 9999 + ID
Pos = 9999, 9999
StateNo = 9999
OwnPal = 1
SuperMoveTime = 2147483647
PauseMoveTime = 2147483647

;===========================================================================
[State -3, AI用飛び道具探知ヘルパー]
Type = Helper
TriggerAll = IsHelper = 0
TriggerAll = NumHelper(300020) = 0
Trigger1 = Alive
Name = "Proj_Search"
StateNo = 300020
ID = 300020
Pos = 9999,9999
SuperMoveTime = 2147483647
PauseMoveTime = 2147483647

[State -3, 飛び道具探知変数代入]
Type = VarSet
;TriggerAll = Var(59) >= 0
Trigger1 = NumHelper(300020)
V = 45
Value = Helper(300020),Var(58)
IgNoreHitPause = 1

;===========================================================================
[State -3, めくり監視用]
Type = Helper
;triggerall = var(59) >=0
Trigger1 = !NumHelper(2666660)
Trigger1 = !IsHelper
Trigger1 = RoundState<=2&&alive
HelperType = Normal
Name = "Chain Guard"
ID = 2666660
StateNo = 2666660
pos=0,524288
KeyCtrl = 0
Ownpal = 0
pausemovetime=0
supermovetime=0
persistent = 0
IgnoreHitPause = 1
;---------------------------------------------------------------------------
[State -3, 念のため]
type=changestate
triggerAll= Ishelper
trigger1= ishelper(2666660+Root,id)
trigger1= stateno!=2666660
value=2666660

;===========================================================================
[State -3, ステージ端感知（右）]
type=Helper
;triggerall = var(59) >=0
triggerall=!ishelper
triggerall=!numhelper(111111)
trigger1=Alive
helpertype=normal
name="right_edge"
ID=111111
pos=0, 0
postype=right
facing=1
stateno=111111
ownpal=1
supermovetime=99999
pausemovetime=99999
ignorehitpause=1
;---------------------------------------------------------------------------
[State -3, 念のため]
type=changestate
triggerAll= Ishelper
trigger1= ishelper(111111+Root,id)
trigger1= stateno!=111111
value=111111

;---------------------------------------------------------------------------
[State -3, ステージ端感知（左）]
type=Helper
;triggerall = var(59) >=0
triggerall=!ishelper
triggerall=!numhelper(111112)
trigger1=Alive
helpertype=normal
name="left_edge"
ID=111112
pos=0, 0
postype=left
facing=-1
stateno=111112
ownpal=1
supermovetime=99999
pausemovetime=99999
ignorehitpause=1
;---------------------------------------------------------------------------
[State -3, 念のため]
type=changestate
triggerAll= Ishelper
trigger1= ishelper(111112+Root,id)
trigger1= stateno!=111112
value=111112

;===========================================================================
[State -3, AIフラグ]
type = VarSet
TriggerAll =!ishelper
triggerall = var(59) = 0
triggerall = RoundState = [1,2]
trigger1 = Command = "AI_00"||Command = "AI_01"||Command = "AI_02"||Command = "AI_03"
trigger2 = Command = "AI_04"||Command = "AI_05"||Command = "AI_06"||Command = "AI_07"
trigger3 = Command = "AI_08"||Command = "AI_09"||Command ="AI_10"||Command = "AI_11"
trigger4 = Command ="AI_12"||Command ="AI_13"||Command ="AI_14"||Command = "AI_15"
trigger5 = Command ="AI_16"||Command ="AI_17"||Command ="AI_18"||Command = "AI_19"
trigger6 = Command ="AI_20"||Command ="AI_21"||Command ="AI_22"||Command = "AI_23"
trigger7 = Command ="AI_24"||Command ="AI_25"||Command ="AI_26"||Command = "AI_27"
trigger8 = Command ="AI_28"||Command ="AI_29"||Command ="AI_30"||Command = "AI_31"
trigger9 = Command ="AI_32"||Command ="AI_33"||Command ="AI_34"||Command = "AI_35"
trigger10= Command ="AI_36"||Command ="AI_37"||Command ="AI_38"||Command = "AI_39"
trigger11= Command ="AI_40"||Command ="AI_41"||Command ="AI_42"||Command = "AI_43"
trigger12= Command ="AI_44"||Command ="AI_45"||Command ="AI_46"||Command = "AI_47"
trigger13= Command ="AI_48"||Command ="AI_49"||Command ="AI_50"
trigger14= Numhelper(9999)
trigger14= Helper(9999),var(59)>0
;trigger15= !Ishelper && RoundState=2 && Ctrl
var(59) = 1
Ignorehitpause = 1

[State -3, AI起動用ヘルパー]
type=helper
trigger1 = !NumHelper(9999)
trigger1 = roundstate=2
trigger1 = alive
trigger1 = var(59)=0
Trigger1 = (PrevStateNo=[190,194])||PrevStateNo=5900
Trigger1 = ctrl&&stateno=0
helpertype=normal
name="AI"
stateno=9999
ID=9999
pos=9999,9999
keyctrl=1
pausemovetime=2147483647
supermovetime=2147483647
persistent = 0
;---------------------------------------------------------------------------
[State -3, 関係無いステートに行かないように]
type=changestate
trigger1= ishelper(9999)
trigger1= stateno!=9999
value=9999

;------------------------------------------------------------------------------
;　ジャンプ用トリガ
;------------------------------------------------------------------------------
[State 45, 4]
type = VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper && PlayerIDExist(var(57))
Trigger1 = PlayerID(var(57)),movetype = H
;Trigger1 = P2BodyDist X != [-20,20]
triggerall = stateno = 45
sysvar(1) = 1
[State 45, 4]
type = VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper
Trigger1 = Roundstate!=2
Trigger1 = P2BodyDist X = [-20,20]
triggerall = stateno = 45
sysvar(1) = 0
[State 45, 4]
type = null;VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper
Trigger1 = Roundstate!=2
Trigger1 = P2BodyDist X != [-25,25]
triggerall = stateno = 40
sysvar(1) = 1
[State 45, 4]
type = null;VarSet
TriggerAll = var(59)>0 && Alive && !Ishelper
Trigger1 = Roundstate!=2
Trigger1 = P2BodyDist X = [-25,25]
triggerall = stateno = 40
sysvar(1) = 0

;------------------------------------------------------------------------------
;　ガード関連
;------------------------------------------------------------------------------
;---------------------------------------------------------------------------
[State -1, ステートタイプ変更]
type = StateTypeSet
TriggerAll = var(59)>=1 && RoundState=2 && Alive && !IsHelper && PlayerIDExist(Var(57))
TriggerAll = StateNo = 120 && StateType = C
Trigger1 = PlayerID(Var(57)),StateType = A
Trigger1 = Helper(111112),Var(54)=0 || Helper(111112),Var(54) != PlayerID(Var(57)),StateNo
Trigger1 = Helper(111112),Var(55)=0 || Helper(111112),Var(55) != PlayerID(Var(57)),StateNo
Trigger1 = Helper(111112),Var(56)=0 || Helper(111112),Var(56) != PlayerID(Var(57)),StateNo
statetype = S
physics = S
;---------------------------------------------------------------------------
[State -1, ステートタイプ変更]
type = StateTypeSet
TriggerAll = var(59)>2 && RoundState=2 && Alive && !IsHelper && PlayerIDExist(Var(57))
TriggerAll = StateNo = 120 && StateType = S
trigger1 = PlayerID(Var(57)),StateType != A
Trigger1 = Helper(111112),Var(57)=0 || Helper(111112),Var(57) != PlayerID(Var(57)),StateNo
Trigger1 = Helper(111112),Var(58)=0 || Helper(111112),Var(58) != PlayerID(Var(57)),StateNo
Trigger1 = Helper(111112),Var(59)=0 || Helper(111112),Var(59) != PlayerID(Var(57)),StateNo
statetype = C
physics = C


