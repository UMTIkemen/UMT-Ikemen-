;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;　ヘルパーステート
;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

; 8000 : ゲージ関連
; 8200 : ゲージ技勝利演出
; 8210 : 残り時間演出（未使用）
; 8213 : メタ世界発動演出
; 8215 : ゲージ技発動演出？
; 8300 : 弱斬撃スパーク演出
; 8301 : 中斬撃スパーク演出
; 8302 : 強斬撃スパーク演出
; 8375 : アビリティ魔法陣演出
; 8500 : カットイン演出

;==============================================================================
;　ゲージ関連
;==============================================================================
[StateDef 8000]
Type        = A
Physics     = N
Anim        = 9999
SprPriority = 8
VelSet      = 0,0

[State -1]
Type     = NotHitBy
Trigger1 = 1
Value    = SAC, NT, ST, HT ,NA, SA, HA ,NP, SP, HP
Time     = 1

[State -1]
Type     = PosSet
Trigger1 = 1
X        = Root,Pos X
Y        = Root,Pos Y

