Trigger1 = NumExplod(8000) = 0
Anim = 8000
ID = 8000
Postype = Left
Pos =  floor(1000*(Root,FVar(17)-floor(Root,FVar(17)))),0+floor(Root,FVar(17))
scale = .5,.5
Sprpriority = 10000
BindTime = -1
SuperMoveTime = 9999999
PauseMoveTime = 9999999
