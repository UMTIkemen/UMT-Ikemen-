triggerall = !Ishelper
Value = 1*fvar(20)*fvar(21)*fvar(23)*(1-0.03125*ifelse(fvar(22)<30,fvar(22),30))*ifelse(random%32=0,1.15,1)
IgnoreHitPause = 1
[State -1, AttackMulSet]
