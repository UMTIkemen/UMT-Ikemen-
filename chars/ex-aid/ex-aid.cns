[Statedef 3233];XX
type    = A
movetype= A
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
anim = 3233+const(Size.Height)
velset = 0,0
sprpriority = 0
;--------------------------------------------
;	記述改変用メモ	67-42=25
;このステートの全体Fは20～25F	どうせならこの部分も回してやれと思いまして（
;X座標:半径は!time時30…？	最後は35/2(17,-18)
;--------------------------------------------
[State 499, 1];Helper用変数設定	※Helperの変数は本体と別
;・初期変数設定(!time)
; var(3)=const(Size.Height)を直入れ
;fvar(6)=X半径にrootのサイズ設定を反映
;fvar(4)=Y半径にrootのサイズ設定を反映
;fvar(7)=中心ズレ
;fvar(1)=角度計算用
;・常時代入
;fvar(2)=可変する半径用の倍率
;fvar(3)=計算用に次のtimeの倍率を算出する
type	= Null;VarSet
trigger1=!time
trigger1= var(3):= const(Size.Height)
trigger1=fvar(6):= ifelse(var(3)=1,30-17/2.0,-30+18/2.0)*root,Const(Size.XScale)
trigger1=fvar(4):= 30*root,Const(Size.XScale)
trigger1=fvar(7):= (fvar(6)+ifelse(var(3)=1,17,-18))*facing*root,Const(Size.XScale)
trigger1=fvar(6):= abs(fvar(6))
trigger1=fvar(1):= 360-0.5*360*var(3)+180*(facing=-1) &&0
trigger2=fvar(2):= 1;ifelse(time<11,1,ifelse(time<21,1+(time-10)*.1,ifelse(time<31,2,2-(time-30)*.1)))
trigger2=fvar(3):= 1;ifelse(time<10,1,ifelse(time<20,1+(time- 9)*.1,ifelse(time<30,2,2-(time-29)*.1)))
trigger2=fvar(9):=1

[State 499, HitOverRide];喰らい判定はありませんが(特に当身等での)ステート盗難防止用
