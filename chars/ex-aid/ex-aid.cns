[Statedef 3051,CutIn];	クリティカルストライク/クリティカルフィニッシュ/クリティカルブレイク
;━━━━━━━━━━━━━━━━	※mugen1.1のステージ側のズーム機能に対応するために少し改修,airの設定は今までと変わりません
type	= A	;諸都合上縮尺違いに関しては対応放り投げてます…zoomしてるか縮尺が違うかのwinmugenで動く記述のみでの判断方法が現状わからずじまいなので
movetype= I
physics	= N
anim	= ifelse(const(size.height)=0,3050,ifelse(const(size.height)=1,3212,ifelse(const(size.height)=2,3304,ifelse(const(size.height)=4,3340,3104))))
velset	= 0, 0
ctrl	= 0
sprpriority =ifelse(ishelper(13051),0,-5);ifelse(ishelper(13051),102,-5)

[state 0,0]	;初期座標設定,判別用数字が奇数が左上,偶数が右上
type	= PosAdd
trigger1=!time
x   	= 120*ifelse(const(size.height)%2=1,-1,1);+320*(const(size.height)%2=0)
y   	= -80-ScreenPos Y

[state 0,0]	;通常座標設定,主に縦へのスクロール対策
type	= PosAdd
trigger1= time>0
trigger1=fvar(2):=fvar(2)+vel x
trigger1=fvar(3):=fvar(3)+vel y
x   	=fvar(2)-screenpos x
y   	=fvar(3)-ScreenPos Y

[state 0,0]	;初速度,画面の中心に向かって動く
type	= VelSet
trigger1=!time
trigger1=fvar(2):=screenpos x
trigger1=fvar(3):=screenpos y
x   	= (120+160)/8.0*ifelse(const(size.height)%2=1,1,-1)*ifelse(const(size.height)=0||const(size.height)=2,1.085,1)
y   	= (80+120)/8.0*ifelse(const(size.height)=0||const(size.height)=2,1.085,1)

[state 0,0]	;適当にある程度大きい数字(時間等の関係上ざっと3桁以上の数字で)で割って速度を遅くする
type	= VelSet
trigger1= AnimElem = 8
x   	= Vel X/120
y   	= Vel Y/120

[state 0,0]	;終わり際の拡大消失用scale弄り,Zoom対応に伴い封印
type	= null;AngleDraw
trigger1= 1
scale	= (AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2),(AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2)

[state 0,0]	;AngleDraw使うとAir側の透かし設定がアレになる…ので入れたのですがZoom対応に伴い封印
type	= null;Trans
trigger1= 1
trans	= AddAlpha
Alpha	= ifelse(AnimElemNo(0)=8,256,256/8*ifelse(time<7,time+1,1-Animtime)),ifelse(AnimElemNo(0)=8,0,256/8*ifelse(time<7,7-time,7+Animtime))

[state 0,0]
type	= AssertSpecial
trigger1= 1
flag	= noshadow
flag2	= invisible


[State 0, Zoom対応用Explod]
type = Explod
trigger1 = const(size.height)%2=1
trigger1 = !time
anim = anim
ID = anim
postype = left;backにできればExplod記述が半分になるんですがvel x周りが面倒で私にしては珍しくこれでいいやってなりました（
pos = floor(screenpos x),floor(screenpos y)
vel = vel x,vel y
removetime = -2
pausemovetime = -1
supermovetime = -1
bindtime=1
scale=(AnimElemNo(0)>8)*(Animelemtime(9)+1)+1.5,(AnimElemNo(0)>8)*(Animelemtime(9)+1)+1.5
sprpriority = ifelse(ishelper(13051),0,-5);ifelse(ishelper(13051),102,-5)
ignorehitpause = 1

[State 0, Zoom対応用Explod]
type = Explod
trigger1 = const(size.height)%2=0
trigger1 = !time
anim = anim
ID = anim
postype = right
pos = floor(screenpos x),floor(screenpos y)
vel = vel x,vel y
removetime = -2
pausemovetime = -1
supermovetime = -1
bindtime=1
scale=(AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2),(AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2);*1.15
sprpriority = ifelse(ishelper(13051),0,-5);ifelse(ishelper(13051),102,-5)
ignorehitpause = 1

[state 0, Zoom対応用ModifyExplod]
type	= ModifyExplod
trigger1 = const(size.height)%2=1
ID = anim
postype = left
pos = floor(screenpos x),floor(screenpos y)
vel = vel x,vel y
scale=(AnimElemNo(0)>8)*(Animelemtime(9)+1)+1.5,(AnimElemNo(0)>8)*(Animelemtime(9)+1)+1.5
pausemovetime = -1
supermovetime = -1
ignorehitpause = 1

[state 0, Zoom対応用ModifyExplod]
type	= ModifyExplod
trigger1 = const(size.height)%2=0
ID = anim
postype = right
facing= 1
pos = floor(screenpos x),floor(screenpos y)
vel = vel x,vel y
scale=(AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2)*1.1,(AnimElemNo(0)>8)*(Animelemtime(9)+1)+(const(size.height)!=2)*1.5+(const(size.height)=2)*1.1;5
pausemovetime = -1
supermovetime = -1
ignorehitpause = 1

[State 12000, DestroySelf]
type	= DestroySelf
Trigger1= IsHelper
trigger1= Animtime = 0


