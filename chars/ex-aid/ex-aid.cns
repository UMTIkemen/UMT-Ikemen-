[Statedef 3210];	マイティダブルクリティカルストライク＿専用カットイン1
;━━━━━━━━━━━━━━━━一部面倒で元の記述のまま放置してるけど許して
type	= A
movetype= I
physics	= N
anim	= 3210
velset	= 0, 0
ctrl	= 0
sprpriority = -5

[state 0,0]	;初期座標設定,判別用数字が奇数が左上,偶数が右上
type	= PosAdd
trigger1=!time
x   	= 120*ifelse(const(size.height)%2=1,-1,1)+(ScreenPos X - Pos X)*2*(const(size.height)%2=0)
y   	= -80-ScreenPos Y

[state 0,0]	;通常座標設定,主に縦へのスクロール対策
type	= PosAdd
trigger1= time>0
trigger1=fvar(2):=fvar(2)+vel x
trigger1=fvar(3):=fvar(3)+vel y
x   	=fvar(2)-screenpos x
y   	=fvar(3)-ScreenPos Y

[state 0,0]	;初速度,画面の中心に向かって動く
type	= VelSet
trigger1=!time
trigger1=fvar(2):=screenpos x
trigger1=fvar(3):=screenpos y
x   	= (120+ScreenPos X-Pos X)/8.0*ifelse(const(size.height)%2=1,1,-1)
y   	= (80+120)/8.0	;縦サイズが240前提です,それ以外のサイズは…変数でも使う？

[state 0,0]	;適当にある程度大きい数字(時間等の関係上ざっと3桁以上の数字で)で割って速度を遅くする
type	= VelSet
trigger1= AnimElem = 8
x   	= Vel X/120
y   	= Vel Y/120

[state 0,0]	;scale＆回転
type	= AngleDraw
trigger1= 1
value	= ifelse(AnimElemNo(0)<9,0,-65*(AnimElemTime(9)+1)/7)
scale	= 1.5,1.5

[state 0,0]	;AngleDraw使うとAir側の透かし設定がアレになるので
type	= Trans
trigger1= 1
trans	= AddAlpha
Alpha	= ifelse(AnimElemNo(0)=8,256,256/8*ifelse(time<7,time+1,1-AnimElemTime(16))),ifelse(AnimElemNo(0)=8,0,256/8*ifelse(time<7,7-time,7+AnimElemTime(16)))

[state 0,0]
type	= AssertSpecial
trigger1= 1
flag	= noshadow


[State 12000, DestroySelf]
type	= DestroySelf
Trigger1= IsHelper
trigger1= Animtime = 0


