[Statedef 3232];Gene
type    = A
movetype= A
physics = N
juggle  = 0
poweradd= 0
ctrl = 0
velset = 0,0
anim = 3231+const(Size.Height)
sprpriority = 0
;--------------------------------------------
;	記述改変用メモ
;このステートの全体Fは42F
;半径は記述改変開始前の計算前の値は28(R-26,L30)…中心がズレてるのはもう懲りたのでRを-30にします
;X座標:半径は!time時30に な る よ う に す る (必ずしも最大値とは言っていない,理由は攻撃判定)
;Y座標はX座標と同様の半径で出した値を1/5(立体的に見せるため)した上でその値をRoot,Pos Yに足す
;Root,Vel Yは変動するがただ単にその値を速度計算時に足せば良いだけなので難しく考える必要はない
;
;前提条件として!timeとtime=42の時同じX座標になるようにする(＝42Fで自然数n回分回る)
;残像を出し,その軌跡がGeneに見えるようにする
;この回転が終わった後にRootの上昇Fがまだ20F残っていることも留意の事
;--------------------------------------------
[State 499, 1];Helper用変数設定	※Helperの変数は本体と別
;・初期変数設定(!time)
; var(3)=const(Size.Height)を直入れ
;fvar(4)=半径にrootのサイズ設定を反映
;fvar(1)=角度計算用
;・常時代入
;fvar(2)=可変する半径用の倍率
;fvar(3)=計算用に次のtimeの倍率を算出する
type	= Null;VarSet
trigger1=!time
trigger1= var(3):= const(Size.Height)
trigger1=fvar(4):= 30*root,Const(Size.XScale)
trigger1=fvar(1):= 360-0.5*360*var(3)+180*(facing=-1) &&0
trigger2=fvar(2):= ifelse(time<11,1,ifelse(time<21,1+(time-10)*.1,ifelse(time<31,2,2-(time-30)*.1)))
trigger2=fvar(3):= ifelse(time<10,1,ifelse(time<20,1+(time- 9)*.1,ifelse(time<30,2,2-(time-29)*.1)))

[State 499, HitOverRide];喰らい判定はありませんが(特に当身等での)ステート盗難防止用
type	= HitOverRide
trigger1=!time
attr	= SCA
stateno	= 3232
time	= -1
ignorehitpause = 1

[State 499, NotHitBy]		;分身防止用ムテキング
type	= NotHitBy
trigger1= 1
value	= SCA

[State 499, PlayerPush];押さない 走らない 喋らない(避難訓練並感)
type	= PlayerPush
trigger1= 1
value	= 0

[State 499, 2];表示優先度増減
type	= Sprpriority	;Sinグラフを利用
trigger1= 1
value	= floor(Sin(fvar(1)/(180/Pi))/15)

[State 499, 2];縮尺(Scale)増減
type	= AngleDraw 	;Sinグラフを利用
trigger1= 1
scale	= 1+Sin(fvar(1)/(180/Pi))*fvar(2)/10,1+Sin(fvar(1)/(180/Pi))*fvar(2)/10

;--------------[Pos,Vel]
[State 499, 2];位置設定
type	= PosSet;色々と面倒なのでこいつで根本から制御
trigger1= 1
x   	= (-Cos(fvar(1)/(180/Pi))*fvar(4)*fvar(2) + root,pos x)*facing
;X  	= (-Cosグラフ*半径+基準位置)*向き
y   	= ( Sin(fvar(1)/(180/Pi))*fvar(4)*fvar(2)/5+root,pos y)
;Y  	= (+Sinグラフ*半径/5+基準位置)

[State 499, 4];角度増加
type	= VarAdd
trigger1= 1
fvar(1)	= 360*2/42.0*facing

[State 499, 5];角度制御
type	= VarSet
trigger1= fvar(1) != (-360,360)
fvar(1)	= 0

