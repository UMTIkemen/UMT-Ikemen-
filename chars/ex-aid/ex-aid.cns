;カチドキアームズ失敗時のボイスストップ
[State -2, stopサウンド]
type	= stopSnd
trigger1 = prevstateno = 3500
trigger1 = StateNo != [3500,3504]
channel = 10


[State -2, アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && MoveType != H
trigger1 = StateNo = 3302
trigger2 = StateNo = 1600 && (time < 53)
trigger3 = 0;StateNo = 3231
trigger4 = StateNo = 3330 && AnimElemTime(17) = 43
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -2, アーマー中の投げ以外無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
value2 = ,AA,AP
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時の点滅]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 5
add = 256,10,10

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = ceil(-0.8*Helper(9000),GetHitVar(damage))
kill = 0
absolute = 1
ignorehitpause = 1

