[Statedef 3331,gks];ガシャコンキースラッシャー！
type    = S;何回かこの記述作ってきましたが今回も鎧武より遥かに分かり易いです
movetype= A;特に今回は回す物が1つしかないので…(複数個(しかも可変)回す記述をいきなり作る方がおかしい)
physics = S;一周しないのでもっと簡略化できそうですがひょっとしたら回す角度長くなるかもなんでその辺考えて残します
juggle  = 0
poweradd= 0
ctrl = 0
velset = 0,0
anim = 3331
sprpriority = 0
;--------------------------------------------
;	記述改変用メモ
;X座標:半径最大80,速度後述
;Y座標はXと一緒だけど実機表示は1/5(立体的に見せるため)
;・作りたい演出
;真後ろから手前まで15Fくらいで回ってくる(速度を調整しなくて良いのすっごい楽
;半径は40→60→70→80(多分ここが一番面倒
;Hitdefは絶版だぁ…（ねっとり
;--------------------------------------------
[State 499, 1];Helper用変数設定	※Helperの変数は本体と別
;・初期変数設定(!time)
; var(3)=const(Size.Height)を直入れ
;fvar(4)=半径にrootのサイズ設定を反映
;fvar(1)=角度計算用
;・常時代入
;fvar(2)=可変する半径用の倍率
;fvar(3)=計算用に次のtimeの倍率を算出する
type	= Null;VarSet
trigger1=!time
trigger1= var(3):= const(Size.Height)
trigger1=fvar(4):= 40*root,Const(Size.XScale)
trigger1=fvar(1):= 0.75*360 &&0
trigger2=fvar(2):= ifelse(time<2,1,ifelse(time<4,1.5,ifelse(time<6,1.75,2)))
trigger2=fvar(3):= ifelse(time<1,1,ifelse(time<3,1.5,ifelse(time<5,1.75,2)))

[State 499, HitOverRide];喰らい判定はありませんが(特に当身等での)ステート盗難防止用
type	= HitOverRide
trigger1=!time
attr	= SCA
stateno	= 3331
time	= -1
ignorehitpause = 1

[State 499, NotHitBy]		;分身防止用ムテキング
type	= NotHitBy
trigger1= 1
value	= SCA

[State 499, PlayerPush];押さない 走らない 喋らない(避難訓練並感)
type	= PlayerPush
trigger1= 1
value	= 0

[State 499, 2];表示優先度増減
type	= Sprpriority	;Sinグラフを利用
trigger1= 1
value	= floor(Sin(fvar(1)/(180/Pi))*15)

[State 499, 2];縮尺(Scale)増減
type	= AngleDraw 	;Sinグラフを利用
trigger1= 1
scale	= 1+Sin(fvar(1)/(180/Pi))*fvar(2)/10,1+Sin(fvar(1)/(180/Pi))*fvar(2)/10

;--------------[Pos,Vel]
[State 499, 2];位置設定
type	= PosSet;色々と面倒なのでこいつで根本から制御
trigger1= 1
x   	= (-Cos(fvar(1)/(180/Pi))*fvar(4)*fvar(2)+root,pos x)*facing
;X  	= (-Cosグラフ*半径+基準位置)*向き
y   	= ( Sin(fvar(1)/(180/Pi))*fvar(4)*fvar(2)/5-80)
;Y  	= (+Sinグラフ*半径/5+基準位置)

[State 499, 4];角度増加
type	= VarAdd
trigger1= 1
fvar(1)	= 180/15.0*facing

[State 499, 5];角度制御
type	= VarSet
trigger1= fvar(1) != (-360,360)
fvar(1)	= 0

[State 499, 5];角度制御2
type	= VarSet
trigger1= fvar(1) != (-180,180)
trigger1= fvar(1) - 180/15.0 = (-180,180)
fvar(1)	= 180

[State 499, 5];角度制御2
type	= VarSet
trigger1= fvar(1) != (-90,90)
trigger1= fvar(1) - 180/15.0 = (-90,90)
fvar(1)	= 90

[State 499, 5];角度制御2
type	= VarSet
trigger1= fvar(1) != (-270,270)
trigger1= fvar(1) - 180/15.0 = (-270,270)
fvar(1)	= 270

[State 499, 7];移動速度,次のtimeのpos値を直接算出して移動
type	= VelSet
trigger1= 1
x   	= (-Cos(fvar(1)/(180/Pi))*fvar(4)*fvar(3)+root,pos x-pos x)*facing
y   	= ( Sin(fvar(1)/(180/Pi))*fvar(4)*fvar(3) / 5 - 80 - pos y)


[State 499, DestroySelf]
type	= DestroySelf
trigger1= AnimTime = 0
trigger2= time >= 15;バグ対策


