;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;	仮面ライダーエグゼイド　キャラクターデータセッティング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━|　 　　基本情報 　　　|━━━━━━━━━━━━━━━━━━━━━━━━
[Info]
name		= "仮面ライダーエグゼイド"	;キャラの名前
displayname	= "Kamen Rider Ex-Aid"		;表示されるキャラの名前
versiondate	= 03,10,2014			;キャラの更新情報
mugenversion	= 1.0			        ;キャラが動くmugenのバージョン
author		= "電脳救命センター(CR)"	;キャラの製作者名
pal.defaults	= 1,3,4,2			;敵としてでるキャラのパレット



;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━| 必要なファイルの設定 |━━━━━━━━━━━━━━━━━━━━━━━━

[Files]
cmd	= ex-aid.cmd
cns	= ex-aid.cns
st	= ex-aid.cns
st1	= Config.txt
stcommon= common1.cns
movelist = movelist_ex-aid.dat
sprite  = ex-aid.sff
anim    = ex-aid.air
sound   = ex-aid.snd
pal1    = ex-aid.act
pal2    = act/brave.act
pal3    = act/snipe.act
pal4    = act/lazer-turbo.act
pal5    = act/genmlv2.act
pal6    = act/para-dx.act
pal7    = act/genmlvx-0.act
pal8    = act/xxr.act
pal9    = act/xxl.act
pal10   = act/poppy.act;glafight.act
pal11   = act/cronus.act;protoorigin.act
pal12   = ex-aid.act;act/ex-aid_f.act