movetype= I
physics	= N
anim	= 3060+Const(Size.Height)
velset	= -Const(Size.Height)*2, -Const(Size.Height)
ctrl	= 0
sprpriority = 5*Const(Size.Height)

[State 7050, Trans]
type	= Trans
trigger1= time<15
trans	= addalpha
alpha	= (256-Const(Size.Height)*128),256;(128+Const(Size.Height)*128)

[State 7050, Trans]
type	= Trans
trigger1= time>=15
trans	= addalpha
alpha	= floor((256-Const(Size.Height)*128)/(time-14)),256;(128+Const(Size.Height)*128)

[State 7050, AngleDraw]
type	= AngleDraw
trigger1= 1
value	= -30
scale	= ((time/10)*(Const(Size.Height)*4+1)),((time/10)*(Const(Size.Height)*4+1))

[State 12000, DestroySelf]
type	= DestroySelf
Triggerall= IsHelper
trigger1= AnimTime = 0

