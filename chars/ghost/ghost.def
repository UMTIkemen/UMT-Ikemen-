;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;	仮面ライダーゴースト　キャラクターデータセッティング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━|　 　　基本情報 　　　|━━━━━━━━━━━━━━━━━━━━━━━━
[Info]
name		= "仮面ライダーゴースト"	;キャラの名前
displayname	= "Kamen Rider Ghost"		;表示されるキャラの名前
versiondate	= 03,10,2014			;キャラの更新情報
mugenversion	= 1.0		         	;キャラが動くmugenのバージョン
author		= "大天空寺"			;キャラの製作者名
pal.defaults	= 1,2,3,4,5,6,7,8		;敵としてでるキャラのパレット



;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━| 必要なファイルの設定 |━━━━━━━━━━━━━━━━━━━━━━━━

[Files]
cmd	= ghost.cmd
cns	= ghost.cns
st      = ghost.cns
st1	= AI.cns
stcommon= common1.cns
sprite  = ghost.sff
anim    = ghost.air
sound   = ghost.snd
movelist = movelist_ghost.dat
pal1    = ghost.act
pal2    = specter.act
pal3    = necrom.act
pal4    = D_ghost.act
pal5    = Z_specter.act
pal6    = D_necrom_Pink.act
pal7    = D_necrom_Red.act
pal8    = D_necrom_Blue.act
pal9    = D_necrom_Yellow.act
pal10   = Extremer.act
pal11   = specter.act
pal12   = ghost.act


