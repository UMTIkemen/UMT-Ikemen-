[Statedef -3]

[State -3, AI Flag set];●開幕闘魂即起動スイッチ
Type = VarSet
Triggerall = !ishelper
Trigger1 = 1
v = 41
value = 0 ; (0 - OFF(default) / 1 - ON)
IgnoreHitPause = 1

[State -3, Flag set];●AIを常時起動にするには「;trigger11  = 1 ;常時起動用」の先頭の ; を消してください
Type = VarSet
var(59) = 1;AIフラグ
TriggerAll = !Var(59) ;フラグが立っていない時。
TriggerAll = RoundState = [1,2]
Trigger1   = Command = "AI1" || Command = "AI2" || Command = "AI3" || Command = "AI4" || Command = "AI5"
Trigger2   = Command = "AI6" || Command = "AI7" || Command = "AI8" || Command = "AI9" || Command = "AI10"
Trigger3   = Command = "AI11" || Command = "AI12" || Command = "AI13" || Command = "AI14" || Command = "AI15"
