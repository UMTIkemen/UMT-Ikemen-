#========================<PROJECTILE SHIELD>=============================
#----- Oni Musou -----

#============================================================
# State 3005
#============================================================

[StateDef 3005;
	type: A;
	physics: N;
	moveType: I;
	anim: 3005;
	ctrl: 0;
	velSet: 0, 0;
]

ignoreHitPause {
	# Override
	hitOverride{attr: SCA, AA, AP, AT; time: -1; stateno: 3005}
	# NHB
	notHitBy{time: -1; value: SCA}
}

# HB
ignoreHitPause if root, stateno = 3000 {
	hitBy{value: SCA, NP, SP; time: -1}
}

# HB
ignoreHitPause if root, stateno = 3050 {
	hitBy{value: SCA, NP, SP, HP; time: -1}
}

# Bind
bindToRoot{facing: 1}

# End
if root, moveType = H
|| (root, stateno != 3000 && root, stateno != 3050)
|| (root, stateno = 3000 && root, animElemTime(5) < 0)
|| (root, stateno = 3050 && root, animElemTime(5) < 0) {
	destroySelf{}
}

#========================<DUSTS>=============================
#----- Jump -----

#============================================================
# State 8100
#============================================================
[StateDef 8100;
	type: S;
	anim: 9999;
	velSet: 0, 0;
]

# Pos
if !time {
	posSet{y: 0}
}

# Bind
if time {
	bindtoparent{}
}

# Dust
if !time {
	explod{
		anim: 8100;
		sprPriority: 3;
		posType: p1;
		pos: 0, ceil(pos y);
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Dust
if !time || time = 2 || time = 6 {
	explod{
		anim: 8101;
		sprPriority: 3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if !numexplod
|| time >= 60 {
	destroySelf{}
}

#----- Dash -----

#============================================================
# State 8103
#============================================================
[StateDef 8103;
	type: A;
	anim: 9999;
	velSet: 0, 0;
	sprPriority: 5;
]

# Pos
if !time = 0 {
	posSet{y: 0}
}

# Dust
if time = 0 || time = 3 || time = 6 {
	explod{
		anim: 8103;
		id: ifelse((time = 6), 3, ifelse((time = 3), 2, 1));
		posType: p1;
		pos: 0, -4;
		random: 8, 8;
		vel: -3 -(random / 1000.0), -2 -(random / 2000.0);
		facing: ifelse(random < 500, -1, 1);
		vfacing: ifelse(random < 500, -1, 1);
		angle: 90 * (random % 4);
		removetime: 16;
		sprPriority: 3;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Scale
if numexplod(1) {
	modifyexplod{
		id: 1;
		scale: 0.1 + (0.025 * time), 0.1 + (0.025 * time);
		trans: addAlpha;
		alpha: 256 - (16 * time), 256;
	}
}

# Scale
if numexplod(2) {
	modifyexplod{
		id: 2;
		scale: 0.1 + (0.025 * (time -3)), 0.1 + (0.025 * (time -3));
		trans: addAlpha;
		alpha: 256 - (16 * (time -3)), 256;
	}
}

# Scale
if numexplod(3) {
	modifyexplod{
		id: 3;
		scale: 0.1 + (0.025 * (time -6)), 0.1 + (0.025 * (time -6));
		trans: addAlpha;
		alpha: 256 - (16 * (time -6)), 256;
	}
}

# End
if time >= 22 {
	removeexplod{}
}

# End
if !numexplod {
	destroySelf{}
}

#----- Impact -----

#============================================================
# State 8110
#============================================================
[StateDef 8110;
	type: A;
	anim: 9999;
	velSet: 0, 0;
]

if !time {
