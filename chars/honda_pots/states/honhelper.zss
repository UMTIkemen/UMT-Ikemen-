		scale: 0.25 + (0.03125 * time), 0.25 + (0.03125 * time);
		trans: addAlpha;
		alpha: 256 - (23 * time), 256;
	}
}

# Scale
if numexplod(2) {
	modifyexplod{
		id: 2;
		scale: 0.25 + (0.03125 * time), 0.25 + (0.03125 * time);
		trans: addAlpha;
		alpha: 256 - (32 * time), 256;
	}
}

# End
if time >= 12 {
	removeexplod{}
}

# End
if !numexplod {
	destroySelf{}
}

#====================<POWER CHARGE>====================

#----- MAIN FX -----
#============================================================
# State 8330
#============================================================
[StateDef 8330;
	type: A;
	physics: N;
	moveType: I;
	anim: 9999;
	ctrl: 0;
	velSet: 0, 0;
]

# Bind
if root, stateno = 730 {
	bindToRoot{pos: (4 * root, const(size.xscale)), 0}
}

# Sound
if !time {
	playSnd{value: 0, 730; channel: 0}
}

# Sound
playSnd{
	value: 0, 731;
	channel: 1;
	lowpriority: 1;
	volumescale: ifelse(time < 180, (time * 0.277), 50);
}

# Aura
if !numexplod(8330) {
	explod{
		id: 8330;
		anim: 8330;
		sprPriority: 3;
		posType: p1;
		bindtime: -1;
		removetime: -1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Dust
if !(time % 6) {
	explod{
		anim: 8105;
		sprPriority: -3;
		posType: p1;
		pos: 0, -pos y;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# FX
if numexplod(8330)
&& root, time <= 60 {
	modifyexplod{id: 8330; scale: 0.5, 0.125}
}

# FX
if numexplod(8330)
&& root, time = [61, 119] {
	modifyexplod{id: 8330; scale: 0.5, 0.1 + ((root, time - 60) * 0.00625)}
}

# FX
if numexplod(8330)
&& root, time >= 120 {
	modifyexplod{id: 8330; scale: 0.5, 0.5}
}

# End
if root, stateno != 730
|| root, moveType = H {
	stopsnd{channel: 0}
	stopsnd{channel: 1}
	removeexplod{}
	destroySelf{}
}

#----- Particles -----

#============================================================
# State 8331
#============================================================
[StateDef 8331;
	type: A;
	physics: N;
	moveType: I;
	anim: 9999;
	ctrl: 0;
	velSet: 0, 0;
]

# Bind
if !(time % 8) {
	bindToRoot{pos: ceil(-140 + (random / 3.125)), ceil(130 - (random / 3.125))}
}

# Particle
if (time % 8) = 1 {
	explod{
		anim: 8331;
		sprPriority: ifelse(random < 750, 5, -1);
		posType: p1;
		vel: ((rootdist x + 20) / 32.0), ((rootdist y -30) / 32.0);
		scale: ifelse(random < 500, 0.5, -0.5), ifelse(random < 500, 0.5, -0.5);
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if root, stateno != 730 {
	removeexplod{}
	destroySelf{}
}

