#========================<CUSTOM COMBO>=============================

#============================================================
# State 8400
#============================================================
[StateDef 8400;
	type: A;
	physics: N;
	moveType: I;
	anim: 8400;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 5;
]

# No Shadow
assertSpecial{flag: noshadow}

# BG PalFX
if time <= 25 {
	bgPalFx{time: 1; mul: 128, 128, 128}
}

# Rotate
if !time {
	angleset{value: 6 * (random % 60)}
}

# Rotate
angleadd{value: -6}

# Scale
if time < 8 {
	angleDraw{scale: 0.0556 * (time + 1), 0.0556 * (time + 1)}
}

# Scale
if time >= 8 {
	angleDraw{scale: 0.5, 0.5}
}

# Trans
if time < 16 {
	trans{trans: addAlpha; alpha: 256, 256}
}

# Trans
if time >= 16 {
	trans{trans: addAlpha; alpha: ceil(256 - 25.6 * (time -16)), 256}
}

# Lines
if !time {
	explod{
		anim: 8401;
		id: 1;
		sprPriority: 5;
		posType: p1;
		facing: ifelse(random < 500, -1, 1);
		vfacing: ifelse(random < 500, -1, 1);
		angle: 90 * (random % 4);
		removetime: 16;
		supermovetime: -1;
	}
}

# Scale
if numexplod(1) {
	modifyexplod{
		id: 1;
		scale: 2 -(0.125 * time), 2 -(0.125 * time);
		trans: addAlpha;
		alpha: ifelse(time < 3, 64 * (time + 1), 256), 256;
	}
}

# Circle
if time = 16 {
	explod{
		anim: 8402;
		id: 2;
		sprPriority: 5;
		posType: p1;
		removetime: 32;
		supermovetime: -1;
	}
}

# Scale
if numexplod(2) {
	modifyexplod{
		id: 2;
		scale: (0.1 * (time -16)), (0.1 * (time -16));
		trans: addAlpha;
		alpha: ceil(256 - 25.6 * (time -16)), 256;
	}
}

if time >= 26 {
	# Safety
	removeexplod{}
	# End
	destroySelf{}
}

