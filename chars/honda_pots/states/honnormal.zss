		guard.velocity: ifelse(map(customcombo), -4.30, -7.51);
		guard.cornerpush.veloff: 0;
		air.velocity: -2.78, -5.33; # air reset;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		forcenofall: !map(customcombo);
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 1;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8011);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 45) * (map(sparkx.max) := 94), map(sparky) := -64;
	}
}

# Hit
if animElem = 3
&& prevStateNo = 700 {
	hitdef{
		id: stateNo;
		attr: S, NA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 70, 0;
		dizzypoints: 100 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 10, 10;
		guard.pausetime: 10, 10;
		animtype: Medium;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 15; # + 3 * map(counterhit_buffer);
		ground.slidetime: 15;
		guard.hittime: 1 + 13;
		guard.ctrltime: 1 + 13;
		guard.slidetime: 13;
		air.hittime: 120;
		ground.velocity: -5.30, -5.30;
		ground.cornerpush.veloff: 0;
		guard.velocity: -7.51;
		guard.cornerpush.veloff: 0;
		air.velocity: -5.30, -5.30;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 1;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8011);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 45) * (map(sparkx.max) := 94), map(sparky) := -64;
	}
}

# Extra Recovery
if prevStateNo = 200
&& !map(customcombo)
&& animElemTime(4) >= 0
&& !(time % 2) {
	assertSpecial{flag: animfreeze}
}

# Idle
persistent(0) if animElemTime(4) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

