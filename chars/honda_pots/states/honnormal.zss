}

# Bind 3
if numTarget
&& (animElemTime(3) >= 0 && animElemTime(4) < 0) {
	targetbind{pos: 36 * const(size.xscale), -88 * const(size.yscale)}
}

if numTarget
&& animElem = 4 {
	# Bind 4
	targetbind{pos: 96 * const(size.xscale), -3 * const(size.yscale)}
	# Damage
	targetlifeadd{value: floor(-140 * map(damagescaling)); dizzy: 0}
	# Stun Damage
	targetdizzypointsadd{value: floor(-100 * map(damagescaling)) * !map(customcombo)}
	# Give Power
