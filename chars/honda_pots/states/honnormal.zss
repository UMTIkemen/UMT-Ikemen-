#==============================================================================================
#========================================<NORMAL MOVES>========================================
#==============================================================================================

#=======================<Standing Light Punch>========================

#============================================================
# State 200
#============================================================
[StateDef 200;
	type: S;
	physics: S;
	moveType: A;
	anim: 200;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 0;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Sound
if animElem = 1 && random < 200 {
	playSnd{value: 4, ifelse(random < 500, 0, 1); channel: 0}
}

if animElem = 2 {
	# Sound
	playSnd{value: 1, 0; stopongethit: 1; freqmul: 0.95 + (random / 10000.0)}
	# Hit
	hitdef{
		id: stateNo;
		attr: S, NA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 40, 0;
		dizzypoints: 50 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 50) * map(meterscaling), 25 * map(meterscaling);
		givepower: 40, 40;
		pausetime: 8, 8;
		guard.pausetime: 8, 8;
		animtype: Light;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 12; # + 2 * map(counterhit_buffer);
		ground.slidetime: 12;
		guard.hittime: 1 + 10;
		guard.ctrltime: 1 + 10;
		guard.slidetime: 10;
		air.hittime: 120;
		ground.velocity: ifelse(map(customcombo), -2.66, -4.49), 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: ifelse(map(customcombo), -2.66, -4.49);
		guard.cornerpush.veloff: 0;
		air.velocity: -2.78, -5.33; # air reset;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		forcenofall: !map(customcombo);
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 0;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8010);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 40) * (map(sparkx.max) := 86), map(sparky) := -58;
	}
}

# Target Combo
if (moveContact + moveReversed) = [1, 2] {
	if (!AIlevel
	&& map(cmd_y)
	&& command != "holddown")
	|| (AILevel
	&& moveHit
	&& p2stateType != A
	&& p2BodyDist x < 35
	&& random < 500) {
		changeState{value: 210}
	}
}

# Idle
persistent(0) if animElemTime(3) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

