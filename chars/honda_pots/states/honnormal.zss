	mapAdd{map: "throwtech_timer"; value: -1}
}

# Tech Hit
if numTarget
&& map(throwtech_timer)
&& (target, command != "holdup" && target, command != "holddown") {
	if ((target, command = "a") + (target, command = "b") + (target, command = "c") + (target, command = "x") + (target, command = "y") + (target, command = "z")) >= 2
	|| ((target, command = "holdfwd" || target, command = "holdback")
	&& (target, command = "b" || target, command = "c" || target, command = "y" || target, command = "z"))
	|| (target, AIlevel > 0
	&& random < (100 * (target, AIlevelF / 8.0))) {
		changeState{value: 890}
	}
}

# Turn
if !time {
	turn{}
}

# Throw
if !time
&& numTarget {
	targetState{value: 815}
}

