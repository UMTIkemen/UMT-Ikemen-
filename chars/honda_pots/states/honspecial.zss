[StateDef 1477;
	type: A;
	physics: N;
	moveType: H;
]

# Turn
if !time
&& frontedgedist < backedgedist {
	turn{}
}

# Pos
posadd{x: -backedgebodydist}
# Pos
posfreeze{value: 1}
# Push
screenBound{value: 0; movecamera: 0, 0}
# Push
playerPush{value: 1}
# Anim
changeAnim{value: 5000}

# FX
if !time {
	playSnd{value: F 7, 2}
	explod{
		anim: F 72;
		posType: p1;
		pos: -15, const(size.mid.pos.y);
		sprPriority: -5;
		ownpal: 1;
	}
}

# End
if time >= 4 {
	changeState{value: 1478}
}

#----- Target Falling -----

#============================================================
# State 1478
#============================================================
[StateDef 1478;
	type: A;
	physics: N;
	moveType: H;
]

# Turn
if !time {
	turn{}
}

# Accel
veladd{
	y: 0.4850; # yaccel
}

if !time {
	# Vel
	velSet{x: -1.0; y: -8.0}
	# Anim
	changeAnim{value: ifelse(selfanimexist(5051), 5051, 5030)}
}

# Anim
if anim = 5030
&& !animTime {
	changeAnim{value: 5050}
}

# Anim
if anim = 5051
&& vel y > -2 {
	changeAnim{value: 5061}
}

# Push
screenBound{value: 1; movecamera: 0, 0}
playerPush{value: 0}

# Fall Recovery
if (alive = 1 && dizzy = 0 && dizzypoints > 0)
&& getHitVar(fall.recover)
&& command = "recovery"
&& vel y > 0
&& pos y >= const(movement.air.gethit.groundrecover.ground.threshold) {
	selfState{value: 5200}
}

# End
if vel y > 0
&& pos y > -vel y {
	selfState{value: 5100}
}

#========================<PUNCH ZERO COUNTER>=============================

#============================================================
# State 2900
#============================================================
[StateDef 2900;
	type: S;
	physics: N;
	moveType: A;
	anim: 2900;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 0;
]

# NHB
ignoreHitPause if animElemTime(3) < 0 {
	notHitBy{value: SCA; time: 1}
}

# Sound
if animElem = 2 {
	playSnd{value: 4, 3; channel: 0}
}

if animElem = 3 {
	# Sound
	playSnd{value: 1, 2; stopongethit: 1}
	# Hit
	hitdef{
		id: stateNo;
		attr: S, SA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 50, 13;
		dizzypoints: 0;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 12, 12;
		guard.pausetime: 12, 12;
		animtype: Diagup;
		air.animtype: Diagup;
		fall.animtype: Diagup;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		ground.velocity: -5.54, -5.25;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -5.54, -5.25;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 95), map(sparky) := -64;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
		kill: 0;
	}
}

# Type
if animElem = 4 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

