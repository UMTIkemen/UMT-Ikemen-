#========================<HYAKURETSU HARITE>=============================

#============================================================
# State 1000
#============================================================
[StateDef 1000;
	type: S;
	physics: N;
	moveType: A;
	anim: 1000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 100 * map(meterscaling);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel
&& time <= 0
&& numEnemy {
	mapSet{
		map: "strength";
		value: ifelse((p2, getHitVar(hittime) <= 4), 0, ifelse((p2, getHitVar(hittime) <= 6), 1, 2));
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

if !time {
	# Anim
	changeAnim{value: ifelse(map(strength) = 2, 1002, ifelse(map(strength) = 1, 1001, 1000))}
	# Vel
	velSet{x: ifelse(map(strength) = 2, 5.00, ifelse(map(strength) = 1, 4.00, 3.00))}
	# Sound
	playSnd{value: 0, 102}
	# Dust
	helper{
		helpertype: normal;
		stateno: 8103;
		id: 8100;
		name: "Dash Dust";
		posType: p1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 1010}
}

#----- Looping -----

#============================================================
# State 1010
#============================================================
[StateDef 1010;
	type: S;
	physics: N;
	moveType: A;
	anim: 1010;
	ctrl: 0;
	sprPriority: 2;
]

# Strength
ignoreHitPause if !time {
	mapSet{map: "strength_alt"; value: map(strength)}
}

# Strength
ignoreHitPause if !AIlevel
&& time > 0
&& (map(cmd_x) || map(cmd_y) || map(cmd_z)) {
	mapSet{map: "strength_alt"; value: ifelse(map(cmd_z), 2, ifelse(map(cmd_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel
&& time > 0
&& animElem = 5 {
	mapSet{map: "strength_alt"; value: ifelse(random < 500, 2, ifelse(random < 500, 1, 0))}
}

# AI Mash Punch Timer
ignoreHitPause if AIlevel
&& map(cmd_check_mashp_timer) > 0 {
	mapAdd{map: "cmd_check_mashp_timer"; value: -1}
}

# AI Mash Punch Timer
ignoreHitPause if AIlevel
&& numEnemy
&& (p2stateType != A && (p2BodyDist x = [0, 75])) {
	mapSet{map: "cmd_check_mashp_timer"; value: 12}
}

# Anim
if !time {
	changeAnim{value: ifelse(map(strength) = 2, 1012, ifelse(map(strength) = 1, 1011, 1010))}
}

# Loop
if !animTime {
	changeAnim{value: anim; elem: 1}
}

# Change Speed
if map(cmd_check_mashp_timer) {
	if animElem = 2
	|| animElem = 4
	|| animElem = 6 {
		changeAnim{
			value: ifelse(map(strength_alt) = 2, 1012, ifelse(map(strength_alt) = 1, 1011, 1010));
			elem: animElemno(0);
		}
	}
}

# Accel
if vel x > 0 {
	veladd{x: -0.6667}
}

# Accel
if vel x < 0 {
	velSet{x: 0}
}

# Looping Sound
if (animElem = 1 || animElem = 4)
&& (map(strength) != 2 || time >= (48 - 12 * hitcount)) {
	playSnd{
		value: 4, 0;
		channel: 0;
		volumescale: ifelse(time <= 25, 100, ifelse(time >= 75, 75, 100 - (time - 25) * 0.5));
	}
}

# Sound
if !time
&& map(strength) = 2 {
	playSnd{value: 4, 4; channel: 0}
}

# Sound
if animElem = 1 || animElem = 4 {
	playSnd{
		value: 7, ifelse(map(strength_alt) = 2, 10, ifelse(map(strength_alt) = 1, 9, 8));
		stopongethit: 1;
	}
}

# Spark XY
if animElem = 1 {
	map(sparkx.min) := 60;
	map(sparkx.max) := 120;
	map(sparky) := -55;
} else if animElem = 3 {
	map(sparkx.min) := 60;
	map(sparkx.max) := 113;
	map(sparky) := -26;
} else if animElem = 5 {
	map(sparkx.min) := 60;
	map(sparkx.max) := 111;
	map(sparky) := -84;
}

# Hit High
if animElem = 1 || animElem = 3 || animElem = 5 {
	hitdef{
		id: stateNo;
		attr: S, SA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 25, 6;
		dizzypoints: 20 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 4, 4;
		guard.pausetime: 4, 4;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: High;
		air.type: Low;
		ground.hittime: 1 + ifelse(map(strength_alt) = 2, 18, ifelse(map(strength_alt) = 1, 15, 12)); # + 2 * map(counterhit_buffer);
		ground.slidetime: 12;
		guard.hittime: 1 + ifelse(map(strength_alt) = 2, 18, ifelse(map(strength_alt) = 1, 15, 12));
		guard.ctrltime: 1 + ifelse(map(strength_alt) = 2, 16, ifelse(map(strength_alt) = 1, 13, 10));
		guard.slidetime: 12;
		air.hittime: 120;
		ground.velocity: ifelse(map(strength_alt) = 2, -6.66, ifelse(map(strength_alt) = 1, -5.00, -3.33)), 0; # unique;
		ground.cornerpush.veloff: 0;
		guard.velocity: ifelse(map(strength_alt) = 2, -6.66, ifelse(map(strength_alt) = 1, -5.00, -3.33)); # unique;
		guard.cornerpush.veloff: 0;
		air.velocity: -4.00, -6.00;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10, -55;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Low
if animElem = 3 {
	modifyhitDef{ground.type: Low}
}

# End
if (!map(cmd_check_mashp_timer) || roundState != 2 || time >= 90)
&& (animElem = 2 || animElem = 4 || animElem = 6)
&& time >= ifelse(map(strength) = 2, 12, ifelse(map(strength) = 1, 18, 24)) {
	changeState{value: 1020}
}

#----- Recover -----

#============================================================
# State 1020
#============================================================
[StateDef 1020;
	type: S;
	physics: N;
	moveType: I;
	anim: ifelse(anim = 1012, 1022, ifelse(anim = 1011, 1021, 1020));
	ctrl: 0;
	sprPriority: 2;
	moveHitpersist: 1;
]

