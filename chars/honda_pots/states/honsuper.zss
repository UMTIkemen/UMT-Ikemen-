#========================<ONI MUSOU>=============================

#============================================================
# State 3000
#============================================================
[StateDef 3000;
	type: S;
	physics: N;
	moveType: A;
	anim: 3000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: -1000 + 0 * (map(superlevel) := 1);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]) && !map(customcombo), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# Lose Charge
persistent(0) ignoreHitPause if time <= 0 {
	map(cmd_charge4) := 0;
	map(ai_charge4) := 0;
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	mapSet{map: "supercancelflag"; value: (prevStateNo = [1000, 2999] && map(supercancel) && !map(customcombo))}
	mapSet{map: "hypercancelflag"; value: (prevStateNo = [3000, 4999] && map(hypercancel))}
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# NHB
if animElemTime(4) < 0 {
	notHitBy{time: 1; value: SCA}
}

# Sound
if time = 3 {
	playSnd{value: 5, 4; channel: 0}
}

# Superpause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8500;
		id: 8500;
		name: "Superpause FX";
		posType: p1;
		pos: ceil(0 * const(size.xscale)), ceil(-82 * const(size.yscale));
		supermovetime: 255;
		size.xscale: 1;
		size.yscale: 1;
		ownpal: 1;
	}
}

# Superpause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		p2defmul: 1;
		unhittable: 1;
		anim: ifelse(map(cfg_superfx), -1, 100);
		pos: ceil(0 * const(size.xscale)), ceil(-82 * const(size.yscale));
		sound: s0, 8500;
		darken: !map(cfg_superfx);
	}
}

if animElem = 5 {
	# Sound
	playSnd{value: 7, 12}
	# Dust
	helper{
		helpertype: normal;
		stateno: 8103;
		id: 8100;
		name: "Dash Dust";
		posType: p1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
	# Type
	stateTypeSet{stateType: A; physics: N}
}

# Pos
if animElem = 3 || animElem = 4 {
	posadd{x: 8 * const(size.xscale)}
}

if animElem = 5 {
	# Pos
	posadd{x: 16 * const(size.xscale)}
	# Vel
	velSet{x: 10.64 * const(size.xscale); y: 0}
}

# Sound
if animElem = 3 {
	playSnd{value: 5, 5; channel: 0}
}

# Shield
if animElem = 5 {
	helper{
		helpertype: normal;
		stateno: 3005;
		id: 3005;
		name: "Shield";
		posType: p1;
		ownpal: 1;
	}
}

# Shield
ignoreHitPause if numHelper(3005) {
	hitBy{value2: SCA, AA, AT, HP; time: 1}
}

# Hit
if animElem = 4 {
	hitdef{
		id: stateNo;
		attr: S, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := (2 + hitcount));
		damage: 60, 15;
		dizzypoints: 0;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 4;
		guard.pausetime: 4, 4;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 18;
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		ground.velocity: -10.52, 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -4.00, -5.00;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		air.fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 40), map(sparky) := -66;
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit
if animElem = 5 {
	hitdef{
		id: stateNo;
		attr: A, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := (2 + hitcount));
		damage: 80, 20;
		dizzypoints: 0;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 4;
		guard.pausetime: 4, 4;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 32;
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		ground.velocity: -10.52, 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -4.00, -5.00;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		air.fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 59), map(sparky) := -47;
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# End
if animElemTime(5) >= 17
|| (animElemTime(5) > 0
&& ((moveContact = [1, 4]) || (moveReversed = [1, 4])))
|| (animElemTime(5) >= 9
&& frontedgebodydist <= 0) {
	changeState{value: 3001}
}

# Wind
if animElemTime(5) = 0
|| animElemTime(5) = 3
|| animElemTime(5) = 6
|| animElemTime(5) = 9 {
	explod{
		anim: 1190;
		id: 1190;
		posType: p1;
		pos: ceil(70 * const(size.xscale)), ceil(-50 * const(size.yscale));
		sprPriority: 3;
		scale: 0.5, 0.5;
		vfacing: ifelse(random < 500, -1, 1);
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

