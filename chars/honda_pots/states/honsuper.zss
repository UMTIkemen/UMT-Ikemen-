		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 94), map(sparky) := -64;
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Idle
persistent(0) if animElemTime(4) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}
