#----- AIR -----

#============================================================
# State 5210
#============================================================
[StateDef 5210;
	type: A;
	physics: N;
	moveType: I;
	anim: 5210;
	ctrl: 0;
]

# Accel
veladd{y: const(movement.air.gethit.airrecover.yaccel)}

# Vel
if !time {
	velmul{
		x: const(velocity.air.gethit.airrecover.mul.x);
		y: const(velocity.air.gethit.airrecover.mul.y);
	}
	veladd{
		x: const(velocity.air.gethit.airrecover.add.x);
		y: const(velocity.air.gethit.airrecover.add.y);
	}
}

# Up
if !time
&& command = "holdup" {
	veladd{y: const(velocity.air.gethit.airrecover.up)}
}

# Down
if !time
&& command = "holddown" {
	veladd{y: const(velocity.air.gethit.airrecover.down)}
}

# Forward
if !time
&& command = "holdfwd" {
	veladd{x: const(velocity.air.gethit.airrecover.fwd)}
}

# Back
if !time
&& command = "holdback" {
	veladd{x: const(velocity.air.gethit.airrecover.back)}
}

# Turn
if !time
&& p2dist x < 0 {
	turn{}
}

if !time {
	# Sound
	playSnd{value: 4, 5; channel: 0}
	# Sound
	playSnd{value: 0, 5200}
	# Flash
	palFx{add: 255, 255, 255; sinadd: -255, -255, -255, 20; time: 5}
	# FX
	explod{
		id: 8200;
		anim: 8200;
		posType: p1;
		pos: 0, ceil(-74 * const(size.yscale));
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
		ontop: 1;
	}
}

# NHB
if time < 14 {
	notHitBy{value: SCA; time: 1}
}

# Ctrl
if time >= 14 {
	ctrlset{value: 1}
}

# Land
if vel y > 0
&& pos y > -vel y {
	changeState{value: 52}
}

