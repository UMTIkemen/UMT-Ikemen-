	anim: 131;
]

# Vel
if !time {
	hitvelSet{x: 1}
}

# Vel
if time = getHitVar(slidetime)
|| hitover {
	velSet{x: 0}
}

# Ctrl
if time = getHitVar(ctrltime) {
	ctrlset{value: 1}
}

# High to Low
if stateType = S {
	if (!AIlevel
	&& command = "holddown")
	|| (AIlevel
	&& !map(ai_blockhigh)) {
		stateTypeSet{stateType: C; physics: C}
	}
}

# Low to High
if stateType = C {
	if (!AIlevel
	&& command != "holddown")
	|| (AIlevel
	&& map(ai_blockhigh)) {
		stateTypeSet{stateType: S; physics: S}
	}
}

# End
if hitover {
	changeState{value: 131; ctrl: 1}
}

