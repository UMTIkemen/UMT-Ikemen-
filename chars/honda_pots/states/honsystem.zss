# Ctrl
if time = getHitVar(ctrltime) {
	ctrlset{value: 1}
}

# Var
varSet{sysv: 0; value: vel y > 0 && (pos y > -vel y)}

if sysvar(0) {
	# Vel
	velSet{y: 0}
	# Pos
	posSet{y: 0}
}

# End
if sysvar(0) && inguarddist {
	if (!AIlevel
	&& ifelse(p2dist x < 0, command = "holdfwd", command = "holdback"))
	|| AIlevel {
		changeState{value: 130}
	}
}

# End
if sysvar(0) {
	changeState{value: 52}
}

