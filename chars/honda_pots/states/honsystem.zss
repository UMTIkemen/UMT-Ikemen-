#==========<POWER CHARGE>==========

#============================================================
# State 730
#============================================================
[StateDef 730;
	type: S;
	physics: S;
	moveType: I;
	anim: 730;
	velSet: 0, 0;
	ctrl: 0;
]

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Power
powerAdd{value: 4 + ifelse(time < 60, 0, (time - 60) / 15)}

# Sound
if time = 8 {
	playSnd{value: 4, 6; channel: 0}
}

# Flash
palFx{time: 1; add: 75 + ceil(sin(time / 6.0 * pi) * 75), 25 + ceil(sin(time / 6.0 * pi) * 25), 0}

# FX
if !numHelper(8330) {
	helper{
		helpertype: normal;
		stateno: 8330;
		id: 8330;
		name: "Power Charge";
		posType: p1;
		pausemovetime: 65535;
		supermovetime: 65535;
		ownpal: 1;
	}
}

# FX
if !numHelper(8331) {
	helper{
		helpertype: normal;
		stateno: 8331;
		id: 8331;
		name: "Particles";
		posType: p1;
		pausemovetime: 65535;
		supermovetime: 65535;
		ownpal: 1;
	}
}

# End
if time >= 24 {
	if (power >= const(data.power) || power >= powerMax || roundState != 2)
	|| (!AIlevel
	&& (command != "/b" || command != "/y"))
	|| (AIlevel
	&& (inguarddist || p2BodyDist x <= 120))
	|| (AIlevel
	&& p2moveType = A
	&& (p2stateno = [3000, 4999] || (p2, vel x * p2, facing * facing) < -1)) {
		changeState{value: 731}
	}
}

#----- END -----

#============================================================
# State 731
#============================================================
[StateDef 731;
	type: S;
	physics: S;
	moveType: I;
	anim: 731;
	velSet: 0, 0;
	ctrl: 0;
]

# Stop Snd
if !time {
	stopsnd{channel: 0}
}

# Sound
if !time
&& power >= const(data.power) {
	playSnd{value: 5, 9; channel: 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#====================<GUARD CANCEL>====================

#============================================================
# State 750
#============================================================
[StateDef 750;
	type: S;
	physics: S;
	moveType: I;
	anim: 750;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 2;
	powerAdd: -1000;
	facep2: 1;
]

# Strength
ignoreHitPause if !time
&& !AIlevel {
	mapSet{
		map: "strength";
		value: ifelse((command = "counter_a" + command = "counter_b" + command = "counter_c") >= 2, 1, 0);
	}
}

# Strength AI
ignoreHitPause if !time
&& AIlevel {
	mapSet{
		map: "strength";
		value: ifelse((p2stateType = A), 0, ifelse((p2stateType = C), 1, ifelse(random < 500, 0, 1)));
	}
}

# NHB
notHitBy{value: SCA; time: 1}
# Freeze
posfreeze{value: 1}

if !time {
	# Sound
	playSnd{value: 4, 0; channel: 0}
	# Flash
	palFx{add: 255, 255, 255; time: 5}
	# Superpause FX
	helper{
		helpertype: normal;
		stateno: 8350;
		id: 8350;
		name: "Zero Counter";
		posType: p1;
		pos: ceil(27 * const(size.xscale)), ceil(-73 * const(size.yscale));
		supermovetime: 255;
		ownpal: 1;
	}
	# Super Pause
	superpause{
		time: 10;
		movetime: 10;
		p2defmul: 1;
		anim: -1;
		sound: s0, 750;
		darken: 0;
	}
	# Guard Points
	guardpointsadd{value: -min((guardpoints - 1), 300)}
}

# End
if time >= 15 {
	changeState{value: ifelse(map(strength) = 1, 2910, 2900)}
}

#====================<PARRY>====================

#----- STANDING -----
#============================================================
# State 760
#============================================================
[StateDef 760;
	type: S;
	physics: S;
	moveType: I;
	anim: 760;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 2;
	powerAdd: 0;
	facep2: 1;
]

# HB
hitBy{value: SCA, AT; time: 1}

# Check Parried Helper
if !time {
	mapSet{map: "parry_helper_ID"; value: 0}
