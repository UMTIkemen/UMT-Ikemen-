		supermovetime: -1;
		ownpal: 1;
	}
}

# Ctrl
if time >= 2 {
	ctrlset{value: 1}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#====================<DODGE>====================

#============================================================
# State 700
#============================================================
[StateDef 700;
	type: S;
	physics: S;
	moveType: I;
	anim: 700;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: -2;
]

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Sound
if animElem = 1 {
	playSnd{value: 4, 0; channel: 0}
	playSnd{value: 1, 3}
}

# Push
playerPush{value: 0}

# HB
if animTime != 0 {
	hitBy{value: SCA, AT; time: 1}
}

# Attack
if !AIlevel
&& time = [15, 25]
&& (command = "a" || command = "b" || command = "c" || command = "x" || command = "y" || command = "z") {
	changeState{value: ifelse((command = "a" || command = "b" || command = "c"), 241, 210)}
}

# Attack
if AIlevel
&& time = [15, 25]
&& !inguarddist
&& p2dist y >= -40
&& abs(map(truebodydistx)) < 55 {
	changeState{value: ifelse(abs(map(truebodydistx)) < 30, 241, 210)}
}

# AI Guard
if AIlevel
&& animTime = [-10, -1]
&& facing = 1 {
	assertInput{flag: L}
}

# AI Guard
if AIlevel
&& animTime = [-10, -1]
&& facing = -1 {
	assertInput{flag: R}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

