	posSet{x: (-320 + abs(pos x)) * facing}
}

# Vel
persistent(0) if roundState != 0 {
	velSet{x: (helper(8999), rootdist x) / -40.0; y: -10.25}
}

# Accel
if roundState != 0 {
	veladd{y: 0.5}
}

# End
if time
&& vel y > 0
&& pos y > -vel y {
	changeState{value: 6901}
}

