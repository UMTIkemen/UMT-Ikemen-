;---------------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, 根性値 設定]
Type = VarSet
trigger1 = !ishelper
var(0) = 3 ;←0で無し 1で防御力のみ 2で攻撃力のみ 3で攻撃力,防御力両方 デフォルトは3
IgnoreHitPause = 1

[State -3, AI Flag set]
Type = VarSet
var(59) = 1;AIフラグ
TriggerAll = !Var(59) ;フラグが立っていない時。
TriggerAll = RoundState = 2
Trigger1   = ailevel
IgnoreHitPause = 1

[State -3, AI Flag off]
Type = VarSet
var(59) = 0
TriggerAll = Var(59) ;フラグが立っていない時。
Trigger1   = !ailevel
IgnoreHitPause = 1

[State -3, タッグ用生死判別]
Type = VarSet
trigger1 = RoundState = 2
var(12) = 0 + (NumEnemy > 1 && EnemyNear(0),life <= 0)
IgnoreHitPause = 1

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 
trigger2 = stateno = 106 
value = 40, 0

[State -3, ダメージボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive
trigger1 = stateno=5000 || stateno=5010 || stateno=5020
trigger2 = stateno = 5070 || stateno = 5080
value = 5000,0+(Random % 3)
channel = 0

