triggerall = power >= 3000
triggerall = statetype != A && stateno != 100 && stateno != 200 && stateno != 400 && stateno != 1202
trigger1 = hitdefattr = SC, NA, SA && movehit = 1 && Enemynear(Var(12)),movetype = H
trigger1 = (p2bodydist X = [0,65]) && p2bodydist Y > -45 && Enemynear(Var(12)),life > 160
trigger1 = !(Enemynear(Var(12)),statetype != A && frontedgebodydist <= 75) || (Enemynear(Var(12)),life <= Enemynear(Var(12)),lifemax*0.35) || (life <= 200&&var(50)=0)

