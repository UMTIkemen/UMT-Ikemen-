; 
[Info]
name = "ユウスケクウガ"          ;キャラの名前
displayname = "Kamen Rider Kuuga DCD"       ;表示されるキャラの名前
versiondate = 11,22,2000         ;キャラの更新情報
mugenversion = 1.0               ;キャラが動くmugenのバージョン
author = "仮面ライダー制作wiki"  ;キャラの製作者名
pal.defaults = 1,2,3             ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = kuuga_o.cmd   ;キャラのコマンド
cns     = kuuga_o.cns   ;キャラのプログラム
st      = kuuga_o.cns   ;キャラのプログラム
st0     = AI.cns
stcommon = common1.cns 
sprite  = kuuga_o.sff   ;キャラの絵
anim    = kuuga_o.air   ;キャラの動き
sound   = kuuga_o.snd   ;キャラの音
movelist = movelist_kuuga.dat
pal1    = kuuga_o.act   ;キャラの色（最大１２個）
pal2    = kuuga_o2.act
pal3    = kuuga_o1.act
pal4    = kuuga_o.act
pal5    = kuuga_o2.act
pal6    = kuuga_o1.act
