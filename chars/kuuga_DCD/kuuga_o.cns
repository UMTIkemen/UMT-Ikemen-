Trigger1 = StateType = S
Trigger1 = Command = "holddown" && Var(59)<1
Trigger2 = StateType != A && ((Enemynear(Var(12)),stateno=var(53)) || (Enemynear(Var(12)),stateno=var(54)) || (Enemynear(Var(12)),statetype = C)) && Var(59)>0
statetype = C
physics = C

[State 151, Lo to Hi]
type = StateTypeSet
Trigger1 = StateType = C
Trigger1 = Command != "holddown" && Var(59)<1
Trigger2 = StateType != A && Enemynear(Var(12)),stateno!=var(53) && Enemynear(Var(12)),stateno!=var(54) && Enemynear(Var(12)),statetype != C && Var(59)>0
statetype = S
physics = S

[State 151, 4]
type = ChangeState
trigger1 = HitOver
value = 130
ctrl = 1

;---------------------------------------------------------------------------
; CGUARDHIT (shaking)
[Statedef 152]
type    = C
movetype= H
physics = N
velset = 0,0

[State 152, 1]
type = ChangeAnim
trigger1 = 1
value = 151

[State 150, 2]
type = ChangeState
triggerall = var(59) <= 0
trigger1 = HitShakeOver
value = 151 + 2*(command="holddown")

[State 150, 2]
type = ChangeState
