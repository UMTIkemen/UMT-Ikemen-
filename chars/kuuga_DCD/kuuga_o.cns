;-------------------------------------------------------------------------------
;ハイパーアーマー用ヘルパー
;-------------------------------------------------------------------------------
[Statedef 9000]; アーマー判定ヘルパー
type = A
movetype = I
physics = N

[State 9000, 0]; 不具合対策
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, 0]; アーマー化した瞬間に重複被弾しないための無敵
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 9000, 0]; 投げ無敵
type = NotHitBy
trigger1 = Time >= 1
value = ,AT
time = 2

[State 9000, 0]; 透明＋影消し
type = AssertSpecial
trigger1 = 1
flag = Invisible
flag2 = NoShadow

[State 9000, 0]; 本体に追従
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, 0]; 判定を揃える
type = ChangeAnim
trigger1 = SelfAnimExist(Parent,Anim)
value = Parent,Anim
elem = Parent,AnimElemNo(0)

[State 9000, 0]; 打撃／飛び道具を受けたらステートを繰り返す
type = HitOverRide
trigger1 = IsHelper(9000)
attr = SCA,AA,AP
stateno = 9000

[State 9000, 0]; 本体がアーマーパートを過ぎたら消滅
type = DestroySelf
trigger1= (Parent,StateNo != 3300)

;-------------------------------------------------------------------------------
;イントロor勝利演出スキップ用ヘルパー
;-------------------------------------------------------------------------------
[Statedef 9010]
type = A
movetype = I
physics = N
anim = 9999

[State 9000, 0]
type = DestroySelf
trigger1= roundstate=2
trigger2= roundstate=3


;---------------------------------------------------------------------------
; ここは-2のステートを書いてください、ヘルパー関係です
;---------------------------------------------------------------------------
[Statedef -2]

[State -2]
type = Helper
triggerall = numhelper(9010)=0
trigger1= roundstate=1
trigger2= roundstate=4
stateno = 9010
ID = 9010
pos = 0,0
postype = p1
helpertype = normal
name = "skip"
keyctrl = 0
ownpal = 1

[State -2, スクロール];負けて倒れたらカメラワークを相手に移す処理
type = ScreenBound
triggerall = (Life <= 0) || (!Alive) || (Lose)
trigger1 = (StateNo = 5150) && (RoundState = 4) && (vel x = 0) && (vel y = 0)
value = 0
MoveCamera = 0,0
IgnoreHitPause = 1

;---------------------------------------------------------------------------
[State -2];補正
type = AttackMulSet
trigger1 = var(0)=2||var(0)=3
trigger1 = life > ceil(LifeMax*0.5)
trigger2 = var(0)!=2&&var(0)!=3
value = 1
ignorehitpause = 1

[State -2, 根性値・攻撃力設定1]
type = AttackMulSet
triggerall = var(0)=2||var(0)=3
trigger1 = Life <= ceil(LifeMax*0.5) && Life > ceil(LifeMax*0.35)
value = 1.1
ignorehitpause = 1

[State -2, 根性値・攻撃力設定2]
type = AttackMulSet
triggerall = var(0)=2||var(0)=3
trigger1 = Life <= ceil(LifeMax*0.35) && Life > ceil(LifeMax*0.2)
value = 1.15
ignorehitpause = 1

[State -2, 根性値・攻撃力設定3]
type = AttackMulSet
triggerall = var(0)=2||var(0)=3
trigger1 = Life <= ceil(LifeMax*0.2)
value = 1.2
ignorehitpause = 1

;---------------------------------------------------------------------------
; 根性値
[State -2, VarSet_根性値設定]
type	= VarSet
triggerall = var(0)=1||var(0)=3
trigger1= !Ishelper
fvar(20)= (Life<=ceil(LifeMax*0.5))*0.1+(Life<=ceil(LifeMax*0.4))*0.05+(Life<=ceil(LifeMax*0.3))*0.05
Ignorehitpause = 1

[State -2, VarSet_攻撃食らってないとき、常にライフを上書き(都合上マイナス)]
Type	= VarSet
triggerall = !IsHelper&&(var(0)=1||var(0)=3)
trigger1= MoveType != H || (StateNo = [150,159]) || StateNo = [5200,5201]
var(21)	= -Life
Ignorehitpause = 1

[State -2, VarSet_ダウン有効]
Type	= VarSet
triggerall = !IsHelper&&(var(0)=1||var(0)=3)
trigger1= StateType = L || StateNo = 5070
var(21)	= -1 - LifeMax

;-----------------------------[ダメージ軽減処理]
[State -2, LifeAdd_1Hit目専用]
Type	= LifeAdd
triggerall = (var(0)=1||var(0)=3)&&fvar(20)!=0
trigger1= MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
trigger1= Life && Alive
trigger1= Life < var(21)
Value	= Floor((var(21)-Life)*fvar(20))
Ignorehitpause = 1

[State -2, DefenceMulSet_通常]
Type	= DefenceMulSet
triggerall = (var(0)=1||var(0)=3)&&fvar(20)!=0
trigger1= var(21) >= -LifeMax
Value	= 1-fvar(20)
Ignorehitpause = 1

[State -2, DefenceMulSet_ダウン中]
Type	= DefenceMulSet
triggerall = (var(0)=1||var(0)=3)&&fvar(20)!=0
trigger1= var(21) < -LifeMax
Value	= (1-fvar(20))*Const(Data.Fall.Defence_Mul)
Ignorehitpause = 1

[State -2, VarSet_反復防止対策]
Type	= VarSet
triggerall = (var(0)=1||var(0)=3)&&fvar(20)!=0
trigger1= MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
trigger1= Life < var(21)
trigger1= var(21)
var(21)	= 0
Ignorehitpause = 1

[State -2, VarSet_1hit目のダメージ軽減をON]
Type	= VarSet
triggerall = (var(0)=1||var(0)=3)&&fvar(20)!=0
trigger1= MoveType = H && (StateNo != [150,159]) && StateNo != [5200,5201]
trigger1= var(21) < 0 && var(21) > -1-LifeMax
var(21)	= -var(21)
Ignorehitpause = 1

