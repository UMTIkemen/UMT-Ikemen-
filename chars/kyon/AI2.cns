[Statedef -3];←この表記は消さないように！
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;AIレベル調整
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;　ここでAIのレベルが設定できます。
;
;　レベルは　0～4　まで調整可能。
;　数値が上がるほど強くなります。
;　value = の数値を変えてください。
;
;　
;
;
[state -3,AI]
type = varset
trigger1 = 1
v = 57
value = 4 ;←ここを変える
;
;
;＊0～4以外の数値は入れないでください
;
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;Ver使用

;Var(4) 空中ダッシュ回数制御
;Var(7) エフェクト関係
;var(12) イントロ判定
;Var(16) ブーストモード判定
;var(32) 椅子投げ関係
;var(33) 体当たり関係
;Var(43) ＥＸエフェクト
;var(56) 飛び道具調整
;var(57) AIレベル
;var(58) AIランダム
;var(59) AI
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

