[Statedef 100];ダッシュ/ラン
type    = S
physics = S
sprpriority = 1
ctrl = 0

[State 20, 3]
type = ChangeAnim
triggerall = anim != 100
triggerall = anim != 101
triggerall = anim != 102
trigger1 = var(59) = 1
trigger2 = var(59) = 0
value = 100

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = anim != 101
x = const(velocity.run.fwd.x)

[State 100, 4]
type = Velmul
triggerall = 1
trigger1 = anim = 101
x = 0.999

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
triggerall = 1
trigger1 = anim = 100
trigger2 = anim = 102
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
triggerall = 1
trigger1 = anim = 100
trigger2 = anim = 102
flag = NoAutoTurn

[State 100, Stop]
type = ChangeAnim
triggerall = anim = 100
triggerall = time > 8
trigger1 = var(59) = 0 && command!="holdfwd"
trigger2 = var(59) = 1 && (enemynear,MoveType = A)
trigger3 = var(59) = 1 && p2bodydist X < 80 && random < 24
trigger4 = var(59) = 1 && p2bodydist X <= 60
trigger5 = var(59) = 0 && (command="holdup" || command="holddown" || command="holdback")
value = 101
persistent=0

[State 100, ChangeAnim]
type = ChangeAnim
triggerall = 1
triggerall = anim = 100
triggerall = time > 8
trigger1 = var(59) = 0 && command = "holdfwd"
trigger2 = var(59) = 1
value = 102

[State 100, Stop]
type = ChangeAnim
triggerall = anim = 102
triggerall = time > 12
trigger1 = var(59) = 0 && command!="holdfwd"
trigger2 = var(59) = 1 && (enemynear,MoveType = A)
trigger3 = var(59) = 1 && p2bodydist X < 80 && random < 24
trigger4 = var(59) = 1 && p2bodydist X <= 40
trigger5 = var(59) = 0 && (command="holdup" || command="holddown" || command="holdback")
value = 101
persistent=0

[State 100, 4]
type = ChangeState
triggerall = 1
triggerall = anim = 101
trigger1 = AnimTime = 0
value = 0
ctrl = 1

