[Statedef 120];GUARD
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 106, 1]
type = VelSet
trigger1 = Time = 0 && statetype != A
y = 0
X = 0

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = var(59) = 0 && statetype = S && command = "holddown"
trigger2 = var(59) = 1 && statetype = S && (enemynear,movetype = A) && (enemynear,statetype = C)
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = var(59) = 0 && statetype = C && command != "holddown"
trigger2 = var(59) = 1 && statetype = C && (enemynear,movetype = A) && ((enemynear,statetype = S) || (enemynear,statetype = A))
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0 || var(59) = 1
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = var(59) = 0 && command != "holdback"
trigger2 = var(59) = 0 && !inguarddist
trigger3 = var(59) = 1 && !inguarddist
value = 140

