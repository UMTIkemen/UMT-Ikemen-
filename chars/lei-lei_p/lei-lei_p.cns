;---------------------------------------------------------------------------
[Statedef 0];待機
type = S
physics = S
velset = 0,0
sprpriority = 0

[State 0, escape]
type = ChangeState
triggerall = var(59) = 1
triggerall = Alive
triggerall = !winko
triggerall = roundstate = 2
trigger1 = prevstateno != 191
trigger1 = time = 0
trigger1 = ctrl = 0
value = 10
ignorehitpause=1
supermovetime = 999999999999999
pausemovetime = 999999999999999

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, DestroySelf]
type = DestroySelf
triggerall = 1
trigger1 = IsHelper
ignorehitpause=1
supermovetime = 999999999999999
pausemovetime = 999999999999999

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

