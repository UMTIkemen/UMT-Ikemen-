[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = -3

[State 3000,AssertSpecial]
type = AssertSpecial
trigger1 = var(24) >= 1 && var(24) < 3
flag = noshadow
ignorehitpause=1

[State 5150, 1]
type = ChangeAnim
trigger1 = var(24) >= 1 && var(24) < 3
value = 2502

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = var(24) = 0
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = var(24) = 0
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = null;ChangeAnim
persistent = 0
;trigger1 = var(24) = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = var(24) = 0
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, 6] ;Friction
type = VelMul
triggerall = var(24) = 0 || var(24) = 3
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
triggerall = var(24) = 0 || var(24) = 3
trigger1 = Vel x < .05
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

