&& p2stateno != [120, 155]
&& p2BodyDist x = [80, 160]
&& (map(ai_neutral) || map(ai_attackwindow) >= 13) {
	if ctrl
	&& random < map(ai_confirm) * 50 {
		changeState{value: 1200}
	}
}

# Henkyouki
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& (roundState = 2 && stateno != 110)
&& !map(projflag)
&& p2stateno != [120, 155]
&& (p2stateType = S || p2stateType = C || p2stateType = A)
&& (map(ai_neutral) || map(ai_attackwindow) >= 9) {
	if (stateno = [200, 499]
	&& abs(map(truebodydistx)) <= 40
	&& (map(specialcancel) && p2moveType = H)
	&& random < map(ai_confirm) * 50)
	|| (ctrl
	&& map(ai_p2fireball_super) = 0
	&& map(ai_p2fireball_distx) > 40
	&& map(ai_p2fireball_disty) = [-80, 0]
	&& map(ai_p2fireball_eta) = [10, 30]
	&& random < map(ai_confirm) * 200) {
		changeState{value: 1300}
	}
}

# Tenraiha
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& roundState = 2
&& stateType != A
&& power >= 3000
&& !map(projflag)
&& (map(juggle_count) < 1 || stateno = [1000, 4999])
&& (p2stateType = S || p2stateType = C)
&& map(ai_p2cannotmove)
&& (p2stateno != [120, 155] || p2stateType = A)
&& ((p2dist x = [40, 120]) && (p2dist y = [-100, 50]))
&& (map(ai_neutral) || map(ai_attackwindow) >= 4) {
	if stateno = [200, 499]
	&& moveHit = [1, 16]
	&& random < map(ai_confirm) * 200 {
		changeState{value: 3400}
	}
}

# EX Henkyouki
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& (roundState = 2 && stateno != 110)
&& power >= 500
&& !map(projflag)
&& (power != [3000, 3499] && (power >= 1500 || random < 500))
&& (p2stateType = S || p2stateType = C)
&& map(ai_p2cannotmove)
&& p2stateno != [120, 155]
&& (map(ai_neutral) || map(ai_attackwindow) >= 11) {
	if (stateno = [200, 499]
	&& p2BodyDist x = [-5, 40]
	&& map(specialcancel)
	&& random < map(ai_confirm) * 50)
	|| (ctrl
	&& map(ai_p2fireball_super) = 1
	&& map(ai_p2fireball_distx) > 40
	&& map(ai_p2fireball_disty) = [-80, 0]
	&& map(ai_p2fireball_eta) = [10, 30]
	&& random < map(ai_confirm) * 200) {
		changeState{value: 1330}
	}
}

# EX Ankihou
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& roundState = 2
&& stateType != A
&& power >= 500
&& !map(projflag)
&& (power != [3000, 3499] && (power >= 1500 || random < 500))
&& !inguarddist
&& (p2stateType = S || p2stateType = C)
&& p2stateno != [120, 155]
&& map(ai_p2cannotmove)
&& (map(ai_neutral) || map(ai_attackwindow) >= 16) {
	if (stateno = 210 || stateno = 220)
	&& map(specialcancel)
	&& random < map(ai_confirm) * 100 {
		changeState{value: 1050}
	}
}

# EX Senpuubu
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& roundState = 2
&& (map(senpubucount) <= 1 && stateno != 110)
&& power >= 500
&& (power != [3000, 3499] && (power >= 1500 || random < 500))
&& p2moveType != A
&& map(ai_p2cannotmove)
&& p2stateno != [120, 155]
&& ((p2BodyDist x = [240, 260]) && (p2dist y = [-100, 100])) {
	if ctrl
	&& backedgedist < 20
	&& random < map(ai_confirm) * 25 {
		changeState{value: 1120}
	}
}

# EX Reitou
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& roundState = 2
&& stateType != A
&& power >= 500
&& !map(projflag)
&& (power != [3000, 3499] && (power >= 1500 || random < 500))
&& p2moveType = A
&& map(ai_p2cannotmove)
&& p2stateno != [120, 155]
&& ((p2BodyDist x = [-5, 40]) && (p2, vel y > -1))
&& (map(ai_neutral) || map(ai_attackwindow) >= 13) {
	if (ctrl && (p2, vel x > -2))
	&& random < map(ai_confirm) * 75 {
		changeState{value: 1220}
	}
}

# Chuukadan
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& roundState = 2
&& stateType != A
&& power >= 1000
&& (!numHelper(3005) && !numHelper(3025))
&& !inguarddist
&& map(ai_p2cannotmove)
&& (p2stateno != [120, 155] || p2stateType = A)
&& p2BodyDist x = [100, 270] {
	if ctrl
	&& life >= 500
	&& p2dist x > 160
	&& random < map(ai_confirm) * 100 {
		changeState{value: 3000}
	}
}

# Chireitou
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& !map(ai_p2unhittable)
&& roundState = 2
&& stateType != A
&& power >= 2000
&& !map(projflag)
&& (map(juggle_count) < 2 || stateno = [1000, 4999])
&& (p2stateType = S || p2stateType = C)
&& map(ai_p2cannotmove)
&& stagefrontedgedist >= 240
&& (p2stateno != [120, 155] || p2stateType = A || p2life <= 50)
&& (p2BodyDist x = [-5, 80] && p2dist y >= -100)
&& (map(ai_neutral) || map(ai_attackwindow) >= 9) {
	if (ctrl
	&& random < map(ai_confirm) * ifelse((p2, hitfall), 200, 100))
	|| (stateno = [200, 499]
	&& map(supercancel)
	&& random < map(ai_confirm) * 50)
	|| ((stateno = [1300, 1330] && map(supercancel))
	&& random < map(ai_confirm) * 100) {
		changeState{value: 3200}
	}
}

# Forward Dash
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& (roundState = 2 && stateType = S)
&& (p2moveType != A && !inguarddist && p2BodyDist x >= 160) {
	if (ctrl
	&& random < 25)
	|| (ctrl
	&& (p2stateno = p2, const(statedizzy) || p2stateno = p2, const(stateguardbreakhit) || p2stateno = p2, const(stateguardbreakrecover))
	&& random < map(ai_confirm) * 100) {
		changeState{value: 100}
	}
}

# Power Charge
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& roundState = 2
&& stateType != A
&& (power < const(data.power) && power < powerMax)
&& !map(darkforce) {
	if ctrl
	&& !inguarddist
	&& (p2moveType != A && p2BodyDist x >= 200)
	&& random < ifelse(power < 1000, 150, ifelse(power < 2000, 100, 50)) {
		changeState{value: 740}
	}
}

# Taunt
if AIlevel
&& map(ai_randompass)
&& (numEnemy && !isAsserted(noinput))
&& stateType != A
&& life >= 0.5 * lifeMax
&& p2, lifeMax != 0 # Division by 0 check just in case
&& (1.0 * p2life / p2, lifeMax) < (0.5 * life / lifeMax)
&& prevStateNo != [170, 199] {
	if ctrl
	&& (p2BodyDist x >= 140 && !(p2, ctrl))
	&& (p2moveType = H && p2, hitfall)
	&& random < 50 {
		changeState{value: 195}
	}
}


###################################################################################################
#											STATE -2											 #
###################################################################################################

[StateDef -2]

# AI
ignoreHitPause if AIlevel {

	# AI Fall Recovery and Throw Escape
	if !isAsserted(noinput) && (inCustomState || hitFall) {
		if random < (250 * AIlevelF / 8.0) {
			if random < 500 {
				assertInput{flag: x; flag2: y; flag3: z}
			} else {
				assertInput{flag: a; flag2: b; flag3: c}
			}
			if random < 333 {
				assertInput{flag: L}
			} else if random < 500 {
				assertInput{flag: R}
			}
			if random < 333 {
				assertInput{flag: U}
			} else if random < 500 {
				assertInput{flag: D}
			}
		}
	}

	# AI Learning
	if moveType = H && prevmoveType != H && time <= 1 {
		# Throws
		if prevStateNo != 40 {
			if getHitVar(attr) = SCA, AT {
				mapSet{map: "ai_p2throw"; value: ifelse(p2, time > 1, p2stateNo, p2, prevStateNo)}
			}
		# Overheads
		} else if stateNo = 5010 && prevStateNo = [120, 155] && p2stateType != A {
			mapSet{map: "ai_p2overhead"; value: p2stateNo}
		# Standing Lows
		} else if (stateNo = 5000 || stateNo = 5070) && prevStateNo = [120, 155] && p2stateType != C {
			mapSet{map: "ai_p2standinglow"; value: p2stateNo}
		}
	}

	# AI Learning Safety Check
	if map(ai_p2throw) = [0, 199] {
		mapSet{map: "ai_p2throw"; value: -1}
	}
	if map(ai_p2overhead) = [0, 199] {
		mapSet{map: "ai_p2overhead"; value: -1}
	}
	if map(ai_p2standinglow) = [0, 199] {
		mapSet{map: "ai_p2standinglow"; value: -1}
	}

	# AI Unlearn
	if roundState = 1 && p2, roundsexisted = 0 {
		mapSet{map: "ai_p2throw"; value: -1}
		mapSet{map: "ai_p2overhead"; value: -1}
		mapSet{map: "ai_p2standinglow"; value: -1}
	}

}


###################################################################################################
#											STATE -3											 #
###################################################################################################

[StateDef -3]

# AI
ignoreHitPause if AIlevel && alive && !standby && roundState = 2 {

	# AI acting frequency by difficulty
	# This map minimizes the calls for RNG
	mapSet{map: "ai_randompass"; value: random < (1000 * (AIlevelF / 8.0))}

	# AI confirmation
	# This reduces the number of missed opportunities without making the AI too hard
	if map(ai_attackwindow) > 0 {
		if map(ai_confirm) < 3 {
			mapAdd{map: "ai_confirm"; value: 0.1}
		}
	} else {
		mapSet{map: "ai_confirm"; value: 1}
	}

	# AI P2 Unhittable Flag
	mapSet{map: "ai_p2unhittable"; value: 0}
	if p2, alive = 0 || p2, standby = 1
	|| p2stateType = A && p2moveType = H && p2, hitFall = 0
	|| p2, dizzy && p2stateNo != p2, const(statedizzy) {
		mapSet{map: "ai_p2unhittable"; value: 1}
	}

	# P2 wakeup throw invulnerability (from common1)
	# A HitBy trigger can replace this in the future
	if p2stateNo = 5120 {
		mapSet{map: "ai_p2wakeupnhb"; value: 12}
	} else if map(ai_p2wakeupnhb) > 0 {
		mapAdd{map: "ai_p2wakeupnhb"; value: -1}
	}

	# P2 can be thrown
	mapSet{map: "ai_canthrow"; value: !(map(unthrowable) || map(ai_p2wakeupnhb) > 0)}

	# P2 cannot act
	mapSet{map: "ai_p2cannotmove"; value: !(p2, ctrl || p2stateNo = [40, 52] || p2stateNo = 100 || p2stateNo = [5201, 5210])}

	# P2 Fireball Detection
	if ctrl && (p2, numHelper || p2, numProj) {
		call P2ClosestFireball();
	} else {
		map(ai_p2fireball_ID) := -1;
		map(ai_p2fireball_super) := 0;
		map(ai_p2fireball_distx) := 9999;
		map(ai_p2fireball_eta) := 9999;
	}

	# AI Spacing
	if AIlevelF >= 6 && !inGuardDist && stateType = S && ctrl {
		# Set spacing
		# Unique to each char
		if p2moveType = H || p2, dizzy {
			map(ai_spacing) := 10;
		} else {
			map(ai_spacing) := 110;
		}
		if command != "holddown" && command != "holdup" {
			# Walk forward
			if inputTime(B) != [1, 10] && p2BodyDist x > map(ai_spacing) + 20 {
				if vel x > 0 || p2, vel x < 0 || p2BodyDist x > map(ai_spacing) {
					if facing = 1 {assertInput{flag: R}} else {assertInput{flag: L}}
					assertCommand{name: "holdfwd"; buffer.time: 2}
					assertCommand{name: "holdback"; buffer.time: 0}
				}
			}
			# Walk back
			if backedgedist > 0 {
				if inputTime(F) != [1, 10] && p2BodyDist x < map(ai_spacing) - 20 {
					if vel x < 0 || p2, vel x > 0 || p2BodyDist x < map(ai_spacing) {
						if facing = 1 {assertInput{flag: L}} else {assertInput{flag: R}}
						assertCommand{name: "holdback"; buffer.time: 2}
						assertCommand{name: "holdfwd"; buffer.time: 0}
					}
				}
			}
		}
	}

	# AI crouch less
	if p2moveType = H {
		assertSpecial{flag: nocrouch}
	}

	# AI crouch fix
	if stateNo = 10
	|| stateNo = 11 && random < 950 {
		assertInput{flag: D}
	}

	# AI jump less
	# Lei-Lei is a bit different because of her air dash
	if inguarddist
	|| p2, ctrl && !map(projflag) && p2BodyDist x < 80
	|| p2stateNo = 5120 && p2, animTime > -30
	|| p2moveType = H && p2stateType != L {
		assertSpecial{flag: nojump}
	}

	# AI Neutral Flag
	mapSet{map: "ai_neutral"; value: 0}
	if moveType != H && p2moveType != H
	&& stateNo != 5120 && p2stateNo != 5120
	&& moveContact = 0 && p2, moveContact = 0
	&& moveReversed = 0 && p2, moveReversed = 0 {
		mapSet{map: "ai_neutral"; value: 1}
	}
	if p2stateType = L
	&& (p2moveType = H || p2stateNo = 5120) {
		mapSet{map: "ai_neutral"; value: 1} # okizeme really
	}

}

###################################################################################################
#											STATE -4											 #
###################################################################################################

[StateDef -4]

# AI
ignoreHitPause if AIlevel && !isHelper {

	# AI block high
	if p2stateNo != map(ai_p2standinglow)
	&& (p2stateType = A || p2, hitdefattr = A, AA, AP || p2stateNo = map(ai_p2overhead)) {
		if random < (100 * (AIlevelF / 8.0)) {
			mapSet{map: "ai_blockhigh"; value: 1}
		}
	} else {
		if random < (200 * (AIlevelF / 8.0)) {
			mapSet{map: "ai_blockhigh"; value: 0}
		}
	}

}
