if animElem = 12 {
	velSet{x: 0}
}

if animElem = 2 {
	# Sound
	playSnd{value: 1, 9}
	# Hit
	hitdef{
		id: stateNo;
		attr: C, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 60, 15;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 10, 10;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Trip;
		air.type: Low;
		ground.hittime: 1 + 18;
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		ground.velocity: -1.0, -8.0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -1.0, -8.0;
		air.cornerpush.veloff: 0;
		yaccel: 0.695;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 9;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8022);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 40) * (map(sparkx.max) := 120), map(sparky) := -22;
		down.bounce: 1;
		fall.xvelocity: -1;
		fall.yvelocity: -3;
	}
}

# Faster
if animElemTime(2) > 0 && animElemTime(8) < 0 {
	if (map(strength) = 1 && animElemTime(2) = 2)
	|| (map(strength) = 2 && animElemTime(2) = 7) {
		changeAnim{value: 4240; elem: 8}
	}
}

# Idle
if animElem = 12 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 4011}
}

#=========<Dark Force Air Punch>==========

#============================================================
# State 4260
#============================================================
[StateDef 4260;
	type: A;
	physics: N;
	moveType: A;
	sprPriority: 1;
	ctrl: 0;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Anim
if !time
&& (prevStateNo != 4500 || anim != 4260) {
	changeAnim{value: 4260}
}

# Sound
if animElem = 3 {
	playSnd{value: 1, 9}
}

# Hit
if animElem = 3 || animElem = 8 || animElem = 13 {
	hitdef{
		id: stateNo;
		attr: A, HA;
		hitflag: MAF;
		guardflag: HA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 30, 8;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 4;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: High;
		air.type: Low;
		ground.hittime: 1 + 12;
		ground.slidetime: 12;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -4.49, 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		guard.cornerpush.veloff: 0;
		air.velocity: -4.31, -7.36;
		air.cornerpush.veloff: 0;
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		forcenofall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 9;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8022);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 26) * (map(sparkx.max) := 108), map(sparky) := -62;
	}
}

# Type
if animElem = 15 {
	stateTypeSet{moveType: I}
}

# Type
if map(armorhittime) <= 0 {
	gravity{}
}

# Type
if vel y > 0
&& pos y > -vel y {
	changeState{value: 4052}
}

#====================<ARMOR>====================

#============================================================
# State 4500
#============================================================
[StateDef 4500;
	type: U;
	physics: N;
	moveType: H;
]

# Damage
if !time {
	lifeadd{value: -getHitVar(damage); kill: 1}
}

if !time
&& alive {
	# Flash
	palFx{
		time: 4;
		add: 255, 255, 255;
		mul: 256, 0, 0;
		color: 0;
	}
	# Hittime
	mapSet{
		map: "armorhittime";
		value: ifelse(getHitVar(animtype) = 0, 12, ifelse(getHitVar(animtype) = 1, 15, 18));
	}
	# Vel
	mapSet{
		map: "armorhitvel";
		value: ifelse(getHitVar(animtype) = 0, -4.49, ifelse(getHitVar(animtype) = 1, -7.51, -10.52));
	}
}

# End
selfState{value: ifelse(!alive, 5000, map(armorstate))}

