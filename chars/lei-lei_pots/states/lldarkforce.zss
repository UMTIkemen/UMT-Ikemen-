#==============================================================================================
#======================================<DARK FORCE STATES>=====================================
#==============================================================================================

#====================<DARK FORCE>====================

#============================================================
# State 4000
#============================================================
[StateDef 4000;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
	ctrl: 0;
]

# Turn
if p2dist x < 0
&& anim != 4005 {
	changeAnim{value: 4005}
}

# Turn
if anim = 4005 && animElem = 1 {
	turn{}
}

# Anim
if (anim != 4000 && anim != 4005)
|| (!animTime
&& anim = 4005) {
	changeAnim{value: 4000}
}

# Dead
if !alive {
	changeState{value: 5050}
}

# Crouch
if command = "holddown" && command != "holdup" {
	changeState{value: 4010}
}

# Walk
if command = "holdfwd" + command = "holdback" = 1 {
	changeState{value: 4020}
}

# Jump
if command = "holdup" && command != "holddown" {
	changeState{value: 4040}
}

#====================<CROUCHING>====================

#============================================================
# State 4010
#============================================================
[StateDef 4010;
	type: C;
	physics: C;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
	ctrl: 0;
]

# Anim
if !time
&& anim = 4012 {
	changeAnim{value: 10; elem: ifelse(animElemTime(4) >= 0, 1, 4 - animElemno(0))}
}

# Anim
if anim != 4010 {
	changeAnim{value: 4010}
}

# Jump
if command = "holdup" && command != "holddown" {
	changeState{value: 4040}
}

# End
if !animTime {
	changeState{value: 4011}
}

#============================================================
# State 4011
#============================================================

[StateDef 4011;
	type: C;
	physics: C;
	moveType: I;
	anim: 4011;
	velSet: 0, 0;
	sprPriority: 0;
	ctrl: 0;
]

# Turn
if p2dist x < 0
&& anim != 4006 {
	changeAnim{value: 4006}
}

# Turn
if anim = 4006 && animElem = 1 {
	turn{}
}

# Anim
if !animTime
&& anim = 4006 {
	changeAnim{value: 4011}
}

# End
if command != "holddown" {
	changeState{value: 4012}
}

#============================================================
# State 4012
#============================================================

[StateDef 4012;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
	ctrl: 0;
]

# Anim
if !time && anim = 4010 {
	changeAnim{value: 4012; elem: 4 - animElemno(0)}
}

# Anim
if anim != 4012 {
	changeAnim{value: 4012}
}

# Stand
if command = "holddown" && command != "holdup" {
	changeState{value: 4010}
}

# Jump
if command = "holdup" && command != "holddown" {
	changeState{value: 4040}
}

# End
if !animTime {
	changeState{value: 4000}
}

#====================<WALKING>====================

#============================================================
# State 4020
#============================================================
[StateDef 4020;
	type: S;
	physics: S;
	moveType: I;
	sprPriority: 0;
	ctrl: 0;
]

# Vel
if command = "holdfwd" {
	velSet{x: 4.17}
}

# Vel
if command = "holdback" {
	velSet{x: -4.43}
}

# Anim
if vel x > 0 {
	if (anim != 4020 && anim != 4005)
	|| (anim = 4005 && animElemTime(1) >= 1) {
		changeAnim{value: 4020}
	}
}

# Anim
if vel x < 0 {
	if (anim != 4021 && anim != 4005)
	|| (anim = 4005 && animElemTime(1) >= 1) {
		changeAnim{value: 4021}
	}
}

# Steps
if anim = [4020, 4021]
&& (animElem = 2 || animElem = 6) {
	playSnd{value: 0, ifelse((animElem = 2), 103, 106)}
}

# Jump
if command = "holdup" && command != "holddown" {
	changeState{value: 4040}
}

# End
if command = "holdfwd" + command = "holdback" != 1 {
	changeState{value: 4000}
}

#===================<JUMPING>================

#============================================================
# State 4040
#============================================================
[StateDef 4040;
	type: S;
	physics: S;
	moveType: I;
	anim: 4040;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 1;
	facep2: 1;
]

# Direction
if !AIlevel {
	varSet{
		sysv: 1;
		value: ifelse(!time, 0, ifelse(command = "holdfwd", 1, ifelse(command = "holdback", -1, sysvar(1))));
	}
}

# Direction
if AIlevel {
	varSet{
		sysv: 1;
		value: ifelse((p2moveType != A || backedgebodydist <= 10), 1, ifelse((p2moveType = A), -1, 0));
	}
}

if !animTime {
	# Sound
	playSnd{value: 0, 40}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7100;
		id: 7100;
		name: "Jump Dust";
		posType: p1;
		ownpal: 1;
	}
	# Vel Normal
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)));
		y: const(velocity.jump.y);
	}
	# End
	changeState{value: 4050}
}

#============================================================
# State 4050
#============================================================

[StateDef 4050;
	type: A;
	physics: N;
	moveType: I;
	sprPriority: 1;
	ctrl: 0;
]

# Anim
if !time
&& (prevStateNo != 4500 || (anim != [4041, 4043])) {
	changeAnim{value: ifelse(vel x >= 0, 4041, 4043)}
}

# Grounded Frame
if time < 1 && prevStateNo = 4040 {
	posfreeze{value: 1}
}

# Accel
if (time >= 1 || prevStateNo != 4040)
&& map(armorhittime) <= 0 {
	gravity{}
}

# Land
if vel y > 0
&& pos y > -vel y {
	changeState{value: 4052}
}

#============================================================
# State 4052
#============================================================

[StateDef 4052;
	type: S;
	physics: S;
	moveType: I;
	anim: 4047;
	velSet: 0, 0;
	sprPriority: 1;
	ctrl: 0;
]

# Anim
if !time
&& (prevStateNo != 4500 || anim != 4047) {
	changeAnim{value: 4047}
}

# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -5;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Turn
if (ctrl && p2dist x < 0)
&& anim != 4005 {
	changeAnim{value: 4005}
}

# Turn
if anim = 4005 && animElem = 1 {
	turn{}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#=========<Dark Force Standing Light Punch>==========

#============================================================
# State 4200
#============================================================
[StateDef 4200;
	type: S;
	physics: S;
	moveType: A;
	velSet: 0, 0;
	powerAdd: 0;
	sprPriority: 1;
	ctrl: 0;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Anim
if !time
&& (prevStateNo != 4500 || anim != 4200) {
	changeAnim{value: 4200}
}

# Sound
if animElem = 2 {
	playSnd{value: 1, 7}
}

# Hit
if animElem = 3 {
	hitdef{
		id: stateNo;
		attr: S, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 50, 13;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 10, 10;
		animtype: Light;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + ifelse((prevStateNo = 4200 || prevStateNo = 230 || prevStateNo = 245), 15, 12); # + 2 * map(counterhit_buffer);
		ground.slidetime: ifelse((prevStateNo = 4200 || prevStateNo = 230 || prevStateNo = 245), 15, 12);
		guard.hittime: 1 + 10;
		guard.ctrltime: 1 + 10;
		guard.slidetime: 10;
		air.hittime: 120;
		ground.velocity: ifelse((prevStateNo = 4200 || prevStateNo = 230 || prevStateNo = 245), -7.51, -4.49), 0;
		ground.cornerpush.veloff: 0;
		air.velocity: -4.31, -7.36;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		forcenofall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		hitsound: s2, 7;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8020);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8000);
		sparkxy: -10 + 0 * (map(sparkx.min) := 40) * (map(sparkx.max) := 128), map(sparky) := -32;
	}
}

# Anim
ignoreHitPause if anim = 4200
&& hitpausetime
&& (moveContact = 1 || moveReversed = 1)
&& (animElemTime(3) >= 0 && animElemTime(4) < 0)
&& hitpausetime <= 7 {
	changeAnim{value: 4200; elem: 4}
}

# Idle
if animElem = 4 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

