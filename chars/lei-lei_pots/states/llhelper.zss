#========================<ANKIHOU OBJECTS>=============================

#============================================================
# State 1005
#============================================================
[StateDef 1005;
	type: S;
	physics: N;
	moveType: A;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
]

ignoreHitPause {
	# Override
	hitOverride{time: -1; attr: SCA, AA, AP, AT; stateno: 1006}
	# HB
	hitBy{time: -1; value: SCA, NP, SP, HP}
}

# Random Item
if !time && !prevStateNo {
	if root, map(ankihotype) <= 2 {
		changeAnim{value: 1005 + (random % 7)}
	}
}

# Shuriken
if !time
&& !prevStateNo
&& root, map(ankihotype) = 3 {
	changeAnim{value: 1015}
}

# Statue or Panda
if !time
&& !prevStateNo
&& root, map(ankihotype) = 4 {
	changeAnim{value: ifelse(random < 500, 1016, 1017)}
}

# Dizzy Item
if !time
&& !prevStateNo
&& root, map(ankihotype) = 5 {
	changeAnim{value: ifelse(random < 333, 1020, ifelse(random < 500, 1021, 1023))}
}

# Strength
if !time && !prevStateNo {
	mapSet{map: "strength"; value: root, map(strength)}
}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1000 {
		root, map(projcontact) := 1;
	}
}

# Accel
veladd{y: ifelse(map(strength) = 2, 0.40, ifelse(map(strength) = 1, 0.35, 0.30))}

# Vel
if !time {
	velSet{
		x: ifelse(map(strength) = 2, 0.77, ifelse(map(strength) = 1, 6.66, 6.15));
		y: ifelse(map(strength) = 2, -14.00, ifelse(map(strength) = 1, -7.50, -3.50));
	}
}

# Pos Fix
if !time && !prevStateNo {
	posadd{x: -vel x; y: -vel y}
}

# Spin Snd
if !(time % 12)
&& (anim = 1005 || anim = 1006 || anim = 1011 || anim = 1015) {
	playSnd{value: 1, 7}
}

# Spin Snd
if (!(time % 12)
&& (anim = 1007 || anim = 1009 || anim = 1010 || anim = 1016))
|| (!(time % 9)
&& anim = 1008) {
	playSnd{value: 1, 1}
}

# Spin Snd
if !(time % 12)
&& (anim = 1017 || anim = 1020 || anim = 1021 || anim = 1023) {
	playSnd{value: 1, 2}
}

# Hit Normal
if anim < 1020 {
	hitdef{
		id: stateNo;
		attr: S, SP;
		hitflag: MAF;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 60, 15;
		dizzypoints: 100;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 0, 10;
		animtype: Hard;
		ground.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -10.52, 0;
		ground.cornerpush.veloff: 0;
		air.velocity: -3.0, -4.5;
		airguard.velocity: -6.00, -1.00;
		guard.dist: const(size.proj.attack.dist);
		yaccel: 0.4850;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := ifelse(anim = 1006 || anim = 1007 || anim = 1009 || anim = 1011 || anim = 1015, 8023, 8013));
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -20) * (map(sparkx.max) := 20), map(sparky) := 0;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Stun
if anim >= 1020 {
	hitdef{
		id: 1020;
		attr: S, SP;
		hitflag: MAF;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: 60, 15;
		dizzypoints: 1000;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 0, 10;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: High;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -4.5, -3;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		air.velocity: -4.5, -3;
		airguard.velocity: -6.00, -1.00;
		guard.dist: const(size.proj.attack.dist);
		yaccel: 0.4850;
		fall: 1;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := ifelse(anim = 1006 || anim = 1007 || anim = 1009 || anim = 1011 || anim = 1015, 8023, 8013));
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -20) * (map(sparkx.max) := 20), map(sparky) := 0;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Overhead
if map(strength) = 2 {
	modifyhitDef{guardflag: HA; ground.type: High}
}

# Getpower
ignoreHitPause if moveContact = 1 && numTarget {
	powerAdd{value: ifelse(moveguarded, 25, 50) * root, map(meterscaling)}
}

# HitSound
persistent(0) ignoreHitPause if (moveHit = 1 || moveReversed = 1)
&& (anim = 1005 || anim = 1008 || anim = 1010 || anim = 1016) {
	playSnd{value: 2, ifelse(numTarget, 2, 0); channel: 2}
}

# HitSound
persistent(0) ignoreHitPause if (moveHit = 1 || moveReversed = 1)
&& (anim = 1020 || anim = 1023) {
	playSnd{value: 2, ifelse(numTarget, 3, 0); channel: 2}
}

# HitSound
persistent(0) ignoreHitPause if (moveHit = 1 || moveReversed = 1)
&& anim = 1017 {
	playSnd{value: 2, ifelse(numTarget, 5, 0); channel: 2}
}

# HitSound
persistent(0) ignoreHitPause if (moveHit = 1 || moveReversed = 1)
&& anim = 1021 {
	playSnd{value: 2, ifelse(numTarget, 6, 0); channel: 2}
}

# HitSound
persistent(0) ignoreHitPause if (moveHit = 1 || moveReversed = 1)
&& (anim = 1006 || anim = 1007 || anim = 1009 || anim = 1011 || anim = 1015) {
	playSnd{value: 2, ifelse(numTarget, 8, 0); channel: 2}
}

# Connected
ignoreHitPause if moveContact || moveReversed {
	changeState{value: 1006}
}

# End
if frontedgedist < -80 || backedgedist < -80 {
	destroySelf{}
}

# End
if vel y > 0
&& pos y >= -16 {
	changeState{value: 1006}
}

#--- CONTACT ---

#============================================================
# State 1006
#============================================================
[StateDef 1006;
	type: A;
	physics: N;
	moveType: I;
	ctrl: 0;
	sprPriority: 1;
]

# NHB
ignoreHitPause {
	notHitBy{time: -1; value: SCA}
}

# Trade Sound
if !time
&& (hitoverridden || prevmoveType = H) {
	playSnd{value: 2, 0; channel: 2; volumescale: 33}
}

# Anim
persistent(0) if anim = 1021 {
	changeAnim{value: 1022}
}

# Ikemen Dizzy Disabled
persistent(0) if time <= 1
&& anim >= 1020
&& numTarget
&& roundState = 2
&& target, dizzy = 0
&& target, moveType = H
&& target, getHitVar(guarded) = 0
&& target, getHitVar(dizzypoints) = 0 # Wait 1 frame to see if gethitvar had any effect
&& target, dizzypoints >= target, dizzypointsmax
&& target, const(default.enable.dizzy)
&& target, map(_iksys_dizzyLimit) = 0 {
	dizzyset{redirectid: target, ID; value: 1}
}

# Accel
veladd{y: 0.50}

# Vel Hit Floor
if !time
&& pos y >= -16 {
	velSet{x: 0.33 * vel x; y: -5.0}
}

# Vel Hit Something
if !time
&& pos y < -16 {
	velSet{x: ifelse(map(strength) = 2, 1.0, -0.5) * vel x; y: -5.0}
}

# Pos
if !time
&& pos y >= -16 {
	posSet{y: -16}
}

# Fade
trans{trans: addAlpha; alpha: 256 - (8 * time), (8 * time)}

# End
if time >= 32
|| (vel y > 0
&& pos y >= -10
&& (time || !numTarget)) {
	destroySelf{}
}

#========================<ANKIHOU SPIKED BALL>=============================

#============================================================
# State 1055
#============================================================
[StateDef 1055;
	type: C;
	physics: N;
	moveType: A;
	anim: 1055;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
]

ignoreHitPause {
	# HB
	hitBy{time: -1; value: SCA, NP, SP, HP}
	# Override
	hitOverride{time: -1; attr: SCA, AA, AP, AT; stateno: ifelse(map(fireball_hits) < 2, 1055, 1056)}
}

# Hit Number
persistent(0) ignoreHitPause {
	mapAdd{map: "fireball_hits"; value: 1}
}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1050 {
		root, map(projcontact) := 1;
	}
}

# Push
playerPush{value: 0}
# Vel
velSet{x: 5; y: 0}

# HitSound
ignoreHitPause if moveHit = 1 || moveReversed = 1 {
	playSnd{value: 2, ifelse(numTarget, 10, 0); channel: 2}
}

# Freeze
if time <= ifelse(numTarget, 6, 0) {
	posfreeze{value: 1}
}

# Hit
if time >= ifelse(numTarget, 6, 0) {
	hitdef{
		id: stateNo;
		attr: S, SP;
		hitflag: MAF;
		guardflag: L;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 2);
		damage: 34, 9;
		dizzypoints: 50;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 0, 12;
		animtype: Hard;
		ground.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		down.hittime: 20;
		ground.velocity: -7.51, 0;
		ground.cornerpush.veloff: 0;
		air.velocity: -3, -3;
		down.velocity: 0, 0;
		guard.dist: const(size.proj.attack.dist);
		yaccel: 0.4850;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -20) * (map(sparkx.max) := 20), map(sparky) := -16;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit Knockdown
if time >= ifelse(numTarget, 6, 0)
&& map(fireball_hits) = 3 {
	hitdef{
		id: stateNo;
		attr: S, SP;
		hitflag: MAF;
		guardflag: L;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 2);
		damage: 34, 9;
		dizzypoints: 50;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 0, 12;
		animtype: Hard;
		ground.type: Trip;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		down.hittime: 20;
		ground.velocity: -1.0, -8.0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -10.52;
		air.velocity: -3, -3;
		down.velocity: 0, 0;
		guard.dist: const(size.proj.attack.dist);
		yaccel: 0.695;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -20) * (map(sparkx.max) := 20), map(sparky) := -16;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Connected
ignoreHitPause if moveContact || moveReversed {
	changeState{value: ifelse(map(fireball_hits) < 3, 1055, 1056)}
}

# End
if frontedgedist < -80 || backedgedist < -80 {
	destroySelf{}
}

#============================================================
# State 1056
#============================================================

[StateDef 1056;
	type: A;
	physics: N;
	moveType: I;
	anim: 1056;
	velSet: -0.33 * vel x, 0;
	ctrl: 0;
	sprPriority: 1;
]

# Trade Sound
if !time
&& (hitoverridden || prevmoveType = H) {
	playSnd{value: 2, 0; channel: 2; volumescale: 33}
}

# fadeout
trans{trans: addAlpha; alpha: 256 - (8 * time), (8 * time)}

# End
if time >= 32 {
	destroySelf{}
}

#========================<SENPUUBU CLAW>=============================

#============================================================
# State 1105
#============================================================
[StateDef 1105;
	type: A;
	physics: N;
	moveType: A;
	anim: 1105;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: -1;
]

ignoreHitPause {
	# No Reversals
	hitOverride{time: -1; attr: SCA, AA, AP, AT; stateno: 5000}
	# HB
	hitBy{time: -1; value: SCA}
}

# Strength
if !time && !prevStateNo {
	mapSet{map: "strength"; value: ifelse((parent, stateno = [1120, 1121]), 3, (parent, map(strength)))}
}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1101 || root, stateno = 1121 {
		root, map(projcontact) := 1;
	}
}

# Bind
ignoreHitPause {
	bindtoparent{pos: (2 * parent, const(size.xscale)), -65}
}

# Mashing and EX Speed
if animElemTime(animElemno(0)) >= 1 {
	if map(strength) = 3
	|| (!AIlevel
	&& (root, command = "x" || root, command = "y" || root, command = "z"))
	|| (AIlevel
	&& random < 333) {
		changeAnim{value: 1105; elem: ifelse(animElemTime(12) >= 0, 1, animElemno(0) + 1)}
	}
}

# Damage
if moveContact = 1 || moveReversed = 1 {
	mapAdd{map: "clawhits"; value: 1}
}

# Damage
ignoreHitPause {
	mapSet{
		map: "clawdamage";
		value: ifelse(map(strength) = 3, (70.0 / (map(clawhits) + 1)), (60.0 / (map(clawhits) + 1)));
	}
}

# Hit
if map(strength) <= 2
&& animElemTime(animElemno(0)) = 0 {
	hitdef{
		id: stateNo;
		attr: A, SA;
		hitflag: MAFD;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 3);
		damage: ceil(map(clawdamage)), ceil(map(clawdamage) * 0.25);
		dizzypoints: 25;
		getpower: ifelse(moveHit, 25, 100), ifelse(moveguarded, 25, 50);
		givepower: 40, 40;
		pausetime: 4, 4;
		animtype: Hard;
		ground.type: High;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: ifelse(p2dist x > 0, -10, 10), 0;
		ground.cornerpush.veloff: 0;
		air.velocity: ifelse(p2dist x > 0, -5, 5), -5;
		airguard.velocity: -6.00, -1.00;
		down.velocity: 0, 0;
		yaccel: 0.4850;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 9;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8023);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -70) * (map(sparkx.max) := 70), map(sparky) := (p2dist y + p2, const(size.mid.pos.y));
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit EX
if map(strength) = 3
&& animElemTime(animElemno(0)) = 0 {
	hitdef{
		id: stateNo;
		attr: A, SA;
		hitflag: MAFD;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := (3 + hitcount));
		damage: ceil(map(clawdamage)), ceil(map(clawdamage) * 0.25);
		dizzypoints: 25;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 4;
		animtype: Hard;
		ground.type: High;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		airguard.ctrltime: 1 + 16;
		ground.velocity: ifelse(p2dist x > 0, -10, 10), 0;
		ground.cornerpush.veloff: 0;
		air.velocity: ifelse(p2dist x > 0, -5, 5), -5;
		airguard.velocity: -6.00, -1.00;
		down.velocity: 0, 0;
		yaccel: 0.4850;
		air.fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 9;
		hitsound.channel: 2;
		guardsound: s2, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8023);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := -70) * (map(sparkx.max) := 70), map(sparky) := (p2dist y + p2, const(size.mid.pos.y));
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Pos X
ignoreHitPause {
	if !time && !prevStateNo {
		# Init
		fvar(1) := (root, pos x) + camerapos x;
		fvar(2) := fvar(1);
		fvar(3) := fvar(1);
		fvar(4) := fvar(1);
	} else {
		# Update
		fvar(1) := fvar(2);
		fvar(2) := fvar(3);
		fvar(3) := fvar(4);
		fvar(4) := (root, pos x) + camerapos x;
	}
}

# Vel X
ignoreHitPause {
	rootmapSet{map: "swing_vel_x"; value: (fvar(4) - fvar(1)) / 4.0}
}

# Pos Y
ignoreHitPause {
	if !time && !prevStateNo {
		# Init
		fvar(11) := (root, pos y) + camerapos y;
		fvar(12) := fvar(11);
		fvar(13) := fvar(11);
		fvar(14) := fvar(11);
	} else {
		# Update
		fvar(11) := fvar(12);
		fvar(12) := fvar(13);
		fvar(13) := fvar(14);
		fvar(14) := (root, pos y) + camerapos y;
	}
}

# Vel Y
ignoreHitPause {
	rootmapSet{map: "swing_vel_y"; value: (fvar(14) - fvar(11)) / 4.0}
}

# End
if (map(strength) <= 2
&& (parent, stateno != 1101 || parent, anim != 1101))
|| (map(strength) = 3
&& (parent, stateno != 1121 || parent, anim != 1101)) {
	destroySelf{}
}

#========================<REITOU BLADE>=============================

#============================================================
# State 1205
#============================================================
[StateDef 1205;
	type: S;
	physics: S;
	moveType: A;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: -1;
]

ignoreHitPause {
	# No Reversals
	hitOverride{time: -1; attr: SCA, AA, AP, AT; stateno: 5000}
	# NHB
	notHitBy{time: -1; value: SCA}
}

# Strength
if !time && !prevStateNo {
