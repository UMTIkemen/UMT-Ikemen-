	sndpan{channel: 1; abspan: ceil(sin(gametime / 20.0 * pi) * 160)}
	assertSpecial{flag: nomusic}
}

# BG PalFX
if time < 16
&& !(time % 2) {
	bgPalFx{time: 1; color: 0; mul: 192, 192, 192}
}

# BG PalFX
if time < 16
&& time % 2 {
	bgPalFx{time: 1; color: 0; mul: 128, 32, 0}
}

# BG PalFX
if time = [16, 24] {
	bgPalFx{
		time: 1;
		color: 32 * (time -16);
		mul: 128 + 8 * (time - 16), 32 + 14 * (time - 16), 32 * (time - 16);
	}
}

# Move Name
if !time
&& root, map(superfinish) = 900 {
	varSet{v: 0; value: 1}
}

# Move Name
if !time
&& root, map(superfinish) = 3000 {
	varSet{v: 0; value: 2}
}

# Move Name
if !time
&& root, map(superfinish) = 3500 {
	varSet{v: 0; value: 3}
}

# Move Name
