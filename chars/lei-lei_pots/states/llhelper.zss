	type: A;
	physics: N;
	moveType: I;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 3;
]

# Strength
if !time && !prevStateNo {
	mapSet{map: "strength"; value: root, map(strength)}
}

# Colorvar
if !time && !prevStateNo {
	mapSet{map: "redbomb"; value: map(strength) = 2}
}

if !time {
	# Anim
	changeAnim{value: ifelse(map(redbomb), 3035, 3005)}
	# Vel
	velSet{
		x: ifelse(map(strength) = 2, 4.5, ifelse(map(strength) = 1, 3.0, 1.5));
		y: ifelse(map(strength) = 2, -6, ifelse(map(strength) = 1, -7.5, -9));
	}
}

# Ticking
if ID = (helper(3005), ID) {
	playSnd{value: 5, 13; channel: 5; lowpriority: 1}
}

ignoreHitPause {
	# Override
	hitOverride{
		time: -1;
		attr: SCA, AA, NP, SP, AT;
		stateno: 3015;
		slot: 0;
	}
	# Override
	hitOverride{
		time: -1;
		attr: SCA, HP;
		stateno: 3020;
		slot: 1;
	}
	# HB
	hitBy{time: -1; value: SCA, AA, AP}
}

# Timer Var
if !time {
	varSet{v: 0; value: ifelse(map(strength) = 2, 40, ifelse(map(strength) = 1, 180, 300))}
}

# Timer Var
ignoreHitPause if time {
	varAdd{v: 0; value: -1}
}

# Timer
if !time
&& !map(redbomb) {
	helper{
		helpertype: normal;
		stateno: 3090;
		id: 3090;
		name: "Timer";
		posType: p1;
		ownpal: 1;
	}
}

# Hit by Lei-Lei
if time > 0
&& root, moveType = A {
	if (root, hitdefattr = SCA, AA
	&& clsnoverlap(clsn2, root, ID, clsn1))
	|| ((root, stateno = 1101 || root, stateno = 1121)
	&& (pos x - root, pos x) * (root, facing) = [-60, 60]
	&& (pos y - root, pos y) = [-60, 60]) {
		changeState{value: 3016}
	}
}

# Hit by Chireitou
if time > 0
&& (numHelper(1205) || numHelper(1225) || numHelper(3205)) {
	if (numHelper(1205)
	&& helper(1205), moveType = A
	&& abs(pos x - (helper(1205), pos x)) < 33)
	|| (numHelper(1225)
	&& helper(1225), moveType = A
	&& abs(pos x - (helper(1225), pos x)) < 33)
	|| (numHelper(3204)
	&& helper(3204), moveType = A
	&& abs(pos x - (helper(3204), pos x)) < 33) {
		changeState{value: 3016}
	}
}

# Hit by Partner
if time > 0
&& numpartner
&& partner, moveType = A
&& partner, hitdefattr = SCA, AA
&& clsnoverlap(clsn2, partner, ID, clsn1) {
	changeState{value: 3017}
}

# Accel
veladd{y: 0.5}

if (vel x > 0 && frontedgedist <= 0)
|| (vel x < 0 && backedgedist <= 0) {
	# Poing
	playSnd{value: 5, 7; channel: 0}
	# Turn
	velmul{x: -1}
}

# bounce
if vel y >= 0
&& pos y >= -5 {
	changeState{value: 3010}
}

# Detonate
if var(0) <= 0
|| (root, stateno = 3002
&& root, animElemTime(3) >= 10) {
	changeState{value: ifelse(roundState = 2, 3020, 3030)}
}

