	veladd{y: 0.75}
}

# Anim
if (anim = 6000 && animElemTime(8) < 0)
&& vel y > 0
&& pos y >= -70 {
	changeAnim{value: 6000; elem: 8}
}

if anim = 6000 && animElemTime(8) = 5 {
	# Sound
	playSnd{value: 5, 9}
	# Flash
	explod{
		anim: 6005;
		id: 6005;
		ontop: 1;
		posType: p1;
		pos: 0, 0;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}

# Anim
if anim = 6000 && animElemTime(8) >= 10 {
	changeAnim{value: 6010}
}

# Pos
if anim = 6010 {
	posSet{y: 0}
}

# Vel
if (anim = 6000 && animElemTime(8) >= 0)
|| anim = 6010 {
	velSet{x: 0; y: 0}
}

# Type
if anim = 6010 {
	stateTypeSet{stateType: S; physics: S}
}

# Sound
if anim = 6010 && animElem = 9 {
	playSnd{value: 6, 1}
}

# Fake Afterimage
if anim != 6010 {
	explod{
		id: 6000;
		anim: anim;
		animfreeze: 1;
		animElem: animElemno(0);
		posType: p1;
		sprPriority: sprPriority - 1;
		removetime: 8;
		trans: addAlpha;
		alpha: 256, 0;
		scale: const(size.xscale), const(size.yscale);
		interpolation.time: 8;
		interpolation.alpha: 0, 256;
		ownpal: 0;
	}
}

#----- INTRO 1 - STANDING -----

#============================================================
# State 6015
#============================================================
[StateDef 6015;
	type: A;
	physics: N;
	anim: 6015;
	sprPriority: -1;
]

# Wait
if roundState = 0 {
	assertSpecial{flag: animfreeze}
}

# Sound
if anim = 6015 && animElem = 2 {
	playSnd{value: 6, 2; channel: 0}
}

# Vel
persistent(0) if anim = 6001 {
	velSet{x: 1.7; y: -12}
}

# Pos
if !animTime
&& anim = 6015 {
	posadd{y: -65}
}

# Accel
if anim = 6001 {
	veladd{y: 0.75}
}

# Anim
if !animTime
&& anim = 6015 {
	changeAnim{value: 6001}
}

if anim = 6015 && animElem = 6 {
	# Sound
	playSnd{value: 5, 9}
	# Flash
	explod{
		anim: 6005;
		id: 6005;
		ontop: 1;
		posType: p1;
		pos: 0, -64;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}

# Fake Afterimage
if anim = 6001 {
	explod{
		id: 6000;
		anim: anim;
		animfreeze: 1;
		animElem: animElemno(0);
		posType: p1;
		sprPriority: sprPriority - 1;
		removetime: 8;
		trans: addAlpha;
		alpha: 256, 0;
		scale: const(size.xscale), const(size.yscale);
		interpolation.time: 8;
		interpolation.alpha: 0, 256;
		ownpal: 0;
	}
}

# Sprite Priority
ignoreHitPause if anim = 6001 {
	sprPriority{value: 1}
}

# End
if anim = 6001 {
	if roundState != [0, 1]
	|| (root, stateno = 191
	&& root, animElemTime(5) >= 0) {
		destroySelf{}
	}
}

