&& root, map(superfinish) = 3400 {
	varSet{v: 0; value: 5}
}

# MvC
if !time {
	explod{
		anim: 8600;
		id: 8600;
		ontop: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5, 0.5 * (1.3333333 * gameheight / gamewidth);
		bindtime: -1;
		removetime: 32;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Fade
if numexplod(8600) {
	modifyexplod{id: 8600; trans: addAlpha; alpha: ifelse(time < 16, 256, 256 -32 * (time -16)), 256}
}

# Text
if !time
&& var(0) {
	explod{
		anim: 8609 + var(0);
		id: 10;
		ontop: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5, 0.5 * (1.3333333 * gameheight / gamewidth);
