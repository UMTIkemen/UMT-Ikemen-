#----- Dark Force Start -----

#============================================================
# State 6040
#============================================================
[StateDef 6040;
	type: S;
	physics: N;
	anim: 6040;
	sprPriority: 2;
]

# Accel
if time > 0
&& animElemTime(7) < 0 {
	veladd{y: 0.75}
}

# Vel
if time = 1 {
	velSet{x: ifelse(pos x > 0, -2.75, 2.75) * facing; y: -11}
}

if animElem = 7 {
	# Sound
	playSnd{value: 5, 9}
	# Flash
	explod{
		anim: 6005;
		id: 6005;
		ontop: 1;
		posType: p1;
		pos: 0, 0;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}

# Vel
if animElemTime(7) >= 0 {
	velSet{x: 0; y: 0}
}

# Pos
if animElem = 7 {
	posSet{y: -64}
}

# Pos
if animElemTime(8) >= 0 {
	posSet{y: 0}
}

# Fake Afterimage
if animElemTime(8) < 0 {
	explod{
		id: 6000;
		anim: anim;
		animfreeze: 1;
		animElem: animElemno(0);
		posType: p1;
		sprPriority: sprPriority - 1;
		removetime: 8;
		trans: addAlpha;
		alpha: 256, 0;
		scale: const(size.xscale), const(size.yscale);
		interpolation.time: 8;
		interpolation.alpha: 0, 256;
		ownpal: 0;
	}
}

# Turn
if animElem = 8
&& rootdist x < 0 {
	turn{}
}

# Sprite Priority
if animElem = 4 {
	sprPriority{value: -4}
}

# Anim
if !animTime {
	changeState{value: 6041}
}

# Offset
if animElemTime(8) >= 0 {
	offset{y: -8}
}

#----- Dark Force Active -----

#============================================================
# State 6041
#============================================================
[StateDef 6041;
	type: S;
	physics: N;
	anim: 6041;
	velSet: 0, 0;
	sprPriority: -4;
]

# Anim Var
if !time {
	varSet{v: 0; value: 0}
	varSet{v: 1; value: 0}
}

# Anim Var
if root, stateno = [4010, 4012] && root, prevStateNo != 4240 {
	var(0) := 1;
} else if root, stateno = 4020 {
	var(0) := 2;
} else if root, stateno = 4040 {
	var(0) := 3;
} else if root, stateno = [4200, 4225] {
	var(0) := 4;
} else if root, stateno = 4240 {
	var(0) := 5;
} else if root, stateno = 4260 {
	var(0) := 6;
}

# Anim Cycle
if !animTime
&& root, time = 1
&& var(1) != var(0) {
	changeAnim{value: ifelse(anim = 6041, 6042, ifelse(anim = 6042, 6043, 6041))}
	var(1) := var(0);
}

# Turn
if animElem = 1
&& rootdist x < 0 {
	turn{}
}

# Sound
if !time {
	playSnd{value: 6, 2; channel: 0}
}

# End
if root, stateno = 4510 {
	changeState{value: 6044}
}

# KO
if !(root, alive)
|| !(root, map(darkforce)) {
	changeState{value: 6045}
}

# Offset
offset{y: -8}

#----- Dark Force Ends -----

#============================================================
# State 6044
#============================================================
[StateDef 6044;
	type: S;
	physics: N;
	anim: 6044;
	velSet: 0, 0;
	sprPriority: -4;
]

if animElem = 6 {
	# Sound
	playSnd{value: 5, 9}
	# Flash
	explod{
		anim: 6005;
		id: 6005;
		ontop: 1;
		posType: p1;
		pos: 0, -64;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}

# Pos
if animElem = 10 {
	posSet{y: -64}
}

# Pos
if animElemTime(11) >= 0 {
	velSet{x: -5; y: -1}
}

# Pos
if rootdist y >= 80 {
	velSet{y: 0}
}

# Offset
if animElemTime(11) < 0 {
	offset{y: -8}
}

# Pos
if animElemTime(11) >= 0 {
	offset{y: ceil(4 * sin((time / 8.0 ) * pi))}
}

# Fake Afterimage
if animElemTime(10) >= 0 {
	explod{
		id: 6000;
		anim: anim;
		animfreeze: 1;
		animElem: animElemno(0);
		posType: p1;
		sprPriority: sprPriority - 1;
		removetime: 8;
		trans: addAlpha;
		alpha: 256, 0;
		scale: const(size.xscale), const(size.yscale);
		interpolation.time: 8;
		interpolation.alpha: 0, 256;
		ownpal: 0;
	}
}

# Turn
if rootdist x < 0
&& !time {
	turn{}
}

# Turn
if rootdist x >= 0
&& animElem = 10 {
	turn{}
}

# Anim
if rootdist x >= 0
&& animElemTime(11) >= 0 {
	destroySelf{}
}

#----- Dark Force Interrupted -----

#============================================================
# State 6045
#============================================================
[StateDef 6045;
	type: S;
	physics: N;
	velSet: 0, 0;
	sprPriority: -4;
]

# Pos
offset{y: -8}
# Fadeout
trans{trans: addAlpha; alpha: 256 - (8 * time), (8 * time)}

# Anim
if time >= 32 {
	destroySelf{}
}

