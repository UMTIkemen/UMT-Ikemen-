		id: 11;
		scale: 0.5 + (0.0625 * time), (0.5 + (0.0625 * time)) * (1.3333333 * gameheight / gamewidth);
		trans: addAlpha;
		alpha: 256 - (32 * time), 32 * time;
	}
}

# Stop Shake
