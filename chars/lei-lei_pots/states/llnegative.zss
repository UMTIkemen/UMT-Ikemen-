# Detect closest enemy fireball
[Function P2ClosestFireball()]

# Check helpers
if p2, numHelper > 0 {
	for i = 0; p2, numHelper - 1; 1 {
		if playerIDexist(p2, helper(-1, $i), ID) {
			if p2, helper(-1, $i), hitdefattr = SCA, AP {
				if !playerIDexist(map(ai_p2fireball_ID))
				|| abs(p2, helper(-1, $i), pos x - pos x) < abs(map(ai_p2fireball_distx)) {
					map(ai_p2fireball_ID) := p2, helper(-1, $i), ID;
					map(ai_p2fireball_super) := (p2, helper(-1, $i), hitdefattr = SCA, HP);
					map(ai_p2fireball_distx) := ((p2, helper(-1, $i), pos x) - pos x) * facing;
					map(ai_p2fireball_disty) := ((p2, helper(-1, $i), pos y) - pos y);
					if p2, helper(-1, $i), vel x != 0 {
						map(ai_p2fireball_eta) := (map(ai_p2fireball_distx) - 20) / p2, helper(-1, $i), vel x; # Good enough estimate
					}
				}
			}
		}
	}
}

# Check projectiles
if p2, numProj > 0 {
	for i = 0; p2, numProj - 1; 1 {
		if abs(p2, projVar(-1, $i, pos x) - pos x) < abs(map(ai_p2fireball_distx)) {
			map(ai_p2fireball_ID) := -1;
			map(ai_p2fireball_super) := (p2, projVar(-1, $i, attr) = SCA, HP);
			map(ai_p2fireball_distx) := (p2, projVar(-1, $i, pos x) - pos x) * facing;
			map(ai_p2fireball_disty) := (p2, projVar(-1, $i, pos y) - pos y);
			if p2, projVar(-1, $i, vel x) != 0 {
				map(ai_p2fireball_eta) := (map(ai_p2fireball_distx) - 20) / p2, projVar(-1, $i, vel x); # Good enough estimate
			}
		}
	}
}


# Blood Particle
[Function Blood_Particle(spark_x, spark_y, size)]
ignoreHitPause {
	switch $size{
	case 2:
		let anim = 8052;
		let xvel = -(random / 333.3);
		let yvel = -3.0 - (random / 500.0);
		let yaccel = 0.25;
	case 1:
		let anim = 8051;
		let xvel = -10 + (random / 50.0);
		let yvel = -5 - (random / 200.0);
		let yaccel = 0.50;
	default:
		let anim = 8050;
		let xvel = -5 + (random / 100.0);
		let yvel = -7.5 - (random / 400.0);
		let yaccel = 0.50;
	}
	explod{
		ID: 8050;
		anim: $anim;
		posType: p1;
		pos: $spark_x, $spark_y;
		vel: $xvel, $yvel;
		accel: 0, $yaccel;
		trans: addAlpha;
		alpha: 256, 128;
		sprPriority: 5;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}


# Nakoruru Spark Particle
[Function NakoSpark_Particle(spark_x, spark_y, type)]
ignoreHitPause {
	explod{
		ID: 8000;
		anim: ifelse($type = 0, 8061, ifelse($type = 1, 8071, 8081));
		posType: p1;
		pos: $spark_x, $spark_y;
		vel: -10 + (random / 50.0), -10 + (random / 50.0);
		facing: ifelse($spark_x < 0, -1, 1);
		scale: 0.4 + (random / 5000.0), 0.4 + (random / 5000.0);
		trans: addAlpha;
		alpha: 256, 256;
		removetime: 16;
		interpolation.time: 16;
		interpolation.alpha: 0, 256;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
		ontop: 1;
	}
}


# Generate Blood Sparks
[Function BloodSparks(spark_no, spark_x, spark_y)]
ignoreHitPause {

	# Check if custom or screenpack blood should be used
	let custom = 1;
	if !isHelper {
		let custom = map(cfg_sparks) != 0;
	} else {
		let custom = root, map(cfg_sparks) != 0;
	}

	# Custom blood
	if $custom {
		# Super
		if $spark_no = 8014 || $spark_no = 8024 {
			call Blood_Particle($spark_x, $spark_y, 2);
			call Blood_Particle($spark_x, $spark_y, 1);
			call Blood_Particle($spark_x, $spark_y, 1);
		}
		# Special
		if $spark_no = 8013 || $spark_no = 8023 {
			call Blood_Particle($spark_x, $spark_y, 2);
			call Blood_Particle($spark_x, $spark_y, 1);
		}
		# Hard
		if $spark_no = 8012 || $spark_no = 8022 {
			call Blood_Particle($spark_x, $spark_y, 2);
		}
		# Medium
		if $spark_no = 8011 || $spark_no = 8021 {
			call Blood_Particle($spark_x, $spark_y, 1);
		}
		# Light (shared)
		call Blood_Particle($spark_x, $spark_y, 0);
		call Blood_Particle($spark_x, $spark_y, 0);
		call Blood_Particle($spark_x, $spark_y, 0);
	}

	# Screenpack blood
	if !$custom {
		# Convert custom numbers to screenpack numbers
		switch $spark_no {
			case 8010; 8020:
				let spark_ffx_no = 10;
			case 8011; 8021:
				let spark_ffx_no = 11;
			default:
				let spark_ffx_no = 12;
		}
		explod{
			ID: 8000;
			anim: F $spark_ffx_no;
			posType: p1;
			pos: $spark_x, $spark_y;
			facing: ifelse($spark_x < 0, -1, 1);
			removetime: -2;
			pausemovetime: -1;
			supermovetime: -1;
			ownpal: 1;
			ontop: 1;
		}
	}

}


# Generate Hit Sparks
[Function HitSparks(spark_no, spark_x, spark_y)]
ignoreHitPause {

	# Check if custom or screenpack sparks should be used
	let custom = 1;
	if !isHelper {
		let custom = ifelse(map(cfg_sparks) = 2, 2, ifelse(map(cfg_sparks) = 0, 0, 1));
	} else {
		let custom = ifelse(root, map(cfg_sparks) = 2, 2, ifelse(root, map(cfg_sparks) = 0, 0, 1));
	}

	# Custom sparks
	if $custom {

		# Guard sparks
		if $spark_no = [8000, 8001] {
			explod{
				ID: 8000;
				anim: $spark_no;
				# Scaled through air file
				posType: p1;
				pos: $spark_x, $spark_y;
				facing: ifelse($spark_x < 0, -1, 1);
				removetime: -2;
				pausemovetime: -1;
				supermovetime: -1;
				ownpal: 1;
				ontop: 1;
			}
		}

		# Geese style hit sparks
		if $custom = 1 && $spark_no = [8010, 8029] {
			# Set scale
			let spark_scale = 0.3 + ($spark_no % 10) * 0.05;
			# Blunt Attacks
			if $spark_no = [8010, 8019] {
				# Main
				explod{
					ID: 8000;
					anim: 8010;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: $spark_scale, $spark_scale;
					angle: 30 * (random % 12);
					removetime: 10;
					interpolation.time: 10;
					interpolation.scale: 0, 0;
					interpolation.angle: -1080;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Center
				explod{
					ID: 8000;
					anim: 8011;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.5 * $spark_scale, 0.5 * $spark_scale;
					angle: 90 * (random % 4);
					trans: addAlpha;
					alpha: 256, 256;
					removetime: 16;
					interpolation.time: 16;
					interpolation.scale: $spark_scale, $spark_scale;
					interpolation.alpha: 0, 256;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Streaks
				explod{
					ID: 8000;
					anim: 8012;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.5 * $spark_scale, 0.5 * $spark_scale;
					angle: 90 * (random % 4);
					trans: addAlpha;
					alpha: 256, 256;
					removetime: 16;
					interpolation.time: 16;
					interpolation.scale: $spark_scale, $spark_scale;
					interpolation.alpha: 0, 256;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Impact
				explod{
					ID: 8000;
					anim: 8014;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: $spark_scale, $spark_scale;
					angle: 90 * (random % 4);
					trans: addAlpha;
					alpha: 128, 256;
					removetime: 8;
					interpolation.time: 8;
					interpolation.scale: 0, 0;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
			}
			# Slashing Attacks
			if $spark_no = [8020, 8029] {
				# Main
				explod{
					ID: 8000;
					anim: 8020;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.55 * $spark_scale, 1.10 * $spark_scale;
					angle: 15 * (random % 24);
					removetime: 10;
					interpolation.time: 10;
					interpolation.scale: 2 * $spark_scale, 0;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Streaks
				explod{
					ID: 8000;
					anim: 8012;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.4 * $spark_scale, 0.4 * $spark_scale;
					angle: 90 * (random % 4);
					trans: addAlpha;
					alpha: 256, 256;
					removetime: 16;
					interpolation.time: 16;
					interpolation.scale: 0.8 * $spark_scale, 0.8 * $spark_scale;
					interpolation.alpha: 0, 256;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Center
				if $spark_no = [8023, 8024] {
					explod{
						ID: 8000;
						anim: 8021;
						posType: p1;
						pos: $spark_x, $spark_y;
						facing: ifelse($spark_x < 0, -1, 1);
						scale: 0.4 * $spark_scale, 0.4 * $spark_scale;
						angle: 90 * (random % 4);
						trans: addAlpha;
						alpha: 256, 256;
						removetime: 16;
						interpolation.time: 16;
						interpolation.scale: 0.8 * $spark_scale, 0.8 * $spark_scale;
						interpolation.alpha: 0, 256;
						pausemovetime: -1;
						supermovetime: -1;
						ownpal: 1;
						ontop: 1;
					}
				}
			}
			# Impact on enemy's back
			if $spark_no = [8013, 8014]
			|| $spark_no = [8023, 8024] {
				if p2moveType = H && p2, getHitVar(playerno) = playerno && p2, animElemvar(group) >= 0 {
					if p2, anim = [5080, 5089] || p2, anim = [5100, 5119]
					|| p2, animElemvar(group) = [5001, 5002] || p2, animElemvar(group) = [5011, 5012] || p2, animElemvar(group) = [5031, 5032]
					|| p2, animElemvar(group) = [5040, 5042] || p2, animElemvar(group) = [5061, 5062] || p2, animElemvar(group) = [5071, 5072] { # type L
						let impact_posy = p2dist y;
					} else if p2, animElemvar(group) = 5020 || p2, anim = [5020, 5029] { # type C
						let impact_posy = p2dist y + 0.50 * p2, const(size.head.pos.y);
					} else {
						let impact_posy = p2dist y + 0.75 * p2, const(size.head.pos.y);
					}
					let impact_facing = cond(isHelper, ifelse(p2, p2dist x < 0, -1, 1), ifelse(p2dist x < 0, -1, 1));
					explod{
						ID: 8013;
						anim: 8013;
						posType: p1;
						pos: p2dist x + $impact_facing * p2, const(size.ground.back), $impact_posy;
						facing: $impact_facing;
						vfacing: ifelse(random < 500, -1, 1);
						scale: 0.5 * $spark_scale, 0.5 * $spark_scale;
						trans: addAlpha;
						alpha: 256, 256;
						#bindtime: 8;
						removetime: 8;
						interpolation.time: 8;
						interpolation.scale: $spark_scale, $spark_scale;
						interpolation.alpha: 0, 256;
						pausemovetime: -1;
						supermovetime: -1;
						sprPriority: -10;
						ownpal: 1;
					}
				}
			}
		}

		# Nakoruru style hit sparks
		if $custom = 2 && $spark_no = [8010, 8029] {
			# Blunt Attacks
			if $spark_no = [8010, 8019] {
				# Main Angled Circle
				explod{
					ID: 8000;
					anim: ifelse($spark_no = 8014, 8080, ifelse($spark_no = 8013, 8070, 8060));
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.5, 0.5;
					angle: 15 * (random % 24);
					removetime: 10;
					interpolation.time: 10;
					interpolation.scale: 2, 0;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
				# Center Fireworks
				explod{
					ID: 8000;
					anim: 8062;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: ifelse($spark_no = 8014 || $spark_no = 8024, 0.625, ifelse($spark_no = 8013 || $spark_no = 8023, 0.565, 0.500)),
						ifelse($spark_no = 8014 || $spark_no = 8024, 0.625, ifelse($spark_no = 8013 || $spark_no = 8023, 0.565, 0.500));
					angle: 45 * (random % 8);
					trans: addAlpha;
					alpha: 256, 256;
					removetime: 13;
					interpolation.time: 13;
					interpolation.alpha: 0, 256;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
			}
			# Slash Attacks
			if $spark_no = [8020, 8029] {
				# Main Angled Circle
				explod{
					ID: 8000;
					anim: ifelse($spark_no = 8024, 8085, ifelse($spark_no = 8023, 8075, 8065));
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: 0.25, 0.50;
					angle: 15 * (random % 24);
					removetime: 10;
					interpolation.time: 10;
					interpolation.scale: 1, 0;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}

			}
			# Special / Super Circle
			if $spark_no = [8013, 8014]
			|| $spark_no = [8023, 8024] {
				explod{
					ID: 8000;
					anim: 8073;
					posType: p1;
					pos: $spark_x, $spark_y;
					facing: ifelse($spark_x < 0, -1, 1);
					scale: ifelse($spark_no = 8014 || $spark_no = 8024, 0.30, 0.25), ifelse($spark_no = 8014 || $spark_no = 8024, 0.30, 0.25);
					angle: 45 * (random % 8);
					trans: addAlpha;
					alpha: 256, 256;
					removetime: 8;
					interpolation.time: 8;
					interpolation.scale: ifelse($spark_no = 8014 || $spark_no = 8024, 0.60, 0.50), ifelse($spark_no = 8014 || $spark_no = 8024, 0.60, 0.50);
					interpolation.alpha: 0, 256;
					pausemovetime: -1;
					supermovetime: -1;
					ownpal: 1;
					ontop: 1;
				}
			}
			# Normal Particles
			if $spark_no = 8014 || $spark_no = 8024 {
				let nakoparticle = 2;
			} else if $spark_no = 8013 || $spark_no = 8023 {
				let nakoparticle = 1;
			} else {
				let nakoparticle = 0;
			}
			call NakoSpark_Particle($spark_x, $spark_y, $nakoparticle);
			call NakoSpark_Particle($spark_x, $spark_y, $nakoparticle);
			call NakoSpark_Particle($spark_x, $spark_y, $nakoparticle);
			call NakoSpark_Particle($spark_x, $spark_y, $nakoparticle);
		}

	}

	# Screenpack sparks
	if !$custom {
		# Convert custom numbers to screenpack numbers
		switch $spark_no {
			case 8000; 8001:
				let spark_ffx_no = 40;
			case 8010; 8021:
				let spark_ffx_no = 0;
			case 8011; 8021:
				let spark_ffx_no = 1;
			case 8012; 8022:
				let spark_ffx_no = 2;
			case 8013; 8023:
				let spark_ffx_no = 3;
			case 8014; 8024:
				let spark_ffx_no = 3;
			default:
				let spark_ffx_no = 0;
		}
		explod{
			ID: 8000;
			anim: F $spark_ffx_no;
			posType: p1;
			pos: $spark_x, $spark_y;
			facing: ifelse($spark_x < 0, -1, 1);
			removetime: -2;
			pausemovetime: -1;
			supermovetime: -1;
			ownpal: 1;
			ontop: 1;
		}
	}

	# Blood
	if $spark_no = [8020, 8024]
	&& cond(!isHelper, map(cfg_blood), root, map(cfg_blood)) {
		call BloodSparks($spark_no, $spark_x, $spark_y);
	}

}


###################################################################################################
#											STATE +1											 #
###################################################################################################

[Statedef +1]

# Henkyouki Fireball Reflection
if !pausetime && (isHelper(1305) || isHelper(1335)) {

	# This flag makes all the calculations a bit more accurate
	# May be useless when a fireball is spawned already inside the reflector
	assertSpecial{flag: runlast}

	# Helper reflection
	for pno = 0; numPlayer - 1; 1 {

		# Find eligible helpers to reflect
		if playerIndexExist($pno)
		&& playerIndex($pno), isHelper
		&& playerIndex($pno), moveType = A
		&& playerIndex($pno), teamside != teamside
		&& playerIndex($pno), animElemvar(numclsn2) > 0
		&& (playerIndex($pno), vel x || playerIndex($pno), vel y) # Don't reflect stationary helpers
		&& (playerIndex($pno), hitdefattr = SCA, NP, SP || isHelper(1335) && playerIndex($pno), hitdefattr = SCA, HP) { # Only EX version can reflect supers

			# Check if reflector Clsn2 overlaps fireball Clsn2
			if clsnoverlap(clsn2, playerIndex($pno), ID, clsn2) {

				# Change teamside and ID of helper, then turn it
				# The ID is changed so that the enemy can fight back with another helper of the same type (bypasses numHelper triggers)
				modifyhitDef{teamside: teamside; redirectID: playerIndex($pno), ID}
				modifyPlayer{teamside: teamside; helpervar.ID: 0; redirectID: playerIndex($pno), ID}
				posadd{x: playerIndex($pno), clsnvar(clsn2, 0, back) * 0.5; redirectID: playerIndex($pno), ID}
				velmul{x: -1.25; redirectID: playerIndex($pno), ID} # Keep y-velocity as-is
				turn{redirectID: playerIndex($pno), ID}

				# Flip the explods that are bound to the helper
				for eidx = 0; (playerIndex($pno), numexplod) - 1; 1 {
					if playerIndex($pno), explodVar(-1, $eidx, bindID) = playerIndex($pno), ID
					&& playerIndex($pno), explodVar(-1, $eidx, bindtime) != 0 {
						modifyexplod{
							ID: -1;
							index: $eidx;
							facing: -1;
							redirectID: playerIndex($pno), ID;
						}
					}
				}
			}
		}
	}

	# Hybrid projectile reflection
	# Helper fireballs that generate projectiles to hit the enemy
	# We will check for helper/projectile pairs that have the same position
	# Note: This must be placed before the conventional projectile reflection code
	for pno = 1; 8; 1 {

		# Check if player exists and has both helpers and projectiles
		if playerNoExist($pno)
		&& player($pno), numHelper > 0
		&& player($pno), numProj > 0 {

			# Iterate through the player's helper/projectile pairs
			for hidx = 0; player($pno), numHelper - 1; 1 {
				for pridx = 0; player($pno), numProj - 1; 1 {

					let helperid = player($pno), helper(-1, $hidx), ID;
					let projvelx = player($pno), projVar(-1, $pridx, vel x);
					let projvely = player($pno), projVar(-1, $pridx, vel y);

					# Check if helper and projectile have the same position
					# We have to predict where the projectile will be from its velocity
					# TODO: Add Z-axis checking to the three codes
					if Abs(playerID($helperid), pos x - player($pno), projVar(-1, $pridx, pos x) - $projvelx * player($pno), projVar(-1, $pridx, facing)) < (Abs($projvelx) + 1) # 1 is for precision errors
					&& Abs(playerID($helperid), pos y - player($pno), projVar(-1, $pridx, pos y) - $projvely) < (Abs($projvely) + 1) {

						if player($pno), projVar(-1, $pridx, projhits) > 0
						&& player($pno), projVar(-1, $pridx, teamside) != teamside
						&& (playerID($helperid), vel x || playerID($helperid), vel y || $projvelx || $projvely)
						&& (player($pno), projVar(-1, $pridx, attr) = SCA, NP, SP || isHelper(1335) && player($pno), projVar(-1, $pridx, attr) = SCA, AP) { # Only the EX version can reflect supers

							# Check Clsn overlap between projectile and reflector
							if player($pno), projClsnOverlap($pridx, ID, clsn2) {
								# Reflect projectile
								modifyProjectile{
									redirectID: player($pno), ID;
									ID: -1;
									index: $pridx;
									teamside: teamside;
									velocity: -1.25 * $projvelx;
								}

								# Reflect its associated helper
								modifyPlayer{teamside: teamside; helpervar.ID: 0; redirectID: $helperid}
								posadd{x: playerID($helperid), clsnvar(clsn2, 0, back) * 0.5; redirectID: $helperid}
								velmul{x: -1.25; redirectID: $helperid}
								turn{redirectID: $helperid}

								# Flip explods that are bound to the helper
								for eidx = 0; (playerID($helperid), numexplod) - 1; 1 {
									if playerID($helperid), explodVar(-1, $eidx, bindID) = $helperid
									&& playerID($helperid), explodVar(-1, $eidx, bindtime) != 0 {
										modifyexplod{
											ID: -1;
											index: $eidx;
											facing: -1;
											redirectID: $helperid;
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	# Conventional projectile reflection
	for pno = 1; 8; 1 {

		# Check if player exists and has any conventional projectiles
		if playerNoExist($pno)
		&& player($pno), numProj > 0 {

			# Check if any of those projectiles is suitable
			for pridx = 0; player($pno), numProj - 1; 1 {
				if player($pno), projVar(-1, $pridx, projhits) > 0
				&& player($pno), projVar(-1, $pridx, teamside) != teamside
				&& (player($pno), projVar(-1, $pridx, vel x) || player($pno), projVar(-1, $pridx, vel y))
				&& (player($pno), projVar(-1, $pridx, attr) = SCA, NP, SP || isHelper(1335) && player($pno), projVar(-1, $pridx, attr) = SCA, AP) { # Only EX version can reflect supers

					# Check Clsn overlap between projectile and reflector
					if player($pno), projClsnOverlap($pridx, ID, clsn2) {

						# Reflect Projectile
						modifyProjectile{
							redirectID: player($pno), ID;
							ID: -1;
							index: $pridx;
							teamside: teamside;
							velocity: -1.25 * player($pno), projVar(-1, $pridx, vel x);
						}
					}
				}
			}
		}
	}
}

# +1, Juggle System
ignoreHitPause {
	# Disable Juggling
	if cond(isHelper, root, map(juggle_count), map(juggle_count)) >= map(juggle_limit)
	&& cond(isHelper, root, map(darkforce) = 0, map(darkforce) = 0) { # Dark Force has infinite limit (TODO: keep or not?)
		assertSpecial{flag: nofallhitflag}
	}
}

# +1, Variable Height
ignoreHitPause if !isHelper && !inCustomState {
	if stateType = A && moveType != H && p2stateType != A {
		# Several compromises made to keep compatibility with Mugen characters
		let vh_box_top = 78; #VS
		let vh_box_bottom = 32; #VS
		let vh_average_stand = 75; #SFA3
		let vh_average_crouch = 49; #SFA3 = CvS2
		let vh_average_down = 12; #CvS2
		if stateNo != [100, 106] {
			if p2stateType = S {
				height{value: $vh_box_top - const(size.height), -($vh_box_bottom - ($vh_average_stand - 60))}
			}
			if p2stateType = C {
				height{value: $vh_box_top - const(size.height), -($vh_box_bottom - ($vh_average_crouch - 60))}
			}
		}
		if p2stateType = L {
			if p2dist y > -($vh_box_bottom - $vh_average_down) {
				if map(truebodyDistx) = [0, vel x] || map(truebodyDistx) = [vel x, 0] {
					playerPush{value : 0}
				}
			}
		}
	}
}

# EX Yellow Flash
ignoreHitPause if map(exflash) > 0 && pausetime = 0 { # PalFX does not update while char is paused
	if moveType = H || stateNo != [1000, 2999] {
		mapSet{map: "exflash"; value: 0}
	} else {
		mapAdd{map: "exflash"; value: -1}
		if (map(exflash) % 2) {
			palFx{time: 1; color: 0; mul: 256, 224, 0; add: 96, 96, 96}
		}
	}
}

# Darkstalkers EX Flash
# This would work better as a RemapPal to a single hue followed by a hue cycle
ignoreHitPause if !isHelper {
	if stateNo = 3000 && time >= 43
	|| stateNo = 3200 && time >= 43
	|| stateNo = 3400 && time >= 43
	|| stateNo = 3500 && time >= 43
	|| stateNo = 3501 {
		if (gametime % 8) {
			palFx{
				time: 1;
				color: 0;
				add: 32, 32, 32;
				mul: 256 + cos(gametime / 8.0 * pi) * 128, 256 + cos((gametime / 8.0 * pi) - (2.0 / 3.0 * pi)) * 128, 256 + cos((gametime / 8.0 * pi) - (4.0 / 3.0 * pi)) * 128;
			}
		}
	}
}

# Fake Hit Sparks
# Placed here because you can't use functions in CNS
if inCustomState = 0 && pausetime = 0 {
	# Air Throw
	if stateNo = 861 && time = 0 {
		let spark_no = 8022;
		let spark_x = 0;
		let spark_y = 0;
		call HitSparks($spark_no, $spark_x, $spark_y);
	}
	# Houtengeki
	if stateNo = 1411
	&& animElemTime(3) >= 0 && numTarget
	&& ((target, vel y > 0 && target, stateNo = 1421 && target, pos y >= -(target, const(size.air.front) + 38))
		|| (target, vel y > 0 && target, stateNo = 1422 && target, pos y >= -(target, const(size.air.front) + 38))
		|| (target, stateNo = 1423 && !(time % 6))) {
		let spark_no = 8022;
		let spark_x = 0;
		let spark_y = -50;
		if map(cfg_sparks) = 0 { # Random
			let spark_x = $spark_x - 10 + (random / 50.0);
			let spark_y = $spark_y - 10 + (random / 50.0);
		}
		call HitSparks($spark_no, $spark_x, $spark_y);
	}
	# Bomb hit by Lei-Lei
	if stateNo = 3016
	&& time = 0 {
		let spark_no = 8010;
		let spark_x = 0;
		let spark_y = -22;
		call HitSparks($spark_no, $spark_x, $spark_y);
	}
	# Bowling pin
	if stateNo = 3512
	&& time = 0 {
		let spark_no = 8014;
		let spark_x = 0;
		let spark_y = 0;
		call HitSparks($spark_no, $spark_x, $spark_y);
	}
	# Time over
	if stateNo = 176
	&& root, anim = 175 && root, animElem = 7 {
		let spark_no = 8010;
		let spark_x = 0;
		let spark_y = -8;
		call HitSparks($spark_no, $spark_x, $spark_y);
	}
}

# +1, Debug text
ignoreHitPause if !isHelper {
	if !AIlevel {
		displaytoclipboard{
			text: "Damage = %.1f%% Juggle = %d Unthrowable = %d";
			params: attack, ceil(map(juggle_count)), ceil(map(unthrowable));
		}
	} else {
		displaytoclipboard{
			text: "AI Combo %d Punish %d Attack %d";
			params: floor(map(ai_combowindow)), floor(map(ai_punishwindow)), floor(map(ai_attackwindow));
		}
	}
	appendtoclipboard {
		text: "\nBy PotS - https://network.mugenguild.com/pots/";
	}
}


###################################################################################################
#											STATE -1											 #
###################################################################################################


###################################################################################################
#											STATE -2											  #
###################################################################################################

[Statedef -2]

# -2, P2 Fall Recovery
ignoreHitPause if p2moveType = H && p2stateType = A {
	if p2, getHitVar(playerno) = playerno
	&& p2, getHitVar(fall.recover)
	&& p2, getHitVar(isbound) = 0
	&& p2, alive && p2, dizzy = 0
	&& p2, inCustomState = 0 # Fall recovery in custom states is best handled inside each state
	&& p2, vel y > 0
	&& p2, pos y >= p2, const(movement.air.gethit.groundrecover.ground.threshold) {
		# Reset time when near ground
		if p2, getHitVar(fall.recovertime) > 0 {
			getHitVarSet{fall.recovertime: 0; redirectID: p2, ID}
		}
		# Ikemen doesn't normally allow recovery in these states
		if (p2stateNo = [5030, 5035] || p2stateNo = 5071)
		&& p2, standby = 0
		&& p2, canRecover
		&& p2, command = "recovery" {
			selfState{value: 5200; redirectID: p2, ID}
		}
	}
}

# -2, P2 Air Reset
ignoreHitPause if numEnemy {
	for i = 0; numEnemy - 1; 1 {
		if enemy($i), moveType = H
		&& enemy($i), stateType = A
		&& enemy($i), getHitVar(playerno) = playerno
		&& enemy($i), getHitVar(guarded) = 0
		&& enemy($i), hitFall = 0
		&& enemy($i), ctrl = 0
		&& enemy($i), time < 60 {
			notHitBy{value: SCA; time: 2; redirectID: enemy($i), ID}
		}
	}
}

# P2 Air Reset Trip Guard
ignoreHitPause if p2stateNo = 52 {
	if alive && !standby {
		if p2, ctrl = 0 && (p2, prevStateNo = [5000, 5999] || p2, prevmoveType = H) {
			ctrlSet{value: 1; redirectID: p2, ID}
		}
	}
}

# -2, P2 Hard Knockdown
ignoreHitPause if p2moveType = H {
	if p2, getHitVar(playerno) = playerno
	&& p2, alive
	&& p2, dizzy = 0
	&& p2, getHitVar(down.recover) = 0
	&& p2, getHitVar(fall.recover) = 0 {
		if p2, getHitVar(fallcount) <= 1 {
			if !map(message_hkd) {
				if p2stateType = L
				&& p2stateNo != 5080
				&& p2, getHitVar(isbound) = 0
				&& p2, pos y = 0 && p2, vel y = 0 {
					lifebarAction{text: "Hard Knockdown"; top: 1; redirectID: p2, ID}
					mapSet{map: "message_hkd"; value: 1}
				}
			}
		} else {
			getHitVarSet{down.recover: 1; redirectID: p2, ID} # Just in case
		}
	}
} else if map(message_hkd) {
	mapSet{map: "message_hkd"; value: 0}
}

# Untechable throw message
ignoreHitPause if moveHitVar(frame)
&& map(throwtech_timer) = 0
&& numTarget = 1
&& target, getHitVar(attr) = S, NT {
	lifebarAction{text: "Untechable"; top: 1; redirectID: p2, ID}
}


# GuardSound Metal
ignoreHitPause if moveguarded = 1
&& moveHitvar(frame) {
	if (stateno = [200, 201] || stateno = 210 || stateno = [220, 221] || stateno = 225 || stateno = 250)
	|| (stateno = 400 || stateno = 410 || stateno = 420)
	|| (stateno = 600 || stateno = 610 || stateno = 620)
	|| (stateno = 4200 || stateno = 4205 || stateno = 4210 || stateno = 4225 || stateno = 4240 || stateno = 4260) {
		playSnd{value: 5, 21; channel: 3; freqmul: 0.9 + (random / 5000.0)}
	}
}

# Reset Combo Limits
ignoreHitPause if numEnemy
&& p2, time > 0
&& (p2moveType != H || p2stateno = p2, const(statedizzy)) {
	map(jugglereset) := 0;
	map(wallbounce) := 0;
}

# Dark Force KO
ignoreHitPause if !alive
&& map(darkforce) != 0
&& (stateno = 5030 && time <= 1) {
	velSet{x: getHitVar(xvel) * 2.0; y: getHitVar(yvel) - 5.0}
}

# Dark Force Timer
ignoreHitPause if map(darkforce) > 0 {
	mapAdd{map: "darkforce"; value: ifelse(map(darkforce) = 1, -2, -1)}
}

# Dark Force Over
ignoreHitPause if map(darkforce) > 0 {
	if standby
	|| roundState != 2 {
		mapSet{map: "darkforce"; value: -1}
	}
}

# Dark Force Over
ignoreHitPause if !alive
&& map(darkforce) {
	mapSet{map: "darkforce"; value: 0}
}

# Dark Force Over
ignoreHitPause if map(darkforce) = 0
&& map(armorhittime) {
	mapSet{map: "armorhittime"; value: 0}
}

# Dark Force Over
ignoreHitPause if map(darkforce) = 0
&& map(armorhitvel) {
	mapSet{map: "armorhitvel"; value: 0}
}

# Dark Force Disables Tagging Out
ignoreHitPause if map(_iksys_tagSwitchCooldown) < 6 {
	if map(darkforce) > 0
	|| stateno = [4500, 4511] {
		mapSet{map: "_iksys_tagSwitchCooldown"; value: 6}
	}
}

# Dark Force BG
ignoreHitPause if stateno = 770 || map(darkforce) != 0 {
	bgPalFx{
		time: 1;
		color: -256;
		hue: 64 * cos(gametime / 120.0 * pi);
		mul: 192 + 64 * cos(gametime / 60.0 * pi), 192 + 64 * cos(gametime / 60.0 * pi), 192 + 64 * cos(gametime / 60.0 * pi);
	}
}

# Dark Force Warning
ignoreHitPause if !(gametime % 2) {
	if map(darkforce) = [1, 60]
	|| (map(darkforce) = -1 && stateno != 4510) {
		palFx{time: 1; add: 96, 96, 96}
	}
}

# Dark Force hitOverride
ignoreHitPause if map(darkforce) != 0 {
	hitOverride{attr: SCA, AA, AP, AT; time: 600; stateno: 4500}
}

# Dark Force Stateno
ignoreHitPause if map(darkforce) != 0
&& moveType != H
&& (stateno != 4500 && (stateno != [5000, 5199])) {
	mapSet{map: "armorstate"; value: stateno}
}

# Dark Force Gethit Vel
ignoreHitPause if map(armorhittime) > 0 {
	posfreeze{value: 1}
	posadd{x: map(armorhitvel)}
}

# Dark Force Gethit Dust
if map(armorhittime) > 0
&& pos y = 0
&& !(gametime % 4) {
	explod{
		anim: F 120;
		sprPriority: -5;
		posType: p1;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Dark Force Gethit VelMul
ignoreHitPause if map(armorhitvel) {
	mapSet{map: "armorhitvel"; value: 0.85 * map(armorhitvel)}
}

# Dark Force Gethit Time
ignoreHitPause if map(armorhittime) > 0 {
	mapAdd{map: "armorhittime"; value: -1}
}

# Dark Force Gethit Over
ignoreHitPause if map(armorhittime) <= 0 {
	mapSet{map: "armorhitvel"; value: 0}
}

# Throw in Front
ignoreHitPause {
	map(grabbehind) := 0;
	if p2dist x < 0
	&& p2dist x < ifelse((facing = p2, facing), -(p2, const(size.ground.front)), -(p2, const(size.ground.back))) {
		map(grabbehind) := 1;
	}
}

# Unthrowable Flag
ignoreHitPause if map(unthrowable) > 0
&& numEnemy
&& (p2stateno != 52 || p2, ctrl || p2, time >= 6) {
	mapAdd{map: "unthrowable"; value: -1}
}

# Unthrowable Flag - Jump Start
ignoreHitPause if numEnemy
&& p2stateno = 40
&& p2moveType = I
&& p2, time < 10 {
	mapSet{map: "unthrowable"; value: 1}
}

# Unthrowable Flag - Hurt
ignoreHitPause if p2, ctrl = 0
&& p2, anim != 5300
&& p2stateno != p2, const(statedizzy) {
	if p2stateno = [150, 155]
	|| p2stateno = 5120 # Just in case
	|| p2stateno = 5201
	|| (p2moveType = H
	&& p2stateType != A)
	|| (p2moveType = H
	&& p2stateType = A
	&& p2, hitfall = 0) {
		mapSet{map: "unthrowable"; value: 3}
	}
}

# Damage Scaling - Reset
ignoreHitPause if p2moveType != H
&& p2, dizzy = 0
&& p2stateno != p2, const(statedizzy) {
	map(combototal) := 0;
	map(combocheck) := 0;
}

# Damage Scaling - Attack Connected Flag
ignoreHitPause if moveContact = 1
&& hitcount <= 1 {
	mapSet{map: "combocheck"; value: 1}
}

# Damage Scaling - Base Formula
ignoreHitPause {
	mapSet{
		map: "damagescaling";
		value: ifelse(map(combototal) <= 0, 1, ifelse(map(combototal) >= 9, 0.1, 1 - 0.1 * map(combototal)));
	}
}

# Damage Scaling - Chain Combos
ignoreHitPause if numTarget
&& p2moveType = H
&& stateno = [200, 699]
&& prevStateNo = [200, 699]
&& (ifelse((stateno = 200 || stateno = 201 || stateno = 400), (prevStateNo != 200 && prevStateNo != 201 && prevStateNo != 400 && prevStateNo != 430), 1))
&& (ifelse((stateno = 230 || stateno = 430), prevStateNo != 430, 1)) {
	mapSet{map: "damagescaling"; value: 0.75 * map(damagescaling)}
}

# Damage Scaling - Minimum Super Damage
ignoreHitPause if stateno = [3000, 4999] {
	if map(superlevel) = 3 && map(damagescaling) < 0.5 {
		map(damagescaling) := 0.5;
	} else if map(superlevel) = 2 && map(damagescaling) < 0.4 {
		map(damagescaling) := 0.4;
	} else if map(damagescaling) < 0.3 {
		map(damagescaling) := 0.3;
	}
}

# Meter Scaling
ignoreHitPause {
	if map(darkforce) {
		map(meterscaling) := 0;
	} else {
		map(meterscaling) := map(damagescaling);
	}
}

# Damage Scaling - Override Fall Defense Bonus
ignoreHitPause if numEnemy
&& p2moveType = H
&& p2, getHitVar(playerno) = playerno {
	assertSpecial{redirectid: p2, ID; flag: nofalldefenceup}
}

# Damage Scaling - Long Combo Guts
ignoreHitPause if numEnemy
&& p2, receiveddamage >= (p2, lifeMax * 0.50) {
	mapSet{
		map: "damagescaling";
		value: map(damagescaling) * ifelse(p2, receiveddamage >= (p2, lifeMax * 0.85), 0.75, ifelse(p2, receiveddamage >= (p2, lifeMax * 0.70), 0.90, 0.95));
	}
}

# Damage Scaling - Root Multiplier
ignoreHitPause {
	attackmulset{
		value: map(damagescaling); # * ifelse(map(counterhit_buffer), 1.2, 1)
	}
}

# Reset Senpuubu Count
if map(senpubucount)
&& stateType != A {
	mapSet{map: "senpubucount"; value: 0}
}

# Drop Target
ignoreHitPause if numTarget = 1
&& target, time > 0 {
	if target, stateno = 5040
	|| target, stateno = 5201
	|| (target, moveType != H
	&& target, moveReversed = 0) {
		targetDrop{}
	}
}

# Get Hit Voice
if alive
&& time <= 1
&& moveType = H
&& !hitoverridden
&& stateno != [120, 155]
&& getHitVar(damage) = (0, life) {
	if (getHitVar(animtype) = 0 && random < 250)
	|| (getHitVar(animtype) = 1 && random < 375)
	|| (getHitVar(animtype) >= 2 && random < 500)
	|| getHitVar(damage) >= 100
	|| getHitVar(fall)
	|| getHitVar(attr) = SCA, HA, HT, HP {
		playSnd{value: 5000, (random % 5); channel: 0}
	}
}

# Get Hit Voice
if alive
&& time = 1
&& moveType = H {
	if (stateno = 5100
	&& (getHitVar(fall.damage) > 0 || sysvar(1) > 14))
	|| ((stateno = 5050 || stateno = 5100)
	&& prevStateNo != [5000, 5120]) {
		playSnd{value: 5000, (random % 5); lowpriority: 1; channel: 0}
	}
}

# Get Hit Voice
if alive
&& time = 1
&& moveType = H
&& inCustomState {
	if anim = [5000, 5002]
	|| anim = [5010, 5012]
	|| anim = [5020, 5022]
	|| anim = 5030
	|| anim = 5070
	|| anim = 5080
	|| anim = [5100, 5101]
	|| anim = 5170
	|| anim = 5950
	|| anim = 170 {
		playSnd{value: 5000, (random % 5); lowpriority: 1; channel: 0}
	}
}

# Dizzy Voice
if time = 1
&& anim = 5300 {
	playSnd{value: 5000, 0; channel: 0}
}

# Guard Break Voice
if time = 1
&& stateno = const(StateGuardBreakRecover) {
	playSnd{value: 5000, 1; lowpriority: 1; channel: 0}
}


###################################################################################################
#											STATE -3											 #
###################################################################################################

[Statedef -3]

# Infinite Prevention System
ignoreHitPause if p2moveType = H {
	if p2, getHitVar(playerno) = playerno
	&& p2, hitFall = 0
	&& p2stateType != A
	&& (p2, getHitVar(hitcount) >= 50 || combocount >= 100)
	&& stateNo != [3000, 4999]
	&& !map(darkforce) {
		hitFallset{value: 1; redirectID: p2, ID}
	}
}

# Check if Zoom is allowed
ignoreHitPause if roundState = 3 {
	mapSet{map: "zoom_allowed"; value: 1}
	for i = 1; 8; 1 {
		if playerNoExist($i) {
			if player($i), alive && player($i), standby = 0 {
				if player($i), playerno != playerno
				&& player($i), getHitVar(playerno) != playerno {
					mapSet{map: "zoom_allowed"; value: 0}
				}
			}
		}
	}
}

# -3, Turning Threshold
if roundState = 2
&& backedgedist > 0
&& p2dist x >= -const(size.ground.back) {
	assertSpecial{flag: noautoturn}
}

# -3, True p2BodyDist X
# Is considered 0 when characters overlap
ignoreHitPause {
	if p2BodyDist x < 0 || facing = p2, facing {
		# P1 Reference Point
		let p1ref = ifelse(p2dist x < 0, clsnvar(size, 0, back), clsnvar(size, 0, front));
		# P2 Reference Point
		if p2dist x >= 0 {
			let p2ref = ifelse(p2, facing = facing, -p2, clsnvar(size, 0, back), p2, clsnvar(size, 0, front));
		} else {
			let p2ref = ifelse(p2, facing = facing, -p2, clsnvar(size, 0, front), p2, clsnvar(size, 0, back));
		}
		# Calculate
		if abs(p2dist x) <= abs($p1ref + $p2ref) {
			mapSet{map: "truebodyDistx"; value: 0}
		} else {
			mapSet{map: "truebodyDistx"; value: p2dist x - $p1ref - $p2ref}
		}
	} else {
		mapSet{map: "truebodyDistx"; value: p2BodyDist x}
	}
}

# Corner Priority
ignoreHitPause if moveType != H && abs(p2dist x) < 80
&& (frontedgedist < vel x || backedgedist < -vel x) {
	if stateType = A && map(jumptype) = 3
	|| stateNo = 100 && animElemTime(7) >= 0 && animElemTime(10) < 0 { # Dash
		width{edge: -1, -1}
		if stateType = A && p2, backedgedist = 0 {
			assertSpecial{flag: noturntarget}
		}
	} else if p2moveType = H || p2stateType = L {
		width{edge: 1, 1}
	}
}

# Corner Push Set
ignoreHitPause if moveContact = 1 {
	if numTarget && reversalDefAttr != SCA, AA, AP, AT {
		mapSet{map: "cornerpush"; value: -1 * target, getHitVar(xvel)}
	}
}

# Corner Push Reset
if map(cornerpush) {
	if !numTarget {
		mapSet{map: "cornerpush"; value: 0}
	} else {
		if target, moveType != H
		|| target, getHitVar(playerID) != ID
		|| target, getHitVar(slidetime) = 0
		|| (target, stateType = S && abs(map(cornerpush)) < 1.0)
		|| target, hitFall = 1
		|| target, vel y != 0 {
			mapSet{map: "cornerpush"; value: 0}
		}
	}
}

# Corner Push Apply
if map(cornerpush) && numTarget {
	if target, pausetime = 0 &&	target, getHitVar(hitshaketime) <= 0 {
		if (target, stateType = S || target, stateType = C) &&
		((target, backedgedist <= 0 && (target, getHitVar(xvel) * target, facing) < 0) ||
		(target, frontedgedist <= 0 && (target, getHitVar(xvel) * target, facing) > 0)) {
			posadd{x: map(cornerpush) * facing}
		}
		# Friction
		mapSet{map: "cornerpush"; value: map(cornerpush) * ifelse(target, stateType = C, target, const(movement.crouch.friction), target, const(movement.stand.friction))}
	}
}

# -3, Auto P2 Facing
ignoreHitPause if p2moveType = H && p2, time <= 0 {
	if p2, getHitVar(playerno) = playerno
	&& p2, getHitVar(facing) = 0
	&& p2, hitShakeOver = 0 &&	p2stateType != L
	&& p2, hitoverridden = 0 && p2, inCustomState = 0 {
		if (p2, facing = facing && p2, p2dist x < p2, const(size.ground.front)) ||
		(p2, facing != facing && p2, p2dist x < -(p2, const(size.ground.back))) {
			turn{redirectID: p2, ID}
		}
	}
}

# -3, Unguardable Freeze
ignoreHitPause if p2, pausetime > 0 {
	for i = 1; numEnemy; 1 {
		if numEnemy >= $i {
			if enemy($i - 1), pausetime > 0 && enemy($i - 1), stateNo != [120, 155] {
				assertSpecial{flag: nostandguard; flag2: nocrouchguard; flag3: noairguard; redirectID: enemy($i - 1), ID}
			}
		}
	}
}

# Juggling Acceleration Fix
# For Mugen characters that override air get hit states and still duplicate acceleration
ignoreHitPause if p2moveType = H {
	if p2, time = 1 {
		if p2, getHitVar(playerno) = playerno
		&& (p2stateNo = 5035 || p2stateNo = 5050)
		&& p2, inCustomState = 0 {
			if p2, vel y = [(map(p2_yaccelfix) + 1.9 * p2, getHitVar(yaccel)), (map(p2_yaccelfix) + 3.1 * p2, getHitVar(yaccel))] {
				velSet{y: map(p2_yaccelfix) + p2, getHitVar(yaccel); redirectID: p2, ID}
			}
		}
	}
	mapSet{map: "p2_yaccelfix"; value: p2, vel y}
}

# Underground Juggling
ignoreHitPause if numEnemy && p2moveType = H {
	if p2, getHitVar(playerno) = playerno
	&& p2, getHitVar(isbound) = 0
	&& p2, pos y > 0 {
		# Fix position
		if p2, time <= 0 && p2, hitShakeOver = 0 {
			posSet{y: 0; redirectID: p2, ID}
		}
		# Change state type
		if p2stateType = A && p2, vel y > 0 
		&& (p2stateNo = [5030, 5109] || p2, inCustomState) {
			stateTypeSet{stateType: L; redirectID: p2, ID}
		}
	}
}

# P2 OTG - Stay Down
ignoreHitPause if p2moveType = H {
	if p2, getHitVar(playerno) = playerno
	&& (p2stateNo = [5020, 5030] || p2stateNo = 5070)
	&& p2, getHitVar(down.velocity.x) = 0
	&& p2, getHitVar(down.velocity.y) = 0
	&& p2, pos y >= -24
	&& p2, prevstateType = L
	&& p2stateType = A
	&& p2, alive {
		selfState{value: 1115080; readplayerID: ID; redirectID: p2, ID}
	}
}

# -3, Cheap KO
ignoreHitPause if moveType = H {
	let cheap = 0;
	if stateNo = [5000, 5019]
	&& !isAsserted(noKO)
	&& getHitVar(kill)
	&& getHitVar(frame)
	&& getHitVar(damage) > 0
	&& getHitVar(damage) >= life {
		if prevStateNo = [120, 155]
		&& getHitVar(guarddamage) > 0 { # Mitigates false positives
			let cheap = 1;
		}
		if getHitVar(hitdamage) = [1, 50]
		&& getHitVar(ground.animtype) = 0
		&& abs(getHitVar(xvel)) < 10
		&& receiveddamage <= 50 # Because of combos
		&& getHitVar(attr) != SCA, HA, HT, HP {
			let cheap = 1;
		}
		if $cheap {
			assertSpecial{flag: nokosnd}
			selfState{value: 5950}
		}
	}
}

# -3, Tag In Sounds
if stateNo = const(StateTagEnteringScreen) {
	if time = 1 {
		playSnd{value: 4, ifelse(random < 500, 1, 4); channel: 0}
	}
	if anim = const(AnimTagEnteringScreen) && (animElem = 2 || animElem = 6) {
		playSnd{value: 0, ifelse((animElem = 2), 103, 106)}
	}
}

# -3, Allow win pose selection
# This workaround is currently necessary in Ikemen because holding a button skips the win screen
if !AIlevel && roundState = [3, 4] {
	if (inputTime(a) > 0 || inputTime(b) > 0 || inputTime(c) > 0 || inputTime(x) > 0 || inputTime(y) > 0 || inputTime(z) > 0 || inputTime(s) > 0) &&
		inputTime(a) != 1 && inputTime(b) != 1 && inputTime(c) != 1 && inputTime(x) != 1 && inputTime(y) != 1 && inputTime(z) != 1 && inputTime(s) != 1 {
		assertSpecial{flag: postroundinput; flag2: roundnotskip}
	}
}

# P2 layering and hitshake during pause
if pausetime = 0 && p2, pausetime > 0 {
	if sprPriority >= 0
	&& sprPriority = p2, sprPriority
	&& cond((p2, numTarget), (p2, target, getHitVar(isbound) = 0), 1) {
		sprPriority{value: p2, sprPriority - 1; redirectID: p2, ID}
	}
	if p2, getHitVar(hitshaketime) > 0 {
		offset{x: (gametime % 2) * facing; redirectID: p2, ID}
	}
}


# ProjContact Reset
if map(projcontact) {
	if (stateno != 1000 && stateno != 1050 && stateno != 1200 && stateno != 1220 && stateno != 1300 && stateno != 1330 && stateno != 3200 && stateno != 3400)
	|| (stateno = 1000 && animElemTime(4) < 0)
	|| (stateno = 1050 && animElemTime(4) < 0)
	|| (stateno = 1200 && animElemTime(4) < 0)
	|| (stateno = 1220 && animElemTime(4) < 0)
	|| (stateno = 1300 && animElemTime(4) < 0)
	|| (stateno = 1330 && animElemTime(4) < 0)
	|| (stateno = 3200 && animElemTime(4) < 0)
	|| (stateno = 3400 && animElemTime(5) < 0) {
		mapSet{map: "projcontact"; value: 0}
	}
}

# ProjContact Timer
if map(projcontact) {
	mapAdd{map: "projcontact"; value: 1}
}

# Projectile Flag
ignoreHitPause {
	mapSet{map: "projflag"; value: 0}
}

# Projectile Flag
ignoreHitPause if map(projflag) != 1 {
	if ((stateno != 1000 && numHelper(1005))
	&& helper(1005), stateno = 1005)
	|| ((stateno != 1050 && numHelper(1055))
	&& helper(1055), stateno = 1055)
	|| ((stateno != 1200 && numHelper(1205))
	&& helper(1205), stateno = 1205)
	|| ((stateno != 1220 && numHelper(1225))
	&& helper(1225), stateno = 1205)
	|| ((stateno != 1300 && numHelper(1305))
	&& helper(1305), stateno = 1305)
	|| ((stateno != 1330 && numHelper(1335))
	&& helper(1335), stateno = 1335)
	|| ((stateno != 3200 && numHelper(3204))
	&& helper(3204), stateno = 3204)
	|| ((stateno != 3400 && numHelper(3410))
	&& helper(3410), stateno = 3410)
	|| map(darkforce) > 0 {
		mapSet{map: "projflag"; value: 1}
	}
}

# Special Cancel Reset
ignoreHitPause if moveType = H
|| moveReversed != [1, 2] {
	mapSet{map: "specialcancel"; value: 0}
}

# Special Cancel Check
ignoreHitPause if stateno = [200, 699] {
	if (!AIlevel
	&& time <= 2
	&& stateno = [200, 699]
	&& prevStateNo != [200, 4999])
	|| (stateno = 200 || stateno = 201)
	|| (stateno = 210
	&& animElemTime(5) < 0
	&& ((moveContact || moveReversed) && prevStateNo != [200, 699]))
	|| (stateno = 221
	&& animElemTime(5) < 0
	&& ((moveContact || moveReversed) && prevStateNo != [200, 699]))
	|| (stateno = 230
	&& animElemTime(5) < 0
	&& ((moveContact || moveReversed) && prevStateNo != [200, 699]))
	|| stateno = 400
	|| stateno = 430
	|| (stateno = 440
	&& animElemTime(4) < 0
	&& ((moveContact || moveReversed) && prevStateNo != [200, 699]))
	|| (stateno = 600
	&& animElemTime(4) < 0
	&& moveContact + moveReversed)
	|| (stateno = 630
	&& animElemTime(4) < 0
	&& ((moveContact || moveReversed) && prevStateNo != [200, 699])) {
		mapSet{map: "specialcancel"; value: 1}
	}
}

# Super Cancel Reset
ignoreHitPause if moveType = H
|| moveReversed != [1, 2] {
	mapSet{map: "supercancel"; value: 0}
}

# Super Cancel Check
ignoreHitPause if stateno = [200, 1999] {
	if map(specialcancel)
	|| (stateno = 1000
	&& map(projcontact) = [1, 12]
	&& ((anim = 1000 && animElemTime(7) < 12) || animElemTime(6) < 12))
	|| (stateno = 1050
	&& (animElemTime(7) < 12 && map(projcontact) = [1, 12]))
	|| (stateno = 1300
	&& (animElemTime(5) < 12 && map(projcontact) = [1, 12]))
	|| (stateno = 1330
	&& (animElemTime(5) < 12 && map(projcontact) = [1, 12])) {
		mapSet{map: "supercancel"; value: 1}
	}
}

# Throw Cancel Fix
# Because first frame of a throw has movehit and Custom Combo has so much freedom
ignoreHitPause if moveHitvar(frame)
&& hitdefattr != SCA, AA, AP
&& numTarget
&& target, getHitVar(frame)
&& target, stateOwner, ID = ID
&& (time <= 0 && target, time <= 0) {
	map(normalcancel) := 0;
	map(specialcancel) := 0;
	map(supercancel) := 0;
	map(hypercancel) := 0;
}

# Super Cancel Flag Reset
ignoreHitPause if map(supercancelflag)
&& ((stateno != [3000, 4999]) || moveType = H) {
	mapSet{map: "supercancel_flag"; value: 0}
}

# Hyper Cancel Flag Reset
ignoreHitPause if map(hypercancelflag)
&& ((stateno != [3000, 4999]) || moveType = H) {
	mapSet{map: "hypercancel_flag"; value: 0}
}

# Movement Afterimage
if time = 1 {
	if (stateno = 50 && map(jumptype) = 3)
	|| (stateno = 720 || stateno = 725) {
		afterimage{
			time: 2;
			timegap: 1;
			framegap: 4;
			length: 9;
			palbright: 0, 0, 0;
			palcontrast: 128, 128, 128;
			palpostbright: 0, 0, 0;
			paladd: 0, 0, 0;
			palmul: 0.9, 0.9, 0.9;
			trans: add1;
		}
	}
}

# Afterimage Persist
ignoreHitPause if ((stateno = 50 || stateno = [600, 699])
&& (map(jumptype) = 3 && vel y < -1))
|| (stateno = 720 || stateno = 725) {
	afterimagetime{time: 2}
}

# Scary Supers
if stateno = [3000, 4999] {
	attackdist{value: 320}
}

# Jump Reset
if map(jumptype)
&& stateno != 40
&& (stateType != A || moveType = H) {
	mapSet{map: "jumptype"; value: 0}
}

# Reset Super Finish Var
if map(superfinish)
&& roundState = [0, 2] {
	mapSet{map: "superfinish"; value: 0}
}

# Dark Force Finish
ignoreHitPause if winKO
&& map(darkforce)
&& roundState = 3
&& !map(superfinish)
&& !numHelper(8600)
&& p2, getHitVar(playerno) = playerno {
	if moveHit = [1, 4] && stateno = [4200, 4299] {
		map(superfinish) := 900;
		helper{
			helpertype: normal;
			stateno: 8600;
			id: 8600;
			name: "Super Finish";
			posType: left;
			pos: 160, -120;
			ownpal: 1;
			pausemovetime: 999;
			supermovetime: 999;
		}
	}
}

# Super Finish
ignoreHitPause if winhyper
&& roundState = 3
&& !map(superfinish)
&& !numHelper(8600)
&& p2, getHitVar(playerno) = playerno {
	let superState = -1;
	# Determine finishing move
	if numHelper(3025) && helper(3025), map(projcontact) {
		let superState = 3000;
	} else if numHelper(3204) && helper(3204), map(projcontact) {
		let superState = 3200;
	} else if (stateno = 3400 && (moveContact || map(projcontact))) {
		let superState = 3400;
	} else if numHelper(3410) && helper(3410), map(projcontact) {
		let superState = 3400;
	} else if stateno = 3501 && numTarget {
		let superState = 3500;
	}
	if $superState > 0 {
		map(superfinish) := $superState;
		helper{
			helpertype: normal;
			stateno: 8600;
			id: 8600;
			name: "Super Finish";
			posType: left;
			pos: 160, -120;
			ownpal: 1;
			pausemovetime: 999;
			supermovetime: 999;
		}
	}
}

# Victory Camera
if roundState != 4 {
	mapSet{map: "victorycam"; value: 0}
}

# Victory Camera
if map(cfg_winzoom)
&& map(zoom_allowed)
&& (alive && !standby)
&& winKO
&& stateno > 180
&& roundState = 4
&& cameraZoom <= 1
&& screenpos y = [0, gameheight]
&& numEnemy
&& p2, inCustomState = 0 {
	mapSet{map: "victorycam"; value: 1}
}

# Victory Camera
if map(victorycam) {
	zoom{
		scale: 1.0 / cameraZoom;
		lag: 0.92;
		stagebound: 1;
		camerabound: 0;
		pos: pos x * cameraZoom, 0;
	}
}

# Victory BGM
if map(victorybgm) != 0
&& motifstate(victoryscreen) = 0 {
	mapSet{map: "victorybgm"; value: 0}
}

# Victory BGM
if map(cfg_victorybgm)
&& motifstate(victoryscreen)
&& teamleader = playerno
&& matchover
&& alive
&& win {
	mapAdd{map: "victorybgm"; value: 1}
}

# Victory BGM
if map(cfg_victorybgm)
&& map(victorybgm) = [1, 5] {
	playbgm{bgm: ""}
}

# Victory BGM
if map(cfg_victorybgm)
&& map(victorybgm) = 6 {
	playbgm{bgm: "llwin.mp3"; loop: 0; volume: 100}
}

# Antifreeze
if !ctrl
&& time >= 300
&& roundState = 2 {
	if (pos y > 0 && screenpos y > gameheight)
	|| !selfanimexist(anim) {
		changeState{value: 5040}
	}
}

# Antifreeze
if numEnemy
&& moveType != A
&& p2, time >= 300
&& p2, inCustomState
&& p2, stateOwner, playerno = playerno {
	selfState{redirectid: p2, ID; value: 5040}
}


###################################################################################################
#											STATE -4											  #
###################################################################################################

[Statedef -4]

# -4, Juggle System
ignoreHitPause {
	# Reset Juggle Count
	if map(juggle_count) > 0
	&& p2, getHitVar(frame) = 0 { # Allow time for P2 to go from type S to type A
		if p2moveType != H
		|| p2, ctrl
		|| p2, hitFall = 0
		|| p2stateType = S || p2stateType = C
		|| (p2stateType = L && p2, pos y = 0 && p2, vel y = 0)
		|| p2stateNo = [120, 155] || p2stateNo = 5201 || p2stateNo = 5210
		|| moveguarded = 1 || moveReversed = 1
		|| roundState != 2 {
			mapSet{map: "juggle_count"; value: 0}
		}
	}
	# Increase Juggle Count
	if pausetime = 0
	&& moveHitvar(frame)
	&& moveHit = 1
	&& numTarget
	&& p2, hitFall
	&& p2moveType = H
	&& p2, getHitVar(frame)
	&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
		if map(juggle_timer) <= 0 {
			mapAdd{map: "juggle_count"; value: map(juggle_start); redirectID: cond(isHelper, root, ID, ID)}
		} else {
			mapAdd{map: "juggle_count"; value: map(juggle_increase); redirectID: cond(isHelper, root, ID, ID)}
		}
	}
	# Juggle Timer
	# To determine if a certain move is a juggle starter
	if p2moveType = H
	&& p2, hitFall
	&& p2, pausetime = 0 {
		if p2, getHitVar(playerno) = playerno {
			mapAdd{map: "juggle_timer"; value: 1}
		}
	} else {
		mapSet{map: "juggle_timer"; value: 0}
	}
}

# Counter Hit buffer
# n.a.

# -4, Counter Hit bonus
ignoreHitPause if pausetime = 0
&& moveHitvar(frame) && moveHit = 1
&& (movecountered = 1 || map(counterhit_buffer)) # MoveCountered has limits against multiple enemies
&& cond(isHelper, root, moveType != H, moveType != H) {
	for i = 0; numPlayer - 1; 1 {
		if playerIndexExist($i)
		&& playerIndex($i), getHitVar(frame)
		&& (playerIndex($i), getHitVar(playerID) = ID || playerIndex($i), ID = moveHitVar(playerID))
		&& playerIndex($i), moveType = H
		&& (playerIndex($i), prevmoveType = A || playerIndex($i), receivedHits > 1) # Just countered or counter buffer active
		&& playerIndex($i), getHitVar(guarded) = 0 {
			let time = playerIndex($i), getHitVar(hittime);
			getHitVarSet{
				hittime: $time + ifelse($time < 16, 2, ifelse($time < 19, 3, 4));
				redirectID: playerIndex($i), ID;
			}
			lifeadd{
				value: -0.20 * playerIndex($i), getHitVar(damage);
				kill: playerIndex($i), getHitVar(kill);
				redirectID: playerIndex($i), ID;
			}
			dizzypointsadd{
				value: -0.20 * playerIndex($i), getHitVar(dizzypoints);
				redirectID: playerIndex($i), ID;
			}
			# Sweep hard knockdown
			if stateNo = 450 {
				getHitVarSet{
					fall.recover: 0;
					down.recover: 0;
					down.recovertime: 30;
					redirectID: playerIndex($i), ID;
				}
			}
		}
	}
}

# Damage Scaling - Helper Update Root
ignoreHitPause if isHelper
&& pausetime = 0
&& !map(combocheck)
&& (moveContact && numTarget) {
	root, map(combocheck) := 1;
	map(combocheck) := 1;
}

# Damage Scaling - Helper Multiplier
ignoreHitPause if isHelper {
	attackmulset{value: root, map(damagescaling)}
}

# Generate Hit Sparks
ignoreHitPause if moveHitvar(frame)
&& inCustomState = 0 && pausetime = 0
&& reversalDefAttr != SCA, AA, AP, AT && hitdefattr != SCA, AT {
	if moveContact = 1
	&& (map(guard.sparkno) = [8000, 8009] || map(sparkno) = [8010, 8099]) {
		if !isHelper {
			let spark_scaleoffset_x = const(size.xscale);
			let spark_scaleoffset_y = const(size.yscale);
		} else {
			let spark_scaleoffset_x = 1;
			let spark_scaleoffset_y = 1;
		}
		let spark_y = map(sparky) * $spark_scaleoffset_y;
		# Find the appropriate enemies
		for i = 0; numPlayer - 1; 1 {
			if playerIndexExist($i)
			&& playerIndex($i), getHitVar(frame)
			&& (playerIndex($i), getHitVar(playerID) = ID || playerIndex($i), ID = moveHitVar(playerID)) { # Latter in case partner hits them as well
				let spark_no = ifelse(playerIndex($i), getHitVar(guarded), map(guard.sparkno), map(sparkno));
				let getterdist = (playerIndex($i), pos x - pos x) * facing;
				let spark_x = cond($getterdist > (map(sparkx.max) * $spark_scaleoffset_x), (map(sparkx.max) * $spark_scaleoffset_x), cond($getterdist > (map(sparkx.min) * $spark_scaleoffset_x), $getterdist, (map(sparkx.min) * $spark_scaleoffset_x)));
				if !isHelper || playerIndex($i), hitoverridden = 0 {
					call HitSparks($spark_no, $spark_x, $spark_y);
				}
				# Counter hit spark
				if moveHit = 1
				&& (movecountered = 1 || map(counterhit_buffer)) # MoveCountered has limits against multiple enemies
				&& cond(isHelper, root, moveType != H, moveType != H)
				&& (!isHelper || playerIndex($i), hitoverridden = 0)
				&& playerIndex($i), moveType = H
				&& (playerIndex($i), prevmoveType = A || playerIndex($i), receivedHits > 1) # Just countered or counter buffer active
				&& playerIndex($i), getHitVar(guarded) = 0
				&& map(sparkno) = [8010, 8099] {
					explod{
						ID: 8000;
						anim: 8290;
						posType: p1;
						pos: $spark_x, $spark_y;
						scale: 0.2, 0.2;
						trans: addAlpha;
						alpha: 256, 256;
						removetime: 16;
						interpolation.time: 16;
						interpolation.scale: 1.0, 1.0;
						interpolation.alpha: 0, 256;
						pausemovetime: -1;
						supermovetime: -1;
						ownpal: 1;
						ontop: 1;
					}
				}
			}
		}
	}
}

# Reset Spark Variables
ignoreHitPause if map(sparkno) >= 0 || map(guard.sparkno) >= 0 {
	if !moveHitvar(frame) && hitdefattr != SCA, AA, AP {
		mapSet{map: "sparkno"; value: -1}
		mapSet{map: "guard.sparkno"; value: -1}
		mapSet{map: "sparkx.min"; value: 0}
		mapSet{map: "sparkx.max"; value: 0}
		mapSet{map: "sparky"; value: 0}
	}
}

# Generate particle effects
# This block must be placed before the next one so we have a buffer for traded hits
ignoreHitPause if map(hitparticles) {
	if moveHitvar(frame) && moveHit = 1 && numTarget {
		# Iterate all targets to see if they already have a particles helper
		for i = 0; numTarget - 1; 1 {
			if target(-1, $i), getHitVar(frame)
			&& target(-1, $i), getHitVar(guarded) = 0
			&& target(-1, $i), getHitVar(playerID) = ID {
				# Search all particle helpers for a match with this target
				let addHelper = 1;
				for j = 0; numHelper(map(hitparticles)) - 1; 1 {
					if helper(map(hitparticles), $j), map(target) = target(-1, $i), ID {
						# Match found. Just refresh the timer
						helper(map(hitparticles), $j), map(timer) := 60;
						let addHelper = 0;
						break;
					}
				}
				if $addHelper {
					# Attach a new helper to this target
					helper {
						helpertype:	normal;
						stateNo: 	map(hitparticles);
						ID:			map(hitparticles);
						name: 		"Particle Emitter";
						posType:	p2;
						ownpal:		1;
						map.target: target(-1, $i), ID;
						map.timer: 60;
					}
				}
			}
		}
	}
	map(hitparticles) := 0;
}

# Set particle effects type
ignoreHitPause {
	if isHelper(3025) {
		map(hitparticles) := 8150; # Regular fire
	}
}
