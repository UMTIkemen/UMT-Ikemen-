#=======================<Throw Attempt>========================

#============================================================
# State 800
#============================================================
[StateDef 800;
	type: S;
	physics: S;
	moveType: A;
	velSet: 0, 0;
	ctrl: 0;
	anim: 800;
	sprPriority: 2;
	facep2: 1;
	powerAdd: 0;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Strength
if !time
&& !AIlevel {
	mapSet{map: "strength"; value: ifelse(map(cmd_kk), 1, 0)}
}

# Strength AI
if !time
&& AIlevel {
	mapSet{map: "strength"; value: (stagebackedgedist < stagefrontedgedist)}
}

# Tech Hit
mapSet{map: "throwtech_timer"; value: 0}

# Tech Hit
if numEnemy
&& p2stateType = S
&& (p2stateno = [0, 999] && p2stateno != [100, 119] && p2stateno != [200, 799] && p2, anim != 5300) {
	mapSet{map: "throwtech_timer"; value: ifelse(map(strength), 12, 7)}
}

# Tech Hit Facing
if !time {
	mapSet{map: "throwtech_facing"; value: facing}
}

# No proximity block
attackdist{value: 0}

# Hit
if animElem = 2
&& (!map(unthrowable) && !map(grabbehind))
&& map(truebodydistx) <= ceil(32 * const(size.xscale)) {
	hitdef{
		id: 800;
		attr: S, NT;
		hitflag: M;
		priority: 1, Miss;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		guard.dist: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: ifelse(map(strength), 1, 0); # because of juggle;
		fall.recovertime: ifelse(map(strength), 120, 0);
		hitsound: s2, 800;
		hitsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 0);
		fall.envshake.ampl: ifelse((gametime % 2), -2, 2);
		fall.envshake.freq: 180;
		fall.envshake.time: 10;
		numhits: 0;
		p1stateno: 810;
		p2stateno: 815;
	}
}

# Sound
if animElem = 4 {
	playSnd{value: 5000, 0; channel: 0}
	playSnd{value: 1, 1; stopongethit: 1; freqmul: 0.95 + (random / 10000.0)}
}

# Idle
persistent(0) if animElemTime(3) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#=======================<THROW>=======================

#----- PLAYER -----
#============================================================
# State 810
#============================================================
[StateDef 810;
	type: S;
	physics: S;
	moveType: A;
	anim: 810;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
]

# Throw
if !time {
	targetState{value: 815}
}

# Throw
if time <= 1 {
	targetfacing{value: -1}
}

# Tech Hit
if time
&& map(throwtech_timer) > 0 {
	mapAdd{map: "throwtech_timer"; value: -1}
}

# Tech Hit
if numTarget
&& map(throwtech_timer)
&& (target, command != "holdup" && target, command != "holddown") {
	if ((target, command = "a") + (target, command = "b") + (target, command = "c") + (target, command = "x") + (target, command = "y") + (target, command = "z")) >= 2
	|| ((target, command = "holdfwd" || target, command = "holdback")
	&& (target, command = "b" || target, command = "c" || target, command = "y" || target, command = "z"))
	|| (target, AIlevel > 0
	&& random < (100 * (target, AIlevelF / 8.0))) {
		changeState{value: 890}
	}
}

# Sound
if animElem = 4 {
	playSnd{value: 3, 2; channel: 0}
}

# Sound
if animElem = 3
|| (!map(strength)
