	}
}

# Anim
ignoreHitPause if anim = 210
&& hitpausetime = [1, 8]
&& (moveContact = 1 || moveReversed = 1)
&& (animElemTime(3) >= 0 && animElemTime(4) <= 0) {
	changeAnim{value: 210; elem: 4}
}

# Idle
