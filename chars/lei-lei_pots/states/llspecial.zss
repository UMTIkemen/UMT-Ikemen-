#======================<ANKIHOU>=============================

#============================================================
# State 1000
#============================================================
[StateDef 1000;
	type: S;
	physics: S;
	moveType: A;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 25;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(p2BodyDist x > 220 || p2dist y < -10, 1, 0)}
}

# Strength AI
ignoreHitPause if AIlevel
&& time <= 0
&& p2dist x < 100 {
	if (p2stateType = A && p2, vel y >= 0)
	|| p2stateType = L {
		mapSet{map: "strength"; value: 2}
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Anim
if !time {
	changeAnim{value: ifelse(map(strength) = 0, 1000, 1001)}
}

# Charge
if time < 60
&& (animElemTime(3) >= 0 && animElemTime(4) < 0) {
	if (!AIlevel
	&& (map(strength) = 0 && command = "/x"))
	|| (!AIlevel
	&& (map(strength) = 1 && command = "/y"))
	|| (!AIlevel
	&& (map(strength) = 2 && command = "/z"))
	|| (AIlevel
	&& (p2moveType = I && !inguarddist)
	&& (p2BodyDist x > 80 || p2stateType = L)
	&& random < 950) {
		changeAnim{value: anim; elem: 3}
	}
}

# Ankihou Var
persistent(0) if !time {
	mapSet{map: "ankihotype"; value: ifelse(map(ankihotype) >= 5, 1, map(ankihotype) + 1)}
}

# No dizzy
if !time
&& map(strength) = 0
&& map(ankihotype) = 5 {
	mapSet{map: "ankihotype"; value: 0}
}

# Charge
if time = 30
&& map(ankihotype) < 3
&& (animElemTime(3) >= 0 && animElemTime(4) < 0) {
	mapSet{map: "ankihotype"; value: 3}
}

# Charge
if time = 45
&& map(ankihotype) < 4
&& (animElemTime(3) >= 0 && animElemTime(4) < 0) {
	mapSet{map: "ankihotype"; value: 4}
}

# Charge
if time = 60
&& map(ankihotype) < 5
&& (animElemTime(3) >= 0 && animElemTime(4) < 0) {
	mapSet{map: "ankihotype"; value: 5}
}

# Width
if anim = 1000
&& animElem = 6 {
	width{value: ceil(32 * const(size.xscale)), 0}
}

# Width
if anim = 1001
&& animElem = 5 {
	width{value: ceil(30 * const(size.xscale)), 0}
}

# Correct Projectile Trade
if (anim = 1000 && animElem = 7) || (anim = 1001 && animElem = 6) {
	hitBy{value2: SCA, AA, AT; time: 1}
}

# Weapon
let addhelper = 0;
let posx = 0;
let posy = 0;
if map(strength) = 0 && anim = 1000 && animElem = 7 {
	let posx = 102 * const(size.xscale);
	let posy = -26 * const(size.yscale);
	let addhelper = 1;
} else if map(strength) = 1 && anim = 1001 && animElem = 7 {
	let posx = 70 * const(size.xscale);
	let posy = -91 * const(size.yscale);
	let addhelper = 1;
} else if map(strength) = 2 && anim = 1001 && animElem = 7 {
	let posx = 48 * const(size.xscale);
	let posy = -97 * const(size.yscale);
	let addhelper = 1;
}
if $addhelper {
	helper{
		helpertype: normal; # projectile
		stateno: 1005;
		id: 1005;
		name: "Ankihou Weapon";
		posType: p1;
		pos: $posx, $posy;
		ownpal: 1;
	}
}

# Sound
if (anim = 1000 && animElem = 4) || (anim = 1001 && animElem = 5) {
	playSnd{value: 3, 6; channel: 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<EX ANKIHOU>=============================

#============================================================
# State 1050
#============================================================
[StateDef 1050;
	type: S;
	physics: S;
	moveType: A;
	anim: 1000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: -500;
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# EX FX
if !time {
	playSnd{value: 0, 1000}
	explod{
		anim: 7210;
		sprPriority: 3;
		posType: p1;
		pos: ceil(-12 * const(size.xscale)), ceil(-77 * const(size.yscale));
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
	mapSet{map: "exflash"; value: 30}
}

# Width
if animElem = 6 {
	width{value: ceil(28 * const(size.xscale)), 0}
}

if animElem = 7 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Weapon
	helper{
		helpertype: normal; # projectile
		stateno: 1055;
		id: 1055;
		name: "Spiked Ball";
		posType: p1;
		pos: ceil(92 * const(size.xscale)), 0;
		ownpal: 1;
	}
}

# Sound
if animElem = 6 {
	playSnd{value: 3, 2; channel: 0}
}

# Sound
if animElem = 7 {
	playSnd{value: 5, 6}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

