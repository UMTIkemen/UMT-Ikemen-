	playSnd{value: 0, 40}
}

# Dust
if animElem = 12
&& pos y = 0 {
	explod{
		anim: 7100;
		id: 7100;
		sprPriority: 3;
		posType: p1;
		pos: 8, 3;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
}

# pos12 - 15
if animElem = 12 || animElem = 13 || animElem = 14 || animElem = 15 {
	posadd{
		x: ifelse((animElem = 12), 25, ifelse((animElem = 13), 5, 4)) * const(size.xscale);
		y: ifelse((animElem = 12), -3, ifelse((animElem = 13), -1, ifelse((animElem = 14), -4, -3))) * const(size.yscale);
