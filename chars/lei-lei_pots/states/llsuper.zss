#======================<CHUUKADAN>=============================

#============================================================
# State 3000
#============================================================
[StateDef 3000;
	type: S;
	physics: S;
	moveType: A;
	anim: 3000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: -1000 + 0 * (map(superlevel) := 1);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_yz), 2, ifelse(map(cmd_strength_xz), 1, 0))}
}

# AI Strength
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(p2BodyDist x > 180, 2, ifelse(p2BodyDist x > 120, 1, 0))}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	map(supercancelflag) := prevStateNo = [1000, 2999] && map(supercancel);
	map(hypercancelflag) := prevStateNo = [3000, 4999] && map(hypercancel);
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# Superpause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8500;
		id: 8500;
		name: "Superpause FX";
		posType: p1;
		pos: ceil(-4 * const(size.xscale)), ceil(-42 * const(size.yscale));
		supermovetime: 255;
		size.xscale: 1;
		size.yscale: 1;
		ownpal: 1;
	}
}

# Superpause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		p2defmul: 1;
		unhittable: 1;
		anim: ifelse(map(cfg_superfx), -1, 100);
		pos: ceil(-4 * const(size.xscale)), ceil(-42 * const(size.yscale));
		sound: s0, 8500;
		darken: !map(cfg_superfx);
	}
}

# NHB
if animElemTime(6) < -1 {
	notHitBy{time: 1; value: SCA}
}

if animElem = 6 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Bomb
	helper{
		helpertype: normal; # projectile?
		stateno: 3004;
		id: 3005;
		name: "Bomb";
		posType: p1;
		pos: ceil(88 * const(size.xscale)), -90;
		ownpal: 1;
	}
}

if animElem = 5 {
	# Sound
	playSnd{value: 4, 0; channel: 0}
	# spinsnd
	playSnd{value: 1, 6; stopongethit: 1}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

