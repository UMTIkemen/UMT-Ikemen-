&& !selfanimexist(7689) {
	changeAnim{value: 5012}
}

# Anim
if !time
&& selfanimexist(7689) {
	changeAnim{value: 7689}
}

# Anim
if hitshakeover
&& anim = 5012 {
	changeAnim{value: 5100}
}

# Anim
if !animTime
&& anim = 5100 {
	changeAnim{value: 5110}
}

# Wait for balls
if time < 30 {
	notHitBy{value: SCA; time: 1}
}

# No Clsn2
if anim = 7689
&& time >= 30
&& animElemvar(numclsn2) = 0 {
	changeAnim{value: 5110}
}

# Scale
if anim != 7689
&& time < 10 {
	angleDraw{scale: 1, 1 - 0.05 * time}
}

# Scale
if anim != 7689
&& time = [10, 50] {
	angleDraw{scale: 1, 0.5}
}

# Scale
if anim != 7689
&& time = [50, 60] {
	angleDraw{scale: 1, 0.5 - 0.05 * (time - 50)}
}

# No FX
varSet{sysv: 0; value: 1}

# End
if hitshakeover
&& time >= 60 {
	selfState{value: 5110}
}

