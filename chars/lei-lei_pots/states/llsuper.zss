#----- Target burned -----

#============================================================
# State 7697
#============================================================
[StateDef 7697;
	type: A;
	physics: N;
	moveType: H;
	velSet: 0, 0;
]

# Anim
if !time
&& selfanimexist(7697) {
	changeAnim{value: 7697}
}

# End
if !time
&& !selfanimexist(7697) {
	selfState{value: 5030}
}

# Accel
veladd{y: max(0.35, getHitVar(yaccel))}

# Vel
if !time {
	hitvelSet{x: 1; y: 1}
}

# End
if vel y > 0
&& pos y >= 25 {
	selfState{value: 5100}
}

