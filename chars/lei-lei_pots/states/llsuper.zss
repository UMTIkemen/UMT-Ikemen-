#----- Target Squished -----

#============================================================
# State 3490
#============================================================
[StateDef 3490;
	type: L;
	physics: N;
	moveType: H;
	velSet: 0, 0;
]

# Hitfall
hitfallset{value: 1}
# Pos
posSet{y: 0}

