#----- TARGET -----

#============================================================
# State 3505
#============================================================
[StateDef 3505;
	type: S;
	physics: N;
	moveType: H;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 2;
]

# Anim
if !time {
	changeAnim2{value: 3505}
}

# Safety
if time >= 180 {
	selfState{value: 5040}
}

#============================================================
# State 3506
#============================================================

[StateDef 3506;
	type: A;
	physics: N;
	moveType: H;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 0;
]

# NHB
notHitBy{value: SCA; time: 1}
# Push
playerPush{value: 0}
# Bound
screenBound{value: 0; movecamera: 0, 0}

# Anim
if !time
&& !selfanimexist(7689) {
	changeAnim2{value: 3506}
}

# Anim
if time <= 19 && selfanimexist(7689) {
	changeAnim{value: 7689; elem: 1}
}

# Anim
if (time = [20, 23]) && selfanimexist(7689) {
	changeAnim{value: 7689; elem: 2}
}

# Anim
if time >= 24 {
	changeAnim2{value: 3506; elem: 3}
}

# Fade
if time >= 24
&& !selfanimexist(7688) {
	palFx{add: -255, -255, -255; time: 2}
}

# Safety
if time >= 180 {
	selfState{value: 5040}
}

#============================================================
# State 3507
#============================================================

[StateDef 3507;
	type: A;
	physics: N;
	moveType: H;
	velSet: 12, 0;
	ctrl: 0;
	sprPriority: 3;
]

# Bound
screenBound{value: 0; movecamera: 0, 0}
# Pos
posSet{y: 0}

# Anim
if !selfanimexist(7688) {
	changeAnim2{value: 3507}
}

# Anim
if selfanimexist(7688) {
	changeAnim{value: 7688; elem: 1}
}

# End
if time >= 180
&& frontedgedist <= 0 {
	changeState{value: 3508}
}

# Fade
if !selfanimexist(7688) {
	palFx{add: -255, -255, -255; time: 2}
}

#============================================================
# State 3508
#============================================================

[StateDef 3508;
	type: A;
	physics: N;
	moveType: H;
	velSet: 0, 0;
]

# Bound
screenBound{value: 0; movecamera: 0, 0}

if !time {
	# NHB
	notHitBy{value: SCA; time: 6}
	# Anim
	changeAnim{value: ifelse(selfanimexist(5052), 5052, 5030)}
}

# Anim
if anim = 5052
&& selfanimexist(5062)
&& vel y >= const240p(2) {
	changeAnim{value: 5062}
}

# Anim
if !animTime
&& (anim = 5030 && selfanimexist(5035)) {
	changeAnim{value: 5035}
}

# Anim
if !animTime {
	if (anim = 5030 && !selfanimexist(5035))
	|| anim = 5035 {
		changeAnim{value: 5050}
	}
}

# Fade
if !time
&& !selfanimexist(7688) {
	palFx{add: -255, -255, -255; sinadd: 255, 255, 255, 80; time: 20}
}

# Accel
veladd{
	y: 0.4850; # yaccel
}

if !time {
	# Vel
	velSet{x: -4; y: -11}
	# Track Nearest Player
	velSet{x: ((p2, pos x - pos x) * facing + 60) / 46.0}
}

# Track Exact Player
if !time
&& getHitVar(playerno)
&& playerIDexist(player(getHitVar(playerno)), ID) {
	velSet{x: ((player(getHitVar(playerno)), pos x - pos x) * facing + 60) / 46.0}
}

# End
if vel y > 0
&& pos y > -vel y {
	selfState{value: 5100}
}
