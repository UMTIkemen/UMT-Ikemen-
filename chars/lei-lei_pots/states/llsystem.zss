#========================<GUARD>========================

#----- START -----
#============================================================
# State 120
#============================================================
[StateDef 120;
	type: U;
	physics: U;
]

# Do or do not
assertSpecial{flag: nostandguard; flag2: nocrouchguard; flag3: noairguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Type
if !time
&& stateType = S {
	stateTypeSet{physics: S}
}

# Type
if !time
&& stateType = C {
	stateTypeSet{physics: C}
}

# Type
if !time
&& stateType = A {
	stateTypeSet{physics: A}
}

# Vel
if !time
&& stateType != A {
	velSet{x: 0; y: 0}
}

# High to Low
if stateType = S {
	if (!AIlevel
	&& command = "holddown")
	|| (AIlevel
	&& !map(ai_blockhigh)) {
		stateTypeSet{stateType: C; physics: C}
	}
}

# Low to High
if stateType = C {
	if (!AIlevel
	&& command != "holddown")
	|| (AIlevel
	&& map(ai_blockhigh)) {
		stateTypeSet{stateType: S; physics: S}
	}
}

# Anim
if !time {
	changeAnim{value: 120 + (stateType = C) + (stateType = A) * 2}
}

# End
if !animTime {
	changeState{value: 130 + (stateType = C) + (stateType = A) * 2}
}

# Stop Guarding
if stateType != A {
	if (!inguarddist
	&& !numHelper(3005))
	|| (!AIlevel
	&& p2dist x >= 0
	&& (command != "holdback" || command = "holdfwd"))
	|| (!AIlevel
	&& p2dist x < 0
	&& (command != "holdfwd" || command = "holdback"))
	|| ((AIlevel && numEnemy)
	&& p2, hitdefattr = SCA, AT) {
		changeState{value: 140}
	}
}

# No Walking
if ctrl {
	if (p2dist x >= 0
	&& command != "holdfwd")
	|| (p2dist x < 0
	&& command != "holdback") {
		assertSpecial{flag: nowalk}
	}
}

#----- STAND GUARD (Guarding) -----

#============================================================
# State 130
#============================================================
[StateDef 130;
	type: S;
	physics: S;
	velSet: ifelse(prevStateNo = 132 && abs(vel x) < 5, 0, vel x), 0;
]

# Do or do not
assertSpecial{flag: nostandguard; flag2: nocrouchguard}

# AI Tranquilizer
if AIlevel {
	assertSpecial{flag: nohardcodedkeys}
}

# Anim
if anim != 130 {
	changeAnim{value: 130}
}

# AI fix
if AIlevel
&& numEnemy
&& (time >= 120 || p2, time >= 60)
&& random < 17 {
	changeState{value: 40}
}

if !time
&& (prevStateNo = 132 || (prevStateNo = [154, 155])) {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
