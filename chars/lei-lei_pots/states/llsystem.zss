#==========<POWER CHARGE>==========

#============================================================
# State 740
#============================================================
[StateDef 740;
	type: S;
	physics: S;
	moveType: I;
	anim: 740;
	ctrl: 0;
	velSet: 0, 0;
]

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "cmd_erase_completed"; value: 1}
}

# Power
powerAdd{value: 5 + ifelse(time < 60, 0, (time - 60) / 12)}
powerAdd{value: 2 + ifelse(time < 60, 0, (time - 60) / 12)}

# Sound
if time = 8 {
	playSnd{value: 3, 10; channel: 0}
}

# Flash
palFx{time: 1; add: 75 + ceil(sin(time / 6.0 * pi) * 75), 25 + ceil(sin(time / 6.0 * pi) * 25), 0}

# FX
if !numHelper(7240) {
	helper{
		helpertype: normal;
		stateno: 7240;
		id: 7240;
		name: "Power Charge";
		posType: p1;
		pausemovetime: 65535;
		supermovetime: 65535;
		ownpal: 1;
	}
}

# FX
if !numHelper(7241) {
	helper{
		helpertype: normal;
		stateno: 7241;
		id: 7241;
		name: "Particles";
		posType: p1;
		pausemovetime: 65535;
		supermovetime: 65535;
		ownpal: 1;
	}
}

# End
if time >= 24 {
	if (power >= const(data.power) || power >= powerMax || roundState != 2)
	|| (!AIlevel
	&& (command != "/b" || command != "/y"))
	|| (AIlevel
	&& (inguarddist || p2BodyDist x <= 120))
	|| (AIlevel
	&& p2moveType = A
	&& (p2stateno = [3000, 4999] || (p2, vel x * p2, facing * facing) < -1)) {
		changeState{value: 741}
	}
}

#----- END -----

#============================================================
# State 741
#============================================================
[StateDef 741;
	type: S;
	physics: S;
	moveType: I;
	anim: 741;
	velSet: 0, 0;
	ctrl: 0;
]

# Sound
if !time {
	stopsnd{channel: 0}
}

# Sound
if !time
&& power >= const(data.power) {
	playSnd{value: 4, 1; channel: 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#==========<GUARD CANCEL>==========

#============================================================
# State 750
#============================================================
[StateDef 750;
	type: S;
	physics: S;
	moveType: I;
	anim: 750;
	ctrl: 0;
	velSet: 0, 0;
	powerAdd: -1000;
	sprPriority: 2;
	facep2: 1;
]

# Strength
ignoreHitPause if !time
&& !AIlevel {
	mapSet{
		map: "strength";
		value: ifelse((command = "counter_a" + command = "counter_b" + command = "counter_c") >= 2, 1, 0);
	}
}

# Strength AI
ignoreHitPause if !time
&& AIlevel {
	mapSet{
		map: "strength";
		value: ifelse((p2stateType = A), 0, ifelse((p2stateType = C), 1, ifelse(random < 500, 0, 1)));
	}
}

if !time {
	# Sound
	playSnd{value: 3, 0; channel: 0}
	# Flash
	palFx{add: 255, 255, 255; time: 5}
}

# Super Pause FX
persistent(0) if !time {
	helper{
		helpertype: normal;
		stateno: 7250;
		id: 7250;
		posType: p1;
		pos: ceil(46 * const(size.xscale)), -46;
		ownpal: 1;
		supermovetime: 999;
	}
}

if !time {
	# Super Pause
	superpause{
		time: 10;
		movetime: 10;
		anim: -1;
		sound: s7, 1;
		p2defmul: 1;
		darken: 0;
	}
	# Guard Points
	guardpointsadd{value: -min((guardpoints - 1), 300)}
}

# End
if time >= 15 {
	changeState{value: ifelse(map(strength) = 1, 2910, 2900)}
}

