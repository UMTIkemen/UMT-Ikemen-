#==============================================================================================
#=======================================<COMMON STATES>========================================
#==============================================================================================

#====================<STANDING>====================

#============================================================
# State 0
#============================================================
[StateDef 0;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
	juggle: 0;
]

# Gone
if isHelper {
	destroySelf{removeexplods: 1}
}

# Anim
if (anim != 0 && anim != 5)
|| (anim = 5 && !animTime) {
	changeAnim{value: 0}
}

# Dark Force
if map(darkforce) {
	changeState{value: 4000}
}

# Dead
if !alive {
	selfState{value: 5050; ctrl: 0}
}

# Not Myself
if inCustomState
&& time > 0 {
	selfState{value: 5040}
}

#====================<CROUCHING>====================

#============================================================
# State 10
#============================================================
[StateDef 10;
	type: C;
	physics: C;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time
&& anim = 12 {
	changeAnim{value: 10; elem: ifelse(animElemTime(3) >= 0, 1, 4 - animElemno(0))}
}

# Anim
if !time
&& anim = 47 {
	changeAnim{value: 10; elem: 2}
}

# Anim
if anim != 10 {
	changeAnim{value: 10}
}

# End
if !animTime {
	selfState{value: 11}
}

#============================================================
# State 11
#============================================================

[StateDef 11;
	type: C;
	physics: C;
	moveType: I;
	anim: 11;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if anim = 6
&& !animTime {
	changeAnim{value: 11}
}

#============================================================
# State 12
#============================================================

[StateDef 12;
	type: S;
	physics: S;
	moveType: I;
	velSet: 0, 0;
	sprPriority: 0;
]

# Anim
if !time
&& anim = 10 {
	changeAnim{value: 12; elem: 4 - animElemno(0)}
}

# Anim
if anim != 12 {
	changeAnim{value: 12}
}

# End
if !animTime {
	selfState{value: 0}
}

#====================<WALKING>====================

#============================================================
# State 20
#============================================================
[StateDef 20;
	type: S;
	physics: S;
	moveType: I;
	sprPriority: 0;
]

# Vel
if command = "holdfwd"
&& ifelse(anim = 20, animElemTime(7) < 0, 1) {
	velSet{x: const(velocity.walk.fwd.x)}
}

# Vel
if command = "holdback" {
	velSet{x: const(velocity.walk.back.x)}
}

# Anim
if vel x > 0 {
	if (anim != 5 && anim != 12 && anim != 20)
	|| (anim = 5 && !animTime)
	|| (anim = 12 && !animTime) {
		changeAnim{value: 20}
	}
}

# Anim
if vel x < 0 {
	if (anim != 5 && anim != 21)
	|| (anim = 5 && !animTime) {
		changeAnim{value: 21}
	}
}

#===================<JUMPING>================

#----- JUMP START -----
#============================================================
# State 40
#============================================================
[StateDef 40;
	type: S;
	physics: S;
	moveType: I;
	anim: 40;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 1;
	facep2: (prevStateNo != 100);
]

# Keyboard Check
# Currently Obsolete in Ikemen
if !time
&& !AIlevel
&& prevStateNo = 52
&& (command = "holddown" && command = "holdup") {
	changeState{value: 10; ctrl: 1}
}

# Direction
if !time {
	varSet{sysv: 1; value: 0}
}

# Direction
persistent(0) if !AIlevel
&& time >= 1
&& (command = "holdfwd" || command = "holdback") {
	varSet{sysv: 1; value: (command = "holdfwd") - (command = "holdback")}
}

# Direction
if AIlevel {
	varSet{
		sysv: 1;
		value: ifelse(p2BodyDist x < 30, 0, ifelse((life - p2life) > 200 && p2moveType != H && random < 333, -1, 1));
	}
}

# High Jump
if !time {
	mapSet{map: "jumptype"; value: 0}
}

# High Jump
if !time
&& !AIlevel
&& map(cmd_highjump) {
	mapSet{map: "jumptype"; value: 3}
}

# High Jump
if !time
&& AIlevel
&& (p2BodyDist x > 80 && p2stateType != L)
&& random < 333 {
	mapSet{map: "jumptype"; value: 3}
}

# Running Jump
if prevStateNo = 100 {
	mapSet{map: "jumptype"; value: 3}
	varSet{sysv: 1; value: 1}
}

if !animTime {
	# Sound
	playSnd{value: 0, ifelse(map(jumptype) = [2, 3], 41, 40)}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7100;
		id: 7100;
		name: "Jump Dust";
		posType: p1;
		ownpal: 1;
	}
	# Vel Normal
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)));
		y: const(velocity.jump.y);
	}
}

# Vel Long
if !animTime && map(jumptype) = 3 {
	velSet{
		x: ifelse(!sysvar(1), const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)));
		y: ifelse(!sysvar(1), const(velocity.runjump.y), const(velocity.jump.y));
	}
}

# End
if !animTime {
	selfState{value: 50; ctrl: 1}
}

#----- JUMP UP -----

#============================================================
# State 50
#============================================================
[StateDef 50;
	type: A;
	physics: N;
	moveType: I;
	sprPriority: 1;
]

# Anim
if !time {
	changeAnim{value: ifelse(!vel x, 41, ifelse((vel x) > 0, 42, 43))}
}

# Grounded Frame
if time < 1 && prevStateNo = 40 {
	posfreeze{value: 1}
}

# Accel
if time >= 1 || prevStateNo != 40 {
	gravity{}
}

# Land
if vel y > 0
&& pos y > -vel y {
	selfState{value: 52}
}

#----- JUMP FALL -----

#============================================================
# State 51
#============================================================
[StateDef 51;
	type: A;
	physics: N;
	moveType: I;
	sprPriority: 1;
]

# Accel
gravity{}

# Land
if vel y > 0
&& pos y > -vel y {
	selfState{value: 52}
}

#----- JUMP LAND -----

#============================================================
# State 52
#============================================================
[StateDef 52;
	type: S;
	physics: S;
	moveType: I;
	anim: 47;
	ctrl: 1; # State -1 only sees this in the next frame
	velSet: 0, 0;
	sprPriority: 1;
]

# Pos
posSet{y: 0}

# Disable Trip Guard
if !time
&& (prevStateNo != [5000, 5999] && prevmoveType != H)
&& (prevStateNo != 50 && prevStateNo != 51 && prevStateNo != [120, 155]) {
	assertSpecial{flag: nostandguard; flag2: nocrouchguard; flag3: noairguard}
}

# Trip Guard
if !time
&& ctrl
&& inguarddist
&& isAsserted(nostandguard) = 0
&& isAsserted(nocrouchguard) = 0 {
	if (!AIlevel
	&& command = "holdback")
	|| (AIlevel
	&& random < (1000 * (AIlevelF / 8.0))) {
		changeState{value: 120}
	}
}

# No Walk
if animTime
&& anim != 5 {
	assertSpecial{flag: nowalk}
}

if !time {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -5;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Remove Pursuit FX
if numexplod(1905) {
	removeexplod{id: 1905}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<FORWARD DASH>==========================

#============================================================
# State 100
#============================================================
[StateDef 100;
	type: S;
	physics: N;
	anim: 100;
	ctrl: 0;
	sprPriority: 1;
]

# Sound
persistent(0) if !time {
	playSnd{value: 0, 100}
}

# Dust
if !time {
	helper{
		helpertype: normal;
		stateno: 7104;
		id: 8100;
		name: "Dash Dust";
		posType: p1;
		pos: ceil(-15 * const(size.xscale)), 0;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
}

# Vel
if animElemTime(7) < 0 || animElemTime(16) >= 0 {
	velSet{x: 0}
}

# Vel
if vel x {
	velmul{x: 0.8}
}

# Vel
if animElemTime(7) >= 0 && animElemTime(10) < 0 {
	velSet{x: const(velocity.run.fwd.x)}
}

# Fadeout
if animElem = 7 {
	explod{
		anim: 103;
		id: 103;
		sprPriority: 1;
		posType: p1;
		removeongethit: 1;
		scale: const(size.xscale), const(size.yscale);
		ownpal: 0;
	}
}

if animElemTime(7) >= 0 && animElemTime(8) < 0 {
	# NHB
	notHitBy{value: SCA; time: 1}
	# Push
	playerPush{value: 0}
}

# Cloud
if animElemTime(7) = 5 || animElemTime(7) = 13 {
	explod{
		anim: 7107;
		id: 7107;
		sprPriority: -2;
		posType: p1;
		scale: 0.5, 0.5;
		ownpal: 1;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Sound
if animElem = 17 {
	playSnd{value: 0, ifelse((time % 72) < 36, 103, 106)}
}

# End
if !animTime {
	if frontedgedist <= 0
	|| (!AIlevel
	&& (command != "holdfwd" || command = "holdback"))
	|| (AIlevel
	&& p2BodyDist x <= 90) {
		changeState{value: 0; ctrl: 1}
	}
}

#========================<BACK DASH>==========================

#============================================================
# State 105
#============================================================
[StateDef 105;
	type: A;
	physics: N;
	moveType: I;
	velSet: 0, 0;
	anim: 105;
	ctrl: 0;
	sprPriority: 1;
]

if animElem = 2 {
	# Sound
	playSnd{value: 0, 105}
	# Dust
	helper{
		helpertype: normal;
		stateno: 7104;
		id: 8100;
		name: "Dash Dust";
		posType: p1;
		facing: -1;
		pausemovetime: 255;
		supermovetime: 255;
		ownpal: 1;
	}
	# Vel
	velSet{x: const(velocity.run.back.x)}
}

# End
if !animTime {
	changeState{value: 106}
}

#----- LAND -----

#============================================================
# State 106
#============================================================
[StateDef 106;
	type: S;
	physics: S;
	ctrl: 0;
	anim: 106;
	velSet: 0, 0;
]

# Vel
velSet{x: 0; y: 0}
# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 106}
	# Dust
	explod{
		anim: 7102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# Ctrl
if time >= 2 {
	ctrlset{value: 1}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#========================<AIR DASH>==========================

#============================================================
# State 110
#============================================================
[StateDef 110;
	type: A;
	anim: 110;
	physics: N;
	ctrl: 1;
	sprPriority: 1;
]

# Turn
if !time {
	if (!AIlevel
	&& command = "holdback")
	|| (AIlevel
	&& p2, ctrl
	&& random < 200) {
		turn{}
	}
}

# Assert
assertSpecial{flag: noairguard}
# Gravity
gravity{}

# Vel
if animElemTime(10) < 0 {
	velSet{x: 5.125; y: 0}
}

if animElem = 2 || animElem = 6 {
	# Sound
	playSnd{value: 0, 110; freqmul: 0.8 + (random / 2500.0)}
	# Cloud
	explod{
		anim: 7107;
		id: 7107;
		sprPriority: 0;
		posType: p1;
		pos: ceil(ifelse((animElem = 2 || animElem = 10), 15, 11) * const(size.xscale)), ifelse((animElem = 2 || animElem = 10), -24, -18);
		scale: 0.5 * const(size.xscale), 0.5;
		ownpal: 1;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Stop
if animElemTime(12) < 0 && time >= 8 && command = "holdback" {
	changeAnim{value: 110; elem: 12}
}

# Land
if vel y > 0
&& pos y > -vel y {
	changeState{value: 52}
}

