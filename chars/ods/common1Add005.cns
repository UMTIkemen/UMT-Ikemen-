; Low Jump > Leap Attack ; 低ジャンプ → リープアタック
; Jump start
;------------------------
[statedef 48]
type=s
physics=s
anim=40
sprpriority=1
velset=0,0
ctrl=0

[state 0]
	type=velset
	trigger1=animtime=0
	x=ifelse(command="holdfwd",2,ifelse(command="holdback",-2,0))
	y=-const(movement.yaccel)*12.5
	;;(1): const(movement.yaccel)/0.50*6.24
	;;(2): const(velocity.runjump.y)/1.25
; ai_vel
[state 0]
	type=velset
;v1.0;	trigger1=animtime=0 && (p2bodydist x>36) && ailevel>0
	trigger1=animtime=0 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>1 && (p2bodydist x>36)
	x=2
[state 0]
	type=ctrlset
	trigger1=vel y>1.82
	value=1
[state 0]
	type=changestate
	trigger1=animtime=0
	value=58
	ctrl=0

