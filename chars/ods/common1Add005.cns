[state 0]
	type=helper
	trigger1=!time && numhelper(88892) && !numhelper(403000)
	id=403000
	stateno=190140
	ownpal=1
	size.height=ifelse(life<200,3,(random%3))
	ignorehitpause=1
;---
[state 0]
	type=varset
	trigger1=!time
	sysfvar(1)=0
[state 0]
	type=varset
	triggerall=time && alive && roundstate=2 && !numhelper(403000) ;; dizzy
;com1;	trigger1=command="recovery"||command="holdback"||command="holddown"
	trigger1=command="x"||command="y"||command="a"||command="b"||command="holdback"||command="holddown"
;v1.0;	trigger2=ailevel>0
	trigger2=sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger2=(playerid(floor(sysfvar(0))),var(0)=90900) && (playerid(floor(sysfvar(0))),var(51)>0)
	trigger2=random<90
	sysfvar(1)=10
;---
[state 0]
	type=changestate
	trigger1=time && roundstate=2 && sysfvar(1)=10
	trigger1=(vel y>0) && (pos y>=0) ;; (pos y+vel y>=0)
	value=5201
;---
; hit ground ;/ edited
[state 0]
	type=changestate
	trigger1=(vel y>0) && (pos y>=const(movement.air.gethit.trip.groundlevel))
	;---
	trigger2=(const(movement.air.gethit.trip.groundlevel)=0) ;;[ def=0 ?? ]
	trigger2=(vel y>0) && (pos y>=0) ;; (pos y+vel y>=0)
	value=5100 ;;<-5101

