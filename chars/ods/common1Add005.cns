	var(8)=var(8)|524288
;;---
[state 0] ; off
	type=varset
	trigger1=(var(8)&1048576)&&(root,command!="z")
	var(8)=var(8)^1048576
[state 0] ; on
	type=varset
	trigger1=(root,command="z")&&!(var(8)&1048576)
	var(8)=var(8)|1048576
;;---
[state 0] ; off
	type=varset
	trigger1=(var(8)&2097152)&&(root,command!="a")
	var(8)=var(8)^2097152
[state 0] ; on
	type=varset
