[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && inguarddist
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/10000)%10
	value=120
	ctrl=0
; Roll ; 避
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4) && (sysvar(4)!=[2,3])
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/100000)%10=1
	value=110
; Jump ; 跳
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[4,7])
	value=ifelse(sysvar(4)=2 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[6,7]), 48, 142000 +(((playerid(floor(sysfvar(0))),var(18)/100000)%10)-4)*10 +((playerid(floor(sysfvar(0))),var(18)/1000000)%10) )
;---

;------------------------
; Crouch to Stand
[statedef 12]
type=s
physics=s
anim=12

[state 0]
	type=changestate
	trigger1=animtime=0
	value=0

;------------------------
;------------------------
; Walk
[statedef 20]
type=s
physics=s
sprpriority=0
;; movetype=i
;---
;---
[state 0]
	type=selfstate
	trigger1=!time && roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0
	value=21
;---
;---
[state 0]
	type=velset
	trigger1=command="holdfwd"
	x=const(velocity.walk.fwd.x)
[state 0]
	type=velset
	trigger1=command="holdback"
	x=const(velocity.walk.back.x)
[state 0]
	type=changeanim
	trigger1=vel x>0
	trigger1=(anim!=20 && anim!=5) || (anim=5 && animtime=0)
	value=20
[state 0]
	type=changeanim
	trigger1=vel x<0
	trigger1=(anim!=21 && anim!=5) || (anim=5 && animtime=0)
	value=21
;------------------------
;---
; Walk_ai
[statedef 21]
type=s
physics=s
sprpriority=0
;---
[state 0]
	type=assertspecial
	trigger1=1
	flag=nowalk
	flag2=noautoturn
;---
[state 0] ; ai_vel_fwd (def)
	type=velset
	trigger1=1
	x=const(velocity.walk.fwd.x)
[state 0] ; ai_vel_back
	type=velset
	triggerall=sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && numenemy
	triggerall=playerid(floor(sysfvar(0))),var(0)=90900 && enemynear,stateno!=190116 ;; dizzy
	trigger1=enemynear,movetype=a || (gametime+id*100)%200<100
	x=const(velocity.walk.back.x)
;---
; Guard ; 防
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && inguarddist
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/10000)%10
	value=120
	ctrl=0
; Roll ; 避
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4) && (sysvar(4)!=[2,3])
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/100000)%10=1
	value=110
; Jump ; 跳
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[4,7])
	value=ifelse(sysvar(4)=2 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[6,7]), 48, 142000 +(((playerid(floor(sysfvar(0))),var(18)/100000)%10)-4)*10 +((playerid(floor(sysfvar(0))),var(18)/1000000)%10) )
; Run ; 走
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysvar(2)>1 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && numenemy
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (p2bodydist x!=[-100,100]) && (playerid(floor(sysfvar(0))),var(19)/1000)%1000=0
	trigger1=random<p2bodydist x/2 || (enemynear,movetype!=a && random<80) || enemynear,stateno=190116 ;; dizzy
	value=100
; Back_Step ; 退
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysvar(2)>1 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && numenemy
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (p2bodydist x=[-80,80]) && enemynear,stateno!=190116 && random<80
	value=105
;---
[state 0]
	type=changestate
	triggerall=command!="holdfwd" && command!="holdback"
	trigger1=(facing=1 && pos x>enemynear,pos x) || (facing=-1 && pos x<enemynear,pos x) ;; turn
	trigger2=(time>18 && (frontedgebodydist<0 || backedgebodydist<0)) || time>120 || roundstate!=2 || command="holddown" || command="holdup"
	trigger3=time>6 && (p2bodydist x=[-32,32]) && random<150
	value=0
	ctrl=1
;---
[state 0]
	type=changeanim
	trigger1=vel x>0
	trigger1=(anim!=20 && anim!=5) || (anim=5 && animtime=0)
	value=20
[state 0]
	type=changeanim
	trigger1=vel x<0
	trigger1=(anim!=21 && anim!=5) || (anim=5 && animtime=0)
	value=21

;------------------------
; Jump start
; sv(1): 0:normal / 1:long / 2:small / 3:middle
;------------------------
[statedef 40]
type=u
physics=u

;---
[state 0]
	type=changestate
	trigger1=!time && roundstate=2 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4)
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0
	value= 0 ;; ifelse(prevstateno!=stateno,prevstateno,10) ;; cancel
;---

[state 0]
	type=changeanim
	trigger1=!time
	value=40
[state 0]
	type=sprpriority
	trigger1=!time
	value=1
[state 0]
	type=ctrlset
	trigger1=!time
	value=0
[state 0]
	type=velset
	trigger1=!time
	x=0
	y=0
[state 0]
	type=statetypeset
	trigger1=!time
	statetype=s
	physics=s
; direction ; 方向
[state 0]
	type=varset
	trigger1=!time
	sysvar(1)=ifelse(command="holdfwd"||prevstateno=100,1,ifelse(command="holdback",-1,0))
;---
; jump type ; ジャンプ種類
; normal (=0 def)
[state 0]
	type=varset
	trigger1=!time
	sysfvar(1)=0
; long jump (=1)
[state 0]
	type=varset
	triggerall=!time
	trigger1=prevstateno=100
	trigger2=sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger2=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(44)>0
	sysfvar(1)=1
; small jump (=2)
[state 0]
	type=varset
	trigger1=command!="holdup" && sysfvar(1)=0 && sysvar(4)!=2
	sysfvar(1)=2
; mid hump (=3)
[state 0]
	type=varset
	trigger1=command!="holdup" && sysfvar(1)=1 && sysvar(4)!=2
	sysfvar(1)=3
;---
; vel x - normal / small
[state 0]
	type=velset
	trigger1=animtime=0 && (sysfvar(1)=0 || sysfvar(1)=2)
	x=ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
; vel x - mid / long
[state 0]
	type=velset
	trigger1=animtime=0 && (sysfvar(1)=1 || sysfvar(1)=3)
	x=ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.runjump.fwd.x),const(velocity.runjump.back.x)))
;---
; vel y - normal
[state 0]
	type=velset
	trigger1=animtime=0
	y=const(velocity.jump.y)
; vel y - long
[state 0]
	type=velset
	trigger1=animtime=0 && sysfvar(1)=1
	y=const(velocity.runjump.y)
; vel y - small / mid
[state 0]
	type=velset
	trigger1=animtime=0 && sysfvar(1)>=2
	y=-const(movement.yaccel)*13.32
	;; const(movement.yaccel)/0.50*6.66
	;; const(velocity.runjump.y)/1.41
[state 0]
	type=changestate
	trigger1=animtime=0
	value=50
	ctrl=1

;------------------------
; AirJump start
[statedef 45]
type=a
physics=n
velset=0,0
ctrl=0

[state 0]
	type=changeanim
	trigger1=selfanimexist(44)
	value=44
[state 0]
	type=changeanim
	trigger1=!selfanimexist(44)
	value=41
[state 0]
	type=varset
	trigger1=!time
	sysvar(1)=0
[state 0]
	type=varset
	trigger1=command="holdfwd"
	sysvar(1)=1
[state 0]
	type=varset
	trigger1=command="holdback"
	sysvar(1)=-1
[state 0]
	type=velset
	trigger1=time=2
	x=ifelse(sysvar(1)=0,const(velocity.airjump.neu.x),ifelse(sysvar(1)=1,const(velocity.airjump.fwd.x),const(velocity.airjump.back.x)))
	y=const(velocity.airjump.y)
[state 0]
	type=changestate
	trigger1=time=2
	value=50
	ctrl=1

;------------------------
; Jump up
[statedef 50]
type=a
physics=a
;movetype=i

[state 0]
	type=playsnd
	trigger1=!time && (prevstateno!=40)
	value=f50,0
	channel=1
;---
[state 0]
	type=changeanim
	trigger1=!time && (sysfvar(1)<2) ;;<-n,l jump
	value=ifelse((vel x)=0,41,ifelse((vel x)>0,42,43))
[state 0]
	type=changeanim
	trigger1=!time && (sysfvar(1)>=2) ;;<-m,s jump
	value=41
[state 0]
	type=changeanim
	trigger1=(vel y>-2) && selfanimexist(anim+3)
	value=anim+3
	persistent=0
;---
; Guard ; 防御
[state 0]
	type=changestate
	trigger1=sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4) && (sysvar(4)!=[2,3])
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/10000)%10
	value=120
	ctrl=0
;---

;------------------------
; Jump Down (empty state for compatibility)
[statedef 51]
type=a
physics=a

[state 0]
	type=null
	trigger1=1

;------------------------
; Jump Land
[statedef 52]
type=s
physics=s
anim=47
velset=0,0
ctrl=0
[state 0]
	type=posset
	trigger1=!time
	y=0
[state 0]
	type=changestate
	trigger1=animtime=0
	value=0
	ctrl=1

;------------------------
; Jump Up
[statedef 58]
type=a
physics=a
anim=41

[state 0]
	type=playsnd
	trigger1=!time
	value=f50,0
[state 0]
	type=changeanim
	trigger1=(vel y>-2) && selfanimexist(anim+3)
	value=anim+3
	persistent=0

;------------------------
; Run Fwd
[statedef 100]
type=s
movetype=i
physics=s
sprpriority=1

;---
; Guard ; 防
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>2 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && inguarddist
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/10000)%10
	value=120
	ctrl=0
; Roll ; 避
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4) && (sysvar(4)!=[2,3])
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/100000)%10=1
	value=110
; Jump ; 跳
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[4,7])
	value=ifelse(sysvar(4)=2 || ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[1,2]), 142011, 142031)
;---
;---
[state 0]
	type=changeanim
	trigger1=!time && (anim!=100)
	value=100

; step sound ; 足音
[state 0]
	type=playsnd
	trigger1=(time%12=6) && const(velocity.run.fwd.y)=0 ;;<-edited
	value=f100,0
	channel=1
[state 0]
	type=playsnd
	trigger1=time=1 && const(velocity.run.fwd.y) ;;<-edited
	value=f50,0
	channel=1

; dash_dust
[state 0]
	type=helper
	trigger1=time=1 && pos y=0 && vel x=0 && !numhelper(152040)
	id=152040
	stateno=152040
	ownpal=1
	pos=floor(8*const(size.xscale)),floor(-pos y)
	size.xscale=0.35
	size.yscale=0.35
	persistent=0

[state 0]
	type=velset
	trigger1=time>=2 || prevstateno=40
	x=const(velocity.run.fwd.x)

[state 0]
	type=assertspecial
	trigger1=1
	flag=nowalk
	flag2=noautoturn

[state 0]
	type=changestate
	triggerall=time>16
	trigger1=roundstate!=2
	;---
;v1.0;	trigger2=ailevel && ((p2bodydist x=[-42,42]) || random>p2bodydist x*8 || frontedgebodydist<0 || time>60)
	trigger2=sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger2=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0 && ((p2bodydist x=[-42,42]) || random>p2bodydist x*8 || frontedgebodydist<0 || time>60)
	;---
;v1.0;	trigger3=command!="holdfwd" && !ailevel
	trigger3=command!="holdfwd" && (sysfvar(0)<1 || (sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))=0))
	trigger4=command!="holdfwd" && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger4=playerid(floor(sysfvar(0))),var(0)!=90900 || playerid(floor(sysfvar(0))),var(51)<1
	;---
	value=0

;------------------------
; Run Back / Back Step
[statedef 105]
type=a
physics=s
movetype=i
anim=105
sprpriority=1
velset=0,0
ctrl=0

; dash_dust
[state 0]
	type=helper
	trigger1=(time=2) && (pos y<=0) && (prevstateno!=stateno) && !numhelper(152040)
	id=152040
	stateno=152040
	ownpal=1
	pos=floor(8*const(size.xscale)),floor(-pos y)
	size.xscale=-0.35
	size.yscale= 0.35
	persistent=0

[state 0]
	type=velset
	trigger1=time=2
	x=const(velocity.run.back.x)
	y=const(velocity.run.back.y)

[state 0]
	type=velset
	trigger1=time=2 && const(velocity.run.back.y)>=0
	y=-0.001

[state 0]
	type=statetypeset
	trigger1=time=2
	physics=n

[state 0]
	type=playsnd
	trigger1=time=2
	value=f50,0
	channel=1
[state 0]
	type=veladd
	trigger1=time>2 && vel x<0
	x=0.02

[state 0] ; gravity
	type=veladd
	trigger1=time>2 && const(velocity.run.back.y)<0
	trigger2=time>12 && const(velocity.run.back.y)>=0 && time>const(velocity.run.back.y)
	y=const(movement.yaccel)

[state 0]
	type=changestate
	trigger1=time>2 && (pos y+vel y>=0) && (vel y>0)
	value=52 ;; 106

[state 0] ; edited
	type=nothitby
	trigger1=time<16
	value=sca,na,sa,ha,np,sp,hp

