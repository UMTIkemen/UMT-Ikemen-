;---
; CanGetHit Type:: 0:Normal
[state 0]
	type=hitby
	trigger1=!var(0) && var(12)>1 ;;<- Changable Timer
	value=sca,np,sp,hp
	ignorehitpause=1
; CanGetHit Type:: 1:CanGetHit
[state 0]
	type=hitby
	trigger1=!var(0) && var(12)>1 ;;<- Changable Timer
	trigger1=var(37)=1 ;;CanGetHit
	value=sca,na,sa,ha,np,sp,hp
	ignorehitpause=1
; for Reflection
[state 0]
	type=nothitby
	trigger1=var(19)=1 ;;<- for Reflection
	value=sca
	ignorehitpause=1
;---
[state 0] ; Normal
	type=hitoverride
	trigger1=!var(0) && var(12)>1 ;;<- Changable Timer
	attr=sca,np,sp,hp
	stateno=stateno
	ignorehitpause=1
[state 0] ; CanGetHit
