	type=screenbound
	trigger1=1
	value=0
	movecamera=0,0
[state 0]
	type=playerpush
	trigger1=1
	value=0
[state 0]
	type=assertspecial
	trigger1=1
	flag=invisible
	flag2=noshadow
;---
[state 0]
	type=turn
	trigger1=sysvar(0)>0 && playeridexist(sysvar(0))
	trigger1=facing!=playerid(sysvar(0)),facing
[state 0]
	type=posset
	trigger1=!time && roundstate=2 && sysvar(0)>0 && playeridexist(sysvar(0))
	x= (playerid(sysvar(0)),pos x)-(playerid(sysvar(0)),backedgebodydist+const240p(90))*facing
	y=-const240p(180)
[state 0]
	type=posset
	trigger1=roundstate>2 && sysvar(0)>0 && playeridexist(sysvar(0))
	x= (playerid(sysvar(0)),pos x)-facing*const240p(28)*(id-sysvar(0))
	y=-(playerid(sysvar(0)),screenpos y)-const240p(80) ;;(-280)
[state 0]
	type=velset
	triggerall=sysvar(0)>0 && playeridexist(sysvar(0))
	trigger1=roundstate=2 && !time
	trigger2=roundstate>2 && time>(!win)*100
;;old;	x=abs(pos x-playerid(sysvar(0)),pos x)*0.1*const(movement.yaccel)*(roundstate=2)
;;old;	y=abs(pos y)*0.1*const(movement.yaccel)
	x=abs(pos x-playerid(sysvar(0)),pos x)*0.05*(roundstate=2)
	y=abs(pos y)*0.05
;---
[state 0]
	type=changestate
	trigger1=roundstate=2 && !time
	trigger2=roundstate>2 && time>(!win)*100
	value=ifelse((sysfvar(4)<1), 190194, 190196)
	ctrl=0

