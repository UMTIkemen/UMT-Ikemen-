	var(8)=var(8)^65536
[state 0] ; on
	type=varset
	trigger1=(root,command="holdup")&&!(var(8)&65536)
	var(8)=var(8)|65536
;;---
[state 0] ; off
	type=varset
	trigger1=(var(8)&131072)&&(root,command!="holddown")
	var(8)=var(8)^131072
[state 0] ; on
