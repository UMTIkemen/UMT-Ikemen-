	size.xscale=-ifelse(ishelper(3000),0.65,0.45)
	size.yscale= ifelse(ishelper(3000),0.65,0.45)
	size.ground.front=(root,const(size.ground.front))
	size.ground.back= (root,const(size.ground.back))
	persistent=0
[state 0] ;; eject flag
	type=projectile
	trigger1=!var(32) ;;<-only once
	projid=91005
	projanim=ifelse(selfanimexist(909002),909002,0) ;; anim
	projscale=0,0
	sparkno=-1
	projhitanim=-1
	projremovetime=32;; <- within 32 frames
;---
;---
[state 0] ; counter
	type=varadd
	trigger1=1
	var(32)=1
	ignorehitpause=1
;--- ---
;--- ---

;==========================
;==========================
; proj chaser after Reflecsion [helper]
; 飛び道具反射後追跡用

; 反射後の飛び道具を,発射主がガードできないため
; 防御誘発用ヘルパー(反射後飛び道具に同行)
;==========================
[statedef 91050]
type=a
movetype=a
physics=n
anim=ifelse(selfanimexist(909002),909002,0)
velset=0,0
ctrl=0
[state 0]
	type=assertspecial
	trigger1=1
	flag=invisible
;op;	flag2=noshadow
	ignorehitpause=1
[state 0]
	type=nothitby
	trigger1=1
	value=sca
	ignorehitpause=1
;---
; temp proj alive flag ; プロジェ有無判定用ダミー
[state 0]
	type=projectile
	trigger1=1
	projanim=ifelse(selfanimexist(909002),909002,0) ;; anim
	projscale=0,0
	sparkno=-1
	projhitanim=-1
;@;	projremanim=-1
;@;	projcancelanim=-1
	projremovetime=0 ;1
	ignorehitpause=1
;---
; proj chaser id ; 追跡飛び道具識別番号
[state 0] ; id def
	type=varset
	trigger1=!time
	var(33)=const(size.height)
	ignorehitpause=1
[state 0]
	type=posset
	trigger1=var(33)>0 && playeridexist(var(33))
	x=playerid(var(33)),pos x
	y=playerid(var(33)),pos y-80000+(teamside)*8000 ;;88888
	ignorehitpause=1
[state 0]
	type=destroyself
	trigger1=!playeridexist(var(33)) || roundstate!=2
;op;	trigger2=time>512 ;;<-for_safety
	ignorehitpause=1

