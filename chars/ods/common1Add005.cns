;------------------------
;------------------------
; modify life bar switch (1st bit)
; 描画変動
[state 0] ; off
	type=varset
	trigger1=(var(8)&1)
	trigger1=var(43)=var(41)
	var(8)=var(8)|1
[state 0] ; on
	type=varset
	trigger1=!(var(8)&1)
	trigger1=var(43)!=var(41)
	var(8)=var(8)^1
;---
;;>>@Config.DamageToPower>>
; damage to pow manage
; パワー管理 ; pow type v22 [1,2,3,4]
;---
[state 0]
	type=poweradd
	triggerall=roundstate=2 && var(20)=power && (var(22)=1||var(22)=4) ;; type::1,4 ;normal,tag
	trigger1=var(40)-var(41)>0 ;; get damage
	value=(var(40)-var(41))*ifelse(playerid(var(15)),gethitvar(guarded),3,1)
[state 0]
	type=poweradd
	triggerall=roundstate=2 && var(20)=power && (var(22)=3) ;; type::3 jd
	trigger1=var(40)-var(41)>0 ;; get damage
	trigger2=playerid(var(15)),stateno=150||playerid(var(15)),stateno=152||playerid(var(15)),stateno=154 ;air
	trigger2=playerid(var(15)),time=1 && (var(26)!=playerid(var(15)),time)
	value=floor((var(40)-var(41)+10)*ifelse(playerid(var(15)),gethitvar(guarded),5,1))
;---
; memo life
; ライフ保存
[state 0]
	type=varset
	trigger1=var(40)!=var(41) && roundstate=2
	var(40)=var(41)

; memo damage
; ダメージ保存
[state 0]
	type=varset
	trigger1=!(var(9)&16) && var(42)!=var(41)
	var(42)=var(41)

; modify life for view
; ライフ変化
[state 0]
	type=varadd
	trigger1=var(43)!=var(41) && roundstate=2
	var(43)=(var(41)-var(43))/8+ifelse(var(43)>var(41),-1,1)

;==========================
; guard crush point
; ガード クラッシュ ポイント
;==========================
; v35-36
; recover -> stop ; (回復 -> 停止)
[state 0]
	type=varset
	triggerall=var(35)
	trigger1=!var(36)
	trigger2=var(36) && (playerid(var(15)),movetype=h)
	var(35)=0
; recover -> start normal speed ; (回復 -> 開始 - 通常速度)
[state 0]
	type=varset
	trigger1=var(35)<1 && playeridexist(var(16))
	trigger1=playerid(var(16)),movetype=h
	var(35)=1
; recover -> start normal speed 2 ; (回復 -> 開始 - 通常速度 2)
[state 0]
	type=varset
	triggerall=var(35)<2
	trigger1=playerid(var(15)),stateno=190010 ;; << ガードクラッシュ
	var(35)=2
; guard point consumptiom ; (ガードポイント消耗)
[state 0]
	type=varadd
	triggerall=(var(7)&2) ;; system_switch
	trigger1=(playerid(var(15)),stateno=150)||(playerid(var(15)),stateno=152)||(playerid(var(15)),stateno=154) ;air
	trigger1=(playerid(var(15)),time=1) && (var(26)!=playerid(var(15)),time)
;old;	var(36)=1+(playerid(var(15)),gethitvar(damage)+playerid(var(15)),gethitvar(hitshaketime))/10
	var(36)=1+(playerid(var(15)),gethitvar(damage)+playerid(var(15)),gethitvar(hitshaketime))/ (11-floor((50-var(36))*0.175))
; recover ; (回復)
[state 0]
	type=varadd
	triggerall=var(35) && var(36)>0
	trigger1=var(35)=1 && (gametime%50=0) ;;<-normal speed ;通常速度
	trigger2=var(35)=2 && (gametime%10=0) ;;<-speed2 ;速度2
	var(36)=-1
[state 0]
	type=varset
	trigger1=var(36)
	trigger1=(playerid(var(15)),stateno=190010) ;;<-guardcrush state ガードクラッシュ
	var(36)=var(36)/2
; range ; (範囲)
[state 0]
	type=varset
	trigger1=(var(36)!=[0,50])
	var(36)=ifelse(var(36)<0,0,50)

;------------------------
;;>>@Config.GuardBar>>
; draw guard bar ; ガードゲージ描画
[state 0] ; bar1
	type=removeexplod
	trigger1=!(var(9)&4)
	id=493000
[state 0] ; bar2
	type=removeexplod
	trigger1=!numexplod(493000)
	id=493010
[state 0] ; warnning bg
	type=removeexplod
	trigger1=!numexplod(493000)||var(37)<=39
	id=493030
;---
; guard bar ; ガードゲージ
[state 0]
	type=explod
	trigger1=(var(9)&4) && numexplod(490000) && numexplod(490100) && !numexplod(493000)
	id=493000
	anim=f210000
	sprpriority=var(46)+1
	ownpal=1
	space=screen
	postype=left
	facing=ifelse(teamside=1,1,-1)
	scale=0.25,0.25
	bindtime=-1
	removetime=-1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1
[state 0]
	type=explod
	trigger1=numexplod(493000) && !numexplod(493010)
	id=493010
	anim=f210005
	sprpriority=var(46)+2
	ownpal=1
	space=screen
	postype=left
	facing=ifelse(teamside=1,1,-1)
	scale=0.25,0.25
	bindtime=-1
	removetime=-1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1
;---
; guard bar change ; ガードバー変化
[state 0]
	type=modifyexplod
	trigger1=(var(8)&4)
	id=493000
	postype=left
	facing=ifelse(teamside=1,1,-1)
	pos=var(14):=var(31)-floor(((50-var(37))*39/50-3)*fvar(0))*ifelse(teamside=1,1,-1), var(32)+floor(6*fvar(0))
	scale=(50-var(37))/200.0, 0.25 *(var(37)<50)
[state 0]
	type=modifyexplod
	trigger1=(var(8)&4)
	id=493010
	postype=left
	facing=ifelse(teamside=1,1,-1)
	pos=var(14),var(32)+floor(6*fvar(0))
	scale=0.25,0.25 *(var(37)<50)
;---
; frame2 warnning ; 外枠2 警告
[state 0]
	type=explod
	trigger1=var(37)>39 && numexplod(493010) && !numexplod(493030)
	id=493030
	anim=f210012
	sprpriority=var(46)+6
	ownpal=1
	space=screen
	postype=left
	facing=ifelse(teamside=1,1,-1)
	pos=var(31)+floor(100*fvar(0))*ifelse(teamside=1,-1,1), var(32)
	scale=0.25,0.25
	bindtime=-1
	removetime=-1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1

;------------------------
;------------------------
; modify guard bar (3rd bit)
; 描画変動
[state 0] ; off
	type=varset
	trigger1=(var(8)&4)
	trigger1=var(37)=var(36)
	var(8)=var(8)|4
[state 0] ; on
	type=varset
	trigger1=!(var(8)&4)
	trigger1=var(37)!=var(36)||!time
	var(8)=var(8)^4

; memo guard point
; ガードポイント保存
[state 0]
	type=varadd
	trigger1=roundstate=2
	trigger1=var(37)!=var(36)
	var(37)=(var(36)-var(37))/8+ifelse(var(37)>var(36),-1,1)


;==========================
; power bar ; パワーバー
;==========================
; v20-22,25,30
; v22: type
; 1: N(normal)
; 2: C(blobking)
; 3: S(just defense)
; 4: T(team mode striker)

; indicate power bar switch (4th bit)
; パワーバー表示スイッチ

[state 0] ; on
	type=varset
	trigger1=!(var(9)&8) && roundstate=2
	var(9)=var(9)|8

[state 0] ; off
	type=varset
	triggerall=(var(9)&8)
	trigger1=(roundstate!=2) || win || lose || drawgame || (var(9)&4096) || const(size.height)=1 || !(var(7)&512) ;; system_switch
	trigger2=(playerid(var(15)),numexplod(920861)) || (playerid(var(15)),numexplod(920862)) ;; switch id
	trigger3=numenemy
	trigger3=enemy,numexplod(920861) ;; switch id
	var(9)=var(9)^8

;------------------------
; modify power ; パワー制御
;------------------------
; update powermax
[state 0]
	type=varset
	trigger1=var(30)!=playerid(var(15)),powermax
	var(30)=playerid(var(15)),powermax

;------------------------
;;>>@Config.Power_Start>>
;; Start Power ;; パワー量開始時
[state 0]
	type=poweradd
	trigger1=!time && roundno=1 && power<1000 ;; var(30)/3
	value=1000 ;; var(30)/3
	persistent=0
; pow-get managed
[state 0]
	type=poweradd
	triggerall=var(20)>0 && power>var(20)
	triggerall=(playerid(var(15)),stateno!=195500) && (playerid(var(15)),movetype!=h)
	trigger1=(var(22)=2 && power<1000) || (var(22)=3 && power<2000)
	value=-(power-var(20))/ifelse(var(22)=2,2,1)

;------------------------
; type 1 N (normal)
;------------------------

;------------------------
; type 2 C (blocking)
;------------------------
; powerup during (1/3)redlife
; 赤体力(1/3)時増加
[state 0]
	type=poweradd
	trigger1=var(22)=2 && power<1000
	trigger1=(var(9)&8192)
	value=2

; power range
[state 0]
	type=powerset
	trigger1=var(22)=2 && power>=1000 && var(20)<=power
	value=ifelse(!(var(9)&8192),1000,var(30))
[state 0]
	type=powerset
	trigger1=var(22)=2 && var(20)>power
	trigger1=power<ifelse(!(var(9)&8192),1000,var(30))
	value=0

;------------------------
; type 3 S (just defense / max mode)
;------------------------
; v25:	max mode timer(マックス状態時間)
; max mode on ; マックスモード開始
[state 0]
	type=varset
	trigger1=roundstate=2 && var(22)=3 && var(25)=0 ;;<-init
	trigger1=power>=var(30)/3*2
	var(25)=2000 ;;<- max mode time & flag
;---
; pow-max eff ; パワーマックス時効果
[state 0]
	type=playsnd
	trigger1=roundstate=2 && var(22)=3 && var(25)=2000 ;;<- just started
	value=f10200,3
	channel=4
[state 0] ; bg
	type=explod
	trigger1=roundstate=2 && var(22)=3 && var(25)=2000 ;;<- just started
	trigger1=!numexplod(21310)
	id=21310
	anim=f210310
	sprpriority=-52
	ownpal=1
	postype=p1
	scale=playerid(var(15)),const(size.xscale)*1.5*ifelse(random<500,1,-1),playerid(var(15)),const(size.yscale)*1.15*ifelse(random<500,1,-1)
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1
[state 0]
	type=modifyexplod
	trigger1=numexplod(21310)
	id=21310
	postype=p1
	pos=floor(playerid(var(15)),pos x-pos x+const(size.mid.pos.x))*facing,floor(playerid(var(15)),pos y-pos y+const(size.mid.pos.y))
;---
[state 0]
	type=powerset
	trigger1=var(22)=3 && var(25)=2000 ;;<- just started
	value=var(30) ;;<- powermax
;---
; modify power to max ; パワー制御
[state 0]
	type=varadd
	trigger1=var(22)=3 && var(25)>0
	var(25)=-ifelse(power=var(30),2, ifelse(var(30)-power>var(25),var(25)-2,(var(30)-power)) )
; allways max
[state 0]
	type=powerset
	trigger1=var(22)=3 && var(25)>0 && power<var(30)
	value=var(30)
;---
; pow-max mode over
[state 0]
	type=varset
	trigger1=var(22)=3 && var(25)<1 && power>=var(30)
	var(25)=-2000 ;;<- max mode over flag
; reset power
[state 0]
	type=powerset
	triggerall=var(22)=3
	trigger1=var(25)=-2000 ;;<- just stopped
	trigger1=1|| var(21):=0
	trigger2=!time && power>=var(30)/3*2
	value=var(30)/3
; init
[state 0]
	type=varset
	trigger1=var(22)=3 && var(25)=-2000 ;;<- just stopped
	var(25)=0

;------------------------
;------------------------
;;>>@Config.PowerBar_Draw>>
; draw power bar ; パワー描画
;------------------------
; alpha blend shadow ; 半透明影
[state 0]
	type=removeexplod
	triggerall=numexplod(492000)
	trigger1=!(var(9)&8)
	trigger2=(var(20)/1000)!=(power/1000)
	id=492000

; chars / numbers ; 文字/数字
[state 0]
	type=removeexplod
	trigger1=!numexplod(492000)
	id=492300

; power bar ; パワーバー
[state 0]
	type=removeexplod
	trigger1=!numexplod(492000)
	id=492200
; power bar 2 ; パワーバー
[state 0]
	type=removeexplod
	trigger1=!numexplod(492000)
	id=492201

; frame ; 外枠
[state 0]
	type=removeexplod
	trigger1=!numexplod(492000)
	id=492100

;------------------------
; type 1 N (normal)
;------------------------
; alpha shadow ; 半透明影
[state 0]
	type=explod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=!numexplod(492000)
	id=492000
	anim=f100050+ifelse(power>=var(30)||power>=10000,10,power/1000)
	sprpriority=-1
	ownpal=1
	space=screen
	postype=left
	pos=var(33)-(teamside=2)*floor(100*fvar(0)),var(34)
	scale=100,0.25
	removetime=-1
	bindtime=-1
	ontop=1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1

; powerbar 1/2 ; パワーバー
[state 0]
	type=explod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=!numexplod(492200) && numexplod(492000)
	id=492200
	anim=f100100+ifelse(power>=var(30)||power>=10000,10,power/1000)
	sprpriority=5
	ownpal=1
	space=screen
	postype=left
	pos=0,-500
	facing=ifelse(teamside=1,1,-1)
	removetime=-1
	bindtime=-1
	ontop=1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1
[state 0]
	type=modifyexplod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=numexplod(492200) && (var(8)&2)
	id=492200
	postype=left
	pos=var(33)-floor(ifelse((var(21)%1000), (var(21)%1000), 1000)*100/1000*fvar(0))*(teamside=2),var(34)
	scale=ifelse(var(21)>=var(30)||var(21)>=10000,100,(var(21)%1000)*100/1000)*ifelse(teamside=1,1,-1),0.25
; powerbar 2/2
[state 0]
	type=explod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=!numexplod(492201) && numexplod(492000)
	id=492201
	anim=f100200+ifelse(power>=var(30)||power>=10000,10,power/1000)
	sprpriority=5
	ownpal=1
	space=screen
	postype=left
	pos=0,-500
	facing=ifelse(teamside=1,1,-1)
	scale=0.25,0.25
	removetime=-1
	bindtime=-1
	ontop=1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1
[state 0]
	type=modifyexplod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=numexplod(492201) && (var(8)&2)
	id=492201
	postype=left
	pos=var(33)+floor((var(21)%1000)*100/1000*fvar(0))*ifelse(teamside=1,1,-1),var(34)

; frame ; 外枠
[state 0]
	type=explod
	trigger1=var(22)=1 && (var(9)&8)
	trigger1=!numexplod(492100) && numexplod(492200)
	id=492100
	anim=f100000+(power>=1000)
	sprpriority=5
	ownpal=1
	space=screen
	postype=left
	pos=var(33),var(34)
	facing=ifelse(teamside=1,1,-1)
	scale=0.25,0.25
	removetime=-1
	bindtime=-1
	ontop=1
	ignorehitpause=1
	supermovetime=-1
	pausemovetime=-1

; numbers ; 数字
[state 0]
