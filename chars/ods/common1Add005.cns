;	ignorehitpause=1
;	persistent=0

;--- clean helpers ; ヘルパー掃除
[state 0]
	type=destroyself
	trigger1=ishelper(99997)
	trigger1=(var(57)=11111) && (var(58)=22222) && (var(59)=33333)
	trigger2=ishelper
	trigger2=(var(15)=10311) && (var(16)=10212) && (var(17)=10113) && (var(18)=30636)
	trigger3=ishelper(90900)
	ignorehitpause=1


;---
[state 0] ; remove afterimages
	type=afterimagetime
	trigger1=!time
	time=0

; set default anim
[state 0]
	type=varset
	trigger1=!time
	sysvar(2)=ifelse(gethitvar(yvel)=0,5080,5090)

[state 0]
	type=varadd
	trigger1=!time
	trigger1=(anim=[5081,5089])||(anim=[5111,5119])
	trigger1=selfanimexist(sysvar(2)+(anim%10))
	sysvar(2)=(anim%10)

; if 5090 doesn't exist
[state 0]
	type=varset
	trigger1=!time && sysvar(2)=5090 && !selfanimexist(5090)
	sysvar(2)=5030

[state 0] ; freeze
	type=changeanim
	trigger1=1
	value=sysvar(2)

[state 0]
	type=changestate
	trigger1=hitshakeover && gethitvar(yvel)=0
	value=5081 ;;<-hitl_slide
[state 0]
	type=changestate
	trigger1=hitshakeover && gethitvar(yvel)!=0
	value=5030 ;;<-hita_up

