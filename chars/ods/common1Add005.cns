;==========================
;==========================
;; Key Pressed Switch / ボタン開閉
;; v08: bit flag (15th-24th,26th)
;;---
;[state 0] ; off_all
;	type=varset
;	trigger1=1
;	var(8)=var(8)^50315264 ;; [ 10111111111100000000000000 / 50315264 ]
;[state 0] ; on_key-dir
;	type=varset
;	trigger1=1
;	var(8)=var(8)|(16384*(root,command="holdfwd")+32768*(root,command="holdback")+65536*(root,command="holdup")+131072*(root,command="holddown"))
;[state 0] ; on_key-bottom
;	type=varset
;	trigger1=1
;	var(8)=var(8)|(262144*(root,command="x")+524288*(root,command="y")+1048576*(root,command="z")+2097152*(root,command="a")+4194304*(root,command="b")+8388608*(root,command="c"))
;;---
;;---
[state 0] ; off
	type=varset
	trigger1=(var(8)&16384)&&(root,command!="holdfwd")
	var(8)=var(8)^16384
[state 0] ; on
	type=varset
	trigger1=(root,command="holdfwd")&&!(var(8)&16384)
	var(8)=var(8)|16384
;;---
[state 0] ; off
	type=varset
	trigger1=(var(8)&32768)&&(root,command!="holdback")
	var(8)=var(8)^32768
[state 0] ; on
	type=varset
	trigger1=(root,command="holdback")&&!(var(8)&32768)
	var(8)=var(8)|32768
;;---
[state 0] ; off
