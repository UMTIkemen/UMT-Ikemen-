;;>>@Config.PowerBar>>
;;>>@Config.PowerBar_Draw>>
;;>>@Config.Face>>
;;>>@Config.Combo.Pos>>
;;>>@Config.Counter_Hit>>
;;>>@Config.DamageToPower>>
;;>>@Config.Power_Start>>
;;>>@Config.Icon_FirstAttack_Pos>>
;;>>@Config.Icon_CPU_Pos>>
;;>>@Config.Score>>
;;>>@Config.Message_Pos>>
;;>>@Config.KO>>
;;>>@Config.Ground_Dust_Effect>>
;;>>@Config.Display_Input>>
;;>>@Config.Tag_Command>>
;;>>@Config.Tag_FirstPlayer_Select>>
;;>>@Config.Camera>>

;;>>@Config.Tag_Asist_StateNo>>
;; tag-mode.partner.statedef [190193-190196]
;; partner-asist/striker.stateno registration [195900]
;;>>@Config.Round_Fight>>
;; round-call.statedef [18000]
;;>>@Config.Ranking>>
;; rank.panel.statedef [99980]


;------------------------
;------------------------
; Stand
[statedef 0]
type=s
physics=s
sprpriority=0
;---
;velset=0,0
;movetype=i
;---

[state 0] ;; remove special helpers
	type=destroyself
	trigger1=ishelper(99997) && (var(57)=11111) && (var(58)=22222) && (var(59)=33333)
	trigger2=ishelper && (var(15)=10311) && (var(16)=10212) && (var(17)=10113) && (var(18)=30636)
	trigger3=ishelper(90900)
	ignorehitpause=1
;---
;---
; Guard ; 防
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && inguarddist
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/10000)%10
	value=120
	ctrl=0
; Roll ; 避
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && sysvar(4) && (sysvar(4)!=[2,3])
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && (playerid(floor(sysfvar(0))),var(18)/100000)%10=1
	value=110
; Jump ; 跳
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[4,7])
	value=ifelse(sysvar(4)=2 && ((playerid(floor(sysfvar(0))),var(18)/100000)%10=[6,7]), 48, 142000 +(((playerid(floor(sysfvar(0))),var(18)/100000)%10)-4)*10 +((playerid(floor(sysfvar(0))),var(18)/1000000)%10) )
; Run ; 走
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && numenemy
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0 && (p2bodydist x!=[-58,58]) && (playerid(floor(sysfvar(0))),var(19)/1000)%1000=0
	trigger1=random<p2bodydist x*2 || (enemynear,movetype=i && random<100) || enemynear,stateno=190116 ;; dizzy
	value=100
; Back_Step ; 退
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0 && (p2bodydist x=[-80,80]) && enemynear,stateno!=190116 && random<120
	value=105
; Walk ; 歩
[state 0]
	type=changestate
	trigger1=roundstate=2 && ctrl && time>5 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900 && playerid(floor(sysfvar(0))),var(51)>0 && (playerid(floor(sysfvar(0))),var(19)/10)%10=0 && random<200
	value=21
;---
;---
[state 0]
	type=changeanim
	trigger1=(anim!=0 && anim!=5) || (anim=5 && animtime=0)
	value=0
[state 0]
	type=velset
	trigger1=!time
	y=0
[state 0]
	type=velset
	trigger1=abs(vel x)<const(movement.stand.friction.threshold) || time=4
	x=0
;---
[state 0]
	type=changestate
	trigger1=time>80 && (lose || drawgame) && (prevstateno=190195) && roundstate>2
	value=ifelse(selfanimexist(170),170,175)
	ctrl=1

