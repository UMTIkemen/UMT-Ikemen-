;==========================
; Get Tag-Team asist-stateno (v53-56)
; タッグ時支援ステート番号取得
;--- tag
[state 0]
	type=varset
	trigger1=!time && numpartner
	var(53)=ifelse((root,sysvar(0)>159), (root,sysvar(0)), 1120)
	persistent=0
[state 0]
	type=varset
	trigger1=!time && numpartner && playeridexist(root,id+1)
	var(54)=ifelse((playerid(root,id+1),sysvar(0)>159), (playerid(root,id+1),sysvar(0)), 1040)
	persistent=0
;--- plus
[state 0]
	type=varset
	trigger1=!time && numpartner>1 && playeridexist(root,id+2)
	var(55)=ifelse((playerid(root,id+2),sysvar(0)>159), (playerid(root,id+2),sysvar(0)), 1020)
	persistent=0
[state 0]
	type=varset
	trigger1=!time && numpartner>2 && playeridexist(root,id+3)
	var(56)=ifelse((playerid(root,id+3),sysvar(0)>159), (playerid(root,id+3),sysvar(0)), 1210)
	persistent=0

;;--- ---
;[state 0] ; p-a_stateno
;	type=displaytoclipboard
