;==========================
;==========================
; Ground Wave [helper] ; 地面衝突用
;==========================
[statedef 9005]
type=c
physics=n
anim=ifelse(selfanimexist(909002),909002,0)
ctrl=0
[state 0]
	type=assertspecial
	trigger1=1
	flag=invisible
	ignorehitpause=1
[state 0]
	type=nothitby
	trigger1=1
	value=sca
	ignorehitpause=1
;--- init
[state 0]
	type=null
	trigger1=!time
	trigger1=1|| var(0):=ishelper(9001) +ishelper(9002)*2 +ishelper(9003)*3 +ishelper(9004)*4 +ishelper(9005)*5 +ishelper(9006)*6 +ishelper(9007)*7 +(ishelper(9008)||ishelper(9009))*8
	trigger1=1|| fvar(0):=(var(0)+8)*0.041 || fvar(1):=fvar(0)*0.85 || fvar(2):=(var(0)*2+9)*0.05 || fvar(10):=(const(size.ground.back)+const(size.ground.front))*0.031 ;;<-localcoord
	trigger1=(root,sysfvar(0)>0) && playeridexist(floor(root,sysfvar(0)))
	trigger1=(playerid(floor(root,sysfvar(0))),var(0)=90900)
	trigger1=1|| var(24):=playerid(floor(root,sysfvar(0))),var(24) ;;<-stage type
;---
[state 0]
	type=envshake
	trigger1=!time && var(0)>1
	time=ifelse(var(0)>4,12,6)
	ampl=ifelse(var(0)>4, 4,2)
	ignorehitpause=1
;--- ground_wave
[state 0]
	type=explod
	trigger1=!time
	anim=f6565 +(var(0)>0) +(var(0)>4) ;; <MASK>
	scale=fvar(0),fvar(1)
	postype=p1
	sprpriority=-7
	ownpal=1
	persistent=0
[state 0]
	type=explod
	trigger1=!time
	anim=f6560 +(var(0)>0) +(var(0)>4)
	scale=fvar(0),fvar(1)
	postype=p1
	sprpriority=-6
	ownpal=1
	persistent=0
;---
; water sound ; 水 - 効果音
[state 0]
	type=playsnd
	trigger1=!time && var(24)=1 ;;<-water
	value=f127,0
; water land ; 水 - 離陸/着陸/移動
[state 0]
	type=explod
	trigger1=!time && var(24)=1 ;;<-water
	anim=f10330
	postype=p1
	sprpriority=7
	ownpal=1
	pos=0,(-pos y*10)/10
	scale=1.25*ifelse(random<500,1,-1)*const(size.xscale),1.25*const(size.yscale)
;--- hit ground sound
[state 0]
	type=playsnd
	trigger1=!time
	value=f7,(var(0)>1)+(var(0)>4)
;--- dust ; 埃
[state 0]
	type=explod
	trigger1=!time && var(0)>4
	anim=f210502-(var(0)>4)
	postype=p1
	sprpriority=-6
	ownpal=1
	facing=  1
