	trigger1=(playerid(sysvar(0)),alive=0 && playerid(sysvar(0)),stateno=5150) || (playerid(sysvar(0)),sysfvar(4)>0)
	trigger1=id=playerid(floor(sysfvar(0))),var(49)
	sysfvar(4)=0 ;; to main-player
