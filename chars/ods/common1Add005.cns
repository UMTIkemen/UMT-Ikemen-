;==========================
;==========================
;;>>@Config.Round_Fight>>
; "round 1 fight!" (round-call) [helper]
; ラウンド開始
;==========================
[statedef 180000]
type=s
movetype=i
physics=n
anim=ifelse(selfanimexist(909002),909002,0)
sprpriority=-2
velset=0,0
ctrl=0
[state 0]
	type=nothitby
	trigger1=1
	value=sca
[state 0]
	type=assertspecial
	trigger1=1
	flag=invisible
	flag2=timerfreeze
;op;	flag3=nobardisplay
	ignorehitpause=1
;---
[state 0]
	type=varset
	trigger1=var(1)>100
	var(0)=1
; if "f1" key pressed ; F1キーが押された場合
[state 0]
	type=varset
	trigger1=roundstate>2 || win || lose
	var(0)=10
;--- init
[state 0]
	type=posset
	trigger1=!time
	trigger1=1|| fvar(0):=(parent,fvar(0)) || fvar(1):=(random%31)-15
	;;--- fv0: localcoord , fv1: angle_img_"fight"
	trigger1=1|| var(9):=(random%4) || var(10):=roundno || var(11):=(parent,var(3)/2) || var(12):=(parent,var(4)/2) || var(21):=ifelse(roundno%2,-1,1)
	;;--- v9: rounds_color , v10: roundno , v11-12: center_pos_x/y , v21: facing
	trigger1=1|| var(13):=var(11)-floor(15*fvar(0)) || var(14):=var(12)+floor(24*fvar(0)) || var(15):=var(11)+floor(5*fvar(0)) || var(16):=var(12)+floor(55*fvar(0))
	;;--- v13-14: rounds pos_x/y , v15-16: num pos_x/y
	x=0
	y=0
;---
[state 0]
	type=varadd
	trigger1=roundstate=2
	var(1)=1
;--- announcer.round call
[state 0]
	type=playsnd
	trigger1=var(1)=1
	value=f10500,(var(10)%4)
	channel=1
;op;	freqmul=2.0
	pan=0
	abspan=0
;--- panel wind
[state 0]
	type=playsnd
	trigger1=!var(20) && var(1)=8
	value=f2100,101
	abspan=0

[state 0] ;; img.ready...
	type=explod
	trigger1=!var(20) && var(1)=1 && !numexplod(1)
	anim=f199130
	id=1
	space=screen
	postype=left
	sprpriority=2
	ownpal=1
	bindtime=-1
	pos=var(11),var(12)
	scale=0.25,0.25
	ontop=1
	removetime=-1
[state 0] ;; img.ready...(mask/shadow)
	type=explod
	trigger1=!var(20) && var(1)=1 && numexplod(1)=1
	anim=f199139 ; <MASK>
	id=1
	space=screen
	postype=left
	sprpriority=-2
	ownpal=1
	bindtime=-1
	pos=var(11),var(12)
	scale=0.5,0.5
	ontop=1
	removetime=-1
[state 0]
	type=modifyexplod
	trigger1=numexplod(1)
	postype=left
	pos=var(11)+ifelse(var(1)<30,floor(((30-var(1))**3)*0.05)*var(21),0),var(12)
	id=1
;---
[state 0] ;; img.rounds...
	type=explod
	trigger1=!var(20) && var(1)>0
	anim=f199120 +ifelse(time%8>3,var(9),4)
	id=2
	space=screen
	postype=left
	sprpriority=-1
	ownpal=1
	bindtime=-1
	pos=var(13)+var(8),var(14)
	scale=1,1
	ontop=1
	removetime=1
[state 0] ;; img.numbers v6:color
	type=explod
	id=2
	trigger1=!var(20) && var(1)>0 && var(10)>0
	anim=f300000+(var(10)%10) +(var(6):=ifelse((time%16=[8,11]),60,ifelse((time%16=[0,3]),50,0)))
	space=screen
	postype=left
	pos=floor(30*(1+(var(10)>9)+(var(10)>99))*fvar(0)*fvar(2)*2)+var(15)+var(8),var(16)
	scale=(fvar(2):=ifelse(var(1)<20,(20-var(1))*0.025,0)+0.5) ,fvar(2)  ;;0.5,0.5
	sprpriority=2
	ownpal=1
	bindtime=-1
	ontop=1
	removetime=1
[state 0]
	type=explod
	id=2
	trigger1=!var(20) && var(1)>0 && var(10)>9
	anim=f300000+((var(10)/10)%10) +var(6)
	space=screen
	postype=left
	pos=floor(30*(1+(var(10)>99))*fvar(0)*fvar(2)*2)+var(15)+var(8),var(16)
	scale=fvar(2),fvar(2)
	sprpriority=2
	ownpal=1
	bindtime=-1
	ontop=1
	removetime=1
[state 0]
	type=explod
	id=2
	trigger1=!var(20) && var(1)>0 && var(10)>99
	anim=f300000+((var(10)/10)%10) +var(6)
	space=screen
	postype=left
	pos=floor(30*fvar(0)*fvar(2)*2)+var(15)+var(8),var(16)
	scale=fvar(2),fvar(2)
	sprpriority=2
	ownpal=1
	bindtime=-1
	ontop=1
	removetime=1
;---
[state 0]
	type=varset
	trigger1=1
;old;	var(8)=floor( ifelse(var(1)<30, ((30-var(1))**3)*0.05, -(var(1)-30)*0.2 ) )*var(21)
	var(8)=floor( -(var(1)-30)*0.2 )*var(21)
[state 0]
	type=modifyexplod
	trigger1=numexplod(2)
	id=2
	trans=addalpha
	alpha= ifelse(var(1)<32,var(1)*8,256), ifelse(var(1)<32,256-var(1)*8,0)
;--- lights
[state 0]
	type=explod
	trigger1=!var(20) && var(1)=30
	anim=f151
	space=screen
	postype=left
	sprpriority=5
	ownpal=1
	pos=var(15)+floor(35*fvar(0)),var(16)-floor(33*fvar(0))
	vel=0.5*fvar(0)*var(21),0
	scale=0.2,5
	ontop=1
[state 0]
	type=explod
	trigger1=!var(20) && var(1)=30
	anim=f151
	space=screen
	postype=left
	sprpriority=5
	ownpal=1
	pos=var(15)+floor(35*fvar(0)),var(16)-floor(33*fvar(0))
	vel=0.5*fvar(0)*var(21),0
	scale=5,0.2
	ontop=1
;---
[state 0] ;; img.fight (mask)
	type=explod
	trigger1=var(0)=1
	anim=f199006+var(21)
	id=3
	space=screen
	postype=left
	sprpriority=0
	ownpal=1
