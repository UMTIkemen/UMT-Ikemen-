;==========================
; * Additions
;==========================
;==========================
; Init2 / Partner Asist-Stateno Registration ; パートナー支援ステート登録
; * override this statedef to regist partner-asist-stateno
;==========================

;------------------------
; default asist-action ; (協力技初期設定)
[statedef 1000]
type=s
physics=s
movetype=i
anim=ifelse(selfanimexist(195),195,0)
sprpriority=-2
velset=0,0
ctrl=0

[state 0]
	type=posset
	trigger1=!time
	y=0
[state 0]
	type=poweradd
	trigger1=(anim=195) && (animtime=0)
	value=1000
[state 0]
	type=changestate
	trigger1=(anim!=195) && (time>16)
	trigger2=(anim=195) && (animtime=0)
	value=0
	ctrl=1

;==========================
; preintro ; 予備イントロ
;==========================
 [statedef 190000]
ctrl=0

; intro for round 1 / turns mode
[state 0]
	type=changestate
	trigger1=roundno=1
	trigger2=roundno>1 && numenemy
	trigger2=(teammode=turns)||(enemy,teammode=turns)
	value=190

; all other rounds
[state 0]
	type=changestate
	trigger1=1
	value=0


;==========================
;==========================
; Blocking / Just Defended ; ブロッキング/ジャストディフェンス
;==========================
[statedef 195500]
type=u
physics=n
velset=0,0
ctrl=0

;; movetype=h ;; *

;;[MUGEN 1.0 / 1.x]
;; 情報を取得するには"movetype=h" が必須ではありません
;; "movetype=h" is NOT required, for getting informations.

;;[winMUGEN / IKEMEN]
;; 情報を取得するには"movetype=h" が必須、ダメージを受け、死ぬこともあります。
;; "movetype=h" is required, for getting informations, and player will get damage or die.

;;--- type init
[state 0]
	type=varset
	trigger1=!time && sysfvar(0)>id && playeridexist(floor(sysfvar(0)))
	trigger1=playerid(floor(sysfvar(0))),var(0)=90900
	sysvar(0)=playerid(floor(sysfvar(0))),var(22)
	ignorehitpause=1

;; animetion for blocking:
;; (stand:195500/130) (squat:195501/131) (air:195502/132)

;; motion ; モーション
;; fly ; 空
[state 0]
	type=changeanim
	trigger1=!time && statetype=a
	value=ifelse(selfanimexist(195502)&&sysvar(0)=2,195502,132)
	ignorehitpause=1
;; squat ; 屈
[state 0]
	type=changeanim
	trigger1=!time && statetype=c
	value=ifelse(selfanimexist(195501)&&sysvar(0)=2,195501,131)
	ignorehitpause=1
;; stand ; 立
