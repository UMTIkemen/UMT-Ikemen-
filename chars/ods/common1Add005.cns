;------------------------
;------------------------
; announcer.big_damage (opponent)
; 放送音.大ダメージ (相手)
[state 0]
	type=playsnd
	triggerall=(roundstate=2) && var(41)>0 && var(40)-var(41)>228 ;; v41:life v40:damage is more then 228
	triggerall=(var(7)&64) ;; system_switch
	trigger1=(playerid(var(15)),movetype=h) && (playerid(var(15)),gethitvar(guarded)=0) && (playerid(var(15)),stateno!=[190190,190196])
	value=f10100,2
	channel=1
	abspan=ifelse(teamside=1,1,-1)*facing*320

;------------------------
;------------------------
; combo indicator, code by k' d(^-^)b
; コンボ数表示、K'さんより
; v11:	nums Temp + Now ([0-9999]*1000 + [0-9999])
; v12:	real combo + timer (timer[0-9999]*1000 + [0-9999])
; v13:	pos_x / timer
; v14:	temp: combo_counter / hittype
;--- ---
; >03 hits: good
; >05 hits: great
; >10 hits: beautiful
; >15 hits: fantastic
; >20 hits: marvelous
; >25 hits: m.u.g.e.n
;;--- announcer.combine + msg_combo (opponent)
[state 0]
	type=playsnd
	trigger1=(roundstate=2) && var(38)<99999999 && numenemy
	trigger1=(enemy,sysfvar(0)>0) && (playeridexist(floor(enemy,sysfvar(0))))
	trigger1=(playerid(floor(enemy,sysfvar(0))),var(0)=90900) && (playerid(floor(enemy,sysfvar(0))),var(11)%10000<1) && (var(14):=(playerid(floor(enemy,sysfvar(0))),var(12)%10000)) && var(14)>2
	trigger1=(var(38):=var(38)*100+10+(var(14)>4)+(var(14)>9)+(var(14)>14)+(var(14)>19)+(var(14)>24)) && (var(14)>4) && (var(7)&64) ;; system_switch
	value=f10100,3 +(var(14)>9)
	channel=1
	abspan=ifelse(teamside=1,-1,1)*facing*320

;;--- real combo init / stop
[state 0]
	type=varset
	trigger1=(var(11)%10000<1)
	var(12)=0
;;---
;; indicate combo nums
;; コンボ数計算
[state 0]
	type=varadd
	trigger1=(var(11)/10000)=(var(11)%10000) && (playerid(var(15)),stateno!=[120,159]) && (playerid(var(15)),ctrl=0)
	trigger1=var(40)>var(41) && (var(9)&16) ;;<-life changed && getting damage
	var(11)=1 +( var(12):=var(12)+(playerid(var(15)),stateno=[5000,5199]) )*0 ;;<-real combo set
[state 0] ;; combo init
	type=varset
	triggerall=(var(11)%10000)>0
	trigger1=!(var(9)&16) ;;<-not getting damage
	trigger2=(roundstate!=2) || (var(9)&4096) ;;<-bonus stage
	trigger3=(playerid(var(15)),ctrl)||(playerid(var(15)),stateno=[0,159])||(playerid(var(15)),stateno=8200)
	var(11)=0
;---
;;>>@Config.Combo.Pos>>
; v13: pos x (240p)
[state 0]
	type=null
	trigger1=(var(11)%10000=2) && ((var(11)/10000)!=(var(11)%10000))
	trigger1=1|| var(13):=ifelse(teamside=2,-150,floor(var(3)/fvar(0))+150) ;;<-init pos x
	trigger2=(var(11)%10000>1) && (var(11)/10000)<(var(11)%10000) ;;<-combo update
