; fvar(1):= 1900 - Charge Meter
; fvar(5):= 3000 - Thundershock, 3050 - Thundershock (air), 3100 - Skull Bash, 3150 - Skull Bash Air, 3200 - Wild Charge (start), 3201 - Wild Charge (Dash), 3103 - Wild Charge (Hit!), 3210 - Wild Charge (Lv. 0 finish), 3211 - Wild Charge (Lv. 1 link), 3212 - Wild Charge (Lv. 2 link), 3213 - Wild Charge (Lv. 3 finish), 3220 - Volt Shock Fist (Success!), 3221 - Volt Shock Fist (Finish), 3500 - Volt Tackle, 3000 - Lightning Rod, -3
;fvar(10):= -3
;fvar(11):= 200 - Standing Light, 210 - Standing Medium, 220 - Standing Heavy, 400 - Crouching Light, 410 - Crouching Medium, 420 - Crouching Heavy, 600 - Jump Light, 610 - Jump Medium, 620 - Jump Heavy, 700 - Launcher, 710 - OTG Attack, 720 - Meteor Smash, 750 - Dash Attack, 950 - Thunder Punch (raw), 951 - Thunder Punch (combo), 1001 - Thunder Jolt weak (spark), 1006 - Thunder Jolt medium (spark), 1011 - Thunder Jolt strong (spark), 1031 - Thunder Jolt EX (spark 1), 1032 - Thunder Jolt EX (spark 2), 1051 - Electro ball weak (ball), 1056 - Electro ball medium (ball), 1061 - Electro ball strong (ball), 1071 - Electro ball "EX (ball), 1101 - Thunder (lightning), 1131 - Thunder (lightning), 1151 - Thunder (lightning level 3), 1200 - Iron Tail, 1201 - Iron Tail (air), 1205 - Iron Tail (slam on the ground), 1210 - Iron Tail "EX", 1215 - Iron Tail "EX" (slam on the ground), 1220 - Iron Tail "EX" (air), 1300 - Quick Attack (horizontal), 1301 - Quick Attack 2nd hit(horizontal fwd), 1302 - Quick Attack 2nd hit diagonal up), 1303 - Quick Attack 2nd hit (vertical), 1305 - Quick Attack (diagonal up), 1306 - Quick Attack 2nd hit(horizontal fwd), 1307 - Quick Attack 2nd hit diagonal up air), 1308 - Quick Attack 2nd hit diagonal down air), 1309 - Quick Attack 2nd hit (air vertical down), 1310 - Quick Attack (vertical), 1311 - Quick Attack 2nd hit (air vertical up), 1320 - Quick Attack Air (diagonal downfwd), 1321 - Quick Attack Air (horizontal fwd), 1322 - Quick Attack Air (diagonal downfwd), 1330 - Quick Attack "EX", 1350 - Quick Attack (Guard Cancel), 1500 - Discharge (Light), 1505 - Discharge (Medium), 1510 - Discharge (Heavy), 1502 - Discharge (projectile), 3201 - Wild Charge (Dash), 3103 - Wild Charge (Hit!), 3210 - Wild Charge (Lv. 0 finish), 3211 - Wild Charge (Lv. 1 link), 3212 - Wild Charge (Lv. 2 link), 3213 - Wild Charge (Lv. 3 finish), 3220 - Volt Shock Fist (Success!), 3501 - Volt Tackle (Charge!), -2 - States that are always executed (use statedef -2)
;fvar(13):= 196 - Charge, 400 - Crouching Light, 801 - Throw 1 (p1), 805 - Throw 2 (p1), -2 - States that are always executed (use statedef -2)
;fvar(14):= 400 - Crouching Light, 801 - Throw 1 (p1), 805 - Throw 2 (p1), 1350 - Quick Attack (Guard Cancel), 5900 - Initialize (at the start of the round)
;fvar(17):= 3101 - Skull Bash (charge!), 3151 - Skull Bash Air (charge!)
;fvar(21):= 5900 - Initialize (at the start of the round)
