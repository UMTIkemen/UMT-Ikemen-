;var(19):= 1101 - Thunder (lightning), 1131 - Thunder (lightning), -2 - States that are always executed (use statedef -2)
;var(21):= 1001 - Thunder Jolt weak (spark), 1006 - Thunder Jolt medium (spark), 1011 - Thunder Jolt strong (spark), 1031 - Thunder Jolt EX (spark 1), 1032 - Thunder Jolt EX (spark 2), 1051 - Electro ball weak (ball), 1056 - Electro ball medium (ball), 1061 - Electro ball strong (ball), 1071 - Electro ball "EX (ball), 1101 - Thunder (lightning), 1131 - Thunder (lightning), 1151 - Thunder (lightning level 3), -2 - States that are always executed (use statedef -2)
;var(22):= 3501 - Volt Tackle (Charge!)
;var(23):= 3501 - Volt Tackle (Charge!)
;var(24):= 3501 - Volt Tackle (Charge!)
;var(25):= 3501 - Volt Tackle (Charge!)
;var(26):= 3500 - Volt Tackle, 3501 - Volt Tackle (Charge!)
