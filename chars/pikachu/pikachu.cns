[Data]
life = 800
attack = 100
defence = 100
fall.defence_up = 0 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 0 ;15       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 200         ;Volume offset (negative for softer)
IntPersistIndex = 0	;Variables with this index and above will not have their values
FloatPersistIndex = 0  ;reset to 0 between rounds or matches. There are 60 int variables,

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 13    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
;z.width = 3          ;Player width (into and out)
height = 30 ;60	     ;Height of player (for opponent to jump over)
;attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1 ;0     ;Set to 1 to scale projectiles too   
head.pos = 0, -39 ;-5, -90   ;Approximate position of head
mid.pos = 0, -15 ;-5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd = 2.8 ;Walk forward
walk.back = -2.6 ;Walk backward
run.fwd = 8.6, 0 ;6.6, 0 ;Run forward (x, y) - if y<0, player will hop
run.back = -6.5,-3.8 ;-4.5,-3.8 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-10.5 ;-8.1 ;Neutral jumping velocity (x, y)
jump.back = -3 ;-2.55 ;Jump back Speed (x, y)
jump.fwd = 3 ;2.5 ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55;-8.1 ;Air jump speeds (opt)
airjump.fwd = 2.5;-8.1    ;.

[Movement]
airjump.num = 1    ;Number of air jumps allowed (opt)
airjump.height = 1  ;Minimum distance from ground before you can air jump (opt)
yaccel = .55 ;.43         ;Vertical acceleration
stand.friction = .89 
crouch.friction = .82 

[Quotes]
victory0 = "Watch your step! My lightning hertz like a truck!"
victory1 = "If you don't wanna get cut short, you should try staying with the current!"
victory2 = "Heh, hard to keep me grounded, isn't it?"
victory3 = "You look like you need some Ketchup, ya Slowpoke!"
; Vs. Pikachu
victory4 = "Between you and me, the one with the higher voltage matters!"; (Normal)
victory5 = "Me, a faker? You're even not good enough to be MY fake, buddy!"; ILLMAKEYOUEATTHOSEWORDS (Mirror Match)
; Vs. Jigglypuff
victory6 = "All that singing must make you tired, too! Why don't you take a rest instead?"; (Normal)
victory7 = "Hey! Balloons aren't supposed to conduct electricity, are they?"; Because Mimic bypasses logic. (Vs. Solar's Jigglypuff)
; Vs. Pichu or pikaclones
victory8 = "You're doing good so far! Just keep it up, and maybe you'll surpass me someday."
; Vs. Mewtwo
victory9 = "This was a test of strength, you say? Well, it's enough to leave everyone feeling riveted!"; (Normal)
victory10 = "Hey, you're much different than I imagined. You're not threatening at all!"; (M2Y)
; Vs. Charizard
victory11 = "Ooooh, you're big and scary! I can't possibly defeat- oh, I did."
; Vs. Shotocario
victory12 = "Is it just me, or is it hard to tell you Lucario apart from one-another?"
; Vs. Greninja
victory13 = "Don't you know what happens when a frog is struck by lightning?"; The same thing that happens to everything else.
; Vs. Sans
victory14 = "Is this some kind of joke? Because I find your fighting to be very humerus!"

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------


;---------------------- Integer variable list ----------------------

; var(0):= 3229 - Volt Shock Fist (BG)
; var(1):= 3229 - Volt Shock Fist (BG), 1900 - Charge Meter, -1 - Don't remove the following line. It's required by the CMD standard.
; var(2):= 800 - Throw (start), 801 - Throw 1 (p1), 805 - Throw 2 (p1)
; var(3):= 800 - Throw (start)
; var(4):= 700 - Launcher, -2 - States that are always executed (use statedef -2)
; var(5):= 40 - Jump start, 740 - Superjump
; var(6):= 1500 - Discharge (Light), 1502 - Discharge (projectile)
; var(7):= -2 - States that are always executed (use statedef -2)
; var(8):= 5300 - Stun, -2 - States that are always executed (use statedef -2)
; var(9):= 1900 - Charge Meter
;var(10):= 180 - Winstate decider
;var(11):= 1200 - Iron Tail, 1201 - Iron Tail (air)
;var(12):= 1101 - Thunder (lightning), 1131 - Thunder (lightning), -2 - States that are always executed (use statedef -2)
