;var(14):= -2 - States that are always executed (use statedef -2)
;var(15):= -2 - States that are always executed (use statedef -2)
;var(16):= 1150 - Thunder (Guard Cancel), 1500 - Discharge (Light), 1505 - Discharge (Medium), 1510 - Discharge (Heavy), 3000 - Thundershock, 3050 - Thundershock (air), 3100 - Skull Bash, 3150 - Skull Bash Air, 3200 - Wild Charge (start), 3500 - Volt Tackle
;var(17):= 3100 - Skull Bash, 3150 - Skull Bash Air
