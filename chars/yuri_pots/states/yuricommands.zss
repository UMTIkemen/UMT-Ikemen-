# AI Punish Window
ignoreHitPause if AIlevel && numEnemy {
	map(ai_p2vely) := p2, vel y;
	map(ai_p2accely) := p2, vel y - map(ai_p2vely);

	if p2, ctrl || p2moveType = H {
		map(ai_punishwindow) := 0;
	} else if p2, vel y = 0 {
		map(ai_punishwindow) := -(p2, animTime);
	} else if p2, vel y != 0 && map(ai_p2accely) != 0 {
		map(ai_punishwindow) := (-(p2, vel y) + (((p2, vel y) ** 2 - 2 * map(ai_p2accely) * (p2, pos y)) ** 0.5)) / map(ai_p2accely);
	}
}

