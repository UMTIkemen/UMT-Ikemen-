#==============================================================================================
#=======================================<HELPER STATES>========================================
#==============================================================================================

#========================<KOUOU KEN>=============================

#============================================================
# State 1005
#============================================================
[StateDef 1005;
	type: S;
	moveType: A;
	ctrl: 0;
	sprPriority: 3;
]

ignoreHitPause {
	# Override
	hitOverride{attr: SCA, AA, AP, AT; time: -1; stateno: 1006}
	# HB
	hitBy{value: SCA, NP, SP, HP; time: -1}
}

# Strength
if !time && !prevStateNo {
	mapSet{map: "strength"; value: root, map(strength)}
}

# Anim
if anim != 1005 {
	changeAnim{value: 1005}
}

# Trans
ignoreHitPause {
	trans{trans: addAlpha; alpha: 256, 256}
}

# Vel
velSet{x: ifelse(map(strength) = 2, 5.00, ifelse(map(strength) = 1, 3.75, 2.50)); y: 0}

# ProjContact
ignoreHitPause if moveContact = 1
&& p2, getHitVar(frame)
&& (p2, getHitVar(playerID) = ID || moveHitVar(playerID) = p2, ID) {
	map(projcontact) := 1;
	if root, stateno = 1000 {
		root, map(projcontact) := 1;
	}
}

# HitSound
ignoreHitPause if moveHit = 1 || moveReversed = 1 {
	playSnd{value: ifelse(numTarget, 2, 3), ifelse(numTarget, 6, 0); channel: 2}
}

# Hit
hitdef{
	id: stateNo;
	attr: S, SP;
	hitflag: MAF;
	guardflag: MA;
	priority: 4, Hit;
	air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
	damage: 70, 18;
	dizzypoints: 100 * !(root, map(customcombo));
	getpower: 0, 0;
	givepower: 40, 40;
	pausetime: 0, 12;
	animtype: Hard;
	air.animtype: Back;
	fall.animtype: Back;
	ground.type: High;
	air.type: Low;
	ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
	ground.slidetime: 18;
	guard.hittime: 1 + 16;
	guard.ctrltime: 1 + 16;
	guard.slidetime: 16;
	air.hittime: 120;
	airguard.ctrltime: 1 + 16;
	ground.velocity: -4.0, -7.4;
	ground.cornerpush.veloff: 0;
	guard.velocity: -10.52;
	air.velocity: -4.0, -7.4;
	air.cornerpush.veloff: 0;
	airguard.velocity: -6.00, -1.00;
	guard.dist: const(size.proj.attack.dist);
	yaccel: 0.4850;
	fall: 1;
	fall.recover: !(root, map(customcombo));
	fall.recovertime: 120;
	forcestand: 1;
	hitsound: -1;
	guardsound: s3, 0;
	guardsound.channel: 2;
	sparkno: -1 + 0 * (map(sparkno) := 8013);
	guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
	sparkxy: -10 + 0 * (map(sparkx.min) := -30) * (map(sparkx.max) := 0), map(sparky) := 0;
	envshake.time: 12; # special;
	envshake.freq: 180;
	envshake.ampl: ifelse((gametime % 2), -2, 2);
	envshake.decay: 1.0; # envshake.mul = 0.667;
}

# Getpower
ignoreHitPause if moveContact = 1 && numTarget {
	powerAdd{value: ifelse(moveguarded, 25, 50) * root, map(meterscaling)}
}

# Connected
ignoreHitPause if moveContact || moveReversed {
	changeState{value: 1006}
}

# End
ignoreHitPause if !animTime {
	changeState{value: 1007}
}

#----- Hit -----

#============================================================
# State 1006
#============================================================
[StateDef 1006;
	type: S;
	moveType: I;
	ctrl: 0;
	anim: 1006;
	velSet: 0, 0;
	sprPriority: 3;
]

# Trade Sound
if !time
&& (hitoverridden || prevmoveType = H) {
	playSnd{value: 3, 0; channel: 2; volumescale: 33}
}

# Scale
angleDraw{scale: 0.75, 0.75}

# Trans
ignoreHitPause {
	trans{trans: addAlpha; alpha: 256, 256}
}

# End
if !animTime {
	destroySelf{}
}

#----- Miss -----

#============================================================
# State 1007
#============================================================
[StateDef 1007;
	type: S;
	moveType: I;
	ctrl: 0;
	anim: 1007;
	velSet: 0, 0;
	sprPriority: 3;
]

# Trans
ignoreHitPause {
	trans{trans: addAlpha; alpha: 256, 256}
}

# End
if !animTime {
	destroySelf{}
}

