	}
}

# Circle
if numexplod(8251) {
	modifyexplod{
		id: 8251;
		scale: 0.0556 * (time + 1), 0.0556 * (time + 1);
		trans: addAlpha;
		alpha: 256 - (16 * time), 256;
	}
}

# Lightning
if !time {
	explod{
		anim: 8250;
		id: 8250;
		sprPriority: -2;
		posType: p1;
		pos: 0, -pos y;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# No Shadow
assertSpecial{flag: invisible; flag2: noshadow}

# End
if time >= 16 {
	destroySelf{}
}

#========================<SUPER FINISH>=============================

#============================================================
# State 8600
#============================================================
[StateDef 8600;
	type: A;
	velSet: 0, 0;
	anim: 9999;
]

# Sound
if !time {
	playSnd{value: 7, 7; channel: 1}
}

# Sound
if time <= 80 {
	sndpan{channel: 1; abspan: ceil(sin(gametime / 20.0 * pi) * 160)}
	assertSpecial{flag: nomusic}
}

# BG PalFX
if time < 16
&& !(time % 2) {
	bgPalFx{time: 1; color: 0; mul: 192, 192, 192}
}

# BG PalFX
if time < 16
&& time % 2 {
	bgPalFx{time: 1; color: 0; mul: 128, 32, 0}
}

# BG PalFX
if time = [16, 24] {
	bgPalFx{
		time: 1;
		color: 32 * (time -16);
		mul: 128 + 8 * (time - 16), 32 + 14 * (time - 16), 32 * (time - 16);
	}
}

# Move Name
if !time
&& root, map(superfinish) = 900 {
	varSet{v: 0; value: 1}
}

# Move Name
if !time
&& root, map(superfinish) = 3000 {
	varSet{v: 0; value: 2}
}

# Move Name
if !time
&& root, map(superfinish) = 3100 {
	varSet{v: 0; value: 3}
}

# Move Name
if !time
&& root, map(superfinish) = [3200, 3210] {
	varSet{v: 0; value: 4}
}

# Move Name
if !time
&& root, map(superfinish) = [3220, 3230] {
	varSet{v: 0; value: 5}
}

# Move Name
if !time
&& root, map(superfinish) = [3300, 3311] {
	varSet{v: 0; value: 6}
}

# Move Name
if !time
&& root, map(superfinish) = 3400 {
	varSet{v: 0; value: 7}
}

# Move Name
if !time
&& root, map(superfinish) = 3500 {
	varSet{v: 0; value: 8}
}

# MvC
if !time {
	explod{
		anim: 8600;
		id: 8600;
		ontop: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5, 0.5 * (1.3333333 * gameheight / gamewidth);
		bindtime: -1;
		removetime: 32;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Fade
if numexplod(8600) {
	modifyexplod{id: 8600; trans: addAlpha; alpha: ifelse(time < 16, 256, 256 -32 * (time -16)), 256}
}

# Text
if !time
&& var(0) {
	explod{
		anim: 8609 + var(0);
		id: 10;
		ontop: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5, 0.5 * (1.3333333 * gameheight / gamewidth);
		bindtime: -1;
		removetime: 32;
		pausemovetime: -1;
		supermovetime: -1;
	}
	explod{
		anim: 8609 + var(0);
		id: 11;
		ontop: 1;
		posType: left;
		pos: 160, ifelse((gamewidth / gameheight) > 1.55, 90, 120);
		scale: 0.5, 0.5 * (1.3333333 * gameheight / gamewidth);
		bindtime: -1;
		removetime: 8;
		pausemovetime: -1;
		supermovetime: -1;
	}
}

# Fade
if numexplod(10) {
	modifyexplod{
		id: 10;
		trans: addAlpha;
		alpha: ifelse(time < 16, 256, 256 -32 * (time -16)), ifelse(time < 16, 0, 32 * (time -16));
	}
}

# Fade
if numexplod(11) {
	modifyexplod{
		id: 11;
		scale: 0.5 + (0.0625 * time), (0.5 + (0.0625 * time)) * (1.3333333 * gameheight / gamewidth);
		trans: addAlpha;
		alpha: 256 - (32 * time), 32 * time;
	}
}

# Stop Shake
if time <= 24 {
	envshake{time: 1; ampl: 0}
}

# Assert
if time < 24 {
	assertSpecial{flag: nobardisplay}
}

# End
if numexplod
&& time >= 24
&& roundState != 3 {
	removeexplod{}
}

# End
if time >= 24
&& roundState != 3 {
	destroySelf{}
}

#========================<CAMERA CONTROL>=============================

#============================================================
# State 8999
#============================================================
[StateDef 8999;
	type: S;
	velSet: 0, 0;
	anim: 9999;
]

# Bound
screenBound{value: 0; movecamera: 1, 1}

# End
if roundState = 2 {
	destroySelf{}
}
