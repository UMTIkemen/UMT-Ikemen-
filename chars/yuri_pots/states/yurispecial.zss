]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# EX FX
if !time {
	playSnd{value: 0, 1000}
	explod{
		anim: 8410;
		sprPriority: 3;
		posType: p1;
		pos: -38, -82;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
	mapSet{map: "exflash"; value: 30}
}

# Sound
if animElem = 2 {
	playSnd{value: 5, 7; channel: 0}
}

# Sound
if animElem = 5 {
	playSnd{value: 7, 0}
}

# FX
if animElem = 2 {
	helper{
		helpertype: normal;
		stateno: 1004;
		id: 1004;
		name: "Kouou Ken FX";
		posType: p1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
}

# Pos
if animElem = 1 {
	posadd{x: 16}
}

# Pos
if animElem = 3 || animElem = 4 {
	posadd{x: 8}
}

if animElem = 5 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Kouou Ken
	helper{
		helpertype: normal; # projectile
		stateno: 1025;
		id: 1025;
		name: "EX Kouou Ken";
		posType: p1;
		pos: 64, -68;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<CHOU UPPER>=============================

#============================================================
# State 1100
#============================================================
[StateDef 1100;
	type: S;
	physics: N;
	moveType: A;
	anim: 1100;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 100 * map(meterscaling);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{
		map: "strength";
		value: ifelse(p2moveType = H && map(ai_attackwindow) >= 6, 2, ifelse(random < 500, 1, 0));
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Anim
if !time {
	changeAnim{value: ifelse(map(strength) = 2, 1102, ifelse(map(strength) = 1, 1101, 1100))}
}

# Pos
if animElem = 2 {
	posadd{x: ifelse(map(strength) = 2, 4, ifelse(map(strength) = 1, 2, 0))}
}

# Pos
if animElem = 4 {
	posadd{x: ifelse(map(strength) = 2, 20, ifelse(map(strength) = 1, 10, 0))}
}

# Vel
if animElemTime(4) >= 0 {
	velmul{x: 0.975}
}

# Accel
if animElemTime(4) >= 1 {
	veladd{y: 0.6}
}

# Vel
if (anim = 1100 && animElem = 4)
|| (anim = [1101, 1102] && animElem = 2) {
	velSet{x: ifelse(anim = 1102, 5, ifelse(anim = 1101, 4.5, 4))}
}

# Vel
if animElemTime(4) = [0, 1] {
	velSet{y: ifelse(anim = 1102, -10, ifelse(anim = 1101, -8, -6))}
}

# Grounded Frame
if animElemTime(4) = 0 {
	posfreeze{value: 1}
}

# Type
if animElem = 4 {
	stateTypeSet{stateType: A}
}

# Idle
persistent(0) if animElemTime(5) >= 0 {
	stateTypeSet{moveType: I}
}

# Sound
if animElem = 3 {
	playSnd{value: 5, 10; channel: 0}
	playSnd{value: 1, 2; stopongethit: 1}
}

if animElemTime(4) = 1 {
	# Sound
	playSnd{value: 0, 40}
	# Dust
	helper{
		helpertype: normal;
		stateno: 8100;
		id: 8100;
		name: "Jump Dust";
		posType: p1;
		ownpal: 1;
	}
}

# Hit
if animElem = 3 {
	hitdef{
		id: stateNo;
		attr: S, SA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 1);
		damage: ifelse(map(strength) = 2, 50, ifelse(map(strength) = 1, 60, 90)), ifelse(map(strength) = 2, 13, ifelse(map(strength) = 1, 15, 23));
		dizzypoints: 100 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 12, 12;
		animtype: Hard;
		air.animtype: Hard;
		fall.animtype: Hard;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		ground.velocity: ifelse(map(strength) = 2, -2.5, -4.5), ifelse(map(strength) = 2, -8.6, ifelse(map(strength) = 1, -7.4, -6.0));
		ground.cornerpush.veloff: 0;
		guard.cornerpush.veloff: 0;
		air.velocity: ifelse(map(strength) = 2, -2.5, -4.5), ifelse(map(strength) = 2, -8.6, ifelse(map(strength) = 1, -7.4, -6.0));
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 40), map(sparky) := -56;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit
if (anim = 1100 && animElem = 4 && (!moveContact && !moveReversed))
|| ((anim = 1101 || anim = 1102) && animElem = 4) {
	hitdef{
		id: stateNo;
		attr: A, SA;
		hitflag: MAF;
		guardflag: MA;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := ifelse((anim = 1101 || anim = 1102) && (animElem = 4), 2, 1));
		damage: ifelse(map(strength) = 2, 30, ifelse(map(strength) = 1, 40, 50)), ifelse(map(strength) = 2, 8, ifelse(map(strength) = 1, 10, 13));
		dizzypoints: 50 * !map(customcombo);
		getpower: ifelse(moveHit, 25, 100) * map(meterscaling), ifelse(moveguarded, 25, 50) * map(meterscaling);
		givepower: 40, 40;
		pausetime: 12, 12;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 1 + 18; # + 2 * map(counterhit_buffer);
		ground.slidetime: 18;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		airguard.ctrltime: 1 + 16;
		ground.velocity: ifelse(map(strength) = 2, -2.5, -4.5), ifelse(map(strength) = 2, -8.6, ifelse(map(strength) = 1, -7.4, -6.0));
		ground.cornerpush.veloff: 0;
		guard.cornerpush.veloff: 0;
		air.velocity: ifelse(map(strength) = 2, -2.5, -4.5), ifelse(map(strength) = 2, -8.6, ifelse(map(strength) = 1, -7.4, -6.0));
		air.cornerpush.veloff: 0;
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 1;
		fall.recovertime: 120;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8013);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 5) * (map(sparkx.max) := 20), map(sparky) := -100;
		envshake.time: 12; # special;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -2, 2);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Blur FX
if animElem = 4 {
	explod{
		id: 8190;
		anim: 8190;
		posType: p1;
		pos: 25, -115;
		scale: 0.67, 0.75;
		bindtime: 60;
		trans: addAlpha;
		alpha: 256, 256;
		removetime: ifelse(map(strength) = 2, 8, ifelse(map(strength) = 1, 6, 4));
