	velSet{x: ifelse(anim = 1202, 4.5, ifelse(anim = 1201, 3.25, 2.0)); y: -8.00}
	# Type
	stateTypeSet{stateType: A; physics: N}
}

# Sound
if ((anim = 1200 || anim = 1201) && animElem = 6)
|| (anim = 1202 && animElem = 14) {
	playSnd{value: 4, 6; channel: 0}
	playSnd{value: 7, 5}
}

# FX
if !numHelper(1204) {
	if ((anim = 1200 || anim = 1201)
	&& (animElemTime(4) >= 0 && animElemTime(7) < 0))
	|| (anim = 1202
	&& (animElemTime(12) >= 0 && animElemTime(15) < 0)) {
		helper{
			helpertype: normal;
			stateno: 1204;
			id: 1204;
			name: "Raiouken FX";
			posType: p1;
			size.xscale: 0.5;
			size.yscale: 0.5;
			ownpal: 1;
		}
	}
}

# Hit
if ((anim = 1200 || anim = 1201) && animElem = 7)
|| (anim = 1202 && animElem = 15) {
