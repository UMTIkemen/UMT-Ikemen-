#======================<KOUOU KEN>=============================

#============================================================
# State 1000
#============================================================
[StateDef 1000;
	type: S;
	physics: S;
	moveType: A;
	anim: 1000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: 50 * map(meterscaling);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: 1}
	mapSet{map: "combocheck"; value: 0}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Strength AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{
		map: "strength";
		value: ifelse(p2moveType = H || random < 500, 2, ifelse(random < 500, 1, 0));
	}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Anim
if !time {
	changeAnim{value: ifelse(map(strength) = 2, 1002, ifelse(map(strength) = 1, 1001, 1000))}
}

# Sound
if animElem = 2 {
	playSnd{value: 5, 7; channel: 0; freqmul: 0.98 + (random / 25000.0)}
}

# Sound
if animElem = 5 {
	playSnd{value: 7, 0}
}

# Pos
if animElem = 1 {
	posadd{x: 16}
}

# Pos
if animElem = 3 || animElem = 4 {
	posadd{x: ifelse(map(strength) = 2, 8, ifelse(map(strength) = 1, 4, 0))}
}

# FX
if animElem = 2 {
	helper{
		helpertype: normal;
		stateno: 1004;
		id: 1004;
		name: "Ko'ou Ken FX";
		posType: p1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
}

if animElem = 5 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Kouou Ken
	helper{
		helpertype: normal; # projectile
		stateno: 1005;
		id: 1005;
		name: "Ko'ou Ken";
		posType: p1;
		pos: 64, -68;
		size.xscale: 0.4;
		size.yscale: 0.4;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<EX KOUOU KEN>=============================

#============================================================
# State 1020
#============================================================
[StateDef 1020;
	type: S;
	physics: S;
	moveType: A;
