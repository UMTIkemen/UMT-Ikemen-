persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_special) := 1;
	map(cmd_erase_completed) := 1;
}

# Anim
if !time {
	changeAnim{value: ifelse(map(strength) = 2, 1202, ifelse(map(strength) = 1, 1201, 1200))}
}

