#======================<HAOU SHOUKOU KEN =============================

#============================================================
# State 3000
#============================================================
[StateDef 3000;
	type: S;
	physics: S;
	moveType: A;
	anim: 3000;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: -1000 + 0 * (map(superlevel) := 1);
	facep2: 1;
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]) && !map(customcombo), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	mapSet{map: "supercancelflag"; value: (prevStateNo = [1000, 2999] && map(supercancel) && !map(customcombo))}
	mapSet{map: "hypercancelflag"; value: (prevStateNo = [3000, 4999] && map(hypercancel))}
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Strength
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(map(cmd_strength_z), 2, ifelse(map(cmd_strength_y), 1, 0))}
}

# Button AI
ignoreHitPause if AIlevel && time <= 0 {
	mapSet{map: "strength"; value: ifelse(random < 500, 2, ifelse(random < 666, 1, 0))}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# NHB
if animElemTime(6) < -1 {
	notHitBy{time: 1; value: SCA}
}

# Sound
if time = 3 {
	playSnd{value: 5, 3; channel: 0}
}

# Superpause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8500;
		id: 8500;
		name: "Super Charge";
		posType: p1;
		pos: 13, -65;
		supermovetime: 255;
		ownpal: 1;
	}
}

# Superpause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		p2defmul: 1;
		unhittable: 1;
		anim: ifelse(map(cfg_superfx), -1, 100);
		pos: 13, -65;
		sound: s0, 8500;
		darken: !map(cfg_superfx);
	}
}

# FX
if animElem = 3 {
	helper{
		helpertype: normal;
		stateno: 3004;
		id: 3004;
		name: "Shoukou Ken FX";
		posType: p1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		supermovetime: 255;
		ownpal: 1;
	}
}

# Width
if animElem = 5 {
	width{player: 16}
}

if animElem = 6 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Haou Shoukou Ken
	helper{
		helpertype: normal; # projectile
		stateno: 3005;
		id: 3005;
		name: "Haou Shoukou Ken";
		posType: p1;
		pos: 70, -58;
		size.xscale: 0.4;
		size.yscale: 0.5;
		ownpal: 1;
	}
	# Sound
	playSnd{value: 7, 2}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<HIEN REKKOU>=============================

#============================================================
