		interpolation.alpha: 0, 256;
		sprPriority: sprPriority + 1;
		removeongethit: 1;
		removeonchangeState: 1;
		ownpal: 1;
	}
}

# Idle
persistent(0) if animElemTime(39) >= 0 {
	stateTypeSet{moveType: I}
}

# End
if vel y > 0
&& pos y > -vel y {
	changeState{value: 3401}
}

#----- Land -----

#============================================================
# State 3401
#============================================================
[StateDef 3401;
	type: S;
	physics: S;
	moveType: I;
	anim: 3401;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	moveHitpersist: 1;
]

# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 8102;
		sprPriority: -3;
		posType: p1;
		pos: 0, 0;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#======================<RAIODAMA>=============================

#============================================================
# State 3500
#============================================================
[StateDef 3500;
	type: A;
	physics: N;
	moveType: A;
	anim: 3500;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	powerAdd: -2000 + 0 * (map(superlevel) := 2);
]

# Damage Scaling - Add
if !time && map(combocheck) {
	mapAdd{map: "combototal"; value: ifelse((prevStateNo = [3000, 4999]), 3, ifelse((prevStateNo = [1000, 2999]) && !map(customcombo), 2, 1))}
	mapSet{map: "combocheck"; value: 0}
}

# Cancel Flags
persistent(0) ignoreHitPause if time <= 0 {
	mapSet{map: "supercancelflag"; value: (prevStateNo = [1000, 2999] && map(supercancel) && !map(customcombo))}
	mapSet{map: "hypercancelflag"; value: (prevStateNo = [3000, 4999] && map(hypercancel))}
}

# Super Cancel Flash
ignoreHitPause if time % 2 && time = [1, 11]
&& (map(supercancelflag) || map(hypercancelflag)) {
	palFx{time: 1; add: 255, 255, 255}
	map(juggle_count) := 0;
}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# Sound
if time = 3 {
	playSnd{value: 6, 15; channel: 0}
}

# Super Pause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8510;
		id: 8510;
		name: "Superpause FX";
		posType: p1;
		pos: ceil(-13 * const(size.xscale)), ceil(-107 * const(size.yscale));
		supermovetime: 255;
		size.xscale: 1;
		size.yscale: 1;
		ownpal: 1;
	}
}

# Super Pause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		anim: ifelse(map(cfg_superfx), -1, 101);
		pos: ceil(-13 * const(size.xscale)), ceil(-107 * const(size.yscale));
		sound: s0, 8500;
		p2defmul: 1;
		darken: !map(cfg_superfx);
	}
}

# NHB
if animElemTime(4) < 0 {
	notHitBy{time: 1; value: SCA}
}

# Width
if animElem = 3 {
	width{value: 16}
}

if animElem = 4 {
	# Correct Projectile Trade
	hitBy{value2: SCA, AA, AT; time: 1}
	# Fireball
	helper{
		helpertype: normal; # projectile
		stateno: 3505;
		id: 3505;
		name: "Raiodama";
		posType: p1;
		pos: 53, -50;
		size.xscale: 0.5;
		size.yscale: 0.5;
		ownpal: 1;
	}
}

# FX
if time = 43 {
	helper{
		helpertype: normal;
		stateno: 3504;
		id: 3504;
		name: "Raiodama FX";
		posType: p1;
		size.xscale: 0.5;
		size.yscale: 0.5;
		supermovetime: cond(numEnemy, (p2, pausetime), 60);
		ownpal: 1;
	}
}

# Sound
if animElem = 4 {
	playSnd{value: 7, 9}
}

# Accel
if animElemTime(4) >= 1 {
	veladd{y: 0.5}
}

# Vel
if animElemTime(4) = 1 {
	velSet{x: -1; y: -5}
}

# Land
if stateType = A
&& vel y > 0
&& pos y > -vel y {
	changeState{value: 3501}
}

