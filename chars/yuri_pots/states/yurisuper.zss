		sound: s0, 8510;
		darken: !map(cfg_superfx);
	}
}

# Push
if animElemTime(39) < 0 {
	playerPush{value: 0}
}

# Vel
if animElemTime(4) >= 0
&& animElemTime(35) < 0 {
	velSet{x: 0; y: -0.5}
}

# Vel
if animElemTime(35) >= 0
&& animElemTime(39) < 0 {
	velSet{x: 0; y: 0}
}

# Accel
if animElemTime(39) >= 0 {
	veladd{y: 0.6}
}

# Width
ignoreHitPause if moveHit = [1, 10]
&& animElemTime(10) >= 0
&& animElemTime(37) < 0 {
	width{edge: 50, 0}
}

# Sound
if animElem = 4 {
	playSnd{value: 5, 15; channel: 0}
}

# Sound
if animElem = 36 {
	playSnd{value: 4, 3; channel: 0}
}

# Sound
if animElem = 4 {
	playSnd{value: 7, 11}
}

# Sound
if animElem = 4 || animElem = 12 || animElem = 20 || animElem = 28 {
	playSnd{value: 1, 4; stopongethit: 1}
}

# Sound
if animElem = 36 {
	playSnd{value: 1, 5; stopongethit: 1}
}

# Hit Front
if animElem = 5 || animElem = 13 || animElem = 21 || animElem = 29 {
	hitdef{
		id: 3400;
		attr: A, HA;
		hitflag: MAF;
		guardflag: H;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := 9);
		damage: 20, 5;
		dizzypoints: 0;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 4;
		guard.pausetime: 0, 0;
		animtype: Hard;
		air.animtype: Back;
		fall.animtype: Back;
		ground.type: High;
		air.type: Low;
		ground.hittime: 1 + 12;
		ground.slidetime: 12;
		guard.hittime: 1 + 10;
		guard.ctrltime: 1 + 10;
		guard.slidetime: 10;
		air.hittime: 120;
		airguard.ctrltime: 1 + 16;
		ground.velocity: -4.49, 0;
		ground.cornerpush.veloff: 0;
		guard.velocity: -4.49;
		guard.cornerpush.veloff: 0;
		air.velocity: ifelse(p2dist x > 32, 20, 12), ifelse(p2dist y < (-64 - p2, const(size.mid.pos.y)), 0, -4.0);
		air.cornerpush.veloff: 0;
		airguard.velocity: -6.00, -1.00;
		airguard.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		air.fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 5;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 30) * (map(sparkx.max) := 60), map(sparky) := -60;
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
		p2facing: 1;
		p2sprPriority: sprPriority - 1;
	}
}

# Hit
if animElem = 9 || animElem = 17 || animElem = 25 || animElem = 33 {
