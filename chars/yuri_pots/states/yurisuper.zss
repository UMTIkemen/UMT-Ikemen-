}

# Custom Combo End
if !time && map(customcombo) > 0 {
	mapSet{map: "customcombo"; value: 0}
	mapSet{map: "juggle_count"; value: 0}
	palFx{time: 1}
}

# Erase Inputs
persistent(0) ignoreHitPause if !AIlevel && time <= 0 {
	map(cmd_erase_motion_super) := 1;
	map(cmd_erase_completed) := 1;
}

# NHB
if animElemTime(11) < 0 {
	notHitBy{time: 1; value: SCA}
}

# Sound
if time = 3 {
	playSnd{value: 5, 9; channel: 0}
}

# Superpause FX
if map(cfg_superfx)
&& time = 3 {
	helper{
		helpertype: normal;
		stateno: 8500;
		id: 8500;
		name: "Super Charge";
		posType: p1;
		pos: -28, -66;
		supermovetime: 255;
		ownpal: 1;
	}
}

# Superpause
if time = 3 {
	superpause{
		time: 41;
		movetime: 41;
		p2defmul: 1;
		unhittable: 1;
		anim: ifelse(map(cfg_superfx), -1, 100);
		pos: -28, -66;
		sound: s0, 8500;
		darken: !map(cfg_superfx);
	}
}

# Sound
if animElem = 12 || animElem = 19 || animElem = 28 {
	playSnd{value: 5, ifelse((animElem = 28), 1, 2); channel: 0}
}

# Vel
if animElem = 8 {
	velSet{x: 9}
}

# Vel
if animElem = 12 || animElem = 19 || animElem = 28 {
	velSet{
		x: ifelse((animElem = 28), 16, 12);
		y: ifelse((animElem = 28), -10, ifelse((animElem = 18), -6, -5));
	}
}

# Accel
if (animElemTime(12) >= 0 && animElemTime(15) < 0)
|| (animElemTime(19) >= 0 && animElemTime(23) < 0)
|| animElemTime(28) >= 0 {
	veladd{y: 0.4}
}

# Type
if animElem = 12
|| animElem = 19
|| animElem = 28 {
	stateTypeSet{stateType: A; physics: N}
}

# Type
if animElem = 15
|| animElem = 23 {
	stateTypeSet{stateType: S; physics: S}
}

# Vel
if stateType = A && vel y <= 0 {
	velmul{x: 0.85}
}

# Vel
if animElemTime(28) >= 0 && vel y > 0 {
	velSet{x: 0}
}

# Freeze Frame
if (animElemTime(14) >= 0
&& animElemTime(15) < 0)
|| (animElemTime(22) >= 0
&& animElemTime(23) < 0) {
	changeAnim{value: 3100; elem: animElemno(0)}
}

# Land
if (animElemTime(12) >= 0 && animElemTime(15) < 0)
&& vel y > 0
&& pos y > -vel y {
	changeAnim{value: 3100; elem: 15}
}

# Land
if (animElemTime(19) >= 0 && animElemTime(23) < 0)
&& vel y > 0
&& pos y > -vel y {
	changeAnim{value: 3100; elem: 23}
}

# Vel
if animElem = 7 || animElem = 15 || animElem = 23 {
	velSet{x: 0}
}

if animElemTime(12) < 0
|| (animElemTime(15) >= 0 && animElemTime(19) < 0)
|| (animElemTime(23) >= 0 && animElemTime(28) < 0) {
	# Vel
	velSet{y: 0}
	# Pos
	posSet{y: 0}
	# Type
	stateTypeSet{stateType: S; physics: S}
}

if animElem = 15 || animElem = 23 {
	# Sound
	playSnd{value: 0, 52}
	# Dust
	explod{
		anim: 8102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

if animElem = 12 || animElem = 19 || animElem = 28 {
	# Sound
	playSnd{value: 1, 1; stopongethit: 1}
	# Sound
	playSnd{value: 0, ifelse((animElem = 28), 41, 40)}
	# Dust
	helper{
		helpertype: normal;
		stateno: 8100;
		id: 8100;
		name: "Jump Dust";
		posType: p1;
		ownpal: 1;
	}
}

# Hit Low
if animElem = 11 || animElem = 17 || animElem = 18 || animElem = 26 || animElem = 27 {
	hitdef{
		id: stateNo;
		attr: S, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := ifelse((animElem = 17 || animElem = 26), 2, 2 + hitcount));
		damage: 30, 8;
		dizzypoints: 0;
		getpower: 0, 0;
		givepower: 40, 40;
		pausetime: 4, 8;
		animtype: Hard;
		air.animtype: Hard;
		fall.animtype: Hard;
		ground.type: Low;
		air.type: Low;
		ground.hittime: 32;
		ground.slidetime: 12;
		guard.hittime: 1 + 16;
		guard.ctrltime: 1 + 16;
		guard.slidetime: 16;
		air.hittime: 120;
		ground.velocity: -4.49, 0;
		ground.cornerpush.veloff: 0;
		air.velocity: -2.0, -6.3;
		air.cornerpush.veloff: 0;
		yaccel: 0.4850;
		fall: 0;
		air.fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 20) * (map(sparkx.max) := 40), map(sparky) := ifelse((animElem = 11), -42, ifelse((animElem = 17 || animElem = 26), -37, -65));
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Hit High
if animElem = 12 || animElem = 19 {
	hitdef{
		id: stateNo;
		attr: S, HA;
		hitflag: MAF;
		guardflag: M;
		priority: 4, Hit;
		air.juggle: 0 * (map(juggle_start) := 1 | map(juggle_increase) := 1 | map(juggle_limit) := (2 + hitcount));
		damage: 30, 8;
