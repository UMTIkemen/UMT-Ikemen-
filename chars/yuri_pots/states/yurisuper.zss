		guard.cornerpush.veloff: 0;
		air.velocity: -3.5, -11.0;
		air.cornerpush.veloff: 0;
		airguard.velocity: -6, -1;
		yaccel: 0.4850;
		fall: 1;
		fall.recover: 0;
		down.recover: 1;
		forcestand: 1;
		hitsound: s2, 2;
		hitsound.channel: 2;
		guardsound: s3, 0;
		guardsound.channel: 2;
		sparkno: -1 + 0 * (map(sparkno) := 8014);
		guard.sparkno: -1 + 0 * (map(guard.sparkno) := 8001);
		sparkxy: -10 + 0 * (map(sparkx.min) := 5) * (map(sparkx.max) := 20), map(sparky) := -100;
		envshake.time: 12; # super;
		envshake.freq: 180;
		envshake.ampl: ifelse((gametime % 2), -4, 4);
		envshake.decay: 1.0; # envshake.mul = 0.667;
	}
}

# Type
if animElem = 29 {
	stateTypeSet{moveType: I}
}

# Blur FX
if animElem = 12 || animElem = 19 || animElem = 28 {
	explod{
		id: 8190;
		anim: 8190;
		posType: p1;
		pos: 30, -120;
		scale: 0.67, 0.75;
		bindtime: 60;
		trans: addAlpha;
		alpha: 256, 256;
		removetime: ifelse((animElem = 28), 8, 4);
		interpolation.time: ifelse((animElem = 28), 8, 4);
		interpolation.alpha: 0, 256;
		sprPriority: sprPriority + 1;
		removeongethit: 1;
		removeonchangeState: 1;
		ownpal: 1;
	}
}

# End
if animElemTime(28) >= 0 && vel y > 0 && (pos y > -vel y) {
	changeState{value: 1105}
}

