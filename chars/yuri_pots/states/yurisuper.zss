#============================================================
# State 3210
#============================================================
[StateDef 3210;
	type: A;
	physics: N;
	moveType: A;
	anim: 3210;
	ctrl: 0;
	velSet: 0, 0;
	sprPriority: 2;
	moveHitpersist: 1;
]

if animElemTime(34) < 0 {
	# Width
	width{edge: 30}
	# Push
	playerPush{value: 0}
}

# Pos
if !time
&& numTarget(3200) {
	posSet{x: (target(3200), pos x) -(48 * facing)}
}

# Vel
if animElem = 3 {
	velSet{x: 0.50; y: (p2, const(size.head.pos.y) + (p2, pos y) -pos y + 45) / 56.0}
}

# Vel
if (animElemTime(3) >= 0 && animElemTime(33) < 0)
&& (vel y < -1.5 || pos y > 0) {
	velSet{y: ifelse(pos y > 0, 0, -1.5)}
}

# Vel
if (animElemTime(3) >= 0 && animElemTime(33) < 0)
&& p2BodyDist x <= 0 {
	velSet{x: 0}
}

# Sound
