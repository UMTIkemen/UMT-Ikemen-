# Anim
ignoreHitPause if anim = 3400
&& hitpausetime
&& (moveContact = 1 || moveReversed = 1)
&& (animElemTime(37) >= 0 && animElemTime(38) <= 0)
&& hitpausetime <= 14 {
	changeAnim{value: 3400; elem: 38}
}

# Blur FX
if animElem = 5 || animElem = 13 || animElem = 21 || animElem = 29 {
	explod{
		id: 8191;
		anim: 8191;
		posType: p1;
		pos: 70, -65;
		scale: 1.00, 0.67;
		bindtime: 60;
		trans: addAlpha;
		alpha: 256, 256;
		removetime: 6;
		interpolation.time: 6;
		interpolation.alpha: 0, 256;
		sprPriority: sprPriority + 1;
		removeongethit: 1;
		removeonchangeState: 1;
		ownpal: 1;
	}
}

# Blur FX
if animElem = 9 || animElem = 17 || animElem = 25 || animElem = 33 {
	explod{
		id: 8191;
		anim: 8191;
		posType: p1;
		pos: -80, -75;
		scale: -1.00, -0.67;
		bindtime: 60;
		trans: addAlpha;
		alpha: 192, 256;
		removetime: 6;
		interpolation.time: 6;
		interpolation.alpha: 0, 256;
		sprPriority: sprPriority - 1;
		removeongethit: 1;
		removeonchangeState: 1;
		ownpal: 1;
	}
}

# Blur FX
if animElem = 37 {
	explod{
		id: 8191;
		anim: 8191;
		posType: p1;
		pos: 70, -60;
		scale: 0.75, 0.75;
		bindtime: 60;
		trans: addAlpha;
		alpha: 256, 256;
		removetime: 6;
