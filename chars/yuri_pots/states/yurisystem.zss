	# Sound
	playSnd{value: 0, 700}
	# Flash
	palFx{add: 0, 64, 255; sinadd: 0, -64, -255, 60; time: 15}
	# FX
	explod{
		anim: 8360;
		ontop: 1;
		posType: p1;
		pos: 24, -34;
		pausemovetime: -1;
		supermovetime: -1;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
	# Shake
	envshake{time: 1; ampl: 0}
}

# End
if !animTime {
	changeState{value: 11; ctrl: 1}
}

#----- JUMPING -----

#============================================================
# State 702
#============================================================
