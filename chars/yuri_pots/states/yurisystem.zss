changeAnim{value: 5080}

# End
if hitshakeover {
	changeState{value: 1115081}
}

#============================================================
# State 1115081
#============================================================

[StateDef 1115081;
	type: L;
	physics: C;
	moveType: H;
	velSet: 0, 0;
]

# Var
if !time {
	varSet{sysv: 0; value: 1}
}

# End
if time >= 18 {
	selfState{value: 5110}
}
