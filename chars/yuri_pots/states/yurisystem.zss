	# FX
	explod{
		anim: 8360;
		ontop: 1;
		posType: p1;
		pos: 18, -86;
		pausemovetime: -1;
		supermovetime: -1;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
	# Shake
	envshake{time: 1; ampl: 0}
}

# End
if !animTime {
