#============================================================
# State 703
#============================================================

[StateDef 703;
	type: A;
	physics: N;
	moveType: I;
	anim: 703;
	ctrl: 1;
]

# Vel
if !time {
	velSet{x: vel x; y: ifelse(vel y < -2.5, vel y, -2.5)}
}

# Accel
if time > 0 {
	gravity{}
}

# Land
if vel y > 0
&& pos y > -vel y {
	changeState{value: 52}
}

#----- HELPER -----

#============================================================
# State 705
#============================================================
[StateDef 705;
	type: A;
	physics: N;
	moveType: I;
	anim: ifelse(root, stateType = C, 706, ifelse(root, stateType = A, 707, 705));
	velSet: 0, 0;
	ctrl: 0;
]

# NHB
notHitBy{value: SCA}
# Bind
bindToRoot{time: -1}

# Anim
if !time {
	if (!(root, AIlevel)
	&& root, command = "D")
	|| (root, AIlevel
	&& ((root, stateType != A) && p2stateType = C)) {
		changeAnim{value: 706}
	}
}

# Anim
if !time {
	if (!(root, AIlevel)
	&& root, command = "F")
	|| (root, AIlevel
	&& anim != 706) {
		changeAnim{value: ifelse((root, stateType = A), 707, 705)}
	}
}

# Anim
if anim = 705 || anim = 707 {
	changeAnim{value: ifelse((root, stateType = A), 707, 705)}
}

# Disable
if time >= ifelse((root, stateType = A), 8, 10)
|| facing != (root, facing)
|| (!(root, ctrl)
&& root, stateno != [700, 702]
&& root, stateno != 5120)
|| (root, stateno = [120, 155]
&& root, stateno != 140) {
	varSet{v: 0; value: 1}
}

# Disable
if !var(0)
&& !(root, AIlevel) {
	if (root, p2dist x >= 0
	&& root, command = "holdback")
	|| (root, p2dist x < 0
	&& root, command = "holdfwd")
	|| (time < 5
	&& root, p2dist x >= 0
	&& (root, command = "holdfwd" + root, command = "holddown") > 1)
	|| (time < 5
	&& root, p2dist x < 0
	&& (root, command = "holdback" + root, command = "holddown") > 1)
	|| (time >= 5
	&& root, p2dist x >= 0
	&& (root, command = "holdfwd" || root, command = "holddown"))
	|| (time >= 5
	&& root, p2dist x < 0
	&& (root, command = "holdback" || root, command = "holddown"))
	|| (time >= 1
	&& (anim = 705 || anim = 707)
	&& root, command = "D")
	|| (time >= 1
	&& anim = 706
	&& ifelse(root, p2dist x < 0, root, command = "B", root, command = "F")) {
		varSet{v: 0; value: 1}
	}
}

# Disable
if var(0) = 1 {
	changeAnim{value: 9999}
}

# Standing / Air
