		ownpal: 1;
	}
}

# Accel
if animElemTime(2) >= 0 {
	veladd{y: 0.85}
}

# Vel
if animElem = 2 {
	velSet{x: -6.73; y: -6.0}
}

# Land
if vel y > 0
&& pos y > -vel y {
	changeState{value: 106}
}

#----- LAND -----

#============================================================
# State 106
#============================================================
[StateDef 106;
	type: S;
	physics: S;
	ctrl: 0;
	anim: 47;
	velSet: 0, 0;
]

# Vel
velSet{x: 0; y: 0}
# Pos
posSet{y: 0}

if !time {
	# Sound
	playSnd{value: 0, 106}
	# Dust
	explod{
		anim: 8102;
		sprPriority: -3;
		posType: p1;
		scale: 0.5, 0.5;
		pausemovetime: -1;
		supermovetime: -1;
		ownpal: 1;
	}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#====================<PARRY>====================

#----- STANDING -----
#============================================================
# State 700
#============================================================
[StateDef 700;
	type: S;
	physics: S;
	moveType: I;
	anim: 700;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 2;
	powerAdd: 0;
	facep2: 1;
]

# HB
hitBy{value: SCA, AT; time: 1}

# Check Parried Helper
if !time {
	mapSet{map: "parry_helper_ID"; value: 0}
	if getHitVar(playerID)
	&& playerIDexist(getHitVar(playerID))
	&& playerID(getHitVar(playerID)), isHelper {
		mapSet{map: "parry_helper_ID"; value: getHitVar(playerID)}
	}
}

# Freeze Parried Helper
if playerIDexist(map(parry_helper_ID))
&& playerID(map(parry_helper_ID)), moveType = A
&& playerID(map(parry_helper_ID)), hitpausetime = 0 {
	posadd{
		redirectid: map(parry_helper_ID);
		x: -1 * playerID(map(parry_helper_ID)), vel x;
		y: -1 * playerID(map(parry_helper_ID)), vel y;
	}
}

# Consecutive Parries
if !time
&& map(parry_nowalk) > 0 {
	posadd{x: -8}
}

# Freeze
posfreeze{value: 1}
# No walking
mapSet{map: "parry_nowalk"; value: 4}

if !time {
	# Sound
	playSnd{value: 4, 0; channel: 0}
	# Sound
	playSnd{value: 0, 700}
	# Flash
	palFx{add: 0, 64, 255; sinadd: 0, -64, -255, 60; time: 15}
	# FX
	explod{
		anim: 8360;
		ontop: 1;
		posType: p1;
		pos: 32, -62;
		pausemovetime: -1;
		supermovetime: -1;
		scale: 0.5, 0.5;
		ownpal: 1;
	}
	# Shake
	envshake{time: 1; ampl: 0}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

#----- CROUCHING -----

