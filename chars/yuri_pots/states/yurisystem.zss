#============================================================
[StateDef 195;
	type: S;
	physics: S;
	moveType: I;
	anim: 195;
	velSet: 0, 0;
	ctrl: 0;
	sprPriority: 1;
]

# Give power
if time = 1
&& numEnemy {
	powerAdd{redirectid: p2, ID; value: min(ceil(p2, powerMax / 9.0), 334)}
}

# Sound
if animElem = 2 {
	playSnd{value: 6, 5; channel: 0}
}

# Sound
if animElem = 3 || animElem = 5 {
	playSnd{value: 1, 0}
}

# Slap
if animElem = 10 || animElem = 13 || animElem = 16 {
	playSnd{value: 7, 3; volumescale: 50; freqmul: 0.95 + (random / 10000.0)}
}

# Loop
if (animElemTime(17) >= 0 && animElemTime(18) < 0)
&& command = "/s" {
	changeAnim{value: 195; elem: 14}
}

# End
if !animTime {
	changeState{value: 0; ctrl: 1}
}

