yes.offset = -80, 60
yes.active.text = "YES"
yes.active.font = 3,0,0, 128,128,128
yes.active.offset = -80, 60
no.text = "NO"
no.font = 3,3,0,
no.offset = 80, 60
no.active.text = "NO"
no.active.font = 3,0,0, 128,128,128
no.active.offset = 80, 60


