;-------------------------------------------------------------------
[Info]
name = "Ultimate MUGEN Team"
author = "JtheSaltyy"
versiondate = 3, 10, 21
mugenversion = 1.1
localcoord = 640,480


;-------------------------------------------------------------------
[Files]
spr = def+sff+snd/system.sff ;Filename of sprite data
snd = def+sff+snd/system_alt.snd ;Filename of sound data
;logo.storyboard = def+sff+snd/logo.def ;Logo storyboard definition
;intro.storyboard = def+sff+snd/intro.def ;Intro storyboard definition
select = select.def
;fight = data/fight.def  
fight = data/VPHD_Bars/fightHD_UMT.def
;fight = data/life_NB/fight.def
;fight = data/life_xi_ar/fight.def
;fight = data/life_legacy/fight.def

font1 = data/MAFJ/font/qoh_big.fnt ;Title Screen (not-active)
font2 = data/MAFJ/font/Qoh_bigbig.fnt ;Title Screen (active), Character Name on vs. screen and win quote screen, Team Mode active font
font3 = data/MAFJ/font/sfa3big.fnt ;"TEAM MODE" text
font4 = data/MAFJ/font/qoh_big.fnt ;Character Name on select screen, continue + yes/no
font5 = data/MAFJ/font/qoh_small.fnt ;Team mode non-active font
font6 = data/MAFJ/font/mshsmall.fnt ;"YOU FINISHED IT" text
font7 = data/MAFJ/font/sfa2name.fnt ;Character names during fight, stage names
font8 = data/MAFJ/font/msgothic-tt20.def ;Winquotes
;font9 = f-4x6.def         ;System fonts
;font10 = f-6x9.def         ;System fonts
;font11 = jg.fnt            ;System fonts


;-------------------------------------------------------------------
[Music]
title.bgm = data/MAFJ/def+sff+snd/title.mp3
title.bgm.loop = 1
select.bgm = data/MAFJ/def+sff+snd/02 - Player Select 1.mp3 ;player-select.mp3
select.bgm.loop = 1
vs.bgm = data/MAFJ/def+sff+snd/versus.mp3
vs.bgm.loop = 0
victory.bgm = data/MAFJ/def+sff+snd/victory.mp3
victory.bgm.loop = 0


