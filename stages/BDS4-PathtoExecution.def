boundright = 96
boundhigh  =-435
boundlow   = 0
verticalfollow = 0.9
floortension   = 90
tension        = 50
cuthigh        = 0
cutlow         = 0
overdrawhigh   = 28
overdrawlow    = 28

;----------------------------------------------------------------------------
[PLAYERINFO]
;--- Player 1 ---
p1startx =-70    
