p1startz = 0     
p1facing = 1     

;--- Player 2 ---
p2startx = 70    
p2starty = 0     
p2startz = 0     
p2facing =-1     

;--- Common ---  
leftbound  =-1000
rightbound = 1000
topbound   = 0  
botbound   = 0  

;----------------------------------------------------------------------------
[SCALING]
