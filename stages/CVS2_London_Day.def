; Through the administrative control of the bus
;------------------------------------------------- -;
[BGCtrlDef 96]
looptime = 1200
CtrlID = 96

[BGCtrl 96]
type = posset
time = 0
x = -50

[bgctrl 96-1]
type = velset
time = 1
x = -2.5

