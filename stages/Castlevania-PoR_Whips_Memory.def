spriteno = 1, 0
mask     = 1
start    = 0, 0
delta    = 0.15, 1
velocity = 0, 0
layerno = 0

;奥木
[BG 3]
type = normal
spriteno = 1, 1
mask     = 1
start    = 0, 0
delta    = 0.15, 1
velocity = 0, 0
layerno = 0

