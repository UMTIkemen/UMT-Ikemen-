;**********************************************************************************
;M.U.G.E.N専用ステージ
;	悪魔城ドラキュラ　ギャラリー オブ ラビリンス　『ムチのきおく』
;　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　by.ライグ・ギラル
;**********************************************************************************

;動作確認：Win版のみ動作確認済み、0414以降対応
;最終更新：2019年10月07日
;ＨＰ公開：『聖なるM.U.G.E.N』にて公開中　http://castlevaniamugen.web.fc2.com/
;Version ：1.00

;-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+
;このステージはＤＳ版『悪魔城ドラキュラ　ギャラリー オブ ラビリンス』の
;「ムチのきおく」エリアです。
;なお、このステージは個人で楽しんでいただく為、転載は一切禁じます。
;-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+-+


;----------------------------------------------------------------------------------
;ステージの名前
[Info]
name= "Castlevania-PoR_Whip's Memory"

;カメラ
[Camera]
startx         = 0
starty         = 0
boundleft      = -220;-250
boundright     = 250;250
boundhigh      = 0
boundlow       = 0
tension        = 40
;verticalfollow = .3
verticalfollow =.93
floortension = 106

;キャラ
[PlayerInfo]
;--- Player 1 ---
p1startx   = -70
p1starty   = 0
p1startz   = 0
p1facing   = 1
;--- Player 2 ---
p2startx   = 70
p2starty   = 0
p2startz   = 0
p2facing   = -1
;--- Common ---
leftbound  =  -2000
rightbound =  2100
topbound   =  0
botbound   =  0

;スケール
[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

;座標
[Bound]
screenleft  = 15
screenright = 15

;ステージ情報
[StageInfo]
zoffset  = 224
autoturn = 1
resetBG  = 0

;影
[Shadow]
color = 0, 0, 0
yscale = 0
reflect = 0

;音楽
[Music]
bgmusic= sound/05. Divine Bloodlines.mp3
bgvolume = 255

;画像ファイルの指定と残像の有無
[BGdef]
spr=stages/Castlevania-PoR_Whips_Memory.sff
debugbg = 1

;ステージの画像配置位置

;背景
[BG 0]
type = normal
spriteno = 0, 1
mask     = 1
start    = 0, 0
delta    = 0.1, 0
velocity = 0, 0
layerno = 0

;天井
[BG 1]
type = normal
spriteno = 5, 0
mask     = 1
start    = 0, 0
delta    = 1, 1
tile = 1,0
tilespacing = 0
velocity = 0, 0
layerno = 0

;奥城
