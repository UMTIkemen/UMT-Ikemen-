[Info]
 ;Name of the stage.
name = "MMANoviceArena_1.1NoZoom"
author = "MatreroG"
displayname = "MMA Novice Arena/A"

[Camera]
startx = 0
starty = 0

boundleft = -260
boundright = 260

boundhigh = -310
boundlow = 0

verticalfollow = .7
floortension = 25
tension = 50


;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70          
p1starty = 0           
p1startz = 0            
p1facing = 1            

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000 
rightbound =  1000 
topbound  =  0     
botbound  =  0     

;--------------------------------------------------------
[Scaling]
topz     = 0       
botz     = 50      
topscale = 1       
botscale = 1.2     

;--------------------------------------------------------
[Bound]
screenleft = 20    
screenright = 20  

;--------------------------------------------------------
[StageInfo]
zoffset = 205
autoturn = 1
resetBG = 1
hires = 0

;--------------------------------------------------------
[Shadow]
intensity = 120
color = 0,0,0
yscale = .12
fade.range = -400,-100

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = sound/MMANoviceArena.mp3
bgvolume = 255

;========================================================
;-------------------------------------
; Main background definition
[BGdef]
spr = MMANoviceArena.sff
debugbg = 0

