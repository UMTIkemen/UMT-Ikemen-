[Info] 
 
name = "Mexico - Ormeca ruins - Urien/A"

[Camera]

startx = 0
starty = 0

boundleft = -290
boundright = 290

boundhigh = -180
boundlow = 0

verticalfollow = 1

floortension = 100

tension = 60

[PlayerInfo]

p1startx = -80        
p1starty = 0            
p1startz = 0          
p1facing = 1           

p2startx = 80
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 
rightbound =  1000 
topbound  =  0     
botbound  =  0  

[Scaling]

topz     = 0     
botz     = 50     
topscale = 1      
botscale = 1.2

[Bound]

screenleft = 28 

screenright = 28  

[StageInfo]

zoffset = 220

autoturn = 1

resetBG = 1

[Shadow]

color = 128,128,128

yscale = .1


[Music]
bgmusic = sound/Urien's Theme - Crazy Chili Dog [SF III.3].mp3
bgvolume = 255

[BGdef]

spr = stages/urienstage.sff

debugbg = 0

