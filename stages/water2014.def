;; SFZ2 Rose's stage MUGEN Edition
;; (options: H-Scroll-loop)

;;Note:
; "window=" does NOT work with "parallax" in ikemen
; please see "@IKEMEN@" below


[Info]
	name="water2014"
	displayname="Water2014/A"
	versiondate=10,31,2016
	mugenversion=1.1

[Camera]
	startx=0
	starty=0
	boundleft=-260
	boundright=260
	boundhigh=-260
	boundlow=0
	verticalfollow=1

	floortension=150
	tension=100 ;;50

	;;--- * v1.1 (zoom) *---
;;	cuthigh=30 ;;c_hi
	cutlow=10 ;;c_lo
	;;---
	overdrawhigh=5
	overdrawlow=5
	;;---
	tensionhigh=85 ;;t_hi
	tensionlow=25
	;startzoom=1
	;zoomout=0.85 ;;c_zo
	;zoomin=1 ;;c_zi
	;;--- * v1.1 (zoom) *---

[PlayerInfo]
	p1startx=-73
	p1starty=0
	p1startz=0
	p1facing=1

	p2startx=73
	p2starty=0
	p2startz=0
	p2facing=-1

	leftbound=-1000
	rightbound=1000
	topbound=0
	botbound=0


[Scaling]
	topz=0
	botz=50
	topscale=1
	botscale=1.2


[Bound]
	screenleft=15
	screenright=15


[StageInfo]
	zoffset=215
	autoturn=1
	resetBG=0
	localcoord=320,240

[Shadow]
	color=0,0,0
	intensity=196
	reflect=0
	yscale=-0.05
	fade.range=-100,0
[Reflection]
	intensity=0

[Music]
	bgmusic=sound/Street Fighter Alpha 2 OST Rose Theme.mp3
	bgvolume=255

;----------------
[BGdef]
	spr=water2014.sff
	debugbg=0





